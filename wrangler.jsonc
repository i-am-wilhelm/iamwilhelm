{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Same worker name the previous prototype deployed to, so `npm run deploy`
  // replaces it in place and the custom domains carry over.
  "name": "iamwilhelm",
  "compatibility_date": "2026-07-01",
  // The script only runs for /api/* (run_worker_first); every other request
  // is served straight from the static assets without invoking it.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Equal Volume two-phone rooms: one PoemRoom per four-character code.
  "durable_objects": {
    "bindings": [{ "name": "POEM_ROOM", "class_name": "PoemRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PoemRoom"] }],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "iamwilhelm.com", "custom_domain": true },
    { "pattern": "www.iamwilhelm.com", "custom_domain": true }
  ]
}
