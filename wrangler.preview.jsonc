{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Preview worker for branch builds (.github/workflows/preview.yml). A
  // separate worker on workers.dev with no routes, so a preview deploy can
  // never touch the production worker or its custom domains.
  "name": "iamwilhelm-preview",
  "compatibility_date": "2026-07-01",
  // The script only runs for /api/* (run_worker_first); every other request
  // is served straight from the static assets without invoking it.
  "main": "./worker/index.ts",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Equal Volume two-phone rooms: one PoemRoom per four-character code.
  "durable_objects": {
    "bindings": [{ "name": "POEM_ROOM", "class_name": "PoemRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PoemRoom"] }]
}
