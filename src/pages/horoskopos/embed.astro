---
/**
 * Horoskopos, the embed route (/horoskopos/embed/). One module of the engine
 * on a page of its own, made to sit in an <iframe> on someone else's site:
 * no site nav, no museum chrome, only the module and a fixed footer with
 * the Horoskopos mark and the way to cast your own chart.
 *
 * It reads the same share state as the engine page
 * (?c=<chart>&m=<module>&f=<focus>&p=<privacy>, plus size and theme). With
 * no view named it is the daily read, which takes no chart and turns over
 * each day. The markup comes from the share registry's embed renderers
 * (src/scripts/horoskopos/share/registry.ts); this page is their stylesheet.
 *
 * Framing is allowed for this route alone (public/_headers). It is kept out
 * of search engines and the sitemap; its canonical is the engine page.
 */
import { SITE_URL } from '../../config/site';
import '../../styles/horoskopos-share.css';

const engine = `${SITE_URL}/gallery/horoskopos/`;
---

<!doctype html>
<html lang="en" data-theme="dark" data-size="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Horoskopos</title>
    <meta name="description" content="One view from Horoskopos, the chart engine by Michael Wilhelm." />
    <meta name="robots" content="noindex, follow" />
    <meta name="referrer" content="origin" />
    <link rel="canonical" href={engine} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/literata-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var q = new URLSearchParams(location.search), size = q.get('size'), root = document.documentElement;
        root.dataset.theme = q.get('theme') === 'light' ? 'light' : 'dark';
        root.dataset.size = size === 'square' || size === 'tall' || size === 'wide' ? size : 'auto';
      })();
    </script>
  </head>
  <body>
    <main id="hk-root" class="emb-main"><p class="emb-wait">Reading the sky…</p></main>
    <footer class="emb-foot">
      <a id="hk-open" class="emb-mark" href="/gallery/horoskopos/?ref=embed" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 12A8.5 8.5 0 1 0 3.5 12A8.5 8.5 0 1 0 20.5 12M0.6 12H23.4" /><circle cx="3.5" cy="12" r="2.1" /></svg>
        <span>Horoskopos</span>
      </a>
      <a class="emb-cta" href="/gallery/horoskopos/?ref=embed" target="_blank" rel="noopener">Cast your own chart <span aria-hidden="true">&rarr;</span></a>
    </footer>
    <script>
      import '../../scripts/horoskopos/share/embed.ts';
    </script>
  </body>
</html>

<style is:global>
@font-face{font-family:'Literata';font-style:normal;font-weight:200 900;font-display:swap;src:url('/fonts/literata-greek-ext-opsz-normal.woff2') format('woff2');unicode-range:U+1F00-1FFF}
@font-face{font-family:'Literata';font-style:normal;font-weight:200 900;font-display:swap;src:url('/fonts/literata-greek-opsz-normal.woff2') format('woff2');unicode-range:U+0370-0377,U+037A-037F,U+0384-038A,U+038C,U+038E-03A1,U+03A3-03FF}
@font-face{font-family:'Literata';font-style:normal;font-weight:200 900;font-display:swap;src:url('/fonts/literata-latin-ext-opsz-normal.woff2') format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:'Literata';font-style:normal;font-weight:200 900;font-display:swap;src:url('/fonts/literata-latin-opsz-normal.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Literata';font-style:italic;font-weight:200 900;font-display:swap;src:url('/fonts/literata-latin-opsz-italic.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/ibm-plex-mono-latin-500-normal.woff2') format('woff2')}
@font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:600;font-display:swap;src:url('/fonts/ibm-plex-mono-latin-600-normal.woff2') format('woff2')}

html{color-scheme:dark;background:#0b0a10}
html[data-theme=light]{color-scheme:light;background:#f6f1e6}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;display:flex;flex-direction:column;background:#0b0a10;color:#efe8d8;font-family:'Literata',Georgia,'Times New Roman',serif}
html[data-theme=light] body{background:#f6f1e6;color:#1d1a24}
html[data-theme=light] .hk{--hk-ink:#1d1a24;--hk-mute:#5a5563;--hk-rule:#d8cfbb}
/* The engine's bright accents are made for a night field; on paper they are deepened so they keep their contrast. */
html[data-theme=light] .hk-k,html[data-theme=light] .hk-gk,html[data-theme=light] .hk-j,html[data-theme=light] .hk-g{filter:brightness(.5) saturate(1.6)}
.emb-main{flex:1 1 auto;padding:18px 18px 14px;min-height:0}
.emb-main>.hk{max-width:640px;margin:0 auto}
.emb-wait{margin:0;font-family:'IBM Plex Mono',ui-monospace,Menlo,Consolas,monospace;font-weight:500;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:#aaa49b}
/* Fixed sizes: the frame sets the box, the reading scrolls inside it, the footer stays put. */
html:not([data-size=auto]) body{height:100vh}
html:not([data-size=auto]) .emb-main{overflow:auto}
html[data-size=wide] .emb-main>.hk-chart{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0 18px;max-width:none;align-items:start}
html[data-size=wide] .hk-chart .hk-h{grid-column:2}
html[data-size=wide] .hk-chart .hk-cv{grid-column:1;grid-row:1 / span 2;margin:0}
html[data-size=wide] .hk-chart .hk-b{grid-column:2}
.emb-foot{flex:none;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 18px;border-top:1px solid #2d2935;background:#15131c;font-family:'IBM Plex Mono',ui-monospace,Menlo,Consolas,monospace;font-weight:600;font-size:.7rem;letter-spacing:.1em;text-transform:uppercase}
html[data-theme=light] .emb-foot{background:#ece5d5;border-top-color:#d8cfbb}
.emb-foot a{display:inline-flex;align-items:center;gap:8px;min-height:32px;color:#f2c56b;text-decoration:none}
html[data-theme=light] .emb-foot a{color:#6b4a06}
.emb-foot a:hover span:first-of-type,.emb-foot a:focus-visible{text-decoration:underline;text-underline-offset:3px}
.emb-foot svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round}
.emb-foot svg circle{fill:currentColor;stroke:none}
.emb-cta{color:#efe8d8 !important;letter-spacing:.06em}
html[data-theme=light] .emb-cta{color:#1d1a24 !important}
.hk a{color:inherit;text-underline-offset:3px}
:focus-visible{outline:2px solid #f2c56b;outline-offset:2px}
</style>
