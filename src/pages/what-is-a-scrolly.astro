---
/**
 * /what-is-a-scrolly: Room IV, the glossary. A plain museum page that
 * defines the form the commissions page sells: what a scrolly is, where the
 * word comes from, what makes a page one, what it is for, what it costs,
 * three to open, and five questions. The copy is the owner's, verbatim.
 * No scroll effects, no pinned exhibits, no script beyond Museum.astro's.
 *
 * JSON-LD: DefinedTerm (the bold first sentence as the definition),
 * FAQPage for the five questions at the foot (built from the same array as
 * the visible text), and Article with the site's Person as author.
 */
import Museum from '../layouts/Museum.astro';
import Placard from '../components/museum/Placard.astro';
import Meander from '../components/museum/Meander.astro';
import Colophon from '../components/museum/Colophon.astro';
import { SITE_URL } from '../config/site';
import { ogImage } from '../config/og';
import { getPiece } from '../lib/pieces';

const url = `${SITE_URL}/what-is-a-scrolly/`;
const title = 'What Is a Scrolly? Definition, Parts, Cost | Michael Wilhelm';
const description =
  'A scrolly is an essay, poem, or report told as a web page where the design is part of the argument. What makes one, where the form came from, what it costs, and live examples.';
const definition =
  'A scrolly is a long piece of writing told as a web page where the design is part of the argument.';
/* "Last updated November 2026" in the byline; the schema carries the same month. */
const modified = new Date('2026-11-09T00:00:00Z');

/* The three to open, by their collection entries, so a moved piece follows. */
const examples = [
  {
    piece: await getPiece('true-amazons'),
    note: 'a pinned arrowhead that oxidizes as the thesis moves; hold-to-draw bow; filterable source ledger.',
  },
  {
    piece: await getPiece('everyone-searchable'),
    note: 'a futurist essay with its own visual world, chaptered and sourced.',
  },
  {
    piece: await getPiece('mimics-and-mythmakers'),
    note: 'a descent through ocean zones with a live depth gauge.',
  },
];

const faq = [
  {
    q: 'Is a scrolly the same as scrollytelling?',
    a: 'Yes. Scrollytelling names the technique; a scrolly is one finished piece built with it. Newsrooms coined both.',
  },
  {
    q: 'Is a scrolly the same as an explorable explanation?',
    a: 'They are siblings. An explorable explanation (Bret Victor, 2011) puts a live simulation inside the text for the reader to run. A scrolly drives its exhibits by scroll position and can include explorable parts.',
  },
  {
    q: 'Does a scrolly need data?',
    a: 'No. The exhibits can be drawings, documents, maps, or instruments. Data becomes a chart the reader reaches at the right moment when it exists.',
  },
  {
    q: 'Does a scrolly work on a phone?',
    a: 'Yes, when it is designed for the phone first. Pinned exhibits stack so the picture stays visible during the step that changes it.',
  },
  {
    q: 'Does a scrolly work with a screen reader?',
    a: 'Yes, when it ships with a plain-text twin and respects the reader’s reduced-motion setting. Every piece I build does both.',
  },
];

const schema = [
  {
    '@type': 'DefinedTerm',
    '@id': `${url}#term`,
    name: 'scrolly',
    description: definition,
    inDefinedTermSet: url,
    url,
  },
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    url,
    mainEntityOfPage: url,
    headline: 'What is a scrolly?',
    description,
    image: ogImage('/og.png'),
    datePublished: modified.toISOString(),
    dateModified: modified.toISOString(),
    author: { '@id': `${SITE_URL}/#person` },
    about: { '@id': `${url}#term` },
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    url,
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---

<Museum title={title} description={description} schema={schema}>
  <article class="page" aria-labelledby="scrolly-title" style="--room-accent: var(--room-iv)">
    <div class="page__inner wrap">
      <header class="page__head">
        <Placard
          id="scrolly-title"
          level={1}
          label="Room IV · Glossary"
          title="What is a scrolly?"
          medium="The form the gallery is built in, defined: its parts, its lineage, what it costs"
          catalog="Cat. IV"
        />
        <div class="page__statement prose-museum" data-reveal>
          <p class="lede">
            <strong>{definition}</strong> As the reader scrolls, a pinned picture changes state, a chart draws itself at
            the moment the text needs it, a held button turns the page. The word is short for scrollytelling, and
            newsroom graphics desks have used it for the form since the early 2010s.
          </p>
        </div>
      </header>

      <section class="sect" aria-labelledby="points-title" data-reveal>
        <h2 class="sect__title display" id="points-title">Key points</h2>
        <ul class="sect__body points" role="list">
          <li>A scrolly is a piece of writing first. The exhibits serve the argument; the scroll position is the reader's hand on the page.</li>
          <li>The form began in newsrooms. The New York Times's Snow Fall (December 2012) is the piece most people name as the start.</li>
          <li>A good scrolly reads complete with scripts off, on a phone, and through a screen reader. Motion is the enhancement, never the content.</li>
          <li>A commissioned scrolly starts at $2,500 and takes three to five weeks.</li>
        </ul>
      </section>

      <section class="sect" aria-labelledby="word-title" data-reveal>
        <h2 class="sect__title display" id="word-title">Where the word comes from</h2>
        <div class="sect__body prose-museum">
          <p>
            Scrollytelling is scrolling plus storytelling: a page where what happens on screen is driven by how far the
            reader has scrolled. Newsroom graphics teams shortened it to "scrolly" for the pieces themselves, the way an
            editor says "the splash" or "the sidebar." The Pudding, the Washington Post, Reuters, the South China Morning
            Post, and Bloomberg build them for data stories; Bartosz Ciechanowski builds them solo for physics and
            machines; Nicky Case's explorable explanations are a sibling form where the reader runs a simulation inside
            the essay.
          </p>
          <p>
            I use the word for what I build: essays, poems, and stories read in the original languages, set as pages the
            reader handles.
          </p>
        </div>
      </section>

      <section class="sect" aria-labelledby="parts-title" data-reveal>
        <h2 class="sect__title display" id="parts-title">What makes a page a scrolly</h2>
        <div class="sect__body prose-museum">
          <p>Four parts, and a piece needs the first three to earn the name.</p>
          <ol class="parts" role="list">
            <li>
              <span class="parts__num display">1</span>
              <span class="parts__text"><strong>A pinned exhibit.</strong> A picture, chart, document, or instrument that stays on screen while text steps past it and changes state with each step.</span>
            </li>
            <li>
              <span class="parts__num display">2</span>
              <span class="parts__text"><strong>Steps.</strong> Short passages of text, each one telling the exhibit what to do next. The text points at the picture; the picture carries the point.</span>
            </li>
            <li>
              <span class="parts__num display">3</span>
              <span class="parts__text"><strong>A twin.</strong> The whole piece as plain text in reading order, with every exhibit described in a sentence, for readers with scripts off, screen readers, search engines, and anyone who wants to quote it.</span>
            </li>
            <li>
              <span class="parts__num display">4</span>
              <span class="parts__text"><strong>A ledger.</strong> Where the piece makes claims, a list of them, each tagged text, reading, or disputed, with its source. Optional for a poem; required for an essay.</span>
            </li>
          </ol>
          <p>
            A page with scroll animations and no argument is a landing page. A page with an argument and no exhibit is an
            article. A scrolly is the one where removing either the text or the picture breaks the piece.
          </p>
        </div>
      </section>

      <section class="sect" aria-labelledby="for-title" data-reveal>
        <h2 class="sect__title display" id="for-title">What a scrolly is for</h2>
        <ul class="sect__body points" role="list">
          <li>An essay or poem whose argument has a shape: a descent, a drawn bow, a word changing meaning across two thousand years.</li>
          <li>An impact report that donors finish, with the numbers drawn as they arrive and the ask at the end.</li>
          <li>A launch page for a chapter, a track, or a series, with a pre-order or ticket door built into the scroll.</li>
          <li>An origin story for a founder, told the way they tell it in the room, with the product arriving where it arrives.</li>
        </ul>
      </section>

      <section class="sect" aria-labelledby="cost-title" data-reveal>
        <h2 class="sect__title display" id="cost-title">What a scrolly costs and how long it takes</h2>
        <div class="sect__body prose-museum">
          <p>
            A commissioned scrolly starts at $2,500 for six to nine chapters with custom exhibits, a twin, a share image
            rendered from the page, and a ledger. Half to start, half at launch. Original illustration, data that needs
            cleaning, voice or sound, and longer pieces are quoted. A base piece takes three to five weeks from the first
            story session to launch. You own the files; the piece lives on your domain or mine.
          </p>
        </div>
      </section>

      <section class="sect" aria-labelledby="open-title" data-reveal>
        <h2 class="sect__title display" id="open-title">Three to open</h2>
        <div class="sect__body prose-museum">
          <ul class="points" role="list">
            {
              examples.map(({ piece, note }) => (
                <li>
                  <a class="text-link" href={piece.path}>{piece.title}</a> &mdash; {note}
                </li>
              ))
            }
          </ul>
          <p>
            The full gallery is at <a class="text-link" href="/gallery/">/gallery/</a>. Pieces like these are built to
            order: <a class="text-link" href="/services/">Commissions</a>.
          </p>
        </div>
      </section>

      <section class="sect" aria-labelledby="questions-title" data-reveal>
        <h2 class="sect__title display" id="questions-title">Questions</h2>
        <div class="sect__body faq">
          {
            faq.map(({ q, a }) => (
              <div class="faq__item">
                <h3 class="faq__q">{q}</h3>
                <p class="faq__a">{a}</p>
              </div>
            ))
          }
        </div>
      </section>

      <p class="page__byline" data-reveal>
        <em>Michael Wilhelm writes and builds scrollies at <a class="text-link" href="/">iamwilhelm.com</a>. Last updated November 2026.</em>
      </p>
    </div>
  </article>
  <Meander />
  <Colophon />
</Museum>

<style>
  .page {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem);
  }
  .page__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .page__head,
  .sect {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .page__statement {
    padding-top: 0.5rem;
    color: var(--ink-soft);
  }
  .page__statement .lede {
    color: var(--ink);
  }
  .page__statement strong {
    font-weight: 600;
  }
  .sect {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    border-top: 1px solid var(--rule);
  }
  .sect__title {
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
    color: var(--ink);
  }
  .sect__body {
    display: grid;
    gap: 1.1rem;
    color: var(--ink-soft);
  }
  .sect__body :global(p + p) {
    margin-top: 0;
  }

  /* Key points and uses: a plain list, each line on its own gilt tick. */
  .points {
    list-style: none;
    display: grid;
    gap: 0.9rem;
    max-width: var(--measure);
  }
  .points li {
    position: relative;
    padding-left: 1.4rem;
    text-wrap: pretty;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.7rem;
    height: 1px;
    background: var(--gilt);
  }

  /* The four parts: numbered on the display face, like the steps on /services. */
  .parts {
    list-style: none;
    display: grid;
    gap: 1.1rem;
    max-width: var(--measure);
  }
  .parts li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    column-gap: 0.8rem;
    align-items: start;
    padding-left: 1.2rem;
    border-left: 1px solid var(--gilt);
  }
  .parts__num {
    font-size: 1.9rem;
    font-weight: 300;
    line-height: 1.1;
    color: var(--room-accent);
    font-variant-numeric: tabular-nums;
  }
  .parts__text {
    text-wrap: pretty;
  }
  .parts__text strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* The questions, in the same face as IV.05 on /services. */
  .faq {
    gap: clamp(1.4rem, 1rem + 1.5vw, 2rem);
  }
  .faq__item {
    display: grid;
    gap: 0.45rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
  }
  .faq__item:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .faq__q {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.4rem;
    line-height: 1.15;
    color: var(--ink);
  }
  .faq__a {
    max-width: var(--measure);
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .page__byline {
    color: var(--ink-faint);
    max-width: var(--measure);
  }

  @media (max-width: 820px) {
    .page__head,
    .sect {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
