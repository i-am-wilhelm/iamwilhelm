<style is:global>
  /* Layout: a tall campaign broadsheet — night-fjord ground, parchment panels pinned on it, one crimson ribbon per section. Single committed look (poster world), no light theme. */
  :root {
    --fjord: #10161d;        /* night water */
    --fjord-2: #1a2430;      /* pine shadow */
    --parchment: #e8d9b5;    /* aged paper */
    --parchment-2: #d9c494;  /* paper edge */
    --ink: #2a1f14;          /* walnut ink */
    --crimson: #8a1d1d;      /* cloak velvet */
    --gold: #c9a24a;         /* weathered gold */
    --gold-2: #f1d78a;       /* gold highlight */
    --fog: #b7c2cc;          /* mist text on fjord */
    --display: 'Metamorphous', 'Georgia', serif;
    --body: 'Alegreya', 'Georgia', 'Times New Roman', serif;
    --caps: 'Alegreya SC', 'Alegreya', 'Georgia', serif;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--fjord);
    color: var(--fog);
    font-family: var(--body);
    font-size: 18px;
    line-height: 1.55;
    background-image:
      radial-gradient(ellipse at 50% -10%, rgba(201,162,74,.18), transparent 55%),
      linear-gradient(180deg, var(--fjord-2) 0%, var(--fjord) 40%, #0b0f14 100%);
  }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .raven, .ember { animation: none !important; } }

  .wrap {
    max-width: 920px;
    margin: 0 auto;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    padding-block: 0;
  }

  /* ---------- top bar ---------- */
  .bar {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
    background: rgba(16,22,29,.86); backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(201,162,74,.35);
  }
  body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 30; background: rgba(16,22,29,.86); }
  .bar .wrap { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block: 10px; }
  .brand { font-family: var(--display); color: var(--gold-2); text-decoration: none; letter-spacing: .04em; font-size: 15px; white-space: nowrap; }
  .bar nav { display: flex; gap: 14px; flex-wrap: wrap; justify-content: flex-end; }
  .bar nav a { color: var(--fog); text-decoration: none; font-family: var(--caps); letter-spacing: .08em; font-size: 14px; }
  .bar nav a:hover, .bar nav a:focus-visible { color: var(--gold-2); outline: none; text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 520px) { .bar nav a.hide-sm { display: none; } }

  /* ---------- hero ---------- */
  .hero .wrap {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px; align-items: center; padding-block: 40px 56px;
  }
  @media (max-width: 760px) { .hero .wrap { grid-template-columns: 1fr; padding-block: 24px 40px; } }
  .poster { position: relative; max-width: 420px; margin: 0 auto; width: 100%; }
  .poster img {
    display: block; width: 100%; height: auto; max-width: 100%;
    border: 2px solid var(--gold); box-shadow: 0 30px 60px rgba(0,0,0,.6), 0 0 0 8px rgba(42,31,20,.6);
    transform: rotate(-1.2deg);
  }
  .poster .tack { position: absolute; top: -10px; left: 50%; width: 18px; height: 18px; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, var(--gold-2), #6b4f14); box-shadow: 0 3px 6px rgba(0,0,0,.6); transform: translateX(-50%); }
  .eyebrow { font-family: var(--caps); letter-spacing: .18em; color: var(--gold); font-size: 14px; margin: 0 0 10px; }
  h1 {
    font-family: var(--display); font-weight: 400; color: var(--gold-2);
    font-size: clamp(38px, 7vw, 64px); line-height: .98; margin: 0 0 18px; text-wrap: balance;
    text-shadow: 0 2px 0 #5a3d0b, 0 6px 18px rgba(0,0,0,.6);
  }
  .lede { font-size: 20px; max-width: 34ch; margin: 0 0 24px; color: #d5dde4; }
  .lede em { color: var(--gold-2); font-style: italic; }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn {
    display: inline-block; font-family: var(--caps); letter-spacing: .12em; font-weight: 700; font-size: 16px;
    padding: 12px 20px; text-decoration: none; cursor: pointer; border: 2px solid var(--gold);
    color: var(--ink); background: linear-gradient(180deg, var(--gold-2), var(--gold)); border-radius: 3px;
    box-shadow: 0 4px 0 #5a3d0b, 0 8px 18px rgba(0,0,0,.5); transition: transform .08s;
  }
  .btn:hover, .btn:focus-visible { transform: translateY(-1px); outline: none; box-shadow: 0 5px 0 #5a3d0b, 0 10px 20px rgba(0,0,0,.5); }
  .btn:active { transform: translateY(3px); box-shadow: 0 1px 0 #5a3d0b; }
  .btn.ghost { background: transparent; color: var(--gold-2); box-shadow: none; }
  .btn.ghost:hover { background: rgba(201,162,74,.12); }

  /* ---------- ribbons & sections ---------- */
  section { padding-block: 48px; }
  .ribbon {
    display: inline-block; position: relative; font-family: var(--display); color: var(--gold-2);
    background: var(--crimson); padding: 10px 28px; font-size: clamp(20px, 3.2vw, 28px); letter-spacing: .04em;
    box-shadow: 0 6px 14px rgba(0,0,0,.5); margin: 0 0 26px;
  }
  .ribbon::before, .ribbon::after {
    content: ""; position: absolute; top: 6px; width: 0; height: 0; border: 22px solid #5e1313; z-index: -1;
  }
  .ribbon::before { left: -22px; border-left-color: transparent; }
  .ribbon::after { right: -22px; border-right-color: transparent; }
  .ribbon-wrap { text-align: center; }

  .panel {
    background: var(--parchment); color: var(--ink);
    background-image:
      radial-gradient(ellipse at 20% 10%, rgba(255,255,255,.35), transparent 45%),
      radial-gradient(ellipse at 90% 90%, rgba(120,80,20,.22), transparent 50%),
      repeating-linear-gradient(0deg, rgba(90,61,11,.04) 0 2px, transparent 2px 5px);
    border: 1px solid var(--parchment-2);
    outline: 3px double rgba(201,162,74,.6); outline-offset: 6px;
    padding: clamp(20px, 4vw, 40px);
    box-shadow: 0 24px 50px rgba(0,0,0,.55);
  }

  /* planks */
  .planks { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .plank { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 16px; padding-block: 18px; border-bottom: 1px dashed rgba(42,31,20,.35); }
  .plank:last-child { border-bottom: 0; }
  .plank .rune { font-family: var(--display); color: var(--crimson); font-size: 30px; line-height: 1; text-align: center; padding-top: 2px; }
  .plank h3 { font-family: var(--display); font-weight: 400; font-size: 21px; margin: 0 0 4px; color: var(--ink); text-wrap: balance; }
  .plank p { margin: 0; max-width: 60ch; }
  .plank p i { color: var(--crimson); }

  /* poll */
  .poll { display: grid; gap: 14px; margin-top: 8px; }
  .poll-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: baseline; }
  .poll-row .name { font-family: var(--caps); letter-spacing: .06em; font-size: 17px; }
  .poll-row .pct { font-family: var(--display); font-variant-numeric: tabular-nums; color: var(--crimson); font-size: 22px; }
  .meter { grid-column: 1 / -1; height: 14px; background: rgba(42,31,20,.12); border: 1px solid rgba(42,31,20,.35); overflow: hidden; }
  .meter > span { display: block; height: 100%; background: linear-gradient(90deg, var(--crimson), #b3302a); }
  .meter.gold > span { background: linear-gradient(90deg, #7a6224, var(--gold)); }
  .meter.grey > span { background: #8a8174; }
  .fine { font-size: 14px; color: #5a4a36; margin: 14px 0 0; font-style: italic; }

  /* endorsements */
  .quotes { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
  .quote { border-left: 3px solid var(--crimson); padding: 4px 0 4px 16px; min-width: 0; }
  .quote p { margin: 0 0 8px; font-size: 19px; font-style: italic; }
  .quote cite { font-style: normal; font-family: var(--caps); letter-spacing: .06em; font-size: 15px; color: #5a4a36; }

  /* pledge form */
  .pledge-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  @media (max-width: 700px) { .pledge-grid { grid-template-columns: 1fr; } }
  form { display: grid; gap: 14px; }
  label { display: grid; gap: 6px; font-family: var(--caps); letter-spacing: .08em; font-size: 15px; }
  input[type=text], input[type=email], select {
    font-family: var(--body); font-size: 17px; padding: 10px 12px; border: 1px solid rgba(42,31,20,.5);
    background: rgba(255,250,235,.7); color: var(--ink); border-radius: 2px; width: 100%;
  }
  input:focus-visible, select:focus-visible { outline: 2px solid var(--crimson); outline-offset: 1px; }
  .counter { font-family: var(--display); font-size: clamp(40px, 8vw, 64px); color: var(--crimson); line-height: 1; font-variant-numeric: tabular-nums; }
  .counter-label { font-family: var(--caps); letter-spacing: .14em; font-size: 14px; color: #5a4a36; }
  .thanks { display: grid; gap: 8px; padding: 18px; border: 1px solid var(--crimson); background: rgba(138,29,29,.08); }
  .thanks strong { font-family: var(--display); font-weight: 400; color: var(--crimson); font-size: 22px; }

  /* raven */
  .raven { display: inline-block; animation: tilt 6s ease-in-out infinite; transform-origin: 50% 90%; }
  @keyframes tilt { 0%, 80%, 100% { transform: rotate(0); } 85% { transform: rotate(-8deg); } 92% { transform: rotate(6deg); } }

  /* ---------- band & party ---------- */
  .ctl { display: flex; gap: 8px; align-items: center; }
  .pill {
    font-family: var(--caps); letter-spacing: .1em; font-size: 13px; font-weight: 700; cursor: pointer;
    border: 1px solid var(--gold); color: var(--gold-2); background: transparent; padding: 6px 10px; border-radius: 999px;
    white-space: nowrap;
  }
  .pill:hover, .pill:focus-visible { background: rgba(201,162,74,.15); outline: none; }
  .pill[aria-pressed="true"] { background: var(--gold); color: var(--ink); }
  .pill.party[aria-pressed="true"] { background: var(--crimson); color: var(--gold-2); border-color: var(--crimson); }
  #confetti { position: fixed; inset: 0; pointer-events: none; z-index: 15; display: none; }
  body.party #confetti { display: block; }
  #torch { position: fixed; inset: 0; pointer-events: none; z-index: 14; opacity: 0;
    background: radial-gradient(ellipse at 50% 100%, rgba(201,162,74,.55), rgba(138,29,29,.25) 45%, transparent 70%); transition: opacity .12s; }
  body.party.thump #torch { opacity: 1; transition: none; }
  body.party .poster img { transition: transform .12s; }
  body.party.thump .poster img { transform: rotate(1.5deg) scale(1.03); }
  body.party .ribbon { animation: wobble 2.52s ease-in-out infinite; }
  @keyframes wobble { 0%,100% { transform: rotate(-1.5deg); } 50% { transform: rotate(1.5deg); } }
  body.party .raven { animation: hop .36s ease-in-out infinite alternate; }
  @keyframes hop { from { transform: translateY(0) rotate(-6deg); } to { transform: translateY(-14px) rotate(6deg); } }
  #skal { position: fixed; left: 50%; top: 50%; transform: translate(-50%,-50%) scale(.6); z-index: 16; pointer-events: none;
    font-family: var(--display); color: var(--gold-2); font-size: clamp(64px, 18vw, 180px); text-shadow: 0 4px 0 #5a3d0b, 0 10px 30px rgba(0,0,0,.8);
    opacity: 0; }
  #skal.show { animation: skal 1.4s ease-out forwards; }
  @keyframes skal { 0% { opacity: 0; transform: translate(-50%,-50%) scale(.6) rotate(-6deg); } 15% { opacity: 1; transform: translate(-50%,-50%) scale(1.1) rotate(2deg); } 70% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%,-60%) scale(1.2); } }
  .band-note { font-size: 13px; color: #7f8b96; margin: 6px 0 0; }
  @media (prefers-reduced-motion: reduce) {
    body.party .ribbon, body.party .raven, #skal.show { animation: none !important; }
    body.party.thump .poster img { transform: none; }
  }

  /* footer */
  footer { padding-block: 40px 56px; text-align: center; color: #7f8b96; font-size: 14px; }
  footer p { margin: 6px 0; }
  footer a { color: var(--gold); }
  .rune-line { font-family: var(--display); letter-spacing: .3em; color: rgba(201,162,74,.5); font-size: 13px; margin-bottom: 12px; }
</style>
