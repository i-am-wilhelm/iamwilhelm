---
/**
 * /scrollbrief: Room V, The Studio. Scrollbrief is the litigation-support
 * studio where the form in the Gallery goes to work: interactive case
 * stories for trial lawyers. The page introduces the studio and sends the
 * reader on to scrollbrief.com, the intake form or the scheduler; it sells
 * nothing itself. Built from the museum's parts, on the plan of /services:
 * the placard, the framed mark, the lens (V.01), the cells (V.02), the
 * numbered rules (V.03), three public Gallery cards (V.04), the meander and
 * the colophon.
 *
 * Every figure and term here (the four pieces, their fees and turnaround,
 * the billing line, the keeper's rules, the closing note) is the owner's
 * copy for scrollbrief.com; change it there and here together.
 */
import Museum from '../layouts/Museum.astro';
import Placard from '../components/museum/Placard.astro';
import PoemGallery from '../components/museum/PoemGallery.astro';
import Meander from '../components/museum/Meander.astro';
import Colophon from '../components/museum/Colophon.astro';
import Lens from '../components/museum/Lens.astro';
import ScrollbriefMark from '../components/museum/ScrollbriefMark.astro';
import { SCHEDULER_URL, SCROLLBRIEF_INTAKE_URL, SCROLLBRIEF_URL } from '../config/site';

/* V.01 · The seven beats of a case story, rim to centre. */
const beats = [
  { name: 'The person', gloss: 'Who this is, before the day it happened.' },
  { name: 'What happened', gloss: 'The event in order, on a timeline the reader can work by hand.' },
  { name: 'Why it happened', gloss: 'The cause, drawn as a mechanism the reader can see.' },
  { name: 'What they knew', gloss: 'What was known beforehand, and by whom.' },
  { name: 'The harm', gloss: 'What it took from the person, shown from the record.' },
  { name: 'The numbers', gloss: 'The figures, each one tied to its page in the record.' },
  { name: 'The ask', gloss: 'What the piece asks for, stated once.' },
];

/* V.02 · The four pieces, each linked to its page on scrollbrief.com. */
const offers = [
  {
    title: 'Interactive demand package',
    href: `${SCROLLBRIEF_URL}/interactive-demand-package/`,
    for: 'Injury matters, before suit',
    terms: '$7,500 to $15,000, about 10 business days.',
  },
  {
    title: 'Mediation presentation and trial graphics',
    href: `${SCROLLBRIEF_URL}/mediation-brief-and-trial-aids/`,
    for: 'Cases in suit',
    terms: 'From $20,000, three to four weeks.',
  },
  {
    title: 'Civil-rights case story',
    href: `${SCROLLBRIEF_URL}/civil-rights-case-story/`,
    for: 'Section 1983 and public-interest matters',
    terms: 'Priced as a demand piece or by scope.',
  },
  {
    title: 'Sentencing mitigation piece',
    href: `${SCROLLBRIEF_URL}/sentencing-mitigation/`,
    for: 'Criminal defense',
    terms: '$5,000 to $15,000, two to three weeks.',
  },
];

/* V.03 · The keeper's rules. */
const rules = [
  {
    title: 'The attorney keeps the light',
    body: 'The attorney sets the theme and the ask, approves the outline, and signs off on a cite table before anything goes out.',
  },
  {
    title: 'Every claim cites the record',
    body: 'Each factual line opens its source, and the other side’s best facts are on the page.',
  },
  {
    title: 'Private by default',
    body: 'Unindexed links, no third-party scripts, no hidden tracking on anything sent to the other side, and files deleted at takedown.',
  },
  {
    title: 'AI by written approval',
    body: 'AI tools are used on a matter only with the firm’s written approval.',
  },
  {
    title: 'Aids, prepared as aids',
    body: 'Trial visuals are prepared as illustrative aids, with Federal Rule of Evidence 107 in mind.',
  },
];

/* V.04 · Three public pieces built the same way. */
const pieces = ['how-to-throw-a-flame-twenty-miles', 'nobody-sees-the-same-sea', 'the-snowflake-machine'];
---

<Museum
  title="Scrollbrief · Interactive case stories for trial lawyers | Michael Wilhelm"
  description="Scrollbrief is Michael Wilhelm’s litigation-support studio: interactive demand packages, mediation presentations, trial graphics and sentencing mitigation pieces, each a private scrolling page where every factual line opens its source in the record."
  current="scrollbrief"
>
  <article class="page" aria-labelledby="scrollbrief-page-title" style="--room-accent: #23456b">
    <div class="page__inner wrap">
      <header class="page__head">
        <div class="page__label">
          <Placard
            id="scrollbrief-page-title"
            level={1}
            label="Room V · The Studio"
            title="Scrollbrief"
            medium="Interactive case stories for trial lawyers"
            year="2026"
            catalog="Cat. V"
          />
          <figure class="page__mark" data-reveal>
            <ScrollbriefMark />
            <figcaption>The mark: a flame, a lens cut into seven rings, and the beam.</figcaption>
          </figure>
        </div>
        <div class="page__statement" data-reveal>
          <p class="page__deck display">The whole record, gathered into one beam.</p>
          <p class="lede">
            Scrollbrief is the studio where the form in the Gallery goes to work. It builds interactive case stories
            for trial lawyers: demand packages, mediation presentations, trial graphics, and sentencing mitigation
            pieces. Each is a private scrolling page where the picture moves with the argument and every factual line
            opens its source in the record.
          </p>
          <p class="actions">
            <a class="cta cta--gilt" href={SCROLLBRIEF_URL} rel="noopener">Visit Scrollbrief.com</a>
            <a class="text-link actions__more" href={SCHEDULER_URL}>or book a call</a>
          </p>
        </div>
      </header>

      <section class="sect sect--wide" aria-labelledby="lens-title" data-reveal>
        <div class="sect__head">
          <p class="sect__num mono">V.01</p>
          <h2 class="sect__title display" id="lens-title">Seven rings, seven beats.</h2>
          <p class="sect__lead">
            A lighthouse lens is cut into rings so that scattered light leaves as one beam. A case story is cut the
            same way. Here the lens in the mark turns to face you: seven rings, seven beats, read from the rim to
            the centre, and the record leaves as one argument.
          </p>
        </div>
        <Lens beats={beats} />
        <p class="more">
          The lens is drawn with the tool from
          <a class="text-link" href="/gallery/how-to-throw-a-flame-twenty-miles/">How to Throw a Flame Twenty Miles</a>
        </p>
      </section>

      <section class="sect" aria-labelledby="pieces-title" data-reveal>
        <div class="sect__head">
          <p class="sect__num mono">V.02</p>
          <h2 class="sect__title display" id="pieces-title">Four pieces it builds.</h2>
        </div>
        <div class="sect__body">
          <ol class="cells" role="list">
            {
              offers.map((o, i) => (
                <li class="cell">
                  <span class="cell__num mono">V.02.{i + 1}</span>
                  <h3 class="cell__title">
                    <a href={o.href} rel="noopener">
                      {o.title}
                    </a>
                  </h3>
                  <p class="cell__for">{o.for}</p>
                  <p class="cell__terms">{o.terms}</p>
                </li>
              ))
            }
          </ol>
          <p class="billing">Flat fees, billed to the firm, half up front. Never a percentage of the recovery.</p>
        </div>
      </section>

      <section class="sect" aria-labelledby="rules-title" data-reveal>
        <div class="sect__head">
          <p class="sect__num mono">V.03</p>
          <h2 class="sect__title display" id="rules-title">The keeper&rsquo;s rules.</h2>
        </div>
        <ol class="steps" role="list">
          {
            rules.map((r, i) => (
              <li class="step">
                <span class="step__num display">0{i + 1}</span>
                <h3 class="step__title">{r.title}</h3>
                <p class="step__body">{r.body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="sect sect--wide" aria-labelledby="hand-title" data-reveal>
        <div class="sect__head">
          <p class="sect__num mono">V.04</p>
          <h2 class="sect__title display" id="hand-title">From the same hand.</h2>
          <p class="sect__lead">
            The studio&rsquo;s pieces are private. These three are public, built the same way, and open to anyone.
          </p>
        </div>
        <PoemGallery level={3} ids={pieces} thumbs />
        <p class="more">
          <a class="text-link" href="/gallery/">The full gallery</a>
        </p>
      </section>

      <section class="sect sect--close" aria-labelledby="close-title" data-reveal>
        <div class="sect__head">
          <p class="sect__num mono">V.05</p>
          <h2 class="sect__title display" id="close-title">Bring one case.</h2>
        </div>
        <div class="sect__body">
          <p class="lede">A matter with a strong record is the place to start.</p>
          <p class="actions">
            <a class="cta cta--gilt" href={SCROLLBRIEF_INTAKE_URL} rel="noopener">Start the intake</a>
            <a class="text-link actions__more" href={SCHEDULER_URL}>or book a call</a>
          </p>
          <p class="more">
            <a class="text-link" href={`${SCROLLBRIEF_URL}/how-it-works/`} rel="noopener">See how a piece is built</a>
          </p>
          <p class="note">
            Scrollbrief is a litigation-support studio. The attorney on each matter directs the work. Scrollbrief
            gives no legal advice and is not a law firm.
          </p>
        </div>
      </section>
    </div>
  </article>
  <Meander />
  <Colophon />
</Museum>

<style>
  .page {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem);
  }
  .page__inner {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .page__head,
  .sect {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .page__label {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    justify-items: start;
  }
  .page__mark {
    display: grid;
    gap: 0.8rem;
    width: 100%;
    max-width: 18rem;
  }
  .page__mark figcaption {
    color: var(--ink-faint);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .page__statement {
    display: grid;
    gap: 1.5rem;
    padding-top: 0.5rem;
  }
  .page__deck {
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2rem, 1.3rem + 3vw, 3.4rem);
    color: var(--room-accent);
  }
  .page__statement .lede {
    color: var(--ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.4rem;
  }
  .actions__more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-soft);
  }
  .sect {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    border-top: 1px solid var(--rule);
  }
  .sect--wide {
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.75rem, 1rem + 2vw, 2.5rem);
  }
  .sect__head {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }
  .sect--wide .sect__head {
    max-width: 40rem;
  }
  .sect__num {
    color: var(--room-accent);
  }
  .sect__title {
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
    color: var(--ink);
  }
  .sect__lead {
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .sect__body {
    display: grid;
    gap: 1.4rem;
    color: var(--ink-soft);
  }
  .sect--close .sect__body .lede {
    color: var(--ink);
  }
  .more {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }
  .cells {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .cell {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1.4rem 1.25rem 1.6rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--wall) 70%, white);
  }
  .cell__num {
    color: var(--gilt-ink);
  }
  .cell__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.4rem;
    line-height: 1.15;
  }
  .cell__title a {
    color: var(--ink);
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size calc(var(--beat) * 1.2) var(--ease-settle);
  }
  .cell__title a:hover,
  .cell__title a:focus-visible {
    background-size: 100% 1px;
  }
  .cell__for {
    color: var(--ink-faint);
    font-style: italic;
    font-size: 0.95rem;
  }
  .cell__terms {
    margin-top: 0.3rem;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.45;
    font-variant-numeric: lining-nums;
  }
  .billing {
    max-width: var(--measure);
    padding-left: 1.4rem;
    border-left: 1px solid var(--gilt);
    color: var(--ink);
  }
  .steps {
    list-style: none;
    display: grid;
    gap: 1.6rem;
  }
  .step {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    grid-template-areas: "num title" "num body";
    column-gap: 1rem;
    row-gap: 0.4rem;
    padding-left: 1.4rem;
    border-left: 1px solid var(--gilt);
  }
  .step__num {
    grid-area: num;
    font-size: 2.2rem;
    font-weight: 300;
    line-height: 1;
    color: var(--room-accent);
    font-variant-numeric: tabular-nums;
  }
  .step__title {
    grid-area: title;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.4rem;
    line-height: 1.15;
  }
  .step__body {
    grid-area: body;
    max-width: var(--measure);
    color: var(--ink-soft);
  }
  .note {
    max-width: var(--measure);
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-faint);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  @media (max-width: 820px) {
    .page__head,
    .sect {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    .cells {
      grid-template-columns: minmax(0, 1fr);
    }
    .step {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "num" "title" "body";
    }
  }
</style>
