---
/**
 * The subject index (/tags/): every tag a piece carries, grouped as in
 * src/config/tags.ts, with how many pieces each holds, and the series
 * beside them. The search page (/search/) prints the same index under its
 * field, so browsing works with scripts off.
 */
import Museum from '../../layouts/Museum.astro';
import Placard from '../../components/museum/Placard.astro';
import TagIndex from '../../components/museum/TagIndex.astro';
import Meander from '../../components/museum/Meander.astro';
import Colophon from '../../components/museum/Colophon.astro';
import { SITE_NAME, SITE_URL } from '../../config/site';
import { getPieces, getTagCounts } from '../../lib/pieces';
import { trail } from '../../lib/crumbs';

const counts = await getTagCounts();
const pieces = (await getPieces()).length;
---

<Museum
  title={`Tags · The subject index · ${SITE_NAME}`}
  description={`Every piece by ${SITE_NAME}, indexed by subject: ${counts.size} tags across ${pieces} pieces, from Greek words and the underworld to money, light and the sea.`}
  current="tags"
  crumbs={trail('Tags')}
  schema={[
    {
      '@type': 'CollectionPage',
      '@id': `${SITE_URL}/tags/#page`,
      url: `${SITE_URL}/tags/`,
      name: 'Tags',
      description: 'The subject index: every tag, and how many pieces carry it.',
      author: { '@id': `${SITE_URL}/#person` },
    },
  ]}
>
  <section class="page" aria-labelledby="tags-title" style="--room-accent: var(--gilt-ink)">
    <div class="page__inner wrap">
      <div class="page__head">
        <Placard
          id="tags-title"
          level={1}
          label="The subject index"
          title="Tags"
          medium={`${counts.size} tags across ${pieces} pieces. A series runs down one wall; a tag runs across all of them.`}
        />
        <div class="page__statement" data-reveal>
          <p class="lede">Choose a subject to see every piece filed under it, newest first.</p>
          <p class="page__links">
            <a class="text-link" href="/search/">Or search the collection by word</a>
          </p>
        </div>
      </div>
      <TagIndex level={2} />
    </div>
  </section>
  <Meander />
  <Colophon />
</Museum>

<style>
  .page {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 6rem);
  }
  .page__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .page__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .page__statement {
    display: grid;
    gap: 1rem;
    padding-top: 0.5rem;
    color: var(--ink);
  }
  .page__links {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }
  @media (max-width: 820px) {
    .page__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
