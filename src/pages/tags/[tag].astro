---
/**
 * A tag's page (/tags/<id>/): every piece filed under the tag, newest
 * first, from every series and both rooms; the tags filed most often
 * beside it; and the way to search inside it. One page per tag that at
 * least one piece carries, built from src/config/tags.ts and the entries'
 * `tags` fields, so a tag's page never needs touching when a piece joins.
 */
import Museum from '../../layouts/Museum.astro';
import Placard from '../../components/museum/Placard.astro';
import WritingsList from '../../components/museum/WritingsList.astro';
import Meander from '../../components/museum/Meander.astro';
import Colophon from '../../components/museum/Colophon.astro';
import { tagGroups, tags as registry, tagHref, type TagId } from '../../config/tags';
import { SITE_NAME, SITE_URL } from '../../config/site';
import { getTagCounts, getTagPieces, relatedTags } from '../../lib/pieces';
import { tagTrail } from '../../lib/crumbs';

export async function getStaticPaths() {
  const counts = await getTagCounts();
  return [...counts.keys()].map((tag) => ({ params: { tag } }));
}

const id = Astro.params.tag as TagId;
const t = registry[id];
const group = tagGroups[t.group];
const pieces = await getTagPieces(id);
const related = await relatedTags(id);
const url = `${SITE_URL}${tagHref(id)}`;
const count = pieces.length === 1 ? 'One piece' : `${pieces.length} pieces`;
---

<Museum
  title={`${t.label} · Tags · ${SITE_NAME}`}
  description={`${t.note} ${count} by ${SITE_NAME}, filed under ${t.label}.`}
  current="tags"
  crumbs={tagTrail(id)}
  schema={[
    {
      '@type': 'CollectionPage',
      '@id': `${url}#page`,
      url,
      name: `${t.label}`,
      description: t.note,
      author: { '@id': `${SITE_URL}/#person` },
      isPartOf: { '@type': 'CollectionPage', name: 'Tags', url: `${SITE_URL}/tags/` },
      hasPart: pieces.map((p) => ({ '@type': 'Article', name: p.title, url: p.url })),
    },
  ]}
>
  <section class="page" aria-labelledby="tag-title" style="--room-accent: var(--gilt-ink)">
    <div class="page__inner wrap">
      <div class="page__head">
        <Placard id="tag-title" level={1} label={`Tag · ${group.name}`} title={t.label} medium={t.note} />
        <div class="page__statement" data-reveal>
          <p class="lede">{count} filed under {t.label}, newest first.</p>
          <p class="page__links">
            <a class="text-link" href={`/search/?tag=${id}`}>Search within this tag</a>
            <span aria-hidden="true"> &middot; </span>
            <a class="text-link" href={`/tags/#${t.group}`}>{group.name}</a>
            <span aria-hidden="true"> &middot; </span>
            <a class="text-link" href="/tags/">Every tag</a>
          </p>
        </div>
      </div>
      <WritingsList level={2} pieces={pieces} />
      {
        related.length > 0 && (
          <div class="related" data-reveal>
            <h2 class="related__title smallcaps">Also filed with {t.label}</h2>
            <ul class="tag-cloud" role="list">
              {related.map((r) => (
                <li>
                  <a class="tag-chip" href={tagHref(r.id)}>
                    {registry[r.id].label}
                    <span class="tag-chip__n" aria-label={`${r.shared} shared`}>{r.shared}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>
  <Meander />
  <Colophon />
</Museum>

<style>
  .page {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 6rem);
  }
  .page__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .page__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .page__statement {
    display: grid;
    gap: 1rem;
    padding-top: 0.5rem;
    color: var(--ink);
  }
  .page__links {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
    color: var(--ink-faint);
  }
  .related {
    display: grid;
    gap: 1rem;
  }
  .related__title {
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
  }
  @media (max-width: 820px) {
    .page__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
