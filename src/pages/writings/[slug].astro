---
/**
 * A reading, hung in the museum's reading room. Static paths come from the
 * `museum`-treatment entries of the `writings` collection; drafts stay
 * unpublished, and the descent and scrolly entries are scroll pages in the
 * Gallery (src/pages/gallery/<id>.astro), not rendered here. The post opens
 * on a placard with its series label, then the long-form text set as wall
 * text; poem movements embedded in the markdown (section.poem-movement)
 * read as verse. When the piece also hangs in the Gallery (same id in the
 * `gallery` collection), the placard links to its interactive page. Every
 * reading ends on the shared foot (ScrollFoot): share, next in the series,
 * the newsletter, the patronage door.
 *
 * The esoteric treatment of this page (WebGL stage, facecards, PostHeader,
 * Prose) stays in src/components/writings for the archived /atelier side.
 */
import { getCollection, render } from 'astro:content';
import Museum from '../../layouts/Museum.astro';
import Placard from '../../components/museum/Placard.astro';
import Meander from '../../components/museum/Meander.astro';
import ScrollFoot from '../../components/scroll/ScrollFoot.astro';
import Byline from '../../components/scroll/Byline.astro';
import { series as registry } from '../../config/series';
import { SITE_URL } from '../../config/site';
import { ogImage } from '../../config/og';
import { getPiece } from '../../lib/pieces';

export async function getStaticPaths() {
  const posts = await getCollection('writings', ({ data }) => !data.draft && data.treatment === 'museum');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const piece = await getPiece(post.id, 'reading');
const hung = (await getCollection('gallery')).find((g) => g.id === post.id);
const date = post.data.date;
const dateLabel = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const url = piece.url;
const s = piece.series ? registry[piece.series] : undefined;
const modified = post.data.updated ?? date;
---

    <Museum
  title={`${post.data.title} · Writings · Michael Wilhelm`}
  description={post.data.description}
  current="writings"
  schema={[
    {
      '@type': 'Article',
      '@id': `${url}#article`,
      url,
      mainEntityOfPage: url,
      headline: post.data.title,
      description: post.data.description,
      image: ogImage('/og.png'),
      datePublished: date.toISOString(),
      dateModified: modified.toISOString(),
      author: { '@id': `${SITE_URL}/#person` },
      ...(s && { isPartOf: { '@type': 'CreativeWorkSeries', name: s.title, url: `${SITE_URL}${s.href}` } }),
    },
  ]}
>
  <article class="post" aria-labelledby="post-title" style="--room-accent: var(--room-v)">
    <div class="post__head wrap">
      <Placard
        id="post-title"
        level={1}
        label={piece.label ? `The Reading Room · ${piece.label}` : 'The Reading Room'}
        title={post.data.title}
        medium={post.data.description ?? 'Writing'}
        year={dateLabel}
      />
      <p class="post__byline" data-reveal>
        <Byline before="By" />
      </p>
      {
        s && (
          <p class="post__series" data-reveal>
            <a class="text-link" href={s.href}>
              All of {s.name}
            </a>
          </p>
        )
      }
      {
        post.data.methodLink && (
          <p class="post__method" data-reveal>
            <span class="smallcaps">How this was made</span>
            <a class="text-link" href="/method/">
              The method: the tags, the originals, and the machines
            </a>
          </p>
        )
      }
      {
        hung?.data.href && (
          <p class="post__hung" data-reveal>
            <span class="smallcaps">Also on view</span>
            <a class="text-link" href={hung.data.href}>
              See {hung.data.title} hung in the Gallery as an interactive page
            </a>
          </p>
        )
      }
    </div>
    <div class="post__body wrap">
      <div class="post__text">
        <Content />
      </div>
    </div>
    <p class="post__back wrap">
      <a class="text-link" href="/writings/">All readings</a>
    </p>
    <div class="wrap">
      <ScrollFoot id={post.id} kind="reading" class="post__foot" />
    </div>
  </article>
  <Meander />
</Museum>

<style>
  .post {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem);
  }
  .post__head {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .post__head :global(.placard) {
    max-width: 34rem;
  }
  .post__hung,
  .post__method {
    display: grid;
    gap: 0.3rem;
    color: var(--room-accent);
  }
  .post__byline {
    color: var(--ink-soft);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }
  .post__series {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }
  .post__foot {
    color: var(--ink-soft);
    max-width: 44rem;
    margin-inline: 0;
  }
  .post__body {
    margin-top: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .post__back {
    margin-top: clamp(2.5rem, 2rem + 3vw, 4rem);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }

  /* The rendered markdown arrives through <Content />, so these reach in. */
  .post__text {
    max-width: 40rem;
    margin-inline: auto;
    color: var(--ink);
  }
  .post__text :global(p) {
    text-wrap: pretty;
  }
  .post__text :global(p + p),
  .post__text :global(blockquote + p),
  .post__text :global(p + blockquote) {
    margin-top: 1.1em;
  }
  .post__text :global([lang='grc']) {
    font-family: 'GFS Didot', 'Gentium Plus', 'Palatino Linotype', Georgia, serif;
  }
  .post__text :global(hr) {
    width: 4rem;
    margin: clamp(2.5rem, 2rem + 3vw, 4rem) auto;
    border: 0;
    border-top: 1px solid var(--gilt);
  }
  .post__text :global(blockquote.greek-quote) {
    margin: 2rem 0;
    padding: 1.25rem 0 1.25rem 1.4rem;
    border-left: 1px solid var(--gilt);
  }
  .post__text :global(.greek-quote p[lang='grc']) {
    font-size: 1.15em;
    line-height: 1.5;
  }
  .post__text :global(.greek-quote .translation) {
    color: var(--ink-soft);
    font-style: italic;
  }
  .post__text :global(.greek-quote cite) {
    display: block;
    margin-top: 0.6rem;
    color: var(--ink-faint);
    font-style: normal;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
  }

  /* Essay parts: numbered sections, each opening on a gilt numeral. */
  .post__text :global(section.part) {
    margin-block: clamp(3rem, 2.4rem + 3vw, 5rem);
  }
  .post__text :global(section.part + section.part) {
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border-top: 1px solid var(--rule);
  }
  .post__text :global(.part-num) {
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.3em;
    color: var(--gilt-ink);
  }
  .post__text :global(.part-title) {
    margin-bottom: 1.2rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.5rem);
    line-height: 1.1;
  }
  .post__text :global(.part-lede) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.4rem, 1.2rem + 1vw, 1.9rem);
    line-height: 1.3;
    text-wrap: balance;
  }
  .post__text :global(section.part--front) {
    text-align: center;
  }
  .post__text :global(.part-epigraph) {
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.2rem);
  }
  .post__text :global(.part-aside) {
    margin-top: 0.3rem;
    color: var(--ink-faint);
    font-style: italic;
  }
  .post__text :global(.part-aside + p:not(.part-lede)),
  .post__text :global(.part-lede + p) {
    margin-top: 1.4em;
  }
  .post__text :global(section.part--front .part-aside + .part-lede) {
    margin-top: 1.4rem;
  }
  .post__text :global(blockquote.pull-quote) {
    margin: 2rem 0;
    padding: 0.4rem 0 0.4rem 1.4rem;
    border-left: 1px solid var(--gilt);
  }
  .post__text :global(.pull-quote p) {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.1rem + 0.5vw, 1.45rem);
    line-height: 1.4;
  }
  .post__text :global(.pull-quote p[lang='la']) {
    font-style: italic;
  }
  .post__text :global(.pull-quote .translation) {
    margin-top: 0.6rem;
    font-family: var(--font-text);
    font-size: 1rem;
    color: var(--ink-soft);
  }
  .post__text :global(.pull-quote cite) {
    display: block;
    margin-top: 0.6rem;
    color: var(--ink-faint);
    font-style: normal;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
  }

  /* Poem movements: verse on the wall, each movement its own panel. */
  .post__text :global(section.poem-movement) {
    margin-block: clamp(2.5rem, 2rem + 3vw, 4rem);
    padding-left: 1.4rem;
    border-left: 1px solid var(--rule);
  }
  .post__text :global(section.poem-front) {
    padding: 0;
    border: 0;
    text-align: center;
  }
  .post__text :global(.poem-dedication) {
    color: var(--ink-faint);
    font-style: italic;
  }
  .post__text :global(.poem-title) {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.9rem, 1.1rem + 3.4vw, 3.6rem);
    letter-spacing: 0.24em;
    padding-left: 0.24em;
    line-height: 1.1;
  }
  .post__text :global(.poem-sub) {
    margin-top: 0.6rem;
    color: var(--ink-soft);
  }
  .post__text :global(.mvt) {
    margin-bottom: 0.9rem;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    color: var(--gilt-ink);
  }
  .post__text :global(section.poem-movement p) {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.4rem);
    line-height: 1.5;
  }
</style>
