---
/**
 * /writings: the full writings index in the museum style. Each post page
 * (/writings/[slug]) keeps its own immersive treatment; a poem's page is
 * the exhibit, and this index is the reading room's catalogue.
 */
import Museum from '../../layouts/Museum.astro';
import Placard from '../../components/museum/Placard.astro';
import WritingsList from '../../components/museum/WritingsList.astro';
import Meander from '../../components/museum/Meander.astro';
import Colophon from '../../components/museum/Colophon.astro';
import { SITE_URL } from '../../config/site';
---

<Museum
  title="Writings · Michael Wilhelm"
  description="Writings by Michael Wilhelm: poems and cross-examinations of ancient wordforms."
  current="writings"
  schema={[
    {
      '@type': 'CollectionPage',
      '@id': `${SITE_URL}/writings/#page`,
      url: `${SITE_URL}/writings/`,
      name: 'Writings',
      author: { '@id': `${SITE_URL}/#person` },
    },
  ]}
>
  <section class="page" aria-labelledby="writings-page-title" style="--room-accent: var(--room-v)">
    <div class="page__inner wrap">
      <div class="page__head">
        <Placard
          id="writings-page-title"
          level={1}
          label="The Reading Room"
          title="Writings"
          medium="Poems and cross-examinations of ancient wordforms"
          catalog="Cat. V"
        />
        <p class="lede page__statement" data-reveal>
          Everything from the desk, newest first. The writings belong to a longer project of cross-examining
          wordforms shared between corpora that rarely meet on the same desk: the pharmacological treatises, the
          lexicons, the epics, and the Septuagint.
        </p>
      </div>
      <WritingsList level={2} />
    </div>
  </section>
  <Meander />
  <Colophon />
</Museum>

<style>
  .page {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem);
  }
  .page__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .page__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .page__statement {
    padding-top: 0.5rem;
    color: var(--ink);
  }
  @media (max-width: 820px) {
    .page__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
