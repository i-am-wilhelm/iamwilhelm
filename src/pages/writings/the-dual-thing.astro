/* Layout: one narrow essay column stepped left and right by section, set over a
   fixed particle sky that runs the whole Orphic sequence on scroll: the egg,
   the swallowing, the mirror, the lightning, the ash, the breath, the two
   springs, and the wheel one soul flies out of. Single dark world, by choice. */
.essay{
  --night:#07070d;      /* ground of the page, violet-black */
  --stone:#12131b;      /* rules, panel edges */
  --bone:#e9e3d5;       /* reading colour */
  --dim:#8f94a3;        /* apparatus, glosses */
  --gold:#e3b85a;       /* the tablets, Phanes, the lake of Memory */
  --ash:#9aa0ad;        /* Titan soot */
  --wine:#9b3a5a;       /* Dionysus, used sparingly */
  --cypress:#b9c7d8;    /* the spring by the white cypress */
  --serif:"Cormorant Garamond",Garamond,"Times New Roman",serif;
  --greek:"EB Garamond","Cormorant Garamond",Garamond,serif;
  --mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  --fg:var(--bone);
}
.essay{
  background:var(--night);
  color:var(--bone);
  font-family:var(--serif);
