---
/**
 * /method: Room IV, how the pieces are made. One plain page in the
 * glossary's register: the tagging system (text, reading, disputed), what
 * is read in the original, what is machine-assisted, and the promise every
 * piece keeps (complete with scripts off, a plain-text twin). The copy is
 * the owner's, verbatim. Linked from every source ledger ("How this was
 * made", MethodLink), from the Philosophy reading's placard, and from the
 * footer.
 */
import Museum from '../layouts/Museum.astro';
import Placard from '../components/museum/Placard.astro';
import Meander from '../components/museum/Meander.astro';
import Colophon from '../components/museum/Colophon.astro';
import { SITE_URL } from '../config/site';

const url = `${SITE_URL}/method/`;
const modified = new Date('2026-11-09T00:00:00Z');

const legend = [
  { tag: 'text', cls: 'text', means: 'The source says it.' },
  { tag: 'reading', cls: 'read', means: 'I am interpreting.' },
  { tag: 'disputed', cls: 'disp', means: 'Scholars disagree.' },
];
---

<Museum
  title="Method · How These Pieces Are Made | Michael Wilhelm"
  description="How the pieces on iamwilhelm.com are made: every claim tagged text, reading, or disputed and listed in a ledger; Greek, Latin, and Hebrew read in the original; what is machine-assisted; and a plain-text twin for every piece."
  current="method"
  schema={[
    {
      '@type': 'Article',
      '@id': `${url}#article`,
      url,
      mainEntityOfPage: url,
      headline: 'How these pieces are made.',
      description:
        'Every claim in an essay is tagged text, reading, or disputed and listed in a ledger; Greek, Latin, and Hebrew are read in the original; the pages are designed and written by Michael Wilhelm with software assistance for code, source checks, and outline drafts; every piece ships with a plain-text twin.',
      datePublished: modified.toISOString(),
      dateModified: modified.toISOString(),
      author: { '@id': `${SITE_URL}/#person` },
    },
  ]}
>
  <article class="page" aria-labelledby="method-title" style="--room-accent: var(--room-iv)">
    <div class="page__inner wrap">
      <header class="page__head">
        <Placard
          id="method-title"
          level={1}
          label="Room IV · Method"
          title="How these pieces are made."
          medium="The tags, the originals, the machines, and the twin"
          catalog="Cat. IV"
        />
        <div class="page__statement prose-museum" data-reveal>
          <p class="lede">
            Every claim in an essay is tagged text, reading, or disputed. Text means the source says it. Reading means I
            am interpreting. Disputed means scholars disagree. The ledger at the end of each piece lists every claim with
            its tag and its source.
          </p>
          <dl class="legend" aria-label="The three tags">
            {
              legend.map((l) => (
                <div class="legend__row">
                  <dt>
                    <span class:list={['tag', l.cls]}>{l.tag}</span>
                  </dt>
                  <dd>{l.means}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </header>

      <section class="sect" aria-labelledby="original-title" data-reveal>
        <h2 class="sect__title display" id="original-title">In the original</h2>
        <div class="sect__body prose-museum">
          <p>
            Greek, Latin, and Hebrew are read in the original, with the lexicon open. Where a translation is quoted, it
            is named.
          </p>
        </div>
      </section>

      <section class="sect" aria-labelledby="machine-title" data-reveal>
        <h2 class="sect__title display" id="machine-title">What is machine-assisted</h2>
        <div class="sect__body prose-museum">
          <p>
            The pages are designed and written by me. I use software assistance for code, for cross-checking sources,
            and for drafting at the outline stage; the argument, the readings, and the final text are mine. Where a
            piece was machine-assisted in a way that matters to its evidence, the ledger says so.
          </p>
        </div>
      </section>

      <section class="sect" aria-labelledby="twin-title" data-reveal>
        <h2 class="sect__title display" id="twin-title">Scripts off</h2>
        <div class="sect__body prose-museum">
          <p>
            Every piece reads complete with scripts off and ships with a plain-text twin. Motion is the enhancement.
          </p>
          <p class="sect__more">
            <a class="text-link" href="/what-is-a-scrolly/">What is a scrolly? &rarr;</a>
          </p>
        </div>
      </section>
    </div>
  </article>
  <Meander />
  <Colophon />
</Museum>

<style>
  .page {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem);
  }
  .page__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .page__head,
  .sect {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .page__statement {
    padding-top: 0.5rem;
    color: var(--ink-soft);
  }
  .page__statement .lede {
    color: var(--ink);
  }
  .sect {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    border-top: 1px solid var(--rule);
  }
  .sect__title {
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
    color: var(--ink);
  }
  .sect__body {
    color: var(--ink-soft);
  }
  .sect__more {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }

  /* The three tags, in the voice the scroll pages give them. */
  .legend {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.4rem;
    max-width: var(--measure);
  }
  .legend__row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.8rem;
    align-items: baseline;
  }
  .legend dt,
  .legend dd {
    margin: 0;
  }
  .tag {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border: 1px solid currentColor;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.6;
  }
  .tag.text {
    color: #2f6e55;
  }
  .tag.read {
    color: #7b4128;
  }
  .tag.disp {
    color: #5a3c63;
  }
  @media (max-width: 820px) {
    .page__head,
    .sect {
      grid-template-columns: minmax(0, 1fr);
    }
    .legend__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.3rem;
    }
  }
</style>
