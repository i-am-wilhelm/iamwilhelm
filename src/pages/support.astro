---
/**
 * /support: the patronage door every scroll page's footer opens onto. A
 * stub: the copy is the owner's to write and no payment is wired yet; the
 * page says so plainly and offers the newsletter and the mail line instead.
 */
import Museum from '../layouts/Museum.astro';
import Placard from '../components/museum/Placard.astro';
import Meander from '../components/museum/Meander.astro';
import Colophon from '../components/museum/Colophon.astro';
import { CONTACT_EMAIL, SITE_URL } from '../config/site';
---

<Museum
  title="Support the work · Michael Wilhelm"
  description="Patronage for the pages on iamwilhelm.com: how to keep the lights on in the Gallery and the reading room."
  current="support"
  schema={[
    {
      '@type': 'WebPage',
      '@id': `${SITE_URL}/support/#page`,
      url: `${SITE_URL}/support/`,
      name: 'Support the work',
      author: { '@id': `${SITE_URL}/#person` },
    },
  ]}
>
  <section class="page" aria-labelledby="support-title" style="--room-accent: var(--gilt-ink)">
    <div class="page__inner wrap">
      <div class="page__head">
        <Placard
          id="support-title"
          level={1}
          label="Patronage"
          title="Keep the lights on"
          medium="The pages are free to read and slow to make"
        />
        <div class="page__statement prose-museum" data-reveal>
          {/* TODO(owner): the patronage copy. Why the work is free, what support pays for, and what a patron gets. */}
          <p class="lede">
            Every piece in the Gallery is built by hand, read in the original, and given away. If one of them stayed
            with you, this is the door.
          </p>
          <p>
            Patronage is not wired yet. Until it is, the surest support is to read, to pass a page on, and to be on
            the newsletter when the next room opens. Or write to
            <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
          </p>
          {/* TODO(owner): payment wiring. A patronage link or embed (and its provider) goes here when chosen; nothing is connected now. */}
          <p class="page__todo mono">Payment link: not yet connected.</p>
        </div>
      </div>
    </div>
  </section>
  <Meander />
  <Colophon />
</Museum>

<style>
  .page {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem);
  }
  .page__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .page__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .page__statement {
    padding-top: 0.5rem;
    color: var(--ink-soft);
  }
  .page__statement .lede {
    color: var(--ink);
  }
  .page__todo {
    margin-top: 1.4rem;
    padding: 0.7rem 0.9rem;
    border: 1px dashed var(--ink-faint);
    color: var(--ink-faint);
    max-width: var(--measure);
  }
  @media (max-width: 820px) {
    .page__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
