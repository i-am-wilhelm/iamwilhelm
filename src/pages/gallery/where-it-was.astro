---
/**
 * Where It Was: Through the Lens No. 3. Freud's three, Plato's three, and
 * the Latin that hid the family resemblance, as a scrolly in seven
 * movements on the True Amazons system: tagged passages (text / reading /
 * disputed), one thing to touch per movement, the source ledger last. Built
 * from the owner's draft in the vault ("Draft - Where It Was (Through the
 * Lens).md"), whose essay text ships verbatim; only the UI copy (labels,
 * readouts, the legend) is the page's own.
 *
 * The movements: Odysseus's line fades in line by line (I); Leontius's
 * shout stays veiled until the reader presses and holds to look (II); the
 * three German pronouns under their thin Latin overlay (III); the lineup,
 * three columns sliding into register, with a removable name layer on
 * Freud's column, Latin / German / Greek, that the rest of the page then
 * follows (IV); the centrepiece, a three-string lyre tuned by its pegs
 * (WebAudio, created on the first touch, resolved to the site's key) beside
 * a dike dragged across a sea, and the choice of which to leave the section
 * on, remembered and carried to the close (V); Plato's beast, lion and man
 * as a constellation figure, and Paul's ἔσω ἄνθρωπος fading in over Plato's
 * ἐντὸς ἄνθρωπος letter by letter (VI); Parent, Adult, Child, the disputed
 * close, and the bridge to the Futurist series (VII).
 *
 * Same page system as True Amazons and Everyone, Searchable (Poem.astro;
 * `treatment: scrolly` on the writings entry): no glyph dither, no backdrop
 * fade, no smoke, the orchestra pit never imported. The stylesheet is scoped
 * under body.wiw so Poem.astro's line and section globals cannot reach it.
 * Title, description, date and series come from
 * the gallery entry (src/lib/pieces.ts); the route is /gallery/where-it-was/,
 * the old /writings/ URL redirects (public/_redirects). The lyre and dike panel carries
 * data-og-frame, so `npm run og:scrollies` shoots it for the share image.
 */
import Poem from '../../layouts/Poem.astro';
import SeriesMark from '../../components/scroll/SeriesMark.astro';
import Byline from '../../components/scroll/Byline.astro';
import ScrollFoot from '../../components/scroll/ScrollFoot.astro';
import MethodLink from '../../components/scroll/MethodLink.astro';
import { series } from '../../config/series';
import { SITE_URL } from '../../config/site';
import { getPiece } from '../../lib/pieces';

const piece = await getPiece('where-it-was');
if (!piece.series) throw new Error('where-it-was: the gallery entry needs a series.');
const { title, description, date } = piece;
const s = series[piece.series];
const month = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
