        <path d="M92 250c0-10 136-10 136 0v12c0 36-136 36-136 0z" fill="#1a1e2c" stroke="#9a958a" stroke-width="1.5"/>
        <path d="M92 250c0-10 136-10 136 0v12c0 36-136 36-136 0z" fill="url(#wiwDots)"/>
        <rect x="108" y="248" width="104" height="4" fill="#9a958a"/>
        <path d="M68 60H252" stroke="#9a958a" stroke-width="7" stroke-linecap="round"/>
        <line class="string" data-i="0" x1="120" y1="63" x2="120" y2="248"/>
        <line class="string" data-i="1" x1="160" y1="63" x2="160" y2="248"/>
        <line class="string" data-i="2" x1="200" y1="63" x2="200" y2="248"/>
        <g class="peg" data-i="0" tabindex="0" role="slider" aria-label="νεάτη, the high string: tuning peg, in cents" aria-valuemin="-60" aria-valuemax="60" aria-valuenow="22" aria-orientation="vertical"><circle cx="120" cy="60" r="16" fill="transparent"/><circle class="pegc" cx="120" cy="60" r="9.5" fill="#121521" stroke="#c9a24a" stroke-width="1.5"/><line class="key" x1="120" y1="53" x2="120" y2="67" stroke="#e8c877" stroke-width="1.8" stroke-linecap="round"/></g>
