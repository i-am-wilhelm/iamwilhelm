  @font-face{font-family:'Lens Mono';font-style:normal;font-weight:100 800;font-display:swap;src:url('/fonts/jetbrains-mono-latin-wght-normal.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}

/* Plan: one night with a blue cast (the dark sea of Lecture 31), bone text,
   and two accents the reader chooses between in V: the lyre's gilt and the
   dike's sea-blue. Tags: text in gilt, reading in star-silver, disputed in
   the writings' fumigation purple. A single column of movements, each with
   one frame to touch; the lineup's name layer (Latin / German / Greek) sets
   body[data-layer] and the .tri chips across the page follow it; the choice
   in V sets body[data-leave] and the close takes its colour. */
body.wiw{
  --ink:#0b0d12;--ink-2:#121521;--ink-3:#1a1e2c;
  --bone:#e6dfcf;--bone-dim:#9a958a;
  --gilt:#c9a24a;--gilt-hi:#e8c877;
  --sea:#1d4e66;--sea-hi:#5fa3bd;
  --land:#6f8a4e;--land-hi:#a3bf78;
  --silver:#8fa8c8;--silver-hi:#b9c9df;
  --violet:#6a3fa0;--violet-hi:#b08ae0;
  --font-display:"Bodoni Moda","Didot",Georgia,serif;
  --font-body:"Literata","Iowan Old Style",Georgia,serif;
  --font-greek:"Literata","EB Garamond Greek","Gentium Plus","Palatino Linotype","Times New Roman",serif;
  --font-mono:"Lens Mono","JetBrains Mono","SFMono-Regular",Consolas,monospace;
  --leave-accent:var(--gilt);
  margin:0;background:var(--ink);color:var(--bone);font-family:var(--font-body);font-size:18px;line-height:1.62;font-optical-sizing:auto;-webkit-font-smoothing:antialiased;overflow-x:hidden;color-scheme:dark;
}
body.wiw[data-leave="lyre"]{--leave-accent:var(--gilt-hi)}
body.wiw[data-leave="dike"]{--leave-accent:var(--sea-hi)}
html:has(> body.wiw){scroll-behavior:smooth}
.wiw *{box-sizing:border-box}
.wiw a{color:var(--gilt);text-decoration-thickness:1px;text-underline-offset:3px}
.wiw a:focus-visible,.wiw button:focus-visible,.wiw input:focus-visible,.wiw [tabindex]:focus-visible{outline:2px solid var(--gilt-hi);outline-offset:3px}
.wiw h1,.wiw h2,.wiw h3{font-family:var(--font-display);font-weight:400;line-height:1.05;text-wrap:balance;margin:0}
/* Bodoni Moda's display optical sizes thin its hairlines almost to nothing
   on screens (see Mimics & Mythmakers): every Bodoni role here sets a low
   optical size and a sturdier weight. */
.wiw h1,.wiw h2,.wiw h3,.wiw .term,.wiw .de .w,.wiw .freud .over.la,.wiw .companion .ct,.wiw .pc b,.wiw .figkey b{font-weight:560;font-variation-settings:"opsz" 18}
.wiw .hero h1{font-weight:560;font-variation-settings:"opsz" 20}
.wiw .plato .term,.wiw .freud .over.gr{font-weight:400;font-variation-settings:normal}
.wiw p{margin:0 0 1.2em}
.wiw [lang="grc"]{font-family:var(--font-greek);font-style:normal}
.wiw button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0}
.wiw .sr{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.wiw .btn{font-family:var(--font-mono);font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;padding:10px 16px;border:1px solid var(--gilt);color:var(--gilt-hi);background:var(--ink-2);border-radius:2px;transition:background .2s,color .2s,border-color .2s,transform .1s}
.wiw .btn:hover{background:var(--gilt);color:var(--ink)}
.wiw .btn:active{transform:translateY(1px)}
.wiw .btn.ghost{border-color:rgba(201,162,74,.4);color:var(--bone-dim)}
.wiw .btn.ghost:hover{background:var(--ink-3);color:var(--bone)}
.wiw .btn[disabled]{opacity:.45;cursor:default}
.wiw .btn[disabled]:hover{background:var(--ink-2);color:var(--gilt-hi)}
.wiw .btn.gold{border-color:var(--gilt);color:var(--gilt-hi)}
.wiw .btn.silver{border-color:var(--silver);color:var(--silver-hi)}
.wiw .btn.silver:hover{background:var(--silver);color:var(--ink)}
.wiw .btn.purple{border-color:var(--violet);color:var(--violet-hi)}
.wiw .btn.purple:hover{background:var(--violet);color:var(--bone)}
.wiw .btn[aria-pressed="true"]{background:var(--gilt);color:var(--ink)}
.wiw .btn[data-leave="dike"][aria-pressed="true"]{background:var(--sea-hi);border-color:var(--sea-hi)}

.wiw #progress{position:fixed;top:0;left:0;height:3px;width:0;background:linear-gradient(90deg,var(--gilt),var(--sea-hi));z-index:50}
.wiw .nav{position:fixed;right:14px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:10px;z-index:40}
.wiw .nav a{display:block;width:28px;height:18px;font-family:var(--font-mono);font-size:.6rem;letter-spacing:.06em;color:var(--bone-dim);text-decoration:none;text-align:right;opacity:.6;transition:color .2s,opacity .2s}
.wiw .nav a:hover{opacity:1;color:var(--bone)}
.wiw .nav a.on{color:var(--gilt-hi);opacity:1}
@media (max-width:1180px){.wiw .nav{display:none}}

/* Mounted in Poem.astro: neutralise its column, section and line rules. */
.wiw main.wi{max-width:none;margin:0;padding:0;position:relative;z-index:1}
.wiw section{display:block;min-height:0;padding:0;gap:0}

/* hero */
.wiw .hero{position:relative;padding:clamp(72px,11vh,130px) 16px 40px;max-width:1120px;margin:0 auto;display:grid;gap:26px}
.wiw .eyebrow{font-family:var(--font-mono);font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gilt);margin:0}
.wiw .eyebrow a{color:var(--gilt)}
.wiw .hero h1{font-size:clamp(56px,12vw,160px);letter-spacing:-.025em;color:var(--bone);animation:rise 1.1s cubic-bezier(.2,.7,.2,1) both}
.wiw .hero h1 em{font-style:italic;color:var(--gilt);position:relative}
.wiw .hero h1 em::after{content:"";position:absolute;left:0;right:0;bottom:.08em;height:.06em;background:linear-gradient(90deg,var(--gilt),transparent);opacity:.6}
@keyframes rise{from{opacity:.35;transform:translateY(14px)}to{opacity:1;transform:none}}
.wiw .hero .dek{max-width:60ch;font-size:clamp(19px,2.1vw,25px);font-weight:300;margin:0}
.wiw .marks{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:16px 34px}
.wiw .marks li{display:flex;align-items:center;gap:12px;font-family:var(--font-mono);font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--bone-dim)}
.wiw .marks svg{width:44px;height:44px;flex:none;fill:none;stroke:var(--gilt);stroke-width:1.1;stroke-linecap:round;stroke-linejoin:round}
.wiw .kicker{font-family:var(--font-mono);font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:var(--bone-dim);margin:0}
.wiw .how{font-size:.95rem;color:var(--bone-dim);max-width:70ch;border-left:2px solid var(--gilt);padding-left:14px;margin:0}
.wiw .how b{color:var(--bone)}
.wiw .tag{display:inline-block;font-family:var(--font-mono);font-size:.64rem;letter-spacing:.14em;text-transform:uppercase;padding:3px 8px;border:1px solid;border-radius:2px;vertical-align:middle;margin-right:6px;position:relative;cursor:help;line-height:1.4}
.wiw .tag.text{color:var(--gilt);border-color:var(--gilt)}
.wiw .tag.read{color:var(--silver);border-color:var(--silver)}
.wiw .tag.disp{color:var(--violet-hi);border-color:var(--violet);background:rgba(106,63,160,.25)}
.wiw .tag[data-tip]::after{content:attr(data-tip);position:absolute;left:0;bottom:calc(100% + 6px);background:var(--ink-3);color:var(--bone);font-size:.68rem;letter-spacing:.02em;text-transform:none;padding:6px 9px;border:1px solid rgba(201,162,74,.4);border-radius:2px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .15s;z-index:3;max-width:min(80vw,420px);white-space:normal;width:max-content}
.wiw .tag[data-tip]:hover::after,.wiw .tag[data-tip]:focus-visible::after{opacity:1}

/* the movements */
.wiw .essay{max-width:1120px;margin:0 auto;padding:0 16px}
.wiw .mv{position:relative;max-width:66ch;padding:10vh 0 6vh;scroll-margin-top:12px}
.wiw .mv .wm{position:absolute;right:-10px;top:6vh;font-family:var(--font-display);font-size:clamp(90px,14vw,200px);line-height:1;color:var(--gilt);opacity:.07;transition:opacity .6s;pointer-events:none;user-select:none}
.wiw .mv.on .wm{opacity:.15}
.wiw .mv h2{font-size:clamp(34px,4.4vw,60px);color:var(--bone);margin:0 0 .6em;position:relative}
.wiw .mv h2 span{color:var(--gilt)}
.wiw p.disputed{border-left:2px solid var(--violet);padding-left:14px;background:linear-gradient(90deg,rgba(106,63,160,.16),transparent 70%)}

/* the Greek: lang="grc", polytonic-safe stack, the translation under it */
.wiw .greek-quote{margin:0 0 2em;padding:22px 26px;background:var(--ink-2);border-left:2px solid var(--gilt)}
.wiw .greek-quote .grc{font-size:clamp(1.25rem,1rem + 1.4vw,1.8rem);line-height:1.5;font-weight:300;color:var(--bone);margin:0 0 .6em}
.wiw .greek-quote .ln{display:inline-block}
.wiw .translation{color:var(--bone-dim);font-size:1rem;margin:0}
.wiw .greek-quote cite{display:block;font-family:var(--font-mono);font-style:normal;font-size:.72rem;color:var(--gilt);margin-top:10px;letter-spacing:.04em}
.wiw .greek-quote cite em{font-style:italic}

/* I: line by line */
.js .wiw [data-fade]{opacity:0;transform:translateY(10px);transition:opacity 1.1s ease calc(var(--d,0) * .4s),transform 1.1s ease calc(var(--d,0) * .4s)}
.js .wiw [data-fade].in{opacity:1;transform:none}

/* interactive frames */
.wiw .play{margin:1.6em 0;border:1px solid rgba(201,162,74,.5);background:linear-gradient(180deg,var(--ink-2),var(--ink));padding:18px;display:grid;gap:14px;position:relative}
.wiw .play::before{content:attr(data-label);position:absolute;top:-9px;left:14px;background:var(--ink);padding:0 8px;font-family:var(--font-mono);font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gilt)}
.wiw .play .row{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.wiw .play .out{font-family:var(--font-mono);font-size:.8rem;color:var(--bone-dim);min-height:1.4em;letter-spacing:.02em}
.wiw .play .out b{color:var(--bone);font-weight:600}
.wiw .play .out .g{color:var(--gilt-hi)}
.wiw .play .out .s{color:var(--sea-hi)}
.wiw .play svg{width:100%;height:auto;display:block}
.wiw .lab{font-family:var(--font-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;fill:var(--bone-dim)}

/* II: the veil */
.wiw #m2{--look:0}
.wiw #m2 .veil{filter:blur(calc((1 - var(--look)) * 7px));opacity:calc(.6 + .4 * var(--look));transition:filter .6s ease,opacity .6s ease}
.wiw #m2.holding .veil{transition:none}
.wiw .look .wall{background:var(--ink);border:1px solid rgba(201,162,74,.25)}
.wiw .look .arm{transform-box:view-box;transition:transform .6s ease}
.wiw #m2.holding .look .arm{transition:none}
.wiw .look .arm.l{transform-origin:188px 100px;transform:rotate(calc(var(--look) * -150deg))}
.wiw .look .arm.r{transform-origin:212px 100px;transform:rotate(calc(var(--look) * 150deg))}
.wiw .look .gaze{opacity:var(--look);transition:opacity .6s ease}
.wiw .look .big{font-size:clamp(1.3rem,1rem + 1.6vw,1.9rem);line-height:1.45;font-weight:300;margin:0}
.wiw .look .seenonly{opacity:0;transition:opacity .9s ease .2s}
.wiw #m2.seen .seenonly{opacity:1}
.wiw .hold{user-select:none;-webkit-user-select:none;touch-action:none}

/* III: the overlay */
.wiw .vienna{display:flex;flex-wrap:wrap;gap:.1em 1.1em;align-items:baseline;margin:0 0 1.4em;padding:10px 0}
.wiw .de{position:relative;display:inline-block;padding:.06em 0}
.wiw .de .w{display:block;font-family:var(--font-display);font-weight:500;font-size:clamp(56px,11vw,124px);line-height:1;letter-spacing:-.02em;color:var(--bone)}
.wiw .de .la{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--font-body);font-weight:200;font-style:italic;font-size:clamp(20px,3.2vw,36px);letter-spacing:.16em;color:var(--sea-hi);text-shadow:0 0 10px var(--ink);pointer-events:none;background:linear-gradient(180deg,transparent 30%,rgba(95,163,189,.14) 50%,transparent 70%)}
.wiw .de .la::before,.wiw .de .la::after{content:"";position:absolute;left:0;right:0;height:1px;background:var(--sea-hi);opacity:.35}
.wiw .de .la::before{top:38%}.wiw .de .la::after{bottom:38%}
.js .wiw .vienna .w{opacity:0;transform:translateY(16px);transition:opacity 1s ease calc(var(--d) * .25s),transform 1s ease calc(var(--d) * .25s)}
.js .wiw .vienna .la{opacity:0;transition:opacity 1.4s ease calc(1.1s + var(--d) * .25s)}
.js .wiw .vienna.in .w{opacity:1;transform:none}
.js .wiw .vienna.in .la{opacity:1}

/* IV: the lineup */
.wiw .cols{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.wiw .col{position:relative;background:var(--ink);border:1px solid rgba(201,162,74,.25);padding:14px;transition:transform 1.1s cubic-bezier(.2,.7,.2,1),opacity .9s ease}
.js .wiw .lineup:not(.in) .col.plato{transform:translate(-36px,18px);opacity:.45}
.js .wiw .lineup:not(.in) .col.freud{transform:translateY(-16px);opacity:.8}
