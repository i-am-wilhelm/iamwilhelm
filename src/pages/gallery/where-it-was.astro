<script>
  import { droneFor } from '../../design/tokens';

  (function () {
    const $ = (s: string, c: ParentNode = document) => c.querySelector(s) as HTMLElement | null;
    const $$ = (s: string, c: ParentNode = document) => Array.from(c.querySelectorAll(s)) as HTMLElement[];
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.add('js');

    /* ---------- reveals: I line by line, III, IV and VI on entry ---------- */
    const targets = $$('[data-fade], .vienna, #lineup, #inner');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
      );
      targets.forEach((el) => io.observe(el));
    } else targets.forEach((el) => el.classList.add('in'));

    /* ---------- movements: numeral, nav, progress ---------- */
    const mvs = $$('.mv'), navs = $$('.nav a'), prog = $('#progress');
    function setActive(i: number) {
      mvs.forEach((m, j) => m.classList.toggle('on', j === i));
      navs.forEach((a, j) => a.classList.toggle('on', j === i));
    }
    if ('IntersectionObserver' in window) {
      const io2 = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) setActive(mvs.indexOf(e.target as HTMLElement)); }),
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
      );
      mvs.forEach((m) => io2.observe(m));
    }
    function onScroll() {
      const h = document.documentElement, max = h.scrollHeight - h.clientHeight;
      if (prog) prog.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
    }
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    /* ---------- II: press and hold to look ---------- */
    (function () {
      const sec = $('#m2'), btn = $('#lookbtn') as HTMLButtonElement | null, reset = $('#lookreset') as HTMLButtonElement | null, out = $('#lookout');
      if (!sec || !btn || !reset || !out) return;
      let look = 0, holding = false, seen = false, raf = 0, last = 0;
      const setLook = (v: number) => { look = clamp(v, 0, 1); sec.style.setProperty('--look', look.toFixed(3)); };
      function step(t: number) {
        if (!holding) return;
        const dt = last ? t - last : 16; last = t;
        setLook(look + dt / 1400);
        if (look >= 1) { release(); return; }
        raf = requestAnimationFrame(step);
      }
      function start(e?: Event) {
        if (seen || holding) return;
        if (e) e.preventDefault();
        holding = true; last = 0;
        sec!.classList.add('holding');
        btn!.setAttribute('aria-pressed', 'true');
        out!.textContent = 'He is looking. The hands come down.';
        if (reduce) { setLook(1); release(); return; }
        raf = requestAnimationFrame(step);
      }
      function release() {
        if (!holding) return;
        holding = false; cancelAnimationFrame(raf);
        sec!.classList.remove('holding');
        seen = true; setLook(1); sec!.classList.add('seen');
        btn!.setAttribute('aria-pressed', 'false'); btn!.textContent = 'He looked'; btn!.disabled = true; reset!.hidden = false;
        out!.innerHTML = 'The line resolves and stays. Plato’s point is not what he saw but what he <b>shouted</b>, and at whom.';
      }
      btn.addEventListener('pointerdown', start);
      addEventListener('pointerup', () => { if (holding) release(); });
      addEventListener('pointercancel', () => { if (holding) release(); });
      btn.addEventListener('keydown', (e) => { if ((e.key === ' ' || e.key === 'Enter') && !e.repeat) start(e); });
      btn.addEventListener('keyup', (e) => { if ((e.key === ' ' || e.key === 'Enter') && holding) release(); });
      reset.addEventListener('click', () => {
        seen = false; setLook(0); sec!.classList.remove('seen'); reset!.hidden = true;
        btn!.disabled = false; btn!.textContent = 'Press and hold to look';
        out!.textContent = 'His hands are over his eyes. The bodies are off to the right, out of the frame, and they stay there.';
      });
    })();

    /* ---------- IV: the name layer ---------- */
    (function () {
      const col = $('.col.freud'), lb = $('#layerbtn'), lo = $('#layerout');
      if (!col || !lb || !lo) return;
      const ORDER = ['latin', 'german', 'greek'];
      const TXT: Record<string, [string, string]> = {
        latin: ['Lift the Latin', 'Freud’s column as his translators left it: <b>super-ego, ego, id</b>.'],
        german: ['Lay the Greek over it', 'Freud’s own words: <b lang="de">das Über-Ich, das Ich, das Es</b>. The Over-I, the I, the It.'],
        greek: ['Put the Latin back', 'Plato’s words in Freud’s slots: <b lang="grc">θυμοειδές, λογιστικόν, ἐπιθυμητικόν</b>. The fit the Latin hid.'],
      };
      function setLayer(l: string) {
        col!.dataset.state = l; document.body.dataset.layer = l;
        lb!.textContent = TXT[l][0];
        lo!.innerHTML = TXT[l][1] + ' The rest of the page names the three by whichever layer you leave on top.';
      }
      const next = () => setLayer(ORDER[(ORDER.indexOf(col!.dataset.state || 'latin') + 1) % ORDER.length]);
      lb.addEventListener('click', next);
      col.addEventListener('click', next);
      setLayer('latin');
    })();

    /* ---------- V: the lyre ---------- */
    (function () {
      const lyre = $('#lyre'), svg = $('#lyresvg') as unknown as SVGSVGElement | null, out = $('#lyreout');
      if (!lyre || !svg || !out) return;
      const pegs = $$('.peg', svg), strings = $$('.string', svg), centsEls = [$('#c0'), $('#c1'), $('#c2')];
      const NAMES = ['νεάτη', 'μέση', 'ὑπάτη'];
      /* The site's key. The orchestra pit opens its score on the hero drone
         (C2 in src/design/tokens.ts; the circle of fifths descends from
         it), so the lyre resolves to C: hypate C3, mese a just fourth above
         (4:3), nete the octave (2:1). Plato's three fixed notes, 443d, in
         just intonation, so a tuned chord has no beats in it at all. */
      const noteHz = (n: string) => {
        const m = /^([A-G])([#b]?)(-?\d)$/.exec(n);
        if (!m) return 65.41;
        const semis = ({ C: 0, D: 2, E: 4, F: 5, G: 7, A: 9, B: 11 } as Record<string, number>)[m[1]] + (m[2] === '#' ? 1 : m[2] === 'b' ? -1 : 0) + (parseInt(m[3], 10) + 1) * 12;
        return 440 * Math.pow(2, (semis - 69) / 12);
      };
      const root = noteHz(droneFor('hero') || 'C2') * 2;
      const target = [root * 2, (root * 4) / 3, root];
      const DEFAULT = [22, -14, 9], TOL = 4;
      let cents = DEFAULT.slice(), tuned = false;
      const hz = (i: number) => target[i] * Math.pow(2, cents[i] / 1200);

      /* WebAudio, created on the first gesture and never before. */
      let ac: AudioContext | null = null, master: GainNode | null = null;
      function audio() {
        if (ac) { if (ac.state === 'suspended') ac.resume(); return ac; }
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        if (!AC) return null;
        try { ac = new AC(); } catch (e) { return null; }
        master = ac.createGain(); master.gain.value = 0.6;
        const comp = ac.createDynamicsCompressor(); comp.threshold.value = -18; comp.ratio.value = 4;
        master.connect(comp); comp.connect(ac.destination);
        return ac;
      }
      function voice(freq: number, type: OscillatorType, gain: number, t0: number, dur: number) {
        const o = ac!.createOscillator(), g = ac!.createGain();
        o.type = type; o.frequency.setValueAtTime(freq, t0);
        g.gain.setValueAtTime(0.0001, t0); g.gain.exponentialRampToValueAtTime(gain, t0 + 0.012); g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
        o.connect(g); g.connect(master!); o.start(t0); o.stop(t0 + dur + 0.05);
      }
      const ringT: number[] = [0, 0, 0];
      function ring(i: number, ms: number) {
        strings[i].classList.add('ring'); clearTimeout(ringT[i]);
        ringT[i] = window.setTimeout(() => strings[i].classList.remove('ring'), ms);
      }
      /* A pluck sounds the string at its pitch and, quietly, the pitch the peg
         is aiming for: the two beat against each other until they agree. */
      function pluck(i: number, dur = 1.8) {
        const a = audio(); if (!a) return;
        const t0 = a.currentTime, f = hz(i);
        voice(f, 'triangle', 0.22, t0, dur);
        voice(f * 2, 'sine', 0.05, t0, dur * 0.45);
        voice(target[i], 'sine', 0.1, t0, dur);
        ring(i, Math.min(900, dur * 500));
      }
      function chord() { if (!audio()) return; for (let i = 0; i < 3; i++) pluck(i, 3.2); }
      /* Held while a peg is dragged, the string and its reference sustain. */
      let held: { i: number; osc: OscillatorNode; ref: OscillatorNode; g: GainNode } | null = null;
      function holdStart(i: number) {
        const a = audio(); if (!a) return;
        holdStop();
        const t0 = a.currentTime, g = a.createGain();
        g.gain.setValueAtTime(0.0001, t0); g.gain.exponentialRampToValueAtTime(0.16, t0 + 0.08); g.connect(master!);
        const osc = a.createOscillator(); osc.type = 'triangle'; osc.frequency.value = hz(i); osc.connect(g); osc.start();
        const rg = a.createGain(); rg.gain.value = 0.5; rg.connect(g);
        const ref = a.createOscillator(); ref.type = 'sine'; ref.frequency.value = target[i]; ref.connect(rg); ref.start();
        held = { i, osc, ref, g };
        strings[i].classList.add('ring');
      }
      function holdUpdate() { if (held && ac) held.osc.frequency.setTargetAtTime(hz(held.i), ac.currentTime, 0.02); }
      function holdStop() {
        if (!held || !ac) return;
        const h = held, t = ac.currentTime; held = null;
        h.g.gain.cancelScheduledValues(t); h.g.gain.setValueAtTime(Math.max(h.g.gain.value, 0.0001), t); h.g.gain.exponentialRampToValueAtTime(0.0001, t + 0.25);
        h.osc.stop(t + 0.3); h.ref.stop(t + 0.3);
        strings[h.i].classList.remove('ring');
      }

      const fmt = (c: number) => { const r = Math.round(c); return (r > 0 ? '+' : r < 0 ? '−' : '') + Math.abs(r) + '¢'; };
      function status() {
        const off = NAMES.filter((_, i) => Math.abs(cents[i]) > TOL);
        if (off.length === 3) return 'Three strings, three pitches, no chord. Drag a peg up or down until the beating stops; on a keyboard, focus a peg and use the arrow keys.';
        if (off.length === 2) return '<b lang="grc">' + off[0] + '</b> and <b lang="grc">' + off[1] + '</b> still beat against the third.';
        return 'Only <b lang="grc">' + off[0] + '</b> is out now. Listen for the slow wobble and bring it in.';
      }
      function render() {
        pegs.forEach((p, i) => {
          p.style.setProperty('--rot', cents[i] * 1.6 + 'deg');
          p.setAttribute('aria-valuenow', String(Math.round(cents[i])));
          p.setAttribute('aria-valuetext', fmt(cents[i]) + (Math.abs(cents[i]) <= TOL ? ', in tune' : cents[i] > 0 ? ', sharp' : ', flat'));
          if (centsEls[i]) centsEls[i]!.textContent = fmt(cents[i]);
        });
        const now = cents.every((c) => Math.abs(c) <= TOL);
        lyre!.classList.toggle('tuned', now);
        if (now && !tuned) {
          out!.innerHTML = '<span class="g">In tune.</span> One clean chord: hypate, mese, nete, a fourth and a fifth framing the octave. Three strings that were already there, brought into one sound.';
          if (ac) chord();
        } else if (!now) out!.innerHTML = (tuned ? 'Detuned again. ' : '') + status();
        tuned = now;
      }

      let drag: { i: number; y: number; c: number } | null = null;
      pegs.forEach((p, i) => {
        p.addEventListener('pointerdown', (e) => {
          e.preventDefault(); drag = { i, y: e.clientY, c: cents[i] };
          try { p.setPointerCapture(e.pointerId); } catch (_) { /* older WebKit */ }
          p.classList.add('on'); holdStart(i);
        });
        p.addEventListener('pointermove', (e) => {
          if (!drag || drag.i !== i) return;
          const scale = svg!.getBoundingClientRect().height / 300;
          cents[i] = clamp(drag.c + (drag.y - e.clientY) / (scale * 1.1), -60, 60);
          holdUpdate(); render();
        });
        const end = () => { if (!drag || drag.i !== i) return; drag = null; p.classList.remove('on'); holdStop(); render(); };
        p.addEventListener('pointerup', end); p.addEventListener('pointercancel', end); p.addEventListener('lostpointercapture', end);
        p.addEventListener('keydown', (e) => {
          let d = 0;
          if (e.key === 'ArrowUp' || e.key === 'ArrowRight') d = e.shiftKey ? 10 : 2;
          else if (e.key === 'ArrowDown' || e.key === 'ArrowLeft') d = e.shiftKey ? -10 : -2;
          else if (e.key === 'PageUp') d = 10;
          else if (e.key === 'PageDown') d = -10;
          else if (e.key === 'Home') cents[i] = -60;
          else if (e.key === 'End') cents[i] = 60;
          else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pluck(i); return; }
          else return;
          e.preventDefault(); cents[i] = clamp(cents[i] + d, -60, 60); render(); pluck(i, 1.1);
        });
      });
      strings.forEach((s, i) => s.addEventListener('click', () => pluck(i)));
      $('#strike')?.addEventListener('click', chord);
      $('#detune')?.addEventListener('click', () => { cents = DEFAULT.slice(); render(); });
      render();
    })();

    /* ---------- V: the dike ---------- */
    (function () {
      const r = $('#dikerange') as HTMLInputElement | null, svg = $('#dikesvg') as unknown as SVGSVGElement | null;
      const clip = $('#landclip'), dg = $('#dikeg'), sea = $('#sea'), waves = $('#seawaves'), lab = $('#landlab'), out = $('#dikeout');
      if (!r || !svg || !clip || !dg || !sea || !waves || !lab || !out) return;
      function set(v: number) {
        v = clamp(Math.round(v), 0, 100);
        if (String(v) !== r!.value) r!.value = String(v);
        const x = v * 6, y = 120 + v * 0.3;
        clip!.setAttribute('width', String(x));
        dg!.setAttribute('transform', 'translate(' + x + ' 0)');
        sea!.setAttribute('y', String(y)); waves!.setAttribute('y', String(y));
        lab!.setAttribute('opacity', v > 16 ? '1' : '0');
        out!.innerHTML = v < 8 ? 'The Zuider Zee. Drag right to push the water back.'
          : v < 55 ? 'A dike, and behind it the first flat land. <span class="s">A work of culture</span>, he called it.'
          : v < 100 ? 'Most of the sea is land now. The dike has to hold, and it has to hold forever.'
          : '<span class="s" lang="de">Wo Es war, soll Ich werden.</span> Where It was. The water is still there, on the other side of the line.';
      }
      r.addEventListener('input', () => set(+r!.value));
      let dd = false;
      const move = (e: PointerEvent) => { const b = svg!.getBoundingClientRect(); set(((e.clientX - b.left) / b.width) * 100); };
      svg.addEventListener('pointerdown', (e) => { dd = true; try { svg!.setPointerCapture(e.pointerId); } catch (_) { /* older WebKit */ } move(e); });
      svg.addEventListener('pointermove', (e) => { if (dd) move(e); });
      const up = () => { dd = false; };
      svg.addEventListener('pointerup', up); svg.addEventListener('pointercancel', up); svg.addEventListener('lostpointercapture', up);
      set(0);
    })();

    /* ---------- V: which image to leave the section on ---------- */
    (function () {
      const KEY = 'wiw:leave', btns = $$('.leave [data-leave]'), lefton = $('#lefton'), lout = $('#leaveout');
      if (!btns.length || !lefton || !lout) return;
      function apply(v: string, say: boolean) {
        document.body.dataset.leave = v;
        btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.leave === v)));
        lefton!.textContent = v === 'dike' ? 'left on the dike' : 'left on the lyre';
        if (say) lout!.innerHTML = v === 'dike' ? 'The close takes the dike’s blue: land where there was water.' : 'The close takes the lyre’s gold: three strings, one sound.';
      }
      let saved: string | null = null;
      try { saved = localStorage.getItem(KEY); } catch (_) { /* private mode, blocked storage */ }
      if (saved === 'lyre' || saved === 'dike') apply(saved, false);
      btns.forEach((b) => b.addEventListener('click', () => {
        const v = b.dataset.leave || 'lyre'; apply(v, true);
        try { localStorage.setItem(KEY, v); } catch (_) { /* fine: the choice lives for this page view */ }
      }));
    })();

    /* ---------- VI: Paul's letters over Plato's ---------- */
    (function () {
      let n = 0;
      $$('#inner .paul.w').forEach((w) => {
        const chars = Array.from(w.textContent || '');
        w.textContent = '';
        chars.forEach((ch) => { const i = document.createElement('i'); i.textContent = ch; i.style.setProperty('--i', String(n++)); w.appendChild(i); });
      });
    })();

    /* ---------- ledger filter ---------- */
    $$('.filter button').forEach((b) => b.addEventListener('click', () => {
      $$('.filter button').forEach((x) => x.classList.remove('on')); b.classList.add('on');
      const f = b.dataset.f;
      $$('#ltable tbody tr').forEach((tr) => tr.classList.toggle('hide', f !== 'all' && tr.dataset.t !== f));
    }));
  })();
</script>
