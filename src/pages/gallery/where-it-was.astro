          <g class="star"><circle cx="150" cy="108" r="3.2"/><circle cx="142" cy="118" r="1.8"/><circle cx="158" cy="118" r="1.8"/><circle cx="146" cy="138" r="1.8"/><circle cx="154" cy="138" r="1.8"/><circle cx="143" cy="150" r="1.8"/><circle cx="157" cy="150" r="1.8"/></g>
