---
/**
 * Blake Wrote It Backwards: Seeing No. 7. How William Blake made a page,
 * as a scrolly in five scenes: the mirror-written plate (I), the acid bite
 * that leaves the poem standing in relief (II), the inking and the pull on
 * the rolling press (III), the hand coloring that makes every copy an
 * original, with a palette for the reader to color a copy of their own, and the
 * fifty-four plates melting down to the one surviving fragment (IV), and
 * fourfold vision, one sunrise drawn four ways (V). The object list and the
 * sources close it.
 *
 * Ported from the owner's prototype
 * (docs/prototypes/blake-wrote-it-backwards-prototype.html, from
 * claude.ai/artifact/3hBdbx7Y71i7fzBMJMMSnC), whose copy, palette, canvases,
 * pacing and exhibit mode (#exhibit: larger type, no outbound links, a slow
 * self-running tour when idle) ship as-is; only the shell is the site's.
 * The prototype labels it "Seen · No. 7" after The Paranoiac-Critical
 * Method, Applied, which is not hung; on the site it follows Monet Invented
 * the Dither and keeps the prototype's number, No. 7, so it lines up with
 * No. 8 to No. 15 after it (the number lives on the gallery entry).
 *
 * Same architecture as the other Seeing essays: a sticky stage (one canvas,
 * 100dvh) per scene under a run of step cards, one requestAnimationFrame
 * loop reading each scene's scroll progress, no images. Each canvas is a
 * role="img" figure with a label and a longer description, which the twin
 * reads as the exhibit. The corner labels sit at the right, clear of the
 * fixed Gallery exit. The stylesheet is scoped under body.blake. The last
 * step of scene III carries data-og-frame, so `npm run og:scrollies` shoots
 * the backwards plate beside the forwards impression for the share image.
 */
import Poem from '../../layouts/Poem.astro';
import SeriesMark from '../../components/scroll/SeriesMark.astro';
import Byline from '../../components/scroll/Byline.astro';
import ScrollFoot from '../../components/scroll/ScrollFoot.astro';
import MethodLink from '../../components/scroll/MethodLink.astro';
import { getPiece } from '../../lib/pieces';

const piece = await getPiece('blake-wrote-it-backwards');
const { title, description, date } = piece;
const month = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Poem
  title={title}
  description={description}
  year={String(date.getUTCFullYear())}
  published={date}
  night="#0c0e19"
  accent="#d6ab52"
  genre="Essay"
  bodyClass="blake"
  preload={[
    '/fonts/cormorant-garamond-latin-400-normal.woff2',
    '/fonts/newsreader-latin-opsz-normal.woff2',
    '/fonts/ibm-plex-mono-latin-500-normal.woff2',
  ]}
>
<main class="blake-page">

<a class="skip" href="#objects" data-twin-skip>Skip to the object list and sources</a>

<header class="hero" id="hero">
  <canvas id="heroCanvas" aria-hidden="true"></canvas>
  <div class="inner">
    <div class="eyebrow"><SeriesMark id="blake-wrote-it-backwards" /> &middot; A scrolly on copper, acid and four ways of seeing</div>
    <h1 id="title">Blake Wrote It <span class="mirror" id="mirror">Backwards</span></h1>
    <p class="sub">Every page William Blake printed began as mirror writing on copper. Acid, a hand press and a paintbrush did the rest. He called it the infernal method, and it carried his whole theory of sight.</p>
    <p class="kicker"><Byline before="By" /> &middot; {month}</p>
    <div class="hint" aria-hidden="true">SCROLL &darr;</div>
  </div>
</header>

<!-- I · The plate -->
<section class="scene" id="s1" aria-labelledby="s1h">
  <div class="stage">
    <canvas role="img" aria-label="A polished copper plate seen from above. A quill writes a poem on it in dark varnish, in mirror image, from right to left." aria-describedby="s1d"></canvas>
    <div class="tag" aria-hidden="true">Copper plate · 11.1 × 6.4 cm · seen from above</div>
    <p class="sr-only" id="s1d">The plate is upright, about the size of a playing card. A tree grows up its left edge and sends three branches across. The title The Tyger and eight lines of the poem appear letter by letter, reversed, as in a mirror. A tiger is drawn at the foot of the plate, facing right.</p>
  </div>
  <div class="steps">
    <div class="step"><div class="card"><h2 class="n" id="s1h">I · The plate</h2><p>Start with a sheet of copper a little taller than a playing card, hammered flat and polished until it shines like a mirror.</p></div></div>
    <div class="step"><div class="card"><p>Blake draws straight onto the metal with a quill and a fine brush. His ink is stop-out varnish, the acid-proof liquid etchers use to protect parts of a plate. Nothing is traced. He designs the page as he writes it.</p></div></div>
    <div class="step"><div class="card"><p>And he writes it backwards. Every letter runs right to left, so the printed page will read left to right. His friend John Linnell wrote that he had attained &ldquo;the most extraordinary facility&rdquo; at it.</p></div></div>
    <div class="step"><div class="card"><p>In 1788 a book of poems with pictures took two workshops: one to set the type, one to engrave the plates. Blake had found a way to be both, alone, on one piece of copper. He was thirty.</p></div></div>
  </div>
</section>

<!-- II · The bite -->
<section class="scene" id="s2" aria-labelledby="s2h">
  <div class="stage">
    <canvas role="img" aria-label="The plate sits in a tray of wax and acid. Bubbles rise from the bare copper. Below it, a cross-section shows the acid eating the metal down around the varnished letters." aria-describedby="s2d"></canvas>
    <div class="tag" id="t2" aria-hidden="true">Wax dike</div>
    <p class="sr-only" id="s2d">Acid floods the tray and turns blue-green. A feather sweeps the bubbles away. In the cross-section, the copper under each varnished letter stays at full height while the copper between the letters sinks, in two stages. At the end the varnish is cleaned off and the poem stands up from the plate in bright metal.</p>
  </div>
  <div class="steps">
    <div class="step"><div class="card"><h2 class="n" id="s2h">II · The bite</h2><p>Wall the plate with strips of wax to make a shallow tray. Pour in diluted nitric acid, about a quarter inch deep. The bare copper starts to fizz.</p></div></div>
    <div class="step"><div class="card"><p>Bubbles can lift the varnish, so Blake strokes them away with a feather. The first bite takes forty-five minutes to an hour and a half. He pours off the acid, paints over the words to protect them, and bites the plate again, deeper.</p></div></div>
    <div class="step"><div class="card"><p>Other etchers bite their lines into the metal and print from the grooves. Blake dissolves everything around his lines. When the acid is done, the poem is the only part of the plate still standing.</p></div></div>
    <div class="step mid"><div class="card"><blockquote>&ldquo;&hellip;melting apparent surfaces away, and displaying the infinite which was hid.&rdquo;</blockquote><cite>The Marriage of Heaven and Hell, plate 14</cite><p>He called this printing in the infernal method. The chemistry doubled as his creed: clear away the surface and the hidden thing shows.</p></div></div>
  </div>
</section>

<!-- III · The pull -->
<section class="scene" id="s3" aria-labelledby="s3h">
  <div class="stage">
    <canvas role="img" aria-label="The plate is inked, covered with a sheet of paper and rolled. The sheet lifts, turns over, and lands beside the plate with the poem now readable." aria-describedby="s3d"></canvas>
    <div class="tag" id="t3" aria-hidden="true">Inking</div>
    <p class="sr-only" id="s3d">A round linen dabber pats orange-brown ink onto the raised letters. A cream sheet comes down over the plate and a roller passes across it. The sheet lifts and flips. At rest, the mirrored plate is on the left and the printed impression is on the right, reading Tyger Tyger, burning bright. A row of twelve small sheets appears beneath: an hour of work.</p>
  </div>
  <div class="steps">
    <div class="step"><div class="card"><h2 class="n" id="s3h">III · The pull</h2><p>Ink goes on with a linen dabber, touching only what stands up. Yellow ochre and raw sienna in the early years, reds and oranges late in life.</p></div></div>
    <div class="step"><div class="card"><p>Catherine Blake lays a damp sheet over the plate, adds the blankets, and turns the handle of the rolling press. They have raised the roller, because a relief plate wants light pressure.</p></div></div>
    <div class="step"><div class="card"><p>Peel the sheet and turn it over. The backwards plate reads forwards.</p></div></div>
    <div class="step" data-og-frame><div class="card"><p>Working together, William and Catherine could pull about a dozen impressions an hour.</p></div></div>
  </div>
</section>

<!-- IV · Every copy an original -->
<section class="scene" id="s4" aria-labelledby="s4h">
  <div class="stage">
    <canvas role="img" aria-label="Watercolor washes bloom across the printed page: a sky, a green bank, a golden tiger. Then four copies of the same page appear, each colored differently." aria-describedby="s4d"></canvas>
    <div class="tag" id="t4" aria-hidden="true">Hand coloring</div>
    <div class="palette" id="palette" role="group" aria-label="Color your own copy" data-twin-skip>
      <span class="pl">Color your copy</span>
      <button type="button" id="w-dawn" data-way="dawn" aria-pressed="true"><i style="background:#f2b6a0"></i>Dawn</button>
      <button type="button" id="w-noon" data-way="noon" aria-pressed="false"><i style="background:#9cc7e0"></i>Noon</button>
      <button type="button" id="w-dusk" data-way="dusk" aria-pressed="false"><i style="background:#8a6fc0"></i>Dusk</button>
      <button type="button" id="w-night" data-way="night" aria-pressed="false"><i style="background:#3d55a8"></i>Night</button>
    </div>
    <p class="sr-only" id="s4d">The four colorings are named Dawn, Noon, Dusk and Night. They are illustrations made for this page and copy no single surviving book. Four buttons let you recolor the page yourself. At the end, a grid of fifty-four small copper plates fades away and one small broken fragment is left.</p>
  </div>
  <div class="steps">
    <div class="step"><div class="card"><h2 class="n" id="s4h">IV · Every copy an original</h2><p>When the sheets dry, the Blakes color them by hand. He grinds his own watercolors and they share the brushwork. Some late copies carry touches of shell gold.</p></div></div>
    <div class="step"><div class="card"><p>So there is no single Tyger. Blake printed the Songs to order for more than thirty years, and the Met describes each copy as &ldquo;visually distinct.&rdquo; The four here illustrate the idea. They were drawn for this page.</p></div></div>
    <div class="step"><div class="card"><p>Try it. Choose a sky for your own copy with the buttons at the top of the screen.</p></div></div>
    <div class="step"><div class="card"><p>Joseph Viscomi counts 168 surviving copies of the illuminated books. The copper did not survive. After Blake died the plates passed to a friend and then vanished, reputedly sold for scrap. One fragment remains, smaller than a playing card, at the National Gallery of Art in Washington.</p></div></div>
  </div>
</section>

<!-- V · Fourfold -->
<section class="scene" id="s5" aria-labelledby="s5h">
  <div class="stage">
    <canvas role="img" aria-label="One sunrise drawn four ways: a measured circle on graph paper, a great eye, a crescent moon over a night sea, and a sun made of hundreds of tiny figures with raised arms." aria-describedby="s5d"></canvas>
    <div class="strata" id="strata" aria-hidden="true"><span>1 Single</span><span>2 Twofold</span><span>3 Threefold</span><span>4 Fourfold</span></div>
    <p class="sr-only" id="s5d">First the sun is a blue circle on a grid, spanned by a pair of dividers, with a gold guinea coin beside it for comparison. Second, the circle fills with fire and two lids open around it, making the sun the iris of an eye on the horizon. Third, night falls: the disk becomes a crescent moon among stars, reflected in the water. Fourth, the sun returns as a spiral of more than a thousand small radiant figures spreading across the whole sky.</p>
  </div>
  <div class="steps">
    <div class="step"><div class="card"><h2 class="n" id="s5h">V · Fourfold</h2><p>All that copper served one idea. Blake believed sight comes in four grades. He numbered them in a verse letter to his patron Thomas Butts in November 1802.</p></div></div>
    <div class="step"><div class="card"><p>Single vision is the eye alone: the world as measurement. The rising sun is a round disk of fire, &ldquo;somewhat like a Guinea.&rdquo; Blake prayed to be kept from &ldquo;Single vision &amp; Newtons sleep.&rdquo;</p></div></div>
    <div class="step"><div class="card"><p>Twofold sees the thing and its meaning at once. On a walk he meets a thistle:</p><p class="verse">&ldquo;With my inward Eye &rsquo;tis an old Man grey;<br>With my outward a Thistle across my way.&rdquo;</p></div></div>
    <div class="step"><div class="card"><p>Threefold he called Beulah: a soft, moonlit country of love and dreaming, where poems begin.</p></div></div>
    <div class="step"><div class="card"><p>Fourfold is the summit, his &ldquo;supreme delight.&rdquo; The same sunrise, seen whole:</p><p class="verse">&ldquo;O no no I see an Innumerable company of the Heavenly host crying Holy Holy Holy&hellip;&rdquo;</p></div></div>
    <div class="step mid"><div class="card"><blockquote>&ldquo;I question not my Corporeal or Vegetative Eye any more than I would Question a Window concerning a Sight. I look thro it &amp; not with it.&rdquo;</blockquote><cite>A Vision of the Last Judgment, 1810</cite></div></div>
  </div>
</section>

<section class="end" id="end">
  <hr class="rule">
  <h2>Look<br>through.</h2>
  <p class="lede">He wrote backwards so the page would read forwards. He let acid take the copper so the poem would stand. Then he asked his readers for the same labor with their eyes.</p>
  <p class="lede">The surviving copies are spread across museums and libraries, and each one is different. The best way to finish this page is to go and see one.</p>

  <h3 id="objects">See the real ones</h3>
  <ul class="objs">
    <li class="obj"><b>Songs of Experience: The Tyger</b><span>William Blake. Etched 1794, printed about 1825 (copy Y). Relief etching printed in orange-brown ink, hand-colored with watercolor and gold. Sheet 15.7 × 14.1 cm.</span><span class="who">The Metropolitan Museum of Art, New York · Rogers Fund, 1917 · 17.10.42 · Open Access</span><a href="https://www.metmuseum.org/art/collection/search/347983">Object record</a></li>
    <li class="obj"><b>Songs of Innocence and of Experience, plate 42, &ldquo;The Tyger&rdquo;</b><span>William Blake. 1794 (copy F). Color-printed relief etching with watercolor. Plate 11.1 × 6.4 cm.</span><span class="who">Yale Center for British Art, Paul Mellon Collection · B1978.43.1573 · Public domain</span><a href="https://collections.britishart.yale.edu/catalog/tms:2519">Object record</a></li>
    <li class="obj"><b>Songs of Innocence and of Experience</b><span>William Blake. London, 1794. The whole book, page by page.</span><span class="who">Library of Congress, Lessing J. Rosenwald Collection</span><a href="https://www.loc.gov/item/48031329/">Object record</a></li>
    <li class="obj"><b>Fragment of a cancelled plate for America: A Prophecy</b><span>William Blake. About 1793. Relief-etched copper, 8.1 × 5.87 cm. The one piece of his relief-etched copper known to survive.</span><span class="who">National Gallery of Art, Washington · Rosenwald Collection · 1943.3.1848.a</span><a href="https://www.nga.gov/artworks/5006-fragment-cancelled-plate-prophecy-recto">Object record</a></li>
    <li class="obj"><b>The Ancient of Days, frontispiece to Europe. A Prophecy</b><span>William Blake. 1794 (copy A). Color-printed relief and white-line etching with oil, watercolor, and pen and black ink. Plate 23.2 × 16.8 cm. The dividers in part V are a nod to this sheet.</span><span class="who">Yale Center for British Art, Paul Mellon Collection · B1992.8.4(1) · Public domain</span><a href="https://collections.britishart.yale.edu/catalog/tms:3878">Object record</a></li>
  </ul>

  <h3>On the record</h3>
  <ul class="src">
    <li>The process follows Joseph Viscomi, <a href="https://viscomi.sites.oasis.unc.edu/viscomi/illuminated.htm">&ldquo;William Blake&rsquo;s Illuminated Printing&rdquo;</a>: the wax dike, the feather, the timings, the dabber, the raised roller, the dozen pulls an hour, the count of 168 copies and the fate of the plates.</li>
    <li>John Linnell&rsquo;s remark on writing backwards is quoted from Michael Phillips, <a href="https://preo.ube.fr/interfaces/index.php?id=489">&ldquo;&lsquo;Printing in the infernal method&rsquo;&rdquo;</a>, <i>Interfaces</i>.</li>
    <li>Blake&rsquo;s words: <i>The Marriage of Heaven and Hell</i>, plate 14; the verse letter to Thomas Butts, 22 November 1802; <i>A Vision of the Last Judgment</i>, 1810. Text after David V. Erdman, <i>The Complete Poetry and Prose of William Blake</i>.</li>
    <li>The lines on the plate are the first two stanzas of &ldquo;The Tyger&rdquo; (1794) in Blake&rsquo;s spelling.</li>
    <li>Dates, media, dimensions and credit lines come from each institution&rsquo;s object record, linked above.</li>
  </ul>
  <MethodLink />

  <div>
    <a class="btn" href="#hero">Read it again &uarr;</a>
    <button class="btn" type="button" id="exhibitBtn" aria-pressed="false">Exhibit mode</button>
  </div>
  <div class="colophon">
    {piece.label}. Drawn in code. No photographs and no image generators. The page layout, tree and tyger are new drawings after Blake&rsquo;s design. The four colorways are illustrative.<br>
    Research, writing and code made with AI assistance and checked against the sources listed.<br>
    An essay &middot; <Byline /> &middot; {date.getUTCFullYear()}<br>
    Previous: <a href="/gallery/monet-invented-the-dither/"><i>Monet Invented the Dither</i></a> &middot; Next: <a href="/gallery/nobody-sees-the-same-sea/"><i>Nobody Sees the Same Sea</i></a> &middot; <a href="/gallery/">The Gallery</a>
  </div>
</section>

<ScrollFoot id="blake-wrote-it-backwards" class="blake-sf" />
</main>

<div class="chip" id="chip" data-twin-skip><span>Exhibit mode · touch to explore</span><button type="button" id="exitExhibit">Exit</button></div>
</Poem>

<style is:global>
/* Blake Wrote It Backwards faces, self-hosted (public/fonts, SIL OFL)
   under the names the prototype loads from Google Fonts: Cormorant
   Garamond (display and the hand on the plate; Poem.astro declares it),
   Newsreader (text) and IBM Plex Mono (labels). */
@font-face{font-family:'Newsreader';font-style:normal;font-weight:400 600;font-display:swap;src:url('/fonts/newsreader-latin-opsz-normal.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Newsreader';font-style:italic;font-weight:400 600;font-display:swap;src:url('/fonts/newsreader-latin-opsz-italic.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/ibm-plex-mono-latin-400-normal.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/ibm-plex-mono-latin-500-normal.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}

/* layout: one sticky full-height stage per scene; text cards scroll over it (bottom on portrait, right column on wide screens) */
body.blake{
  --bg:#0c0e19; --bone:#ece4d2; --copper:#c47d42; --copper-hi:#f2bb8a; --acid:#5cc4b8; --ink:#9a4a22; --gold:#d6ab52; --muted:#948f80; --paper:#efe5cf;
  --bl-display:'Cormorant Garamond',Georgia,'Times New Roman',serif;
  --bl-body:'Newsreader',Georgia,'Times New Roman',serif;
  --bl-mono:'IBM Plex Mono',ui-monospace,Menlo,Consolas,monospace;
  --font-mono:var(--bl-mono);
  --fg:var(--bone);
  background:var(--bg);color:var(--bone);
  font-family:var(--bl-body);font-size:18px;line-height:1.55;-webkit-font-smoothing:antialiased;overflow-x:hidden;
}
/* Mounted in Poem.astro: neutralise its column, section, heading and fixed-stage rules. */
.blake main.blake-page{max-width:none;margin:0;padding:0;position:relative;z-index:1}
.blake section{display:block;min-height:0;padding:0;gap:0}
.blake a{color:var(--copper-hi)}
.blake .sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.blake .skip{position:absolute;left:12px;top:-60px;z-index:10;background:var(--bone);color:#14121c;padding:10px 14px;font-family:var(--bl-mono);font-size:12px;text-decoration:none}
.blake .skip:focus{top:60px}

.blake .hero{position:relative;min-height:100vh;min-height:100dvh;display:flex;align-items:center;justify-content:center;text-align:center;padding:14vh 24px 10vh;overflow:hidden}
.blake .hero canvas{position:absolute;inset:0;width:100%;height:100%}
.blake .hero .inner{position:relative;max-width:820px}
.blake .eyebrow{font-family:var(--bl-mono);font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)}
.blake h1{font-family:var(--bl-display);font-weight:400;font-size:clamp(46px,12.5vw,124px);line-height:.92;margin:.35em 0 .3em;letter-spacing:-.015em;text-wrap:balance;cursor:default}
.blake h1 .mirror{display:inline-block;font-style:italic;color:var(--copper-hi);transform:scaleX(-1);animation:bl-unflip 1.1s 2.4s cubic-bezier(.6,0,.2,1) forwards}
.blake h1 .mirror.again{animation:none;transform:scaleX(-1)}
@keyframes bl-unflip{to{transform:scaleX(1)}}
.blake .sub{max-width:40ch;margin:0 auto;font-size:19px;color:#cfc6b2;font-style:italic}
.blake .kicker{margin:2em auto 0;font-family:var(--bl-mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#cfc6b2}
.blake .hint{margin-top:8vh;font-family:var(--bl-mono);font-size:11px;letter-spacing:.22em;color:var(--muted)}

.blake .scene{position:relative}
.blake .stage{position:sticky;inset:auto;top:0;width:auto;height:100vh;height:100dvh;overflow:hidden;z-index:auto;display:block;touch-action:auto}
.blake .stage canvas{display:block;width:100%;height:100%;touch-action:pan-y}
.blake .steps{position:relative;margin-top:-100vh;margin-top:-100dvh;pointer-events:none}
.blake .step{min-height:100vh;min-height:100dvh;display:flex;align-items:flex-end;justify-content:center;padding:0 18px 8vh}
.blake .step.mid{align-items:center;padding-bottom:0}
.blake .card{pointer-events:auto;max-width:37ch;background:rgba(14,16,28,.9);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border:1px solid rgba(214,171,82,.22);padding:18px 20px 16px;font-size:clamp(17.5px,calc(12px + .85vmin),26px);color:var(--bone)}
.blake .card p{margin:0 0 .7em}
.blake .card p:last-child{margin:0}
.blake .card .n{font-family:var(--bl-mono);font-weight:500;font-size:10px;line-height:1.55;letter-spacing:.22em;color:var(--gold);display:block;margin:0 0 9px;text-transform:uppercase}
.blake .card blockquote{margin:0 0 .5em;font-family:var(--bl-display);font-size:29px;line-height:1.12;font-style:italic;color:#fff3dc}
.blake .card cite{display:block;font-family:var(--bl-mono);font-style:normal;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin:0 0 .9em}
.blake .card .verse{font-family:var(--bl-display);font-style:italic;font-size:21px;line-height:1.25;color:#fff3dc}
/* the corner labels: set at the right, since Poem.astro pins the Gallery exit to the left corner */
.blake .tag,.blake .strata{position:absolute;right:12px;top:12px;font-family:var(--bl-mono);font-weight:500;font-size:10px;line-height:1.6;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);background:rgba(12,14,25,.72);border:1px solid rgba(214,171,82,.25);padding:5px 9px;max-width:calc(100% - 172px);text-align:right;pointer-events:none}
.blake .strata span{display:inline-block;opacity:.38;margin-left:.9em;transition:opacity .4s;white-space:nowrap}
.blake .strata span.on{opacity:1}
.blake .strata span:first-child{margin-left:0}
.blake .palette{position:absolute;left:50%;top:60px;transform:translateX(-50%);display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:center;width:max-content;max-width:calc(100% - 24px);background:rgba(12,14,25,.82);border:1px solid rgba(214,171,82,.3);padding:8px 10px;opacity:0;pointer-events:none;transition:opacity .4s}
.blake .palette.on{opacity:1;pointer-events:auto}
.blake .palette .pl{font-family:var(--bl-mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin-right:2px}
.blake .palette button{font-family:var(--bl-mono);font-size:12px;letter-spacing:.06em;color:var(--bone);background:transparent;border:1px solid rgba(236,228,210,.35);padding:9px 12px 9px 10px;min-height:44px;cursor:pointer;display:inline-flex;align-items:center;gap:7px}
.blake .palette button i{width:12px;height:12px;border-radius:50%;display:inline-block}
.blake .palette button[aria-pressed="true"]{border-color:var(--gold);background:rgba(214,171,82,.16)}

@media (max-width:520px){ .blake .palette{top:56px;gap:6px;padding:6px} .blake .palette .pl{display:none} .blake .palette button{padding:8px 9px 8px 8px;font-size:11.5px} }
@media (min-width:900px) and (min-aspect-ratio:5/4){
  .blake .step,.blake .step.mid{justify-content:flex-end;align-items:center;padding:0 7vw 0 0}
  .blake .card{max-width:40ch}
  .blake .palette{left:35%}
}

.blake .end{padding:16vh 22px 12vh;max-width:760px;margin:0 auto}
.blake .end h2{font-family:var(--bl-display);font-weight:400;font-size:clamp(40px,9vw,76px);line-height:.98;margin:10vh 0 .45em;text-align:center}
.blake .end .lede{color:#cfc6b2;max-width:46ch;margin:0 auto 1em;text-align:center}
.blake hr.rule{border:0;height:1px;background:linear-gradient(90deg,transparent,rgba(214,171,82,.5),transparent);margin:0 auto;width:60%}
.blake .end h3{font-family:var(--bl-mono);font-weight:500;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin:11vh 0 1.4em}
.blake .objs{list-style:none;margin:0;padding:0;display:grid;gap:18px}
.blake .obj{border-top:1px solid rgba(236,228,210,.16);padding-top:14px;display:grid;gap:3px}
.blake .obj b{font-family:var(--bl-display);font-weight:600;font-size:22px;line-height:1.15}
.blake .obj span{font-size:15.5px;color:#cfc6b2}
.blake .obj .who{font-family:var(--bl-mono);font-size:11px;letter-spacing:.04em;color:var(--muted);line-height:1.7}
.blake .obj a{font-family:var(--bl-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;justify-self:start;margin-top:4px}
.blake .src{margin:0;padding-left:1.1em;font-size:15.5px;color:#cfc6b2;display:grid;gap:8px}
.blake .end .method-link{font-size:15.5px;color:#cfc6b2}
.blake .colophon{font-family:var(--bl-mono);font-size:11px;letter-spacing:.04em;color:var(--muted);margin-top:9vh;line-height:1.8}
.blake .colophon a{color:inherit;text-underline-offset:.3em}
.blake .colophon a:hover,.blake .colophon a:focus-visible{color:var(--bone)}
.blake .btn{display:inline-block;margin:3vh 10px 0 0;font-family:var(--bl-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);background:transparent;border:1px solid rgba(214,171,82,.45);padding:12px 16px;text-decoration:none;cursor:pointer}
.blake .chip{position:fixed;left:12px;bottom:12px;z-index:5;display:none;align-items:center;gap:10px;font-family:var(--bl-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#14121c;background:var(--gold);padding:8px 8px 8px 12px}
.blake .chip button{font:inherit;letter-spacing:inherit;text-transform:inherit;background:#14121c;color:var(--gold);border:0;padding:8px 10px;cursor:pointer}

/* exhibit mode: gallery screens. Larger type, no outbound links, slow self-running tour when idle. */
.exhibit .blake .chip{display:flex}
.exhibit .blake .card{font-size:clamp(21px,calc(14px + 1.1vmin),34px);max-width:34ch}
.exhibit .blake .card blockquote{font-size:34px}
.exhibit .blake .end a[href^="http"]{pointer-events:none;text-decoration:none;color:inherit}
.exhibit .blake .obj a{display:none}
.exhibit .blake .skip{display:none}

/* the shared foot takes the page's voice */
.blake .blake-sf{color:var(--bone);font-size:17px}

@media (prefers-reduced-motion:reduce){ .blake h1 .mirror{animation:none;transform:none} .blake .palette,.blake .strata span{transition:none} }

/* The share image: `npm run og:scrollies` centres [data-og-frame] (the last
   step of scene III: the backwards plate beside the forwards impression)
   and sets html.og; the canvas alone, centred (frameOf reads the class). */
html.og .blake .card,html.og .blake .hint,html.og .blake .tag,html.og .blake .chip{display:none}
