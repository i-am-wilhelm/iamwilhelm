    if (frag > 0) {
      const fh = Math.min(F.ah * 0.24, F.aw * 0.4), fw = fh * 5.87 / 8.1, fx = F.cx - fw / 2, fy = F.cy - fh / 2 - 10;
      ctx.save(); ctx.globalAlpha = frag; ctx.shadowColor = 'rgba(0,0,0,.6)'; ctx.shadowBlur = fw * 0.2; ctx.shadowOffsetY = fw * 0.06;
      ctx.beginPath(); ctx.moveTo(fx, fy + fh * 0.04); ctx.lineTo(fx + fw * 0.97, fy); ctx.lineTo(fx + fw, fy + fh * 0.93); ctx.lineTo(fx + fw * 0.06, fy + fh); ctx.closePath();
      const g = ctx.createLinearGradient(fx, fy, fx + fw, fy + fh); g.addColorStop(0, '#6b3d1c'); g.addColorStop(.45, '#d99a62'); g.addColorStop(1, '#5f3518'); ctx.fillStyle = g; ctx.fill(); ctx.shadowColor = 'transparent';
      ctx.clip(); ctx.strokeStyle = 'rgba(255,224,190,.75)'; ctx.lineWidth = Math.max(1, fw * 0.02); ctx.lineCap = 'round';
      for (let k = 0; k < 7; k++) { const ly = fy + fh * (0.14 + k * 0.115); ctx.beginPath(); ctx.moveTo(fx + fw * 0.1, ly); ctx.lineTo(fx + fw * (0.6 + 0.3 * frac(k * 0.37)), ly + fh * 0.008); ctx.stroke(); }
      ctx.restore();
      mono(ctx, 'ONE FRAGMENT SURVIVES', F.cx, fy + fh + 22, `rgba(236,228,210,${frag})`, 'center', 10.5);
      mono(ctx, '8.1 × 5.87 CM · NATIONAL GALLERY OF ART', F.cx, fy + fh + 40, `rgba(214,171,82,${frag})`, 'center', 9.5);
    }
  }
}

/* ---------- V · fourfold ---------- */
const s5 = document.querySelector('#s5 canvas'), strata = [...document.querySelectorAll('#strata span')];
const STARS = (() => { const R = rng(11), a = []; for (let i = 0; i < 150; i++) a.push([R(), R(), 0.5 + R() * 1.2, R() * TAU]); return a; })();
function renderS5(p, t) {
  const { ctx, w, h } = prep(s5), F = frameOf(w, h), T = reduce ? 0 : t;
  const sx = F.cx, sy = F.wide ? h * 0.42 : h * 0.31, R = Math.min(F.aw, h) * (F.wide ? 0.15 : 0.19), hz = sy + R * 1.5;
  const a2 = ease(p, .27, .34), a3 = ease(p, .45, .52), a4 = ease(p, .62, .70);
  const w1 = 1 - a2, w2 = a2 * (1 - a3), w3 = a3 * (1 - a4), w4 = a4;
  const cur = w4 > .5 ? 3 : w3 > .5 ? 2 : w2 > .5 ? 1 : 0; strata.forEach((el, i) => el.classList.toggle('on', i === cur));
  // 1 · graph paper
  ctx.fillStyle = '#f3efe4'; ctx.fillRect(0, 0, w, h);
  if (w1 > 0.01) {
    const U = R / 2; ctx.lineWidth = 1;
    for (let x = sx % U; x < w; x += U) { const major = Math.abs(Math.round((x - sx) / U)) % 2 === 0; ctx.strokeStyle = major ? 'rgba(42,39,64,.2)' : 'rgba(42,39,64,.07)'; ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke(); }
    for (let y = hz % U; y < h; y += U) { const major = Math.abs(Math.round((y - hz) / U)) % 2 === 0; ctx.strokeStyle = major ? 'rgba(42,39,64,.2)' : 'rgba(42,39,64,.07)'; ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke(); }
    ctx.strokeStyle = 'rgba(42,39,64,.6)'; ctx.lineWidth = 1.3; ctx.beginPath(); ctx.moveTo(0, hz); ctx.lineTo(w, hz); ctx.moveTo(sx, 0); ctx.lineTo(sx, h); ctx.stroke();
  }
  const sky = (c0, c1, c2, a, sea) => { if (a <= 0) return; ctx.globalAlpha = a; const g = ctx.createLinearGradient(0, 0, 0, hz); g.addColorStop(0, c0); g.addColorStop(.72, c1); g.addColorStop(1, c2); ctx.fillStyle = g; ctx.fillRect(0, 0, w, hz + 1); ctx.fillStyle = sea; ctx.fillRect(0, hz, w, h - hz); ctx.globalAlpha = 1; };
  sky('#241f3d', '#b9603f', '#f3c27a', a2, '#2c2540'); sky('#070b22', '#141c46', '#27306a', a3, '#080d28'); sky('#2a0a10', '#a3391a', '#f6c452', a4, '#4a160f');
  const shimmer = (col, a) => { if (a <= 0) return; ctx.strokeStyle = col; ctx.lineWidth = 1.6; ctx.lineCap = 'round'; for (let i = 0; i < 12; i++) { const yy = hz + 8 + i * (h - hz) / 14, ww = R * (0.9 - i * 0.05) * (0.8 + 0.2 * Math.sin(T * 0.002 + i * 1.3)); ctx.globalAlpha = a * (0.75 - i * 0.05); ctx.beginPath(); ctx.moveTo(sx - ww, yy); ctx.lineTo(sx + ww, yy); ctx.stroke(); } ctx.globalAlpha = 1; };
  // 1 · single vision: the disk, the dividers, the guinea
  if (w1 > 0.01) {
    ctx.globalAlpha = w1; const k = ease(p, .02, .13), dm = ease(p, .08, .17), open = ease(p, .10, .22), coin = ease(p, .16, .24);
    ctx.strokeStyle = '#2d70b3'; ctx.lineWidth = 2.4; ctx.beginPath(); ctx.arc(sx, sy, R, -Math.PI / 2, -Math.PI / 2 + TAU * k); ctx.stroke();
    ctx.fillStyle = `rgba(45,112,179,${0.07 * k})`; ctx.beginPath(); ctx.arc(sx, sy, R, 0, TAU); ctx.fill();
    ctx.strokeStyle = '#fa7e19'; ctx.lineWidth = 1.6; ctx.setLineDash([5, 4]); ctx.beginPath(); ctx.moveTo(sx - R * dm, sy); ctx.lineTo(sx + R * dm, sy); ctx.stroke(); ctx.setLineDash([]);
    if (open > 0) { // dividers spanning the diameter
      const px = sx, py = sy - R * 1.9; ctx.strokeStyle = '#2a2740'; ctx.lineWidth = Math.max(2, R * 0.035); ctx.lineCap = 'round';
      ctx.beginPath(); ctx.moveTo(px, py); ctx.lineTo(sx - R * open, sy); ctx.moveTo(px, py); ctx.lineTo(sx + R * open, sy); ctx.stroke();
      ctx.fillStyle = '#2a2740'; ctx.beginPath(); ctx.arc(px, py, R * 0.07, 0, TAU); ctx.fill();
      ctx.fillStyle = '#fff'; ctx.strokeStyle = '#fa7e19'; ctx.lineWidth = 2; for (const s of [-1, 1]) { ctx.beginPath(); ctx.arc(sx + s * R * open, sy, 4, 0, TAU); ctx.fill(); ctx.stroke(); }
    }
    const fsz = F.wide ? 12 : 10.5;
    if (k > .5) mono(ctx, 'x² + y² = r²', sx - R * 1.12, sy - R * 0.95, `rgba(42,39,64,${(k - .5) * 2})`, 'right', fsz);
    if (dm > .5) mono(ctx, 'd = 2r', sx, sy + 14, `rgba(42,39,64,${(dm - .5) * 2})`, 'center', fsz);
    if (coin > 0) {
      const cx = sx + R * 1.02, cy = sy + R * 1.02, cr = R * 0.3; ctx.globalAlpha = w1 * coin;
      const g = ctx.createRadialGradient(cx - cr * .3, cy - cr * .3, cr * .1, cx, cy, cr); g.addColorStop(0, '#f6e3a0'); g.addColorStop(.7, '#d2a440'); g.addColorStop(1, '#8f6a1e');
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(cx, cy, cr, 0, TAU); ctx.fill(); ctx.strokeStyle = 'rgba(110,80,20,.7)'; ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(cx, cy, cr * .82, 0, TAU); ctx.stroke();
      mono(ctx, '≈ A GUINEA', cx, cy + cr + 12, 'rgba(42,39,64,1)', 'center', fsz - 1);
    }
    ctx.globalAlpha = 1;
  }
  // 2 · twofold: the sun is also an eye
  if (w2 > 0.01) {
    ctx.globalAlpha = w2; const o = ease(p, .29, .42);
    let g = ctx.createRadialGradient(sx, sy, R * .4, sx, sy, R * 3.2); g.addColorStop(0, 'rgba(255,233,168,.6)'); g.addColorStop(1, 'rgba(255,233,168,0)'); ctx.fillStyle = g; ctx.fillRect(0, 0, w, hz);
    g = ctx.createRadialGradient(sx, sy, 0, sx, sy, R); g.addColorStop(0, '#fff3c0'); g.addColorStop(.6, '#f6b23c'); g.addColorStop(1, '#d8641e'); ctx.fillStyle = g; ctx.beginPath(); ctx.arc(sx, sy, R, 0, TAU); ctx.fill();
    ctx.strokeStyle = `rgba(120,40,10,${0.4 * o})`; ctx.lineWidth = 1.2; ctx.beginPath(); for (let i = 0; i < 36; i++) { const a = i / 36 * TAU; ctx.moveTo(sx + Math.cos(a) * R * .34, sy + Math.sin(a) * R * .34); ctx.lineTo(sx + Math.cos(a) * R * .92, sy + Math.sin(a) * R * .92); } ctx.stroke();
    ctx.fillStyle = '#2a0d08'; ctx.beginPath(); ctx.arc(sx, sy, R * .3 * o, 0, TAU); ctx.fill();
    ctx.fillStyle = 'rgba(255,250,230,.9)'; ctx.beginPath(); ctx.arc(sx - R * .12, sy - R * .12, R * .07 * o, 0, TAU); ctx.fill();
    ctx.strokeStyle = '#1e1426'; ctx.lineWidth = Math.max(2.5, R * 0.04); ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(sx - R * 2.3, sy); ctx.quadraticCurveTo(sx, sy - R * 2.5 * o, sx + R * 2.3, sy); ctx.moveTo(sx - R * 2.3, sy); ctx.quadraticCurveTo(sx, sy + R * 2.3 * o, sx + R * 2.3, sy); ctx.stroke();
