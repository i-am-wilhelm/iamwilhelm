  }
}

/* ---------- title word, exhibit mode, loop ---------- */
const mirrorEl = document.getElementById('mirror');
document.getElementById('title').addEventListener('click', () => mirrorEl.classList.toggle('again'));

const root = document.documentElement, exBtn = document.getElementById('exhibitBtn');
let exhibit = false, lastInput = 0, lastT = 0, endHold = 0;
function setExhibit(on) {
  exhibit = on; root.classList.toggle('exhibit', on); exBtn.setAttribute('aria-pressed', String(on)); lastInput = performance.now();
  try { if (on) location.hash = 'exhibit'; else if (location.hash === '#exhibit') history.replaceState(null, '', location.pathname + location.search); } catch (e) {}
  if (on) window.scrollTo(0, 0);
}
exBtn.addEventListener('click', () => setExhibit(!exhibit));
document.getElementById('exitExhibit').addEventListener('click', () => setExhibit(false));
for (const ev of ['pointerdown', 'wheel', 'keydown', 'touchstart']) addEventListener(ev, () => { lastInput = performance.now(); }, { passive: true });
if (location.hash === '#exhibit') setExhibit(true);

const scenes = [
  { el: document.getElementById('s1'), render: renderS1 }, { el: document.getElementById('s2'), render: renderS2 },
  { el: document.getElementById('s3'), render: renderS3 }, { el: document.getElementById('s4'), render: renderS4 },
  { el: document.getElementById('s5'), render: renderS5 },
];
const hero = document.getElementById('hero');
function frame(t) {
  const vh = window.innerHeight, dt = Math.min(64, t - lastT); lastT = t;
  // exhibit mode: after 20 s without a touch, tour the page slowly; at the end, rest, then start over
  if (exhibit && !reduce && t - lastInput > 20000) {
    const max = document.documentElement.scrollHeight - vh;
    if (window.scrollY >= max - 2) { endHold += dt; if (endHold > 9000) { endHold = 0; window.scrollTo(0, 0); } }
    else window.scrollBy(0, Math.max(1, dt * 0.07));
  }
  const hr = hero.getBoundingClientRect();
  if (hr.bottom > 0) renderHero(t, 1 - ramp(-hr.top, 0, vh * 0.9));
  for (const s of scenes) {
    const r = s.el.getBoundingClientRect();
    if (r.bottom < -2 || r.top > vh + 2) continue;
    s.render(clamp(-r.top / Math.max(1, r.height - vh), 0, 1), t);
  }
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);
})();
</script>
