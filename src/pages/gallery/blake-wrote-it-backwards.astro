  }
  // 3 · threefold: Beulah
  if (w3 > 0.01) {
    for (const s of STARS) { ctx.globalAlpha = w3 * (0.5 + 0.5 * Math.sin(T * 0.002 * s[2] + s[3])); ctx.fillStyle = '#e9ecff'; ctx.beginPath(); ctx.arc(s[0] * w, s[1] * hz * 0.96, s[2] * 0.9, 0, TAU); ctx.fill(); }
    ctx.globalAlpha = w3;
    const g = ctx.createRadialGradient(sx, sy, R * .5, sx, sy, R * 2.8); g.addColorStop(0, 'rgba(190,204,255,.38)'); g.addColorStop(1, 'rgba(190,204,255,0)'); ctx.fillStyle = g; ctx.fillRect(0, 0, w, hz);
    ctx.fillStyle = '#eef0fb'; ctx.beginPath(); ctx.arc(sx, sy, R * .8, 0, TAU); ctx.fill();
    ctx.fillStyle = '#10173c'; ctx.beginPath(); ctx.arc(sx + R * .34, sy - R * .1, R * .74, 0, TAU); ctx.fill();
    ctx.globalAlpha = 1; shimmer('rgba(214,222,255,1)', w3 * .6);
  }
  // 4 · fourfold: an innumerable company
  if (w4 > 0.01) {
    const f = ease(p, .64, .9); ctx.globalAlpha = w4;
    const g = ctx.createRadialGradient(sx, sy, 0, sx, sy, R * (2.2 + 2 * f)); g.addColorStop(0, 'rgba(255,246,207,.95)'); g.addColorStop(.35, 'rgba(255,176,74,.45)'); g.addColorStop(1, 'rgba(255,176,74,0)'); ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    const N = 1300, shown = Math.floor(N * f), c = R * 3.4 / Math.sqrt(N), cols = ['#fffbe6', '#ffe19a', '#ffab58'], k = R / 90;
    for (let b = 0; b < 3; b++) {
      const lo = Math.floor(N * b / 3), hi = Math.min(shown, Math.floor(N * (b + 1) / 3)); if (hi <= lo) break;
      const body = new Path2D(), heads = new Path2D();
      for (let n = lo; n < hi; n++) {
        const th = n * 2.39996323 + T * 0.00003, r = c * Math.sqrt(n) + R * 0.1, s = (2.4 + 3.4 * n / N) * k * (1 + 0.18 * Math.sin(T * 0.004 + n * 1.7));
        const ux = Math.cos(th), uy = Math.sin(th), x0 = sx + ux * r, y0 = sy + uy * r, x1 = x0 + ux * s * 2.2, y1 = y0 + uy * s * 2.2, mx = x0 + ux * s * 1.35, my = y0 + uy * s * 1.35;
        const ca = Math.cos(0.95), sa = Math.sin(0.95), L = s * 1.15;
        body.moveTo(x0, y0); body.lineTo(x1, y1);
        body.moveTo(mx, my); body.lineTo(mx + (ux * ca - uy * sa) * L, my + (uy * ca + ux * sa) * L);
        body.moveTo(mx, my); body.lineTo(mx + (ux * ca + uy * sa) * L, my + (uy * ca - ux * sa) * L);
        const hx = x1 + ux * s * 0.5, hy = y1 + uy * s * 0.5; heads.moveTo(hx + s * 0.45, hy); heads.arc(hx, hy, s * 0.45, 0, TAU);
      }
      ctx.strokeStyle = cols[b]; ctx.fillStyle = cols[b]; ctx.lineWidth = Math.max(1, k * 1.15); ctx.lineCap = 'round'; ctx.stroke(body); ctx.fill(heads);
