    ctx.save(); ctx.globalAlpha = solo; drawImpression(ctx, F.cx, F.cy, B.PW * 1.3, B.PH * 1.14, { PW: B.PW, PH: B.PH, wash: WAYS[way], wp: p < .3 ? ramp(p, .02, .25) : 1, T }); ctx.restore();
  }
  if (grid > 0.01) {
    const cols = F.wide ? 4 : 2, rows = F.wide ? 1 : 2, gx = F.aw * 0.035, gy = F.ah * 0.07;
    const cw = Math.min((F.aw - gx * (cols - 1)) / cols / 1.26, (F.ah - gy * rows) / rows / 1.14 * AR), ch = cw / AR;
    const totW = cols * cw * 1.26 + gx * (cols - 1), totH = rows * (ch * 1.14 + gy);
    Object.keys(WAYS).forEach((k, i) => {
      const c = i % cols, r = Math.floor(i / cols), cx = F.cx - totW / 2 + cw * 0.63 + c * (cw * 1.26 + gx), cy = F.cy - totH / 2 + ch * 0.57 + r * (ch * 1.14 + gy);
      ctx.save(); ctx.globalAlpha = grid; drawImpression(ctx, cx, cy, cw * 1.26, ch * 1.14, { PW: cw, PH: ch, wash: WAYS[k], wp: 1, T });
      mono(ctx, WAYS[k].name.toUpperCase(), cx, cy + ch * 0.57 + 12, 'rgba(214,171,82,1)', 'center', 9.5); ctx.restore();
    });
  }
  if (end > 0) { // fifty-four plates, then one fragment
    const melt = ramp(p, .89, .96), frag = ease(p, .93, .99), cols = 9, rows = 6, cell = Math.min(F.aw / cols, F.ah * 0.8 / rows / 1.5), pw = cell * 0.72, ph = pw / AR;
    for (let i = 0; i < 54; i++) {
      const a = end * (1 - clamp((melt - ORDER[i] * 0.85) / 0.15, 0, 1)); if (a <= 0) continue;
      const c = i % cols, r = Math.floor(i / cols), px = F.cx + (c - (cols - 1) / 2) * cell - pw / 2, py = F.cy + (r - (rows - 1) / 2) * cell * 1.5 - ph / 2 + (1 - a / end) * 14;
      ctx.globalAlpha = a; const g = ctx.createLinearGradient(px, py, px + pw, py + ph); g.addColorStop(0, '#7a4521'); g.addColorStop(.5, '#e0a36b'); g.addColorStop(1, '#70401f'); ctx.fillStyle = g; ctx.fillRect(px, py, pw, ph);
    }
