---
/**
 * /gallery: The Gallery on its own. The same framed tiles as the homepage's
 * Room II, hung by series (each wall headed by its series, linking to the
 * series index); new pieces drop in from src/content/gallery. The Futurist
 * essays hang last, as a pair of companion pieces under their own line.
 */
import Museum from '../../layouts/Museum.astro';
import Placard from '../../components/museum/Placard.astro';
import PoemGallery from '../../components/museum/PoemGallery.astro';
import Meander from '../../components/museum/Meander.astro';
import Colophon from '../../components/museum/Colophon.astro';
import { SITE_URL } from '../../config/site';
---

<Museum
  title="The Gallery · Michael Wilhelm"
  description="Visualized poems and essays by Michael Wilhelm, each framed and opening onto its own interactive page: Everyone, Searchable and Everyone, Serialized, the companion Futurist essays; Where It Was, the third Through the Lens essay; The Keeper and the Flame, PHARMAKON, Equal Volume, True Amazons, Mimics & Mythmakers, the in-the-original essays The Only Sighted One, The Dual Thing, and The Pretty Toy; and the Seeing essays The Double Image, Varo's Workshop, and Monet Invented the Dither."
  current="gallery"
  schema={[
    {
      '@type': 'CollectionPage',
      '@id': `${SITE_URL}/gallery/#page`,
      url: `${SITE_URL}/gallery/`,
      name: 'The Gallery',
      author: { '@id': `${SITE_URL}/#person` },
    },
  ]}
>
  <section class="page" aria-labelledby="gallery-page-title" style="--room-accent: var(--room-iv)">
    <div class="page__inner wrap">
      <div class="page__head">
        <Placard
          id="gallery-page-title"
          level={1}
          label="Room II"
          title="The Gallery"
          medium="Poems and essays written to be read slowly, each set on its own interactive page"
          catalog="Cat. II"
        />
        <div class="page__statement prose-museum" data-reveal>
          <p class="lede">
            Each piece here is staged as a page you walk through. Movements arrive one at a time and the text settles
            into place as you read.
          </p>
          <p>The wall is hung by series. Choose a frame to enter; new work is hung here as it is finished.</p>
        </div>
      </div>
      <PoemGallery
        level={2}
        grouped
        pair={{
          series: 'futurist',
          statement:
            'Companion essays on being known by machines. The first follows a search for your name, the second your body as it becomes a number, and both end with the people who know you.',
        }}
      />
      <p class="page__more" data-reveal>
        Pieces like these are built to order. <a class="text-link" href="/services/">Commissions &rarr;</a>
      </p>
      <p class="page__more page__more--glossary" data-reveal>
        New to the form? <a class="text-link" href="/what-is-a-scrolly/">What is a scrolly? &rarr;</a>
      </p>
    </div>
  </section>
  <Meander />
  <Colophon />
</Museum>

<style>
  .page {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem);
  }
  .page__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .page__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .page__statement {
    padding-top: 0.5rem;
    color: var(--ink-soft);
  }
  .page__statement .lede {
    color: var(--ink);
  }
  .page__more {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }
  .page__more + .page__more--glossary {
    margin-top: calc(-1 * clamp(2.5rem, 2rem + 3vw, 4.5rem) + 0.6rem);
  }
  @media (max-width: 820px) {
    .page__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
