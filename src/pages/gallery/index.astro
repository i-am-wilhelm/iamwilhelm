---
/**
 * /gallery: The Gallery on its own. Every piece on view as a small tile
 * (GalleryGrid): a preview shot from the piece's own pictures, with a short
 * loop that plays when the reader looks closer, hung by series (each wall
 * headed by its series, linking to the series index), four or five across
 * on a wide screen and two on a phone. A row of links at the head jumps to
 * each wall. New pieces drop in from src/content/gallery; their previews
 * come from `npm run reel -- <slug>`. The Futurist wall hangs first.
 */
import Museum from '../../layouts/Museum.astro';
import Placard from '../../components/museum/Placard.astro';
import GalleryGrid from '../../components/museum/GalleryGrid.astro';
import Meander from '../../components/museum/Meander.astro';
import Colophon from '../../components/museum/Colophon.astro';
import { SITE_URL } from '../../config/site';
import { trail } from '../../lib/crumbs';
---

<Museum
  title="The Gallery · Michael Wilhelm"
  description="Visualized poems and essays by Michael Wilhelm, each framed and opening onto its own interactive page: the Futurist installments Everyone, Searchable, Everyone, Serialized, Face Forward, The Receipts, Depth Chart, and Quantum Banking; Where It Was, the third Through the Lens essay; The Keeper and the Flame, PHARMAKON, Equal Volume, The Unseen One Pleads His Case, and Ladies, Ladies, the interlude between the poems; True Amazons, the Mythmaking essays Mimics & Mythmakers, Questions Wearing Teeth and The So-Called Count, the in-the-original essays The Only Sighted One, The Dual Thing, The Pretty Toy, and Before and Behind; the Seen essays The Double Image, Varo's Workshop, Monet Invented the Dither, Panofsky for Internet People, Root Rectangles in Desmos, The Paranoiac-Critical Method, Applied, Blake Wrote It Backwards, Nobody Sees the Same Sea, Type Is an Image, The Sleep of Reason, Why Klimt Went to Ravenna, Redon's Turn, How to Throw a Flame Twenty Miles, Living Vanitas, The Mask Is the Method, Fall Line, Off Soundings, and The Label Comes Last; The Snowflake Machine, a hands-on symmetry toy; Due Space, an essay on the honeybee Arizona never had and the one it got; Nine Hundred Lights, an endorsement of the Libertarian Leadership Academy; Per My Last Memo, a memo from Regional on the five laws of human stupidity, with graphs; Those Who Heard the Sky, a scrolly for the ears in six movements; BackGold Scrolly, a walk through the platform; and LLA Scrolly Homepage, a homepage design for the Libertarian Leadership Academy."
  current="gallery"
  crumbs={trail('Gallery')}
  schema={[
    {
      '@type': 'CollectionPage',
      '@id': `${SITE_URL}/gallery/#page`,
      url: `${SITE_URL}/gallery/`,
      name: 'The Gallery',
      author: { '@id': `${SITE_URL}/#person` },
    },
  ]}
>
  <section class="page" aria-labelledby="gallery-page-title" style="--room-accent: var(--room-iv)">
    <div class="page__inner wrap">
      <div class="page__head">
        <Placard
          id="gallery-page-title"
          level={1}
          label="Room II"
          title="The Gallery"
          medium="Poems and essays written to be read slowly, each set on its own interactive page"
          catalog="Cat. II"
        />
        <div class="page__statement prose-museum" data-reveal>
          <p class="lede">
            Each piece here is staged as a page you walk through. Movements arrive one at a time and the text settles
            into place as you read.
          </p>
          <p>The wall is hung by series. Rest on a piece, or scroll to it on a phone, to see it move; choose it to enter. New work is hung here as it is finished.</p>
        </div>
      </div>
      <GalleryGrid level={2} feature="futurist" />
      <p class="page__more" data-reveal>
        Pieces like these are built to order. <a class="text-link" href="/services/">Commissions &rarr;</a>
      </p>
      <p class="page__more page__more--glossary" data-reveal>
        New to the form? <a class="text-link" href="/what-is-a-scrolly/">What is a scrolly? &rarr;</a>
      </p>
    </div>
  </section>
  <Meander />
  <Colophon />
</Museum>

<style>
  .page {
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 5rem);
  }
  .page__inner {
    display: grid;
    gap: clamp(1.75rem, 1.25rem + 2vw, 3rem);
  }
  .page__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .page__statement {
    padding-top: 0.5rem;
    color: var(--ink-soft);
  }
  .page__statement .lede {
    color: var(--ink);
  }
  .page__more {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }
  .page__more + .page__more--glossary {
    margin-top: calc(-1 * clamp(1.75rem, 1.25rem + 2vw, 3rem) + 0.6rem);
  }
  @media (max-width: 820px) {
    .page__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
