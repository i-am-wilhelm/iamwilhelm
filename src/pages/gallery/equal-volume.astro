requestAnimationFrame(frame);
if (document.fonts) document.fonts.ready.then(() => { lastSig = ''; });

/* ---------- scroll: mood ---------- */
const secs = [...document.querySelectorAll('section')];
function onScroll() {
  const y = scrollY + H * .55;
  const r = secs.map(s => { const b = s.getBoundingClientRect(); return {top: b.top + scrollY, h: b.height}; });
  let m = 0;
  if (y >= r[2].top) m = 1 + Math.min(1, (y - r[2].top) / (r[2].h * .35));
  else if (y >= r[1].top) m = Math.min(1, (y - r[1].top) / (r[1].h * .25));
  else m = 0;
  S.mood = m;
}
addEventListener('scroll', onScroll, {passive: true}); onScroll();

/* ---------- lines: placement, reflection, reveal ---------- */
const lines = [...document.querySelectorAll('.ln')];
lines.forEach((el, i) => {
  el.style.marginLeft = ((i * 37) % 23) + '%';
  if (el.closest('#sec1')) {
    const t = el.innerHTML; el.innerHTML = `<span class="t">${t}</span><span class="rx" aria-hidden="true">${t}</span>`;
  }
  if (!RM) el.classList.add('wait');
});
const fired = new Set();
const io = new IntersectionObserver(es => es.forEach(e => {
  if (!e.isIntersecting) return;
  e.target.classList.remove('wait');
  const fx = e.target.dataset.fx;
  if (fx && !fired.has(e.target)) { fired.add(e.target); trigger(fx); }
}), {rootMargin: '0px 0px -18% 0px', threshold: .2});
lines.forEach(l => io.observe(l));

let tappable = false, coats = 0, windows = 0;
function trigger(fx) {
  switch (fx) {
    case 'drain': S.levelT = Math.max(.08, S.levelT - .31); break;
    case 'crack': S.cracks = Math.min(6, S.cracks + 1); break;
    case 'mirrors': break;
    case 'shatter': S.scatterT = 1; S.levelT = 0; S.vyT = .82; S.aT = .35; break;
    case 'lantern': lantern.classList.add('on'); S.xT = .1; S.yT = .92; S.hT = 40; S.aT = .5; break;
    case 'tappable': tappable = true; break;
    case 'coats': S.panels.forEach((p, i) => { if (p.state === 'figure') setTimeout(() => handBack(p), 300 * i); }); break;
    case 'floor':
      S.floorT = 1; S.thud = RM ? 0 : 1;
      try { navigator.vibrate && navigator.vibrate(40); } catch (e) {}
      lantern.style.setProperty('--lr', Math.max(W, H) * 1.3 + 'px');
      S.panels.forEach(p => { if (p.state === 'figure') handBack(p); });
      break;
    case 'littleone': S.xT = .18; S.yT = .92; S.hT = 54; S.aT = .9; break;
    case 'rebuild': lantern.classList.remove('on'); S.scatterT = 0; S.vyT = .78; S.vsT = 1.05; S.floorT = 0; S.goldT = .35; S.xT = .22; S.yT = .93; S.hT = 56; S.aT = .9; S.panels.forEach(p => { p.state = 'empty'; p.offT = 1; p.sT = 0; }); break;
    case 'hold': openHold(); break;
    case 'black': if (!RM) blackout(); break;
    case 'window': { const p = S.panels[windows++ % 6]; p.state = 'sky'; p.skyT = 1; p.offT = 0; break; }
    case 'elder': S.elT = {x: .8, y: .93, h: 84, a: .85}; S.xT = .24; break;
    case 'sit': S.hT = 36; S.yT = .94; S.xT = .27; S.elT = {x: .73, y: .94, h: 48, a: .85}; S.panels.forEach(p => { p.state = 'sky'; p.skyT = 1; p.offT = 0; }); break;
