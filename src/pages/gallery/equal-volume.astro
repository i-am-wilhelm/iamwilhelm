function handBack(p) { p.state = 'empty'; p.offT = 1; setTimeout(() => { p.sT = 0; }, 700); }

/* ---------- pointer: lantern + mirrors ---------- */
function movePointer(e) {
  const x = e.clientX, y = e.clientY;
  lantern.style.setProperty('--lx', x + 'px'); lantern.style.setProperty('--ly', y + 'px');
}
addEventListener('pointermove', movePointer, {passive: true});
addEventListener('pointerdown', e => {
  movePointer(e);
  if (!tappable || S.mood < .5 || S.mood > 1.5) return;
  const rects = panelRects();
  rects.forEach((r, i) => {
    if (e.clientX >= r.x - 10 && e.clientX <= r.x + r.w + 10 && e.clientY >= r.y && e.clientY <= r.y + r.h) {
      const p = S.panels[i];
      if (p.state === 'glass') { p.state = 'figure'; p.sT = 1; }
      else if (p.state === 'figure') handBack(p);
    }
  });
}, {passive: true});
if (RM) lantern.style.display = 'none';

/* ---------- the black beat ---------- */
function blackout() {
  black.classList.add('on');
  setTimeout(() => black.classList.remove('on'), 2600);
}

/* ---------- press and hold ---------- */
let holding = false, holdOpen = false, heldOnce = false, holdStart = 0;
function openHold() {
  holdOpen = true; holdEl.classList.add('on'); document.body.classList.add('locked');
  S.levelT = Math.max(S.levelT, .04); S.goldT = 1;
  setTimeout(() => skip.classList.add('show'), 7000);
  updateRing();
}
function closeHold() {
  holdOpen = false; holdEl.classList.remove('on'); document.body.classList.remove('locked');
  const pct = Math.round(S.levelT * 100);
  document.getElementById('levelNote').textContent = `vessel rebuilt to ${pct}% of its volume`;
}
function updateRing() {
  ring.style.setProperty('--lv', S.levelT.toFixed(3));
  if (holding && !pairOk()) holdMsg.textContent = 'waiting for the other hand';
  else if (holding) holdMsg.textContent = 'it fills as long as you stay';
  else holdMsg.textContent = paired() ? 'press and hold, both of you' : 'press and hold anywhere, as long as you are willing';
}
function down(e) {
