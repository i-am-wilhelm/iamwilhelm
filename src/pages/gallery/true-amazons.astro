      b.classList.add('used');b.classList.remove('next');idx++;
      liq.setAttribute('y',125-idx*25);liq.setAttribute('height',idx*25);liq.setAttribute('fill',cols[k]);
      out.textContent=says[k];
      if(btns[idx])btns[idx].classList.add('next');
      if(idx===3){bury.disabled=false;}
    })});
    bury.addEventListener('click',function(){
      bury.disabled=true;var d=0;
      var t=setInterval(function(){d++;days.textContent='day '+d;
        if(d===3)out.textContent='The watery part rises on the blood.';
        if(d>=7){clearInterval(t);liq.setAttribute('fill','#4ea88a');out.innerHTML='<span class="g">σκυθικόν.</span> Draw off the serum, mix it with the juice of the snake, smear the arrows. Ovid: a double death on every barb.';setBlade('venom');}
      },reduce?10:380);
    });
    /* interlinear */
    var gl=$('#glossline');
    $$('#inter .w').forEach(function(w){
      function on(){$$('#inter .w').forEach(function(x){x.classList.remove('on')});w.classList.add('on');gl.innerHTML='<b>'+w.dataset.g.split(' · ')[0]+'</b> · '+w.dataset.g.split(' · ').slice(1).join(' · ');}
      w.addEventListener('mouseenter',on);w.addEventListener('click',on);w.setAttribute('tabindex','0');w.addEventListener('focus',on);
    });
  })();

  /* ---------- V bow ---------- */
  (function(){
    var btn=$('#draw'),fill=$('#bowfill'),band=$('#band'),str=$('#bowstring'),arr=$('#bowarrow'),out=$('#bowout'),sons=$$('#sons span');
    var lo=68,hi=84,son=0,hold=false,val=0,raf;
    band.style.left=lo+'%';band.style.width=(hi-lo)+'%';
    function render(){fill.style.width=val+'%';var pull=300-val*2.1;str.setAttribute('d','M60 60 L'+pull+' 60 L540 60');arr.setAttribute('transform','translate('+(-(300-pull))+',0)');}
    function loop(){if(!hold)return;val=Math.min(100,val+1.1);render();if(val>=100){release();return;}raf=requestAnimationFrame(loop);}
    function start(e){if(son>2)return;e.preventDefault();hold=true;val=0;loop();}
    function release(){
      if(!hold)return;hold=false;cancelAnimationFrame(raf);
      var ok=val>=lo&&val<=hi,name=sons[son].textContent;
      if(ok){sons[son].classList.add('king');out.innerHTML='<span class="g">'+name+' strings the bow and buckles the belt.</span> He stays, and the Scythians descend from him.'+(son<2?' The myth gives it to the youngest; you gave it to '+name+'.':'');
        sons.forEach(function(s,i){if(i!==son)s.classList.add('gone')});son=3;}
      else{sons[son].classList.add('gone');out.innerHTML=name+(val<lo?' could not bend it far enough.':' snapped the string.')+' His mother sends him out of the country.';son++;
        if(son===3){out.innerHTML+=' <span class="p">No king. In Herodotus, Scythes manages it.</span>';}}
      setTimeout(function(){val=0;render();},reduce?0:600);
      if(son>2){btn.textContent='The test is over · reset';btn.classList.add('ghost');}
    }
    btn.addEventListener('pointerdown',function(e){if(son>2){son=0;sons.forEach(function(s){s.className=''});out.textContent='Three sons. One bow. Each gets one pull.';btn.textContent='Hold to draw · release in the green';btn.classList.remove('ghost');return;}start(e)});
    addEventListener('pointerup',release);addEventListener('pointercancel',release);
    btn.addEventListener('keydown',function(e){if((e.key===' '||e.key==='Enter')&&!hold){e.preventDefault();start(e)}});
    btn.addEventListener('keyup',function(e){if(e.key===' '||e.key==='Enter')release()});
    render();
  })();

  /* ---------- VI fire ---------- */
  (function(){
    var hearth=$('#hearth'),mort=$('#mort'),day=$('#dayb'),night=$('#nightb'),look=$('#lookb'),reset=$('#firereset'),out=$('#fireout');
    var m=100,nights=0,done=false;
    var nl=['First night. She hides him in the heart of the fire like a brand. He does not cry.','Second night. He grows like a daimon, eating no grain, taking no breast.','Third night. His parents marvel at how he thrives and do not ask why.','Fourth night. The mortal part is nearly gone. One more.','Fifth night. No mortal in the surviving sources ever got this far.'];
    function setM(x){m=Math.max(0,x);mort.style.width=m+'%';}
    day.addEventListener('click',function(){if(done)return;hearth.classList.add('day');hearth.classList.remove('night');night.disabled=false;day.disabled=true;out.textContent='Anointed with ambrosia, as though born of the goddess. Breathe on him. Wait for dark.';});
    night.addEventListener('click',function(){if(done)return;hearth.classList.add('night');hearth.classList.remove('day');nights++;setM(m-20);night.disabled=true;day.disabled=false;out.textContent=nl[nights-1];
      if(m<=0){done=true;out.innerHTML='<span class="g">ἄμβροτος.</span> Mortality burned off entirely. The hymn never lets this happen; Metaneira always looks. You kept her out of the room.';day.disabled=true;night.disabled=true;}});
    look.addEventListener('click',function(){if(done)return;done=true;hearth.classList.remove('night');hearth.classList.remove('day');day.disabled=true;night.disabled=true;
      out.innerHTML='<span class="p">She screams.</span> Demeter sets the child on the floor and turns on her: "Witless mortals, who cannot tell good fortune from bad." Demophoon keeps <b>'+m+'%</b> of his mortality and dies an ordinary death. Eleusis gets its Mysteries as the consolation prize.';});
    reset.addEventListener('click',function(){m=100;nights=0;done=false;setM(100);hearth.setAttribute('class','hearth day');day.disabled=false;night.disabled=true;out.textContent='Night one has not come yet.';});
  })();

  /* ---------- VII vials ---------- */
  (function(){
    var p=$('#patient'),out=$('#vialout'),L=$('#vialL'),R=$('#vialR'),used=false;
    L.addEventListener('click',function(){if(used)return;used=true;p.classList.add('stone');out.innerHTML='<span class="p">Stone.</span> Left vein: the bane of mankind. He stiffens where he lies. In Hillman\'s reading this is the stasis, the held threshold; in Apollodorus it is simply death.';});
    R.addEventListener('click',function(){if(used)return;used=true;p.classList.add('risen');out.innerHTML='<span class="g">He rises.</span> Right vein: salvation. Asclepius raised Hippolytus, Glaucus, Tyndareus this way, and Zeus killed him for it. The physician was punished for the antidote, never for the poison.';});
    $('#vialreset').addEventListener('click',function(){used=false;p.classList.remove('stone','risen');out.textContent='A patient on the table. Which side of the Gorgon do you give?';});
  })();

  /* ---------- VIII hair ---------- */
  (function(){
    var r=$('#hair'),s1=$('#hs1'),s2=$('#hs2'),serp=$('#serp'),out=$('#hairout');
    function mix(a,b,t){var pa=a.match(/\w\w/g).map(function(x){return parseInt(x,16)}),pb=b.match(/\w\w/g).map(function(x){return parseInt(x,16)});return 'rgb('+pa.map(function(v,i){return Math.round(v+(pb[i]-v)*t)}).join(',')+')';}
    function upd(){
      var v=+r.value,t=v/100;
      s1.setAttribute('stop-color',mix('1c1f16','6b1f4a',t));s2.setAttribute('stop-color',mix('2f7a66','c98aa8',t*.8));
      serp.setAttribute('opacity',v<36?1:Math.max(0,1-(v-36)/20));
      if(v<36)out.innerHTML='<span class="g">text.</span> Serpents for hair (Apollodorus), speckled skin (Hesiod), shafts painted like adders. Everything here has a citation.';
      else if(v<68)out.innerHTML='<span style="color:var(--bronze-hi)">reading.</span> The stain of the work: putrefied viper, blood serum, bronze oxide. No text says it; no text forbids it. Imagery, voiced as imagery.';
      else out.innerHTML='<span class="p">disputed.</span> ἰός heard as ἴον, the violet. Hillman\'s bridge: one sound, one colour, the burning purple pharmakon. Voice it as his reading.';
    }
    r.addEventListener('input',upd);upd();
  })();

  /* ---------- IX thesis ---------- */
  (function(){
    var t1=$('#t1'),t2=$('#t2'),t3=$('#t3'),th=$('#thesis'),out=$('#thesisout'),copy=$('#copythesis');
    function upd(){
      $('.thesis .t').classList.toggle('off',!t1.checked);$('.thesis .r').classList.toggle('off',!t2.checked);$('.thesis .d').classList.toggle('off',!t3.checked);
      var n=[t1,t2,t3].filter(function(x){return x.checked}).length;
      if(!t1.checked&&n)out.innerHTML='<span class="p">No ground.</span> Switch the texts back on. Hillman\'s readings stand strongest on their sources.';
      else if(n===0)out.innerHTML='Nothing to assert. Switch a tier on.';
      else if(n===1)out.innerHTML='<span class="g">Text only.</span> Unassailable, and a little dull. This is the version for the hostile reviewer.';
      else if(n===2&&!t3.checked)out.innerHTML='<span class="g">Two tiers on.</span> This version a classicist can argue with but cannot laugh at.';
      else out.innerHTML='<span class="p">All three.</span> The full Lady Babylon. Credit the purple to Hillman by name and let it ride.';
    }
    [t1,t2,t3].forEach(function(x){x.addEventListener('change',upd)});upd();
    copy.addEventListener('click',function(){
      var txt=$$('.thesis span').filter(function(s){return !s.classList.contains('off')}).map(function(s){return s.textContent.trim()}).join(' ');
      try{navigator.clipboard.writeText(txt).then(function(){copy.textContent='Copied';setTimeout(function(){copy.textContent='Copy this thesis'},1500)},function(){copy.textContent='Select and copy by hand'});}catch(e){copy.textContent='Select and copy by hand';}
    });
  })();

  /* ---------- ledger filter ---------- */
  $$('.filter button').forEach(function(b){b.addEventListener('click',function(){
    $$('.filter button').forEach(function(x){x.classList.remove('on')});b.classList.add('on');
    var f=b.dataset.f;$$('#ltable tbody tr').forEach(function(tr){tr.classList.toggle('hide',f!=='all'&&tr.dataset.t!==f)});
  })});
})();
</script>
