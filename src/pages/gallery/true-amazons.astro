  addEventListener('scroll',onScroll,{passive:true});onScroll();

  /* ---------- hero triad ---------- */
  var tl=$('#triadline');
  $$('.triad button').forEach(function(b){b.addEventListener('click',function(){
    $$('.triad button').forEach(function(x){x.classList.remove('on')});b.classList.add('on');
    tl.innerHTML=b.dataset.line;setBlade(b.dataset.state);
    if(b.dataset.state==='rust')stain.setAttribute('y',0);else if(b.dataset.state==='venom')stain.setAttribute('y',260);else stain.setAttribute('y',390);
  })});

  /* ---------- II kills ---------- */
  (function(){
    var kills=0,enemies=$$('.enemy'),fly=$('#arrowfly'),out=$('#killout'),tally=$$('#tally i');
    var lines=['<b>1 / 3</b> · one man of the enemy. Herodotus would let her marry now. Hippocrates would not.','<b>2 / 3</b> · the second. Some grow old and die unmarried, Herodotus says, because they cannot fulfil the law.','<b>3 / 3</b> · <span class="g">τὰ ἱερὰ θύσει</span>. She may perform the lawful rites, take a husband, and set down the bow. She will not ride again unless the whole people is called up.'];
    function loose(e){
      if(e.classList.contains('down'))return;
      var tx=parseFloat(e.getAttribute('transform').match(/translate\(([\d.]+)/)[1]);
      fly.style.opacity=1;fly.style.transition='none';fly.style.transform='translate(70px,58px)';
      requestAnimationFrame(function(){requestAnimationFrame(function(){fly.style.transition='';fly.style.transform='translate('+(tx-40)+'px,100px)';});});
      setTimeout(function(){fly.style.opacity=0;e.classList.add('down');kills++;tally[kills-1].classList.add('k');out.innerHTML=lines[kills-1];},reduce?0:330);
    }
    enemies.forEach(function(e){e.addEventListener('click',function(){loose(e)});e.addEventListener('keydown',function(ev){if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();loose(e)}})});
