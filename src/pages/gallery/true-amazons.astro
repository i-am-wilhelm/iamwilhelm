    size();addEventListener('resize',size);
    for(var i=0;i<70;i++)pts.push({x:Math.random()*2000,y:Math.random()*2000,r:Math.random()*1.6+.4,v:Math.random()*.25+.08,a:Math.random()*Math.PI*2,g:Math.random()<.5});
