  })();

  /* ---------- III guess ---------- */
  (function(){
    var r=$('#guess'),v=$('#guessval'),btn=$('#guessbtn'),bars=$('#bars'),out=$('#guessout'),youn=$('#youn');
    r.addEventListener('input',function(){v.textContent=r.value+'%';});
    btn.addEventListener('click',function(){
      var g=+r.value;bars.hidden=false;youn.textContent=g+'%';$('.bar.you .f').dataset.w=g;
      requestAnimationFrame(function(){$$('#bars .f').forEach(function(f){f.style.width=f.dataset.w+'%'})});
      var msg;
      if(g<10)msg='You guessed the way the first excavators did: every grave with a sword was a man until the bones said otherwise.';
      else if(g<25)msg='Close to the eastern figure. Herodotus put the Sauromatae exactly there, east of the Don.';
      else if(g<=45)msg='In range. Mayor\'s highest cemeteries run to 37%, and arrowheads in the bone say the weapons were used.';
      else msg='Higher than any cemetery yet dug. The Greek myth of a women-only nation is the one part the mounds do not support; these were mixed tribes where some women fought.';
      out.innerHTML='<b>'+msg+'</b>';
    });
  })();

  /* ---------- IV brew ---------- */
  (function(){
    var order=['viper','blood','dung'],idx=0,btns=$$('#ingr button'),liq=$('#liquid'),bury=$('#bury'),days=$('#days'),out=$('#brewout');
    var says={viper:'Vipers that have just given birth, taken alive. The text is specific about the whelping.',blood:'Human blood, in a small pot. Aelian says the serum of it.',dung:'Buried in dung to putrefy. Now there is nothing to do but wait.'};
    var cols={viper:'#2f7a66',blood:'#6b1f4a',dung:'#3b2a12'};
    btns.forEach(function(b){b.addEventListener('click',function(){
      var k=b.dataset.k;
