/* Plan: a bronze Scythian point oxidising to verdigris as the reader scrolls. ios = arrow, venom, rust; the page is the third meaning.
   Sticky left panel holds the blade and the current Greek word; nine steps scroll on the right, each with one thing to touch.
   Single dark theme by choice: bronze-black ground, bone text, verdigris accent, one tyrian purple reserved for the disputed layer. */
:root{
  --ink:#0b0c0a;
  --ink-2:#14160f;
  --ink-3:#1c1f16;
  --bone:#e4ddc8;
  --bone-dim:#9a9480;
  --bronze:#b7843a;
  --bronze-hi:#e2b76a;
  --verdigris:#4ea88a;
  --verdigris-hi:#7fd3b4;
  --tyrian:#6b1f4a;
  --tyrian-hi:#c98aa8;
  --font-display:"Bodoni Moda","Didot",Georgia,serif;
  --font-body:"Literata","Iowan Old Style",Georgia,serif;
  --font-mono:"Amazons Mono","JetBrains Mono","SFMono-Regular",Consolas,monospace;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto} *{animation-duration:.01ms !important;transition-duration:.01ms !important}}
body.amazons{margin:0;background:var(--ink);color:var(--bone);font-family:var(--font-body);font-size:18px;line-height:1.6;font-optical-sizing:auto;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.amazons a{color:var(--verdigris);text-decoration-thickness:1px;text-underline-offset:3px}
.amazons a:focus-visible,.amazons button:focus-visible,.amazons input:focus-visible,.amazons [tabindex]:focus-visible{outline:2px solid var(--verdigris);outline-offset:3px}
.amazons h1,.amazons h2,.amazons h3{font-family:var(--font-display);font-weight:400;line-height:1.05;text-wrap:balance;margin:0}
.amazons p{margin:0 0 1.2em}
.amazons .grc{font-style:italic}
.amazons button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0}
.amazons .btn{font-family:var(--font-mono);font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;padding:10px 16px;border:1px solid var(--bronze);color:var(--bronze-hi);background:var(--ink-2);border-radius:2px;transition:background .2s,color .2s,border-color .2s,transform .1s}
.amazons .btn:hover{background:var(--bronze);color:var(--ink)}
.amazons .btn:active{transform:translateY(1px)}
.amazons .btn.ghost{border-color:rgba(183,132,58,.4);color:var(--bone-dim)}
.amazons .btn.ghost:hover{background:var(--ink-3);color:var(--bone)}
.amazons .btn[disabled]{opacity:.4;cursor:default}
.amazons .btn[disabled]:hover{background:var(--ink-2);color:var(--bronze-hi)}
.amazons .btn.green{border-color:var(--verdigris);color:var(--verdigris-hi)}
.amazons .btn.green:hover{background:var(--verdigris);color:var(--ink)}
.amazons .btn.purple{border-color:var(--tyrian);color:var(--tyrian-hi)}
.amazons .btn.purple:hover{background:var(--tyrian);color:var(--bone)}

.amazons #motes{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.55}
.amazons #progress{position:fixed;top:0;left:0;height:3px;width:0;background:linear-gradient(90deg,var(--bronze),var(--verdigris));z-index:50}

/* chapter nav */
.amazons .nav{position:fixed;right:14px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:10px;z-index:40}
.amazons .nav a{display:block;width:28px;height:18px;font-family:var(--font-mono);font-size:.6rem;letter-spacing:.06em;color:var(--bone-dim);text-decoration:none;text-align:right;opacity:.6;transition:color .2s,opacity .2s}
.amazons .nav a:hover{opacity:1;color:var(--bone)}
.amazons .nav a.on{color:var(--verdigris);opacity:1}
@media (max-width:1180px){.amazons .nav{display:none}}

/* hero */
.amazons .hero{position:relative;z-index:1;padding:clamp(48px,9vh,110px) 16px 56px;max-width:1120px;margin:0 auto;display:grid;gap:28px}
.amazons .eyebrow{font-family:var(--font-mono);font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;color:var(--bronze)}
.amazons .hero h1{font-size:clamp(56px,11.5vw,160px);letter-spacing:-.025em;color:var(--bone);animation:rise 1.1s cubic-bezier(.2,.7,.2,1) both}
.amazons .hero h1 em{font-style:italic;color:var(--verdigris);position:relative}
.amazons .hero h1 em::after{content:"";position:absolute;left:0;right:0;bottom:.08em;height:.06em;background:linear-gradient(90deg,var(--verdigris),transparent);opacity:.6}
@keyframes rise{from{opacity:.35;transform:translateY(14px)}to{opacity:1;transform:none}}
.amazons .hero .dek{max-width:60ch;font-size:clamp(19px,2.1vw,24px);font-weight:300}
.amazons .hero .dek strong{font-weight:600;color:var(--bronze-hi)}
.amazons .triad{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;border:1px solid var(--bronze);max-width:760px;position:relative}
.amazons .triad button{text-align:left;padding:16px 18px;background:var(--ink-2);transition:background .25s;position:relative;overflow:hidden}
.amazons .triad button::before{content:"";position:absolute;inset:0;background:var(--bronze);opacity:0;transition:opacity .25s}
.amazons .triad button.on::before{opacity:.12}
.amazons .triad button:hover{background:var(--ink-3)}
.amazons .triad .k{font-family:var(--font-display);font-size:2.2rem;color:var(--bone);line-height:1;position:relative}
.amazons .triad .v{font-family:var(--font-mono);font-size:.74rem;color:var(--bone-dim);margin-top:8px;letter-spacing:.06em;text-transform:uppercase;position:relative}
.amazons .triad .src{font-family:var(--font-mono);font-size:.68rem;color:var(--bronze);margin-top:6px;position:relative}
.amazons .triad button.on .v{color:var(--verdigris-hi)}
.amazons .triadline{font-family:var(--font-mono);font-size:.78rem;color:var(--bone-dim);min-height:1.4em}
.amazons .triadline b{color:var(--bone);font-weight:600}
.amazons .how{font-size:.95rem;color:var(--bone-dim);max-width:70ch;border-left:2px solid var(--bronze);padding-left:14px}
.amazons .how b{color:var(--bone)}
.amazons .tag{display:inline-block;font-family:var(--font-mono);font-size:.64rem;letter-spacing:.14em;text-transform:uppercase;padding:3px 8px;border:1px solid;border-radius:2px;vertical-align:middle;margin-right:6px;position:relative;cursor:help}
.amazons .tag.text{color:var(--verdigris);border-color:var(--verdigris)}
.amazons .tag.read{color:var(--bronze);border-color:var(--bronze)}
.amazons .tag.disp{color:var(--tyrian-hi);border-color:var(--tyrian);background:rgba(107,31,74,.25)}
.amazons .tag::after{content:attr(data-tip);position:absolute;left:0;bottom:calc(100% + 6px);background:var(--ink-3);color:var(--bone);font-size:.68rem;letter-spacing:.02em;text-transform:none;padding:6px 9px;border:1px solid rgba(183,132,58,.4);border-radius:2px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .15s;z-index:3}
.amazons .tag:hover::after,.amazons .tag:focus-visible::after{opacity:1}

/* scrolly frame */
.amazons .scrolly{position:relative;z-index:1;max-width:1120px;margin:0 auto;padding:0 16px;display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(24px,5vw,72px);align-items:start}
.amazons .sticky{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;justify-content:center;gap:22px;padding:24px 0}
.amazons .sticky .num{font-family:var(--font-mono);font-size:.74rem;color:var(--bronze);letter-spacing:.2em}
/* The numeral, word and gloss share one wrapper so the phone strip can stack them; on the wide layout the wrapper is transparent and the numeral keeps its place above the blade. */
.amazons .sticky .stripe{display:contents}
.amazons .sticky .num{order:-1}
.amazons .sticky .word{font-family:var(--font-display);font-size:clamp(44px,6vw,86px);line-height:.95;color:var(--bone);transition:color .5s}
.amazons .sticky .gloss{font-family:var(--font-mono);font-size:.8rem;color:var(--bone-dim);letter-spacing:.04em;max-width:34ch}
.amazons .blade{width:min(100%,340px);aspect-ratio:1/1.3;filter:drop-shadow(0 20px 40px rgba(0,0,0,.6))}
.amazons .glint{opacity:0}
.amazons .blade[data-state="arrow"] .glint{opacity:1;animation:glint 2.4s ease-in-out infinite}
@keyframes glint{0%{transform:translateY(-120px)}60%,100%{transform:translateY(380px)}}
.amazons .drip{opacity:0}
.amazons .blade[data-state="venom"] .drip{opacity:1;animation:drip 1.8s ease-in infinite}
.amazons .blade[data-state="venom"] .venomtint{opacity:.55}
.amazons .venomtint{opacity:0;transition:opacity .5s}
@keyframes drip{0%{transform:translateY(0);opacity:0}15%{opacity:1}100%{transform:translateY(70px);opacity:0}}
.amazons #stainRect{transition:y .9s cubic-bezier(.2,.7,.2,1)}
.amazons .steps{padding:16px 0 20vh}
.amazons .step{position:relative;min-height:70vh;padding:12vh 0 6vh;max-width:64ch}
/* Every step stays at full strength; the active one only brightens its numeral. */
.amazons .step.on .wm{opacity:.15}
.amazons .step .wm{position:absolute;right:-10px;top:6vh;font-family:var(--font-display);font-size:clamp(90px,14vw,200px);line-height:1;color:var(--bronze);opacity:.07;transition:opacity .6s;pointer-events:none;user-select:none}
.amazons .step h2{font-size:clamp(34px,4.4vw,60px);color:var(--bone);margin:0 0 .5em;position:relative}
