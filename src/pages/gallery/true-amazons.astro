.amazons .step .lede{font-size:1.15em;font-weight:300}
.amazons .quote{margin:1.4em 0;padding:18px 22px;background:var(--ink-2);border-left:2px solid var(--verdigris);font-weight:300}
.amazons .quote .grc{display:block;color:var(--bone-dim);font-size:.95em;margin-bottom:8px;font-style:normal}
.amazons .quote cite{display:block;font-family:var(--font-mono);font-style:normal;font-size:.72rem;color:var(--bronze);margin-top:10px;letter-spacing:.04em}
.amazons .note{font-size:.92rem;color:var(--bone-dim);margin:1.2em 0;padding-top:10px;border-top:1px dashed rgba(183,132,58,.4)}
.amazons .note b{color:var(--bone)}

/* interactive frames */
.amazons .play{margin:1.6em 0;border:1px solid rgba(183,132,58,.55);background:linear-gradient(180deg,var(--ink-2),var(--ink));padding:18px;display:grid;gap:14px;position:relative}
.amazons .play::before{content:attr(data-label);position:absolute;top:-9px;left:14px;background:var(--ink);padding:0 8px;font-family:var(--font-mono);font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--verdigris)}
.amazons .play .row{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.amazons .play .out{font-family:var(--font-mono);font-size:.8rem;color:var(--bone-dim);min-height:1.4em;letter-spacing:.02em}
.amazons .play .out b{color:var(--bone);font-weight:600}
.amazons .play .out .g{color:var(--verdigris-hi)}
.amazons .play .out .p{color:var(--tyrian-hi)}
.amazons .play svg{width:100%;height:auto;display:block}

/* II kills */
.amazons .field{background:var(--ink);border:1px solid rgba(183,132,58,.25);position:relative}
.amazons .enemy{cursor:pointer;transition:transform .5s cubic-bezier(.3,.7,.3,1),opacity .6s;transform-origin:50% 100%}
.amazons .enemy:hover .body{fill:var(--bronze-hi)}
.amazons .enemy.down{transform:rotate(78deg) translate(10px,6px);opacity:.35;pointer-events:none}
.amazons .arrowfly{transition:transform .35s cubic-bezier(.2,.9,.3,1),opacity .2s;opacity:0}
.amazons .tally{display:flex;gap:8px}
.amazons .tally i{width:30px;height:6px;background:var(--ink-3);border:1px solid rgba(183,132,58,.4);transition:background .3s}
.amazons .tally i.k{background:var(--verdigris)}

/* III guess */
.amazons .gauge{display:grid;gap:8px}
.amazons .gauge input[type=range]{width:100%;accent-color:var(--verdigris)}
.amazons .bars{display:grid;gap:8px;margin-top:6px}
/* The answer bars stay hidden until "Open the mounds" is pressed: display:grid would otherwise beat the [hidden] attribute. */
.amazons .bars[hidden]{display:none}
.amazons .bar{display:grid;grid-template-columns:150px 1fr 52px;gap:10px;align-items:center;font-family:var(--font-mono);font-size:.72rem;color:var(--bone-dim)}
.amazons .bar .t{height:14px;background:var(--ink-3);border:1px solid rgba(183,132,58,.3);overflow:hidden}
.amazons .bar .f{height:100%;width:0;background:var(--bronze);transition:width 1s cubic-bezier(.2,.7,.2,1)}
.amazons .bar.you .f{background:var(--verdigris)}
.amazons .bar .n{text-align:right;color:var(--bone);font-variant-numeric:tabular-nums}

/* IV recipe */
.amazons .ingr{display:flex;flex-wrap:wrap;gap:8px}
.amazons .ingr button{font-family:var(--font-mono);font-size:.72rem;letter-spacing:.08em;padding:8px 12px;border:1px solid rgba(183,132,58,.5);color:var(--bone);background:var(--ink-2);border-radius:2px;transition:all .2s}
.amazons .ingr button:hover{border-color:var(--bronze-hi)}
.amazons .ingr button.used{opacity:.35;text-decoration:line-through;pointer-events:none}
.amazons .ingr button.next{border-color:var(--verdigris);box-shadow:0 0 0 1px var(--verdigris) inset}
.amazons .pot .liquid{transition:height .6s,fill .6s}
.amazons .days{font-family:var(--font-display);font-size:2.4rem;color:var(--bone);line-height:1;font-variant-numeric:tabular-nums}
.amazons .inter{font-family:var(--font-body);font-size:1.25rem;line-height:1.9;letter-spacing:.01em}
.amazons .inter .w{cursor:pointer;padding:0 2px;border-bottom:1px dotted rgba(183,132,58,.6);transition:color .15s,border-color .15s}
.amazons .inter .w:hover,.amazons .inter .w.on{color:var(--verdigris-hi);border-bottom-color:var(--verdigris)}
.amazons .inter .w.hot{color:var(--bronze-hi)}
.amazons .glossline{font-family:var(--font-mono);font-size:.8rem;color:var(--bone-dim);min-height:1.6em}
.amazons .glossline b{color:var(--bone)}

/* V bow */
.amazons .meter{position:relative;height:18px;background:var(--ink-3);border:1px solid rgba(183,132,58,.4);overflow:hidden}
.amazons .meter .band{position:absolute;top:0;bottom:0;background:rgba(78,168,138,.25);border-left:1px solid var(--verdigris);border-right:1px solid var(--verdigris)}
.amazons .meter .fill{position:absolute;top:0;bottom:0;left:0;width:0;background:linear-gradient(90deg,var(--bronze),var(--bronze-hi))}
.amazons .hold{user-select:none;-webkit-user-select:none;touch-action:none}
.amazons .sons{display:flex;gap:6px;flex-wrap:wrap}
.amazons .sons span{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.08em;padding:4px 8px;border:1px solid rgba(183,132,58,.35);color:var(--bone-dim)}
.amazons .sons span.gone{opacity:.4;text-decoration:line-through}
.amazons .sons span.king{color:var(--verdigris-hi);border-color:var(--verdigris)}
.amazons .bowsvg .string{transition:d .15s}

/* VI fire */
.amazons .hearth{background:var(--ink)}
.amazons .flame{transform-origin:50% 100%;opacity:0;transition:opacity .4s}
.amazons .hearth.night .flame{opacity:1;animation:flick .5s ease-in-out infinite alternate}
@keyframes flick{from{transform:scaleY(.9) scaleX(1.02)}to{transform:scaleY(1.08) scaleX(.96)}}
.amazons .hearth .glow{opacity:0;transition:opacity .5s}
.amazons .hearth.day .glow{opacity:1}
.amazons .mort{height:10px;background:var(--ink-3);border:1px solid rgba(183,132,58,.4)}
.amazons .mort i{display:block;height:100%;background:linear-gradient(90deg,var(--tyrian),var(--bronze));transition:width .8s}

/* VII vials */
.amazons .vials{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:end}
.amazons .vial{display:grid;gap:8px;justify-items:center;padding:12px;border:1px solid rgba(183,132,58,.3);background:var(--ink-2);transition:border-color .2s,transform .15s}
.amazons .vial:hover{border-color:var(--bronze-hi);transform:translateY(-2px)}
.amazons .vial .h{font-family:var(--font-mono);font-size:.68rem;letter-spacing:.14em;text-transform:uppercase}
.amazons .vial.lv .h{color:var(--tyrian-hi)}.amazons .vial.r .h{color:var(--verdigris-hi)}
.amazons .patient{transition:filter .9s,transform .9s,opacity .9s}
.amazons .patient.stone{filter:grayscale(1) contrast(1.3) brightness(.7)}
.amazons .patient.risen{filter:drop-shadow(0 0 14px rgba(78,168,138,.8))}
.amazons .cracks{opacity:0;transition:opacity .9s}
.amazons .patient.stone .cracks{opacity:1}

/* VIII hair */
.amazons .hairwrap{display:grid;grid-template-columns:140px 1fr;gap:16px;align-items:center}
.amazons .hairwrap input[type=range]{width:100%;accent-color:var(--tyrian-hi)}
.amazons .ticks{position:relative;height:18px;font-family:var(--font-mono);font-size:.62rem;color:var(--bone-dim);letter-spacing:.08em}
.amazons .ticks span{position:absolute;transform:translateX(-50%);white-space:nowrap}
.amazons .ticks span::before{content:"";position:absolute;left:50%;top:-8px;height:6px;border-left:1px solid var(--bronze)}

/* IX thesis */
.amazons .tiers{display:flex;flex-wrap:wrap;gap:10px}
.amazons .tiers label{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;padding:8px 12px;border:1px solid rgba(183,132,58,.4);cursor:pointer;user-select:none}
.amazons .tiers input{accent-color:var(--verdigris)}
.amazons .thesis{font-family:var(--font-body);font-size:1.1rem;font-weight:300;line-height:1.7;padding:16px 18px;background:var(--ink);border:1px solid rgba(183,132,58,.3);min-height:4em}
.amazons .thesis span{transition:opacity .3s}
.amazons .thesis span.off{display:none}
.amazons .thesis .r{color:var(--bronze-hi)}
.amazons .thesis .d{color:var(--tyrian-hi)}

/* companion */
.amazons .companion{display:block;margin:2.2em 0 0;padding:22px 24px;border:1px solid var(--bronze);background:linear-gradient(135deg,var(--ink-2),var(--ink));color:var(--bone);text-decoration:none;position:relative;overflow:hidden;transition:border-color .25s,transform .2s}
.amazons .companion::after{content:"";position:absolute;right:-40px;top:-40px;width:160px;height:160px;border-radius:50%;background:radial-gradient(circle,rgba(78,168,138,.25),transparent 70%);transition:transform .4s}
.amazons .companion:hover{border-color:var(--verdigris);transform:translateY(-2px)}
.amazons .companion:hover::after{transform:scale(1.4)}
.amazons .companion .ct{font-family:var(--font-display);font-size:2.4rem;line-height:1;margin:6px 0 10px;color:var(--bone)}
.amazons .companion p{font-size:.95rem;color:var(--bone-dim);margin:0 0 12px;max-width:52ch}
.amazons .companion .mono{font-family:var(--font-mono);font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:var(--verdigris)}
.amazons .eyebrow a{color:var(--verdigris)}

/* ledger */
.amazons .ledger{position:relative;z-index:1;max-width:1120px;margin:0 auto;padding:60px 16px 100px;border-top:1px solid var(--bronze)}
.amazons .ta-sf{max-width:none;padding-inline:0;color:var(--bone)}
.amazons .ledger h2{font-size:clamp(34px,4vw,56px);margin-bottom:.3em}
.amazons .ledger .sub{color:var(--bone-dim);max-width:70ch;margin-bottom:28px}
.amazons .ltable{width:100%;border-collapse:collapse;font-size:.92rem}
.amazons .ltable th{text-align:left;font-family:var(--font-mono);font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--bronze);padding:10px 8px;border-bottom:1px solid var(--bronze)}
.amazons .ltable td{padding:12px 8px;border-bottom:1px solid rgba(183,132,58,.25);vertical-align:top}
.amazons .ltable td:first-child{white-space:nowrap}
.amazons .ltable .c{font-family:var(--font-mono);font-size:.76rem;color:var(--bone-dim)}
.amazons .tablewrap{overflow-x:auto}
.amazons .ledger .foot{margin-top:36px;color:var(--bone-dim);font-size:.9rem;max-width:72ch}
.amazons .ledger .foot b{color:var(--bone)}
.amazons .srcs{columns:2;column-gap:32px;font-size:.86rem;margin-top:22px}
.amazons .srcs p{break-inside:avoid;margin:0 0 .6em}
.amazons .filter{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.amazons .ltable tr.hide{display:none}

/* Phones and small tablets: the sticky panel becomes a compact pinned strip
   above the steps. The scrolly drops to a block (not a one-column grid): a
   sticky grid item can only stick inside its own row, which is just its own
   height, so on engines that honour that (WebKit) the blade scrolled away
   with the hero and was never beside the text that says "watch the blade".
   As a block child of .scrolly it sticks for the whole run of steps. */
@media (max-width:899px){
  .amazons .scrolly{display:block}
  .amazons .sticky{position:sticky;top:0;height:auto;flex-direction:row;align-items:center;gap:14px;padding:10px 0;background:linear-gradient(var(--ink) 80%,transparent);z-index:5}
  .amazons .sticky .blade{width:60px;aspect-ratio:1/1.3;filter:none}
  .amazons .sticky .word{font-size:28px}
  .amazons .sticky .gloss{display:none}
  .amazons .step{min-height:0;padding:6vh 0}
  .amazons .step .wm{font-size:90px;top:2vh}
  .amazons .triad{grid-template-columns:1fr}
  .amazons .srcs{columns:1}
  .amazons .bar{grid-template-columns:110px 1fr 46px}
  .amazons .hairwrap{grid-template-columns:1fr}
  .amazons .vials{grid-template-columns:1fr 1fr}
  .amazons .vials .mid{grid-column:1/-1;order:-1}
}

/* Mounted in Poem.astro: neutralise its column and section rules for this page. */
.amazons main.ta{max-width:none;margin:0;padding:0;position:relative;z-index:1}
.amazons section.ledger{display:block;min-height:0}
.amazons .ta-foot{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-top:48px;padding-top:18px;border-top:1px solid rgba(183,132,58,.35);font-family:var(--font-mono);font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--bone-dim)}
.amazons .ta-foot a{color:inherit;text-underline-offset:.3em}
.amazons .ta-foot a:hover{color:var(--bone)}
/* The gallery exit sits top-left; on phones the sticky strip shares its line:
   the blade just right of the placard (the nearest thing to "on the left" the
   phone has), then the step numeral over the Greek word. The strip is 72px
   tall so its three states (glint, drip and tint, verdigris stain) read at a
   glance without covering the text below it. */
@media (max-width:899px){
  .amazons .sticky{justify-content:flex-start;min-height:72px;padding:max(8px, env(safe-area-inset-top, 0px)) 12px 8px 150px;gap:12px}
  .amazons .sticky .blade{width:40px;flex:none}
  .amazons .sticky .stripe{display:flex;flex-direction:column;justify-content:center;gap:2px;min-width:0}
  .amazons .sticky .num{order:0;font-size:.62rem;letter-spacing:.16em;line-height:1.2;white-space:nowrap}
  .amazons .sticky .stripe{flex:1 1 auto}
  .amazons .sticky .word{font-size:clamp(18px,5.6vw,26px);line-height:1.05;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
}
@media (max-width:340px){.amazons .sticky .word{display:none}}

</style>

<script>
(function(){
  var $=function(s,c){return (c||document).querySelector(s)};
