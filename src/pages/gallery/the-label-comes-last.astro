---
/**
 * The Label Comes Last: mounted from the page file of the owner's published artifact,
 * _incoming/elsewhere/the-label-comes-last.html (named in SEEN_SOURCES, src/config/seen.ts).
 * The page is the file; src/lib/seen.ts documents the few changes made on
 * the way (self-hosted fonts, share and schema meta). It is a whole
 * document with no wrapper, so nothing above its sticky exhibits clips or
 * transforms them and every index card pins as it did in the artifact.
 */
import { seenDocument } from '../../lib/seen';
const html = await seenDocument('the-label-comes-last');
---

<Fragment set:html={html} />
