<script is:inline>
(function () {
  var root = document.documentElement;
  root.classList.add('js');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var wide = window.matchMedia('(min-width: 900px)');
  var NS = 'http://www.w3.org/2000/svg';

  function mk(tag, attrs, parent) {
    var el = document.createElementNS(NS, tag);
    for (var k in attrs) el.setAttribute(k, attrs[k]);
    parent.appendChild(el);
    return el;
  }

  function buildNet() {
    var svg = document.getElementById('net');
    if (!svg) return;
    var cx = 320, cy = 320;
    function at(r, a) { return [cx + r * Math.cos(a * Math.PI / 180), cy + r * Math.sin(a * Math.PI / 180)]; }
    var r1 = [], r2 = [], r3 = [], i;
    for (i = 0; i < 7; i++) { var a = -90 + i * 360 / 7; r1.push({ a: a, p: at(118, a) }); }
    r1.forEach(function (n) { [-13, 13].forEach(function (o) { r2.push({ a: n.a + o, p: at(212, n.a + o), up: n.p }); }); });
    r2.forEach(function (n) { [-6.5, 6.5].forEach(function (o) { r3.push({ a: n.a + o, p: at(288, n.a + o), up: n.p }); }); });
    function L(g, p, q, cls, w) { return mk('line', { x1: p[0].toFixed(1), y1: p[1].toFixed(1), x2: q[0].toFixed(1), y2: q[1].toFixed(1), 'class': cls, 'stroke-width': w || 1 }, g); }
    function D(g, p, r, cls) { return mk('circle', { cx: p[0].toFixed(1), cy: p[1].toFixed(1), r: r, 'class': cls }, g); }
    var C = [cx, cy];
    var outer = mk('g', { 'class': 'net-outer' }, svg);
    r3.forEach(function (n) { L(outer, n.up, n.p, 'e'); });
    r2.forEach(function (n) { L(outer, n.up, n.p, 'e'); });
    r3.forEach(function (n) { D(outer, n.p, 3.5, 'nd'); });
    r2.forEach(function (n) { D(outer, n.p, 5.5, 'nd'); });
    var inner = mk('g', { 'class': 'net-inner' }, svg);
    var w = [3.4, 1.4, 2.6, 1.8, 2.2, 1.2, 3];
    r1.forEach(function (n, k) { L(inner, C, n.p, k === 3 ? 'e e1 cut' : 'e e1', w[k]); });
    r1.forEach(function (n, k) { D(inner, n.p, 9, k === 3 ? 'nd cutn' : 'nd'); });
    var path = mk('g', { 'class': 'net-path' }, svg);
    var h1 = r1[1].p, h2 = r2[3].p, h3 = r3[6].p;
    L(path, C, h1, 'pe', 3); L(path, h1, h2, 'pe', 3); L(path, h2, h3, 'pe', 3);
    D(path, h1, 8, 'pn'); D(path, h2, 7, 'pn'); D(path, h3, 10, 'pn');
    var core = mk('g', { 'class': 'net-core' }, svg);
    D(core, C, 27, 'core');
    mk('text', { x: cx, y: cy + 5, 'text-anchor': 'middle', 'class': 'core-t' }, core).textContent = 'YOU';
    var p3 = r1[3].p;
    mk('text', { x: (p3[0] + 16).toFixed(1), y: (p3[1] + 30).toFixed(1), 'class': 'lab lab-cut' }, svg).textContent = 'stopped talking';
    mk('text', { x: h3[0].toFixed(1), y: (h3[1] - 20).toFixed(1), 'text-anchor': 'middle', 'class': 'lab lab-sc' }, svg).textContent = 'a scandal';
  }

  function buildDots() {
    var g = document.getElementById('dots');
    if (!g) return;
    for (var i = 0; i < 100; i++) {
      var c = mk('circle', { cx: 74 + 42 * (i % 10), cy: 114 + 42 * Math.floor(i / 10), r: 14, 'class': i < 19 ? 'd a' : (i < 28 ? 'd b' : 'd o') }, g);
      c.style.setProperty('--i', i);
    }
  }

  function buildWall() {
    var wall = document.querySelector('.wall');
    if (!wall) return;
    for (var i = 0; i < 48; i++) {
      var f = document.createElement('span');
      f.className = i === 27 ? 'wf you' : 'wf';
      f.innerHTML = i === 27 ? '<i></i><b>You</b>' : '<i></i>';
      wall.appendChild(f);
    }
  }

  function typeQuery(scene) {
    var el = scene.querySelector('.typed');
    if (!el || el.getAttribute('data-done') || reduce) return;
    el.setAttribute('data-done', '1');
    var text = el.textContent, n = 0;
    el.textContent = '';
    var t = setInterval(function () {
      n += 1;
      el.textContent = text.slice(0, n);
      if (n >= text.length) clearInterval(t);
    }, 90);
  }

  buildNet(); buildDots(); buildWall();

  function activate(step) {
    var scene = step.closest('.scene');
    var n = +step.getAttribute('data-step');
    scene.querySelectorAll('.step').forEach(function (s) { s.classList.toggle('is-active', s === step); });
    if (scene.getAttribute('data-scene') === 'search' && n === 1) typeQuery(scene);
    if (+scene.getAttribute('data-step') === n) return;
    scene.setAttribute('data-step', n);
    var total = scene.querySelectorAll('.step').length;
    for (var i = 1; i <= total; i++) scene.classList.toggle('at-' + i, i <= n);
    update();
  }

  var io;
  function observe() {
    if (io) io.disconnect();
    io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) activate(e.target.closest('.step')); });
    }, { rootMargin: wide.matches ? '-47% 0px -47% 0px' : '-58% 0px -36% 0px' });
    document.querySelectorAll('.step .card').forEach(function (c) { io.observe(c); });
  }
  observe();
  if (wide.addEventListener) wide.addEventListener('change', observe);

  var chapters = Array.prototype.slice.call(document.querySelectorAll('[data-chapter]'));
  var now = document.getElementById('now');
  var prog = document.querySelector('.progress');
  var vessel = document.querySelector('[data-scene="vessel"]');
  var coda = document.getElementById('coda');
  var ticking = false;
  function update() {
    var h = document.documentElement.scrollHeight - window.innerHeight;
    prog.style.transform = 'scaleX(' + (h > 0 ? Math.min(1, window.scrollY / h) : 0) + ')';
    var line = window.innerHeight * 0.35, cur = null;
    chapters.forEach(function (c) { if (c.getBoundingClientRect().top <= line) cur = c; });
    var label = cur ? cur.getAttribute('data-num') + ' · ' + cur.getAttribute('data-title') : 'Contents';
    if (coda.getBoundingClientRect().top <= line) label = 'Sources';
    if (now.textContent !== label) now.textContent = label;
    var flooded = +vessel.getAttribute('data-step') >= 4 && vessel.getBoundingClientRect().top < window.innerHeight * 0.5;
    document.body.classList.toggle('flood', flooded);
  }
  function onScroll() {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(function () { ticking = false; update(); });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();

  var toc = document.querySelector('.toc');
  toc.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { toc.removeAttribute('open'); }); });
  document.addEventListener('click', function (e) { if (toc.open && !toc.contains(e.target)) toc.removeAttribute('open'); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && toc.open) { toc.removeAttribute('open'); toc.querySelector('summary').focus(); } });
})();
</script>
