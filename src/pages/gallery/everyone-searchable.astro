  /* Poem.astro's shared night-piece rules, undone where the prototype does not
     set them itself: its body face and smoothing, the fixed full-bleed .stage
     (here .stage is the search results area), and the centred main and
     flex sections of a poem column. */
  body.es{overflow-x:visible;-webkit-font-smoothing:auto;-moz-osx-font-smoothing:auto}
  .es main{position:static;z-index:auto;max-width:none;margin:0;padding:0}
  .es section{min-height:0;display:block;flex-direction:row;justify-content:normal;gap:normal;padding-block:0}
  .es .stage{width:auto;height:auto;z-index:auto;touch-action:auto}

  /* ---- the prototype, scoped ---- */
.es{
  /* Layout: a dossier that opens as you scroll. Step text on the left, the pinned exhibit on the right; on phones the exhibit pins full-screen and the steps slide over it. One visual world: archive paper, redaction black, stamp red, and the water that floods it at the end. */
  --paper:#e3e5e0;
  --ink:#15171a;
  --ink-soft:#575c63;
  --redact:#0c0d0f;
