.es p{margin:0}
.es a{color:inherit;text-underline-offset:.18em}
.es :focus-visible{outline:2px solid var(--stamp);outline-offset:3px;border-radius:2px}
.es mark{background:none;color:inherit}
.es .sheer{background:var(--redact);color:color-mix(in srgb,var(--paper) 58%,transparent);padding:.05em .3em;border-radius:1px;-webkit-box-decoration-break:clone;box-decoration-break:clone}

/* top bar */
.es .bar{position:fixed;inset:0 0 auto;height:var(--bar);z-index:30;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 max(16px,4vw);background:color-mix(in srgb,var(--paper) 92%,transparent);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border-bottom:1px solid var(--rule);font-family:var(--typed);font-size:13px;letter-spacing:.06em;transition:background-color .8s ease,color .8s ease}
.es.flood .bar{background:color-mix(in srgb,var(--water) 92%,transparent);border-color:color-mix(in srgb,var(--foam) 22%,transparent);color:var(--foam);transition-delay:1.4s}
.es .bar-title{text-transform:uppercase;letter-spacing:.14em;color:var(--ink-soft)}
.es.flood .bar-title{color:var(--foam)}
.es .progress{position:absolute;left:0;bottom:-1px;height:2px;width:100%;transform-origin:0 50%;transform:scaleX(0);background:var(--stamp)}
.es .toc{position:relative}
.es .toc summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:10px;padding:8px 0;text-transform:uppercase;letter-spacing:.12em}
.es .toc summary::-webkit-details-marker{display:none}
.es .chev{width:8px;height:8px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:translateY(-2px) rotate(45deg);transition:transform .2s ease}
.es .toc[open] .chev{transform:translateY(2px) rotate(-135deg)}
.es .toc ol{position:absolute;top:calc(100% + 6px);left:0;margin:0;padding:8px;list-style:none;min-width:270px;background:var(--paper);color:var(--ink);border:1px solid var(--rule);box-shadow:0 14px 34px rgba(12,13,15,.16)}
.es .toc a{display:grid;grid-template-columns:44px 1fr;padding:8px 10px;text-decoration:none;text-transform:none;letter-spacing:.02em;font-size:14px}
.es .toc a:hover,.es .toc a:focus-visible{background:color-mix(in srgb,var(--ink) 7%,transparent)}
.es .toc a span:first-child{color:var(--stamp);font-weight:700}

/* hero */
.es .hero{max-width:1240px;margin:0 auto;padding:calc(var(--bar) + clamp(48px,9vh,110px)) max(24px,4vw) clamp(40px,7vh,80px)}
.es .kicker{display:flex;flex-wrap:wrap;gap:6px 22px;font-family:var(--typed);font-size:14px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft)}
.es .title{font-family:var(--display);font-size:clamp(52px,12.5vw,200px);line-height:.84;letter-spacing:.01em;text-transform:uppercase;margin:.2em 0 .26em;overflow-wrap:break-word;hyphens:auto}
.es .title span{display:block}
.es .title .second{color:var(--stamp)}
.es .dek{font-size:clamp(21px,1.1rem + .9vw,30px);line-height:1.32;max-width:31ch}
.es .epigraph{margin:clamp(28px,5vh,48px) 0 0;max-width:44ch;padding-left:18px;border-left:2px solid var(--stamp);font-style:italic;color:var(--ink-soft);font-size:clamp(17px,1rem + .2vw,19px)}
.es .epigraph cite{display:block;margin-top:6px;font-style:normal;font-family:var(--typed);font-size:13px;letter-spacing:.08em}
.es .cue{margin-top:clamp(28px,5vh,44px);display:flex;align-items:center;gap:12px;font-family:var(--typed);font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}
.es .cue::before{content:"";width:1px;height:32px;background:currentColor;transform-origin:top;animation:cue 1.8s ease-in-out infinite}
@keyframes cue{0%,100%{transform:scaleY(.35)}50%{transform:scaleY(1)}}

/* chapters */
.es .chapter{scroll-margin-top:var(--bar)}
.es .chap{max-width:1240px;margin:0 auto;padding:clamp(80px,15vh,170px) max(24px,4vw) clamp(12px,2vh,24px);display:grid;grid-template-columns:auto 1fr;align-items:end;gap:0 clamp(16px,2vw,28px)}
.es .chap-n{font-family:var(--display);font-weight:800;font-size:clamp(70px,10vw,150px);line-height:.8;color:var(--stamp)}
.es .chap h2{font-family:var(--display);font-size:clamp(40px,5.6vw,86px);line-height:.88;text-transform:uppercase;letter-spacing:.01em;overflow-wrap:break-word;hyphens:auto}
@media (max-width:520px){.es .chap{grid-template-columns:minmax(0,1fr)}.es .chap-n{margin-bottom:10px}}
.es .chap-of{grid-column:1 / -1;margin-top:14px;padding-top:10px;border-top:1px solid var(--rule);font-family:var(--typed);font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}
.es.flood .chap-of{border-color:color-mix(in srgb,var(--foam) 25%,transparent);color:var(--foam)}

/* scenes */
.es .scene{position:relative;padding:0 max(24px,4vw)}
.es .scene-in{max-width:1240px;margin:0 auto;display:grid;grid-template-columns:minmax(300px,410px) minmax(0,1fr);gap:clamp(32px,5vw,80px)}
.es .graphic{grid-column:2;grid-row:1;align-self:start;position:sticky;top:var(--bar);height:calc(100vh - var(--bar));--gh:calc(100vh - var(--bar));display:flex;align-items:center;justify-content:center}
.es .steps{grid-column:1;grid-row:1;padding:6vh 0 32vh}
.es .step{min-height:74vh;display:flex;align-items:center}
.es .card{max-width:36ch;font-size:clamp(19px,1rem + .4vw,22px);line-height:1.5;transition:opacity .4s ease}
.es .card p+p{margin-top:.75em}
.es .card .yr{display:block;margin-bottom:8px;font-family:var(--typed);font-size:14px;font-weight:700;letter-spacing:.14em;color:var(--stamp)}
.js .es .step:not(.is-active) .card{opacity:.3}
.es .exhibit{margin:0;position:relative;width:min(100%,var(--ex-w,640px),calc((var(--gh) - 48px) * var(--ar,1)));aspect-ratio:var(--ar,1);container-type:inline-size}
.es .exhibit>svg{display:block;width:100%;height:100%;overflow:visible}

@media (max-width:899px){
  .es .scene-in{display:block}
  .es .graphic{height:calc(100svh - var(--bar));--gh:calc(60svh - var(--bar));align-items:flex-start;padding-top:2.5svh}
  .es .steps{position:relative;z-index:2;margin-top:calc(-100svh + var(--bar));padding:0 0 34svh;pointer-events:none}
  .es .step{min-height:92svh;align-items:flex-end;padding-bottom:5svh}
  .es .card{pointer-events:auto;max-width:none;width:100%;font-size:18px;background:var(--paper);border:1px solid var(--rule);box-shadow:0 10px 28px rgba(12,13,15,.14);padding:16px 18px}
  .js .es .step:not(.is-active) .card{opacity:1}
  .es.flood .card{background:color-mix(in srgb,var(--water) 88%,#000000);border-color:color-mix(in srgb,var(--foam) 18%,transparent)}
}

/* I. search */
.es .ex-search{--ar:.9;--ex-w:600px;font-family:var(--typed);font-size:3.1cqw}
.es .searchbox{position:absolute;left:0;right:1.4cqw;top:0;display:flex;align-items:center;gap:2.4cqw;padding:3cqw 3.6cqw;border:2px solid var(--ink);background:var(--sheet);font-size:4.8cqw;box-shadow:1.4cqw 1.4cqw 0 var(--ink)}
.es .sb-label{font-size:2.5cqw;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);border-right:1px solid var(--rule);padding-right:2.4cqw;white-space:nowrap}
.es .sb-query{display:flex;align-items:center;min-width:0}
.es .caret{display:inline-block;width:.5em;height:1.05em;margin-left:.1em;background:var(--stamp);animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
.es .stage{position:absolute;left:0;right:0;top:21cqw;bottom:0;overflow:hidden}
.es .results{list-style:none;margin:0;padding:0;display:grid;align-content:start}
.es .results li{display:grid;grid-template-columns:25cqw minmax(0,1fr);align-items:center;gap:2cqw;padding:2.1cqw 1cqw;border-bottom:1px solid var(--rule);transition:opacity .4s ease}
.es .results .k{font-size:2.5cqw;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft)}
.es .results .v{font-size:3cqw;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.es .answer{display:grid;gap:2.6cqw;align-content:start}
.es .a-q{justify-self:end;max-width:84%;padding:2.2cqw 3cqw;background:var(--ink);color:var(--paper);font-family:var(--body);font-size:3.7cqw;line-height:1.3;border-radius:3cqw 3cqw .6cqw 3cqw}
.es .a-a{padding:3.2cqw 3.6cqw;border:1.5px solid var(--ink);background:var(--sheet)}
.es .a-who{font-size:2.5cqw;letter-spacing:.16em;text-transform:uppercase;color:var(--stamp);margin-bottom:1.4cqw}
.es .a-lead{font-family:var(--body);font-size:4cqw;margin-bottom:2.4cqw}
.es .answer dl{margin:0;display:grid;gap:2cqw}
.es .answer dl div{display:grid;grid-template-columns:27cqw minmax(0,1fr);gap:2cqw;align-items:baseline;transition:opacity .5s ease,transform .5s ease}
.es .answer dt{font-size:2.4cqw;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft)}
.es .answer dd{margin:0;font-size:3cqw;line-height:1.5}
.js .es .ex-search .stage>*{position:absolute;inset:0;transition:opacity .6s ease,transform .6s ease}
.js .es .scene:not(.at-2) .ex-search .results{opacity:0;transform:translateY(3cqw)}
.js .es .scene.at-3 .ex-search .results{opacity:.07;transform:translateY(-2cqw) scale(.97)}
.js .es .scene:not(.at-3) .ex-search .answer{opacity:0;transform:translateY(3cqw)}
.js .es .scene:not(.at-4) .ex-search .answer dl div{opacity:0;transform:translateX(-2cqw)}
.es .ex-search .results li:nth-child(2){transition-delay:.06s}.es .ex-search .results li:nth-child(3){transition-delay:.12s}.es .ex-search .results li:nth-child(4){transition-delay:.18s}.es .ex-search .results li:nth-child(5){transition-delay:.24s}.es .ex-search .results li:nth-child(6){transition-delay:.3s}.es .ex-search .results li:nth-child(7){transition-delay:.36s}.es .ex-search .results li:nth-child(8){transition-delay:.42s}
.js .es .scene:not(.at-2) .ex-search .results li{opacity:0}
.es .ex-search .answer dl div:nth-child(2){transition-delay:.15s}.es .ex-search .answer dl div:nth-child(3){transition-delay:.3s}.es .ex-search .answer dl div:nth-child(4){transition-delay:.45s}

/* II. polyneural */
.es .ex-net{--ar:1;--ex-w:640px}
.es .ex-net .e{stroke:var(--ink);stroke-opacity:.26}
.es .ex-net .e1{stroke-opacity:.72}
.es .ex-net .nd{fill:var(--ink)}
.es .ex-net .net-outer .nd{fill-opacity:.5}
.es .ex-net .cut{stroke-dasharray:3 7;stroke-opacity:.32;transition:stroke-opacity .6s ease}
.es .ex-net .cutn{fill-opacity:.32;transition:fill-opacity .6s ease}
.es .ex-net .pe{stroke:var(--stamp);stroke-linecap:round}
.es .ex-net .pn{fill:var(--stamp)}
.es .ex-net .core{fill:var(--ink)}
.es .ex-net .core-t{fill:var(--paper);font-family:var(--typed);font-weight:700;font-size:15px;letter-spacing:.08em}
.es .ex-net .lab{font-family:var(--typed);font-size:15px;fill:var(--ink)}
.es .ex-net .lab-sc{fill:var(--stamp);font-weight:700}
.es .ex-net .net-outer,.es .ex-net .net-path,.es .ex-net .lab{transition:opacity .8s ease}
.es .ex-net .net-path,.es .ex-net .lab-sc{transition-delay:.7s}
.js .es .scene:not(.at-2) .ex-net .cut{stroke-dasharray:none;stroke-opacity:.72}
.js .es .scene:not(.at-2) .ex-net .cutn{fill-opacity:1}
.js .es .scene:not(.at-2) .ex-net .lab-cut{opacity:0}
.js .es .scene:not(.at-3) .ex-net :is(.net-outer,.net-path,.lab-sc){opacity:0}

/* III. timeline */
.es .ex-time{--ar:.88;--ex-w:600px}
.es .tl{list-style:none;margin:0;padding:3cqw 4cqw;position:absolute;inset:0;display:grid;grid-template-rows:repeat(6,1fr)}
.es .tl li{display:grid;grid-template-columns:20cqw minmax(0,1fr);align-items:center;gap:4cqw;border-top:1px solid var(--rule);position:relative;transition:opacity .5s ease}
.es .tl li::after{content:"";position:absolute;left:21.6cqw;top:50%;width:2.2cqw;height:2.2cqw;border-radius:50%;background:var(--ink);transform:translate(-50%,-50%)}
.es .tl .yr{font-family:var(--display);font-weight:800;font-size:9cqw;line-height:1}
.es .tl .ev{font-size:3.9cqw;line-height:1.25}
.es .tl-next .yr,.es .tl-next .ev{color:var(--stamp)}
.es .tl-next::after{background:var(--stamp)!important}
.es .curtain{position:absolute;inset:0;pointer-events:none;display:grid;place-items:center;opacity:.22;background:repeating-linear-gradient(90deg,var(--redact) 0 5cqw,color-mix(in srgb,var(--redact) 84%,var(--paper)) 5cqw 10cqw);transition:opacity 1.8s ease}
.es .curtain span{font-family:var(--display);font-weight:800;font-size:13cqw;letter-spacing:.06em;text-transform:uppercase;color:var(--stamp);border:.8cqw solid var(--stamp);padding:0 3cqw;transform:rotate(-8deg)}
.js .es .scene:not(.at-1) .ex-time .curtain{opacity:.95}
.js .es .ex-time li{opacity:.28}
.js .es .scene.at-2 .ex-time li[data-i="1"],.js .es .scene.at-3 .ex-time li[data-i="2"],.js .es .scene.at-4 .ex-time li[data-i="3"],.js .es .scene.at-5 .ex-time li[data-i="4"],.js .es .scene.at-5 .ex-time li[data-i="5"],.js .es .scene.at-6 .ex-time li[data-i="6"]{opacity:1}

/* IV. stairs */
.es .ex-stairs{--ar:1.143;--ex-w:660px}
.es .ex-stairs .st rect{fill:var(--ink);stroke:var(--ink);stroke-width:1.5;transition:fill .5s ease,stroke .5s ease}
.es .ex-stairs .st6 rect{fill:var(--stamp);stroke:var(--stamp)}
.es .ex-stairs .nm{font-family:var(--typed);font-weight:700;font-size:15px;letter-spacing:.04em;fill:var(--paper);transition:fill .5s ease}
.es .ex-stairs .sb{font-family:var(--body);font-style:italic;font-size:14px;fill:color-mix(in srgb,var(--paper) 80%,transparent);transition:fill .5s ease}
.es .ex-stairs .st3 *{transition-delay:.15s}.es .ex-stairs .st4 *{transition-delay:.3s}.es .ex-stairs .st5 *{transition-delay:.45s}
.js .es .scene:not(.at-2) .ex-stairs :is(.st2,.st3,.st4,.st5) rect,.js .es .scene:not(.at-3) .ex-stairs .st6 rect{fill:transparent;stroke:color-mix(in srgb,var(--ink) 30%,transparent)}
.js .es .scene:not(.at-2) .ex-stairs :is(.st2,.st3,.st4,.st5) .nm,.js .es .scene:not(.at-3) .ex-stairs .st6 .nm{fill:color-mix(in srgb,var(--ink) 38%,transparent)}
.js .es .scene:not(.at-2) .ex-stairs :is(.st2,.st3,.st4,.st5) .sb,.js .es .scene:not(.at-3) .ex-stairs .st6 .sb{fill:color-mix(in srgb,var(--ink) 32%,transparent)}
.es .ex-stairs .mire path{fill:var(--redact)}
.es .ex-stairs .mire text{font-family:var(--typed);font-size:15px;letter-spacing:.12em;fill:var(--paper)}
.es .ex-stairs .myfile rect{fill:var(--sheet);stroke:var(--ink);stroke-width:1.5}
.es .ex-stairs .mf1{font-family:var(--typed);font-weight:700;font-size:15px;letter-spacing:.1em;fill:var(--ink)}
.es .ex-stairs .mf2{font-family:var(--body);font-style:italic;font-size:15px;fill:var(--ink-soft)}
.es .ex-stairs .mf3{font-family:var(--display);font-weight:800;font-size:25px;letter-spacing:.04em;fill:var(--stamp)}
.es .ex-stairs .mire,.es .ex-stairs .myfile{transition:opacity .6s ease,transform .6s ease}
.js .es .scene:not(.at-3) .ex-stairs .mire{opacity:0}
.js .es .scene:not(.at-4) .ex-stairs .myfile{opacity:0;transform:translateY(12px)}

/* V. dots */
.es .ex-dots{--ar:.839;--ex-w:540px}
.es .ex-dots .d{fill:transparent;stroke:var(--ink);stroke-opacity:.28;stroke-width:1.5;transition:fill .4s ease,stroke .4s ease,stroke-opacity .4s ease,opacity .5s ease}
.es .ex-dots .d.a{fill:var(--ink);stroke-opacity:1;transition-delay:calc(var(--i) * 18ms)}
.es .ex-dots .d.b{fill:var(--stamp);stroke:var(--stamp);stroke-opacity:1;transition-delay:calc((var(--i) - 19) * 70ms)}
.es .ex-dots .d.o{opacity:.35}
.js .es .scene:not(.at-2) .ex-dots .d.b{fill:transparent;stroke:var(--ink);stroke-opacity:.28}
.js .es .scene:not(.at-3) .ex-dots .d.o{opacity:1}
.es .ex-dots .dt{font-family:var(--typed);font-size:15px;fill:var(--ink)}
.es .ex-dots .ds{font-family:var(--typed);font-size:12.5px;fill:var(--ink-soft)}
.es .ex-dots .big{font-family:var(--display);font-weight:800;font-size:66px;fill:var(--ink)}
.es .ex-dots .big.b{fill:var(--stamp)}
.es .ex-dots .sm{font-family:var(--typed);font-size:13px;fill:var(--ink-soft)}
.es .ex-dots .arr{font-family:var(--typed);font-size:30px;fill:var(--ink-soft)}
.es .ex-dots .y23{transition:opacity .5s ease}
.js .es .scene:not(.at-2) .ex-dots .y23{opacity:0}

/* VI. file */
.es .ex-file{--ar:.86;--ex-w:580px;font-family:var(--typed)}
.es .folder{position:absolute;inset:9% 8% 9%;transition:opacity .7s ease,transform .7s ease}
.es .folder .tab{position:absolute;top:-6cqw;left:7%;padding:1.3cqw 4cqw;background:var(--folder);font-size:2.6cqw;letter-spacing:.16em;text-transform:uppercase;border-radius:1.4cqw 1.4cqw 0 0}
.es .sheet{position:absolute;inset:0;background:var(--sheet);border:1px solid var(--rule);padding:8cqw 7cqw;display:grid;align-content:start;gap:4.2cqw;font-size:3.5cqw;box-shadow:0 1.2cqw 3.6cqw rgba(12,13,15,.14)}
.es .sheet .row{display:grid;grid-template-columns:24cqw minmax(0,1fr);gap:2cqw;line-height:1.35}
.es .sheet .row b{font-size:2.5cqw;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);padding-top:.5cqw}
.es .redact{color:var(--stamp);font-weight:700;padding:0 .3em;transition:background-color .9s ease,color .9s ease}
.js .es .scene:not(.at-3) .ex-file .redact{background:var(--redact);color:var(--redact)}
.es .stamp-sm{position:absolute;right:6cqw;bottom:7cqw;font-family:var(--display);font-weight:800;font-size:5.4cqw;letter-spacing:.04em;text-transform:uppercase;color:var(--stamp);border:.5cqw solid var(--stamp);padding:.2cqw 2cqw;transform:rotate(-6deg)}
.es .cover{position:absolute;inset:0;background:var(--folder);border:1px solid var(--rule);display:grid;place-items:center;transform:translateY(-118%) rotate(-4deg);opacity:0;transition:transform .9s cubic-bezier(.6,.05,.3,1),opacity .9s ease}
.es .cover span{font-family:var(--display);font-weight:800;font-size:12cqw;letter-spacing:.05em;text-transform:uppercase;color:var(--stamp);border:.8cqw solid var(--stamp);padding:0 3cqw;transform:rotate(-7deg)}
.js .es .scene:not(.at-2) .ex-file .cover{transform:none;opacity:1}
.es .file-note{position:absolute;left:0;right:0;bottom:-6.5cqw;text-align:center;font-size:2.5cqw;letter-spacing:.06em;color:var(--ink-soft)}
.es .wall,.es .wall-stamp{display:none}
.js .es .wall{position:absolute;inset:3% 1% 5%;display:grid;grid-template-columns:repeat(8,1fr);grid-auto-rows:1fr;gap:3.4cqw 2.2cqw;padding-top:1.4cqw;transition:opacity .8s ease,transform .8s ease}
.es .wf{position:relative;background:var(--folder);border-radius:.6cqw;display:grid;place-content:center;justify-items:center;gap:1cqw;transition:background-color .6s ease}
.es .wf::before{content:"";position:absolute;top:-1.3cqw;left:12%;width:42%;height:1.6cqw;background:inherit;border-radius:.6cqw .6cqw 0 0}
.es .wf i{display:block;width:6cqw;height:1.2cqw;background:var(--redact);opacity:.75}
.es .wf b{font-size:2.3cqw;letter-spacing:.1em;text-transform:uppercase;color:var(--paper)}
.es .wf.you{background:var(--ink)}
.js .es .wall-stamp{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;transition:opacity .6s ease,transform .6s ease}
.es .wall-stamp span{font-family:var(--display);font-weight:800;font-size:17cqw;letter-spacing:.05em;text-transform:uppercase;color:var(--stamp);border:1cqw solid var(--stamp);padding:0 4cqw;transform:rotate(-9deg);background:color-mix(in srgb,var(--paper) 55%,transparent)}
.js .es .scene:not(.at-4) .ex-file .wall{opacity:0;transform:scale(1.08)}
.js .es .scene.at-4 .ex-file .folder{opacity:0;transform:scale(.5)}
.js .es .scene:not(.at-5) .ex-file .wall-stamp{opacity:0;transform:scale(1.25)}
.js .es .scene:not(.at-5) .ex-file .wf.you{background:var(--folder)}
.js .es .scene:not(.at-5) .ex-file .wf.you b{color:var(--ink)}

/* VII. quadrants */
.es .ex-quad{--ar:.941;--ex-w:640px}
.es .ex-quad line{stroke:var(--ink-soft);stroke-width:1.4}
