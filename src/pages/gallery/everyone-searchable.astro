---
/**
 * Everyone, Searchable: Futurist No. 1. A scrolly in nine chapters, set as a
 * dossier that opens as you scroll: step text on the left, the exhibit pinned
 * on the right; on phones the exhibit pins full-screen and the steps slide
 * over it. Archive paper, redaction black, stamp red, and the water that
 * floods the page at the end.
 *
 * Ported from docs/prototypes/everyone-searchable-prototype.html, which is
 * the design of record: its copy, chapter order, pacing and look ship as-is.
 * The markup and the script are the prototype's, byte for byte; the CSS is
 * the prototype's scoped under `.es` (one class added to every selector, so
 * its cascade is unchanged), with the fonts self-hosted under the same names.
 * The one addition is the link back to the Gallery in the top bar, the
 * series label in the kicker, and the shared foot (ScrollFoot) after the
 * sources. The route is /gallery/everyone-searchable/; the old
 * /writings/ URL redirects (public/_redirects).
 *
 * Same page system as The Dual Thing (Poem.astro), and the writings entry
 * opts the route out of the site's effects (`treatment: scrolly`): no glyph
 * dither, no backdrop fade, no smoke, and the audio layer stays dormant.
 * Title, description and date come from the gallery entry (src/lib/pieces.ts).
 */
import Poem from '../../layouts/Poem.astro';
import SeriesMark from '../../components/scroll/SeriesMark.astro';
import ScrollFoot from '../../components/scroll/ScrollFoot.astro';
import MethodLink from '../../components/scroll/MethodLink.astro';
import { series } from '../../config/series';
import { SITE_URL } from '../../config/site';
import { getPiece } from '../../lib/pieces';

const piece = await getPiece('everyone-searchable');
if (!piece.series) throw new Error('everyone-searchable: the gallery entry needs a series.');
const { title, description, date } = piece;
const s = series[piece.series];
---

<Poem
  title={title}
  description={description}
  year={String(date.getUTCFullYear())}
  published={date}
  night="#e3e5e0"
  accent="#c0281c"
  genre="Essay"
  scheme="light"
  exit={false}
  partOf={{ name: s.title, url: `${SITE_URL}${s.href}`, type: 'CreativeWorkSeries' }}
  preload={[
    '/fonts/big-shoulders-stencil-display-latin-wght-normal.woff2',
    '/fonts/newsreader-latin-opsz-normal.woff2',
    '/fonts/courier-prime-latin-400-normal.woff2',
  ]}
  bodyClass="es"
>
<div class="bar" data-twin-skip>
  <details class="toc">
    <summary><span class="chev" aria-hidden="true"></span><span id="now">Contents</span></summary>
    <ol>
      <li><a href="#the-index"><span>I</span><span>The Index</span></a></li>
      <li><a href="#polyneural"><span>II</span><span>The Polyneural</span></a></li>
      <li><a href="#already-here"><span>III</span><span>Already Here</span></a></li>
      <li><a href="#the-searcher"><span>IV</span><span>The Searcher</span></a></li>
      <li><a href="#the-genie"><span>V</span><span>The Genie</span></a></li>
      <li><a href="#reveal-day"><span>VI</span><span>Reveal Day</span></a></li>
      <li><a href="#who-comes-through"><span>VII</span><span>Who Comes Through</span></a></li>
      <li><a href="#come-to-jesus"><span>VIII</span><span>The Come-to-Jesus Move</span></a></li>
      <li><a href="#fear-not"><span>IX</span><span>Fear Not</span></a></li>
      <li><a href="#sources"><span>&#183;</span><span>Sources</span></a></li>
    </ol>
  </details>
  <span class="bar-end">
    <span class="bar-title">Everyone, Searchable</span>
    <a class="bar-exit" href="/gallery/" data-og-hide><svg class="bar-frame" viewBox="0 0 14 11" aria-hidden="true"><rect x=".75" y=".75" width="12.5" height="9.5"/><rect class="pic" x="4" y="3.5" width="6" height="4"/></svg><span class="bar-exit-t">Gallery</span></a>
  </span>
  <span class="progress" aria-hidden="true"></span>
</div>

<header class="hero" id="top">
  <p class="kicker"><span><SeriesMark id="everyone-searchable" /></span><span>By Michael Wilhelm</span><span>November 2026</span></p>
  <h1 class="title"><span>Everyone,</span><span class="second">Searchable</span></h1>
  <p class="dek">Every human life is about to become searchable through a god-level AI. It will break the searcher before it breaks the searched, and the one move that holds is to get known before you get searched.</p>
  <blockquote class="epigraph"><p>That which ye have spoken in the ear in closets shall be proclaimed upon the housetops.</p><cite>Luke 12:3</cite></blockquote>
  <p class="cue">Scroll to open the file</p>
</header>

<main>

<!-- I -->
<section class="chapter" id="the-index" data-chapter data-num="I" data-title="The Index">
  <header class="chap"><span class="chap-n">I</span><h2>The Index</h2><p class="chap-of">Chapter I of IX</p></header>
  <div class="scene at-1" data-scene="search" data-step="1">
    <div class="scene-in">
      <div class="graphic">
        <figure class="exhibit ex-search" role="img" aria-label="A search for your name returns your texts, emails, photos, DMs, deleted posts, TV viewing log, voice clips and location pings. Then an AI assistant answers a question about where someone is and what he is hiding.">
          <div class="searchbox"><span class="sb-label">Search anyone</span><span class="sb-query"><span class="typed">your name</span><span class="caret"></span></span></div>
          <div class="stage">
            <ol class="results">
              <li><span class="k">Texts</span><span class="v"><mark class="sheer">don't tell her I said this</mark></span></li>
              <li><span class="k">Emails</span><span class="v"><mark class="sheer">re: the thing we agreed never to mention</mark></span></li>
              <li><span class="k">Photos</span><span class="v"><mark class="sheer">IMG_2231 &#183; geotagged &#183; 11:48 pm</mark></span></li>
              <li><span class="k">DMs</span><span class="v"><mark class="sheer">delete this after you read it</mark></span></li>
              <li><span class="k">Deleted posts</span><span class="v"><mark class="sheer">removed by you, archived anyway</mark></span></li>
              <li><span class="k">TV viewing log</span><span class="v"><mark class="sheer">2:14 to 3:40 am, paused twice</mark></span></li>
              <li><span class="k">Voice clips</span><span class="v"><mark class="sheer">&#8220;hey&#8230; you still up?&#8221;</mark></span></li>
              <li><span class="k">Location pings</span><span class="v"><mark class="sheer">the address you never mention</mark></span></li>
            </ol>
            <div class="answer">
              <p class="a-q">Where is he right now, and what is he hiding?</p>
              <div class="a-a">
                <p class="a-who">Assistant</p>
                <p class="a-lead">Here's everything on file.</p>
                <dl>
                  <div><dt>Whereabouts</dt><dd><mark class="sheer">two blocks from the address on file</mark></dd></div>
                  <div><dt>Alter egos</dt><dd><mark class="sheer">a forum persona from 2011</mark></dd></div>
                  <div><dt>Burner accounts</dt><dd><mark class="sheer">matched by writing style</mark></dd></div>
                  <div><dt>Stopped talking to</dt><dd><mark class="sheer">his brother, last spring</mark></dd></div>
                </dl>
              </div>
            </div>
          </div>
        </figure>
      </div>
      <div class="steps">
        <div class="step is-active" data-step="1"><div class="card"><p>Everyone is about to become searchable. Type a name, get a life.</p></div></div>
        <div class="step" data-step="2"><div class="card"><p>Every text, email, photo, DM and deleted post since the first digital message. The viewing logs your smart TV ships home. The audio your phone catches. Every location ping. All of it compiled and cross-referenced.</p></div></div>
        <div class="step" data-step="3"><div class="card"><p>Out of all that comes a simulacrum of each of us, a working model of you. Anyone can query it through an AI assistant that will feel, to most people, like a god.</p></div></div>
        <div class="step" data-step="4"><div class="card"><p>Ask it anything about anyone. Where they are. What they're into. Their alter egos and burner accounts. Everything once thought private gets aired out on request.</p><p>People will lose their minds.</p></div></div>
      </div>
    </div>
  </div>
</section>

<!-- II -->
<section class="chapter" id="polyneural" data-chapter data-num="II" data-title="The Polyneural">
  <header class="chap"><span class="chap-n">II</span><h2>The Polyneural</h2><p class="chap-of">Chapter II of IX</p></header>
  <div class="scene at-1" data-scene="net" data-step="1">
    <div class="scene-in">
      <div class="graphic">
        <figure class="exhibit ex-net" role="img" aria-label="The Polyneural: you at the center, the people you talk to around you, one connection cut off, and a three-hop path in red from you to a stranger's scandal.">
          <svg id="net" viewBox="0 0 640 640" aria-hidden="true"></svg>
        </figure>
      </div>
      <div class="steps">
        <div class="step is-active" data-step="1"><div class="card"><p>Then the connections. Who you talk to, how often, and at what hour.</p></div></div>
        <div class="step" data-step="2"><div class="card"><p>And who you suddenly stopped talking to.</p></div></div>
        <div class="step" data-step="3"><div class="card"><p>Call it the Polyneural, a living map of every relationship on earth. Three hops out, everyone connects to a predator, a fraudster or a scandal, and guilt by association goes universal.</p></div></div>
      </div>
    </div>
  </div>
</section>

<!-- III -->
<section class="chapter" id="already-here" data-chapter data-num="III" data-title="Already Here">
  <header class="chap"><span class="chap-n">III</span><h2>Already Here</h2><p class="chap-of">Chapter III of IX</p></header>
  <div class="scene" data-scene="time" data-step="0">
    <div class="scene-in">
      <div class="graphic">
        <figure class="exhibit ex-time" role="img" aria-label="A timeline under a sheer curtain: Ashley Madison's breach in 2015, Microsoft's patent for a chatbot of a specific person in 2020, the I-XRAY glasses in 2024, Texas suing TV makers in 2025, Meta's Name Tag plan in 2026, and next, the index.">
          <ol class="tl">
            <li data-i="1"><span class="yr">2015</span><span class="ev">Ashley Madison breach exposes 32 million accounts</span></li>
            <li data-i="2"><span class="yr">2020</span><span class="ev">Microsoft is granted a patent for a chatbot of a specific person</span></li>
            <li data-i="3"><span class="yr">2024</span><span class="ev">I-XRAY glasses identify strangers on the street</span></li>
            <li data-i="4"><span class="yr">2025</span><span class="ev">Texas sues five TV makers over screen capture</span></li>
            <li data-i="5"><span class="yr">2026</span><span class="ev">Meta's &#8220;Name Tag&#8221; face recognition plan is reported</span></li>
            <li data-i="6" class="tl-next"><span class="yr">Next</span><span class="ev">The index</span></li>
          </ol>
          <div class="curtain" aria-hidden="true"><span>Private</span></div>
        </figure>
      </div>
      <div class="steps">
        <div class="step" data-step="1"><div class="card"><p>We thought digital privacy was a blackout curtain. It was sheer the whole time. The data is already archived, and the machinery is already here.</p></div></div>
        <div class="step" data-step="2"><div class="card"><span class="yr">2015</span><p>Ashley Madison is breached and 32 million accounts spill. Five years later the extortion emails are still landing.</p></div></div>
        <div class="step" data-step="3"><div class="card"><span class="yr">2020</span><p>Microsoft is granted a patent for building a chatbot of a specific person out of their posts, messages, voice and photos. Living or dead.</p></div></div>
        <div class="step" data-step="4"><div class="card"><span class="yr">2024</span><p>Two Harvard students wire Meta's camera glasses to a face-search engine and an AI, then pull strangers' names and addresses off the street in real time.</p></div></div>
        <div class="step" data-step="5"><div class="card"><span class="yr">2025 &#183; 2026</span><p>Texas sues five TV makers, alleging their sets capture what plays on screen and sell it. Then Meta is reported to be planning facial recognition for its glasses, internally called Name Tag.</p></div></div>
        <div class="step" data-step="6"><div class="card"><p>Who builds the rest? A government, more likely a corporation. Or nobody at all. Millions of AI agents run small lookups until the index assembles itself, an immaculate conception if you trust the official narrative.</p><p>Watch for the blur around the few it protects.</p></div></div>
      </div>
    </div>
  </div>
</section>

<!-- IV -->
<section class="chapter" id="the-searcher" data-chapter data-num="IV" data-title="The Searcher">
  <header class="chap"><span class="chap-n">IV</span><h2>The Searcher</h2><p class="chap-of">Chapter IV of IX</p></header>
  <div class="scene at-1" data-scene="stairs" data-step="1">
    <div class="scene-in">
      <div class="graphic">
        <figure class="exhibit ex-stairs" role="img" aria-label="A staircase down: safety, curiosity, suspicion, jealousy, leverage, fantasy, and at the bottom the mire. Your searches end up filed under your own name.">
          <svg viewBox="0 0 640 560" aria-hidden="true">
            <g class="st st1"><rect x="20" y="30" width="180" height="56" rx="4"/><text class="nm" x="34" y="54">1 &#183; SAFETY</text><text class="sb" x="34" y="75">the babysitter, the date</text></g>
            <g class="st st2"><rect x="104" y="100" width="180" height="56" rx="4"/><text class="nm" x="118" y="124">2 &#183; CURIOSITY</text><text class="sb" x="118" y="145">an ex, an old friend</text></g>
            <g class="st st3"><rect x="188" y="170" width="180" height="56" rx="4"/><text class="nm" x="202" y="194">3 &#183; SUSPICION</text><text class="sb" x="202" y="215">your partner's coworker</text></g>
            <g class="st st4"><rect x="272" y="240" width="180" height="56" rx="4"/><text class="nm" x="286" y="264">4 &#183; JEALOUSY</text><text class="sb" x="286" y="285">who they text now</text></g>
            <g class="st st5"><rect x="356" y="310" width="180" height="56" rx="4"/><text class="nm" x="370" y="334">5 &#183; LEVERAGE</text><text class="sb" x="370" y="355">if it ever came to that</text></g>
            <g class="st st6"><rect x="440" y="380" width="180" height="56" rx="4"/><text class="nm" x="454" y="404">6 &#183; FANTASY</text><text class="sb" x="454" y="425">the puppet version</text></g>
            <g class="mire"><path d="M380 472C420 454 460 490 500 472S580 454 630 474L630 540L380 540Z"/><text x="505" y="516" text-anchor="middle">THE MIRE</text></g>
            <g class="myfile"><rect x="20" y="462" width="300" height="76" rx="4"/><text class="mf1" x="38" y="492">YOUR SEARCHES</text><text class="mf2" x="38" y="519">filed under your own name</text><text class="mf3" x="304" y="497" text-anchor="end" transform="rotate(-8 304 497)">ON FILE</text></g>
          </svg>
        </figure>
      </div>
      <div class="steps">
        <div class="step is-active" data-step="1"><div class="card"><p>Start with what it does to the person searching. The first search always has a good reason.</p></div></div>
        <div class="step" data-step="2"><div class="card"><p>Then curiosity. Then suspicion. Then jealousy. Then leverage.</p></div></div>
        <div class="step" data-step="3"><div class="card"><p>Then fantasy, because this thing retrieves and it also performs. Ask it to play your ex, your crush, your rival. People will rehearse arguments with puppets, then resent the real person for never saying the puppet's lines.</p></div></div>
        <div class="step" data-step="4"><div class="card"><p>Every query you run lands in your own file. The voyeur's record is the most damning one in the archive.</p></div></div>
      </div>
    </div>
  </div>
</section>

<!-- V -->
<section class="chapter" id="the-genie" data-chapter data-num="V" data-title="The Genie">
  <header class="chap"><span class="chap-n">V</span><h2>The Genie</h2><p class="chap-of">Chapter V of IX</p></header>
  <div class="scene at-1" data-scene="dots" data-step="1">
    <div class="scene-in">
      <div class="graphic">
        <figure class="exhibit ex-dots" role="img" aria-label="Out of 100 U.S. adults, 19 scored at the lowest literacy levels in 2017 and 28 in 2023, an increase of 9 points.">
          <svg viewBox="0 0 520 620" aria-hidden="true">
            <text class="dt" x="40" y="44">U.S. adults at the lowest literacy levels</text>
            <text class="ds" x="40" y="68">Each dot is one adult in a hundred &#183; PIAAC</text>
            <g id="dots"></g>
            <g class="y17"><text class="big" x="40" y="574">19</text><text class="sm" x="40" y="600">in 100 &#183; 2017</text></g>
            <g class="y23"><text class="arr" x="200" y="560">&#8594;</text><text class="big b" x="280" y="574">28</text><text class="sm" x="280" y="600">in 100 &#183; 2023 &#183; up 9 points</text></g>
          </svg>
        </figure>
      </div>
      <div class="steps">
        <div class="step is-active" data-step="1"><div class="card"><p>The genie only grants wishes as big as the wisher's language. In 2017, 19 in 100 U.S. adults scored at the lowest literacy levels.</p></div></div>
        <div class="step" data-step="2"><div class="card"><p>By 2023 it was 28 in 100.</p></div></div>
        <div class="step" data-step="3"><div class="card"><p>Language is the operating system. Hand god-level power to people who can only form small, mean questions and you get small, mean answers at god-level scale.</p></div></div>
      </div>
    </div>
  </div>
</section>

<!-- VI -->
<section class="chapter" id="reveal-day" data-chapter data-num="VI" data-title="Reveal Day">
  <header class="chap"><span class="chap-n">VI</span><h2>Reveal Day</h2><p class="chap-of">Chapter VI of IX</p></header>
  <div class="scene at-1" data-scene="file" data-step="1">
    <div class="scene-in">
      <div class="graphic">
        <figure class="exhibit ex-file" role="img" aria-label="An illustrated Stasi file on Vera Wollenberger. The informant code-named Donald turns out to be her husband. Then one file becomes a wall of files, one of them yours, stamped public.">
          <div class="folder">
            <span class="tab">MfS &#183; Akte</span>
            <div class="sheet">
              <p class="row"><b>Subject</b><span>Wollenberger, Vera</span></p>
              <p class="row"><b>Source</b><span>IM &#8220;Donald&#8221;</span></p>
              <p class="row"><b>Reports</b><span>dinner-table talk, pillow talk</span></p>
              <p class="row"><b>Source is</b><span><mark class="redact">her husband</mark></span></p>
              <span class="stamp-sm">Opened 2 Jan 1992</span>
            </div>
            <div class="cover" aria-hidden="true"><span>Sealed</span></div>
            <p class="file-note">Illustration based on reporting about her file</p>
          </div>
          <div class="wall" aria-hidden="true"></div>
          <div class="wall-stamp" aria-hidden="true"><span>Public</span></div>
        </figure>
      </div>
      <div class="steps">
        <div class="step is-active" data-step="1"><div class="card"><p>Picture it arriving the way a leak arrives, all at once. The truest black swan humanity has ever faced together.</p></div></div>
        <div class="step" data-step="2"><div class="card"><p>We've had a rehearsal. On January 2, 1992, Germany opened the Stasi files to the people they were written about.</p></div></div>
        <div class="step" data-step="3"><div class="card"><p>Vera Wollenberger read hers and learned that the informant code-named Donald was her own husband.</p></div></div>
        <div class="step" data-step="4"><div class="card"><p>Now picture everyone holding their own file, and everyone else's. Relationships end in an instant. Relations change shape overnight.</p></div></div>
        <div class="step" data-step="5"><div class="card"><p>The cruelest part is the timing. People normally face themselves in private first. The index collapses the private reckoning and the public one into one instant.</p><p>Search yourself, and you find what you refused to face at the exact moment everyone else does.</p></div></div>
      </div>
    </div>
  </div>
</section>

<!-- VII -->
<section class="chapter" id="who-comes-through" data-chapter data-num="VII" data-title="Who Comes Through">
  <header class="chap"><span class="chap-n">VII</span><h2>Who Comes Through</h2><p class="chap-of">Chapter VII of IX</p></header>
  <div class="scene at-1" data-scene="quad" data-step="1">
    <div class="scene-in">
      <div class="graphic">
        <figure class="exhibit ex-quad" role="img" aria-label="A two-by-two chart of self-acceptance against accountability. The Integrated, high on both, come through bruised and whole. The Penitent, the Divided and the Shameless fill the other corners. The Hunted sit off the chart.">
          <svg viewBox="0 0 640 680" aria-hidden="true">
            <defs><marker id="qa" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" style="fill:var(--ink-soft)"/></marker></defs>
            <line x1="40" y1="562" x2="40" y2="36" marker-end="url(#qa)"/>
            <line x1="40" y1="562" x2="622" y2="562" marker-end="url(#qa)"/>
            <text class="ax" x="22" y="300" text-anchor="middle" transform="rotate(-90 22 300)">Accountability to those you affected &#8594;</text>
            <text class="ax" x="342" y="594" text-anchor="middle">Self-acceptance &#8594;</text>
            <g class="q q-pen"><rect x="64" y="44" width="268" height="240" rx="6"/><g class="qt"><text class="qn" x="84" y="92">THE PENITENT</text><text class="ql" x="84" y="132">Made amends to everyone</text><text class="ql" x="84" y="156">but themselves.</text><text class="qv" x="84" y="258">FORGIVE YOURSELF FIRST</text></g></g>
            <g class="q q-int"><rect x="348" y="44" width="268" height="240" rx="6"/><g class="qt"><text class="qn" x="368" y="92">THE INTEGRATED</text><text class="ql" x="368" y="132">Told their people first.</text><text class="ql" x="368" y="156">The file confirms what</text><text class="ql" x="368" y="180">love already absorbed.</text><text class="qv" x="368" y="258">BRUISED AND WHOLE</text></g></g>
            <g class="q q-div"><rect x="64" y="300" width="268" height="240" rx="6"/><g class="qt"><text class="qn" x="84" y="348">THE DIVIDED</text><text class="ql" x="84" y="388">Avoided the mirror</text><text class="ql" x="84" y="412">and the apology.</text><text class="qv" x="84" y="514">FIRST HIT, HARDEST HIT</text></g></g>
            <g class="q q-sha"><rect x="348" y="300" width="268" height="240" rx="6"/><g class="qt"><text class="qn" x="368" y="348">THE SHAMELESS</text><text class="ql" x="368" y="388">At peace with themselves,</text><text class="ql" x="368" y="412">careless of the harm.</text><text class="qv" x="368" y="514">BARELY DENTED</text></g></g>
            <g class="q-hunt"><rect x="64" y="616" width="558" height="48" rx="6"/><circle cx="90" cy="640" r="7"/><text x="108" y="645">Off the chart: the Hunted, hiding to survive</text></g>
          </svg>
        </figure>
      </div>
      <div class="steps">
        <div class="step is-active" data-step="1"><div class="card"><p>How it goes for any one person comes down to two things. How fully they've accepted themselves, and how accountable they've been to the people they've affected.</p></div></div>
        <div class="step" data-step="2"><div class="card"><p>The Integrated already did the work. Their people heard it from them first, and they come through bruised and whole.</p></div></div>
        <div class="step" data-step="3"><div class="card"><p>The Shameless barely get dented. The Penitent made amends to everyone but themselves. The Divided avoided the mirror and the apology, and they get hit first and hardest.</p></div></div>
        <div class="step" data-step="4"><div class="card"><p>One group sits off the chart entirely, the people whose hiding keeps them alive. The woman who fled an abuser. The kid in a hostile house. The dissident. The index can't tell a hypocrite from someone in hiding.</p></div></div>
      </div>
    </div>
  </div>
</section>

<!-- VIII -->
<section class="chapter" id="come-to-jesus" data-chapter data-num="VIII" data-title="The Come-to-Jesus Move">
  <header class="chap"><span class="chap-n">VIII</span><h2>The Come-to-Jesus Move</h2><p class="chap-of">Chapter VIII of IX</p></header>
  <div class="scene at-1" data-scene="stones" data-step="1">
    <div class="scene-in">
      <div class="graphic">
        <figure class="exhibit ex-stones" role="img" aria-label="A row of figures, eldest to youngest, each holding a stone under the words The Accuser. The stones drop one by one, eldest first, and the line Get known before you get searched remains.">
          <svg viewBox="0 0 640 560" aria-hidden="true">
            <g class="acc"><text class="acc-t" x="320" y="118" text-anchor="middle" transform="rotate(-4 320 104)">THE ACCUSER</text><text class="acc-s" x="320" y="152" text-anchor="middle">Revelation 12:10</text></g>
            <g class="known"><text x="320" y="138" text-anchor="middle">GET KNOWN BEFORE</text><text x="320" y="206" text-anchor="middle">YOU GET SEARCHED.</text></g>
            <line class="ground" x1="40" y1="392" x2="600" y2="392"/>
            <g class="fig" style="--i:0"><circle cx="80" cy="250" r="17"/><rect x="60" y="272" width="40" height="118" rx="16"/><line class="arm" x1="94" y1="290" x2="108" y2="238"/></g>
            <g class="fig" style="--i:1"><circle cx="160" cy="250" r="17"/><rect x="140" y="272" width="40" height="118" rx="16"/><line class="arm" x1="174" y1="290" x2="188" y2="238"/></g>
            <g class="fig" style="--i:2"><circle cx="240" cy="250" r="17"/><rect x="220" y="272" width="40" height="118" rx="16"/><line class="arm" x1="254" y1="290" x2="268" y2="238"/></g>
            <g class="fig" style="--i:3"><circle cx="320" cy="250" r="17"/><rect x="300" y="272" width="40" height="118" rx="16"/><line class="arm" x1="334" y1="290" x2="348" y2="238"/></g>
            <g class="fig" style="--i:4"><circle cx="400" cy="250" r="17"/><rect x="380" y="272" width="40" height="118" rx="16"/><line class="arm" x1="414" y1="290" x2="428" y2="238"/></g>
            <g class="fig" style="--i:5"><circle cx="480" cy="250" r="17"/><rect x="460" y="272" width="40" height="118" rx="16"/><line class="arm" x1="494" y1="290" x2="508" y2="238"/></g>
            <g class="fig" style="--i:6"><circle cx="560" cy="250" r="17"/><rect x="540" y="272" width="40" height="118" rx="16"/><line class="arm" x1="574" y1="290" x2="588" y2="238"/></g>
            <circle class="stone" style="--i:0" cx="110" cy="228" r="10"/>
            <circle class="stone" style="--i:1" cx="190" cy="228" r="10"/>
            <circle class="stone" style="--i:2" cx="270" cy="228" r="10"/>
            <circle class="stone" style="--i:3" cx="350" cy="228" r="10"/>
            <circle class="stone" style="--i:4" cx="430" cy="228" r="10"/>
            <circle class="stone" style="--i:5" cx="510" cy="228" r="10"/>
            <circle class="stone" style="--i:6" cx="590" cy="228" r="10"/>
            <text class="age" x="80" y="420" text-anchor="middle">eldest</text>
            <text class="age" x="560" y="420" text-anchor="middle">youngest</text>
            <path class="dirt" d="M190 454q10 -8 20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0"/>
            <text class="dirt-t" x="320" y="492" text-anchor="middle">written in the dirt</text>
          </svg>
        </figure>
      </div>
      <div class="steps">
        <div class="step is-active" data-step="1"><div class="card"><p>Look at the god being built. An intelligence that knows every sin and forgives none. Scripture has a name for that figure. The accuser.</p></div></div>
        <div class="step" data-step="2"><div class="card"><p>The God of the come-to-Jesus moment does the opposite. &#8220;I will remember their sin no more.&#8221; Mercy as chosen forgetting.</p></div></div>
        <div class="step" data-step="3"><div class="card"><p>In John 8, the accusers walk away one by one, &#8220;beginning at the eldest.&#8221; They had the longest files.</p></div></div>
        <div class="step" data-step="4"><div class="card"><p>So when you're handed &#8220;damned if you use it, damned if you don't,&#8221; walk the third way.</p><p>Get known before you get searched.</p></div></div>
      </div>
    </div>
  </div>
  <section class="moves" aria-labelledby="moves-h">
    <h3 id="moves-h">Seven moves<small>Before Reveal Day</small></h3>
    <ol>
      <li><span class="mn">01</span><p><b>Search yourself first,</b> while your reckoning can still be private.</p></li>
      <li><span class="mn">02</span><p><b>Tell your people first.</b> Every secret has two possible narrators, you or a machine talking to a stranger. Be the first one.</p></li>
      <li><span class="mn">03</span><p><b>Be one person.</b> The index feeds on the double life, and a single life starves it.</p></li>
      <li><span class="mn">04</span><p><b>Walk backward with the blanket.</b> When you could look, love sometimes means leaving the file closed.</p></li>
      <li><span class="mn">05</span><p><b>Drop your stone.</b> The index runs on our hunger to condemn. Starve it.</p></li>
      <li><span class="mn">06</span><p><b>Build the mirror both ways.</b> If someone searches you, you see it. Your data is your property. In 1791, the same year Bentham published his Panopticon, America ratified the Fourth Amendment. Our papers live on servers now, and the principle holds.</p></li>
      <li><span class="mn">07</span><p><b>Guard your rough-draft room.</b> Read. Build your vocabulary. Raise kids who can imagine better wishes than the autocomplete.</p></li>
    </ol>
  </section>
</section>

<!-- IX -->
<section class="chapter" id="fear-not" data-chapter data-num="IX" data-title="Fear Not">
  <header class="chap"><span class="chap-n">IX</span><h2>Fear Not</h2><p class="chap-of">Chapter IX of IX</p></header>
  <div class="scene at-1" data-scene="vessel" data-step="1">
    <div class="scene-in">
      <div class="graphic">
        <figure class="exhibit ex-vessel" role="img" aria-label="A Greek water jar, the vessel of Aquarius, tips over and pours until the page floods.">
          <svg viewBox="0 0 520 620" aria-hidden="true">
            <defs><clipPath id="vclip"><path d="M226 92H294C294 100 290 104 286 106C283 124 282 140 286 156C334 172 374 208 376 262C378 334 344 412 302 466L314 494H206L218 466C176 412 142 334 144 262C146 208 186 172 234 156C238 140 237 124 234 106C230 104 226 100 226 92Z"/></clipPath></defs>
