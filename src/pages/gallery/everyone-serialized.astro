.ser .moves h3{font-family:var(--display);font-size:clamp(42px,5vw,76px);line-height:.88;text-transform:uppercase}
.ser .moves h3 small{display:block;margin-top:14px;font-family:var(--typed);font-size:13px;font-weight:400;letter-spacing:.14em;color:var(--fg-soft)}
.ser .moves ol{list-style:none;margin:0;padding:0;border-top:2px solid var(--fg)}
.ser .moves li{display:grid;grid-template-columns:72px minmax(0,1fr);gap:16px;padding:20px 0;border-bottom:1px solid var(--rule);max-width:62ch}
.ser .moves .mn{font-family:var(--display);font-weight:800;font-size:42px;line-height:.9;color:var(--acc)}
.ser .moves li b{font-weight:600}
@media (max-width:899px){
  .ser .moves{grid-template-columns:minmax(0,1fr)}
  .ser .moves li{grid-template-columns:52px minmax(0,1fr)}
  .ser .moves .mn{font-size:34px}
}

/* coda */
.ser .coda{position:relative;overflow:hidden;background:#14100b;color:#f1e9dc;padding:clamp(80px,16vh,180px) max(24px,4vw) 64px}
.ser .coda-eye{position:absolute;inset:0;width:100%;height:100%;opacity:.92;pointer-events:none}
.ser .coda-in{position:relative;max-width:1240px;margin:0 auto;min-height:min(70vh,640px);display:flex;flex-direction:column;justify-content:center}
.ser .coda-line{font-family:var(--display);font-weight:800;text-transform:uppercase;font-size:clamp(56px,10vw,150px);line-height:.86;letter-spacing:.01em;max-width:9ch;text-wrap:balance;text-shadow:0 2px 30px #14100b}
.ser .coda-by{margin-top:28px;font-family:var(--typed);font-size:14px;letter-spacing:.14em;text-transform:uppercase}
.ser .sources{position:relative;max-width:1240px;margin:clamp(64px,10vh,120px) auto 0;padding-top:28px;border-top:1px solid rgba(241,233,220,.28);display:grid;grid-template-columns:minmax(160px,240px) minmax(0,1fr);gap:24px;scroll-margin-top:var(--bar)}
.ser .sources h2{font-family:var(--typed);font-size:14px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
.ser .sources ol{margin:0;padding-left:1.5em;display:grid;gap:10px;font-size:16px;line-height:1.4}
.ser .sources a{color:#f1e9dc}
.ser .sources .note{grid-column:2;font-size:15px;line-height:1.5;opacity:.85}
.ser .coda :focus-visible{outline-color:#e3a13a}
@media (max-width:700px){.ser .sources{grid-template-columns:minmax(0,1fr)}.ser .sources .note{grid-column:1}.ser .coda-eye{opacity:.5}}

@media (prefers-reduced-motion:reduce){
  html:has(> body.ser){scroll-behavior:auto}
  :is(.ser,.ser *),:is(.ser,.ser *)::before,:is(.ser,.ser *)::after{transition-duration:.01ms!important;transition-delay:0s!important;animation:none!important}
}

  /* ---- the site's additions ---- */
  /* The way back to the Gallery: one discreet link at the bar's right end,
     after the depth gauge. Typed like the bar, it follows the page's depth
     colours; the frame mark alone on narrow phones, where the chapter label
     needs the room. */
  .ser .bar-end{display:flex;align-items:center;gap:16px;min-width:0}
  .ser .bar-exit{display:inline-flex;align-items:center;gap:9px;padding:8px 0 8px 16px;border-left:1px solid var(--rule);color:var(--fg-soft);text-decoration:none;text-transform:uppercase;letter-spacing:.14em;text-underline-offset:.3em;transition:color .9s ease,border-color .9s ease}
  .ser .bar-exit:hover{text-decoration:underline}
  .ser .bar-frame{display:block;flex:none;width:14px;height:11px}
  .ser .bar-frame rect{fill:none;stroke:currentColor;stroke-width:1.5}
  .ser .bar-frame .pic{fill:currentColor;stroke:none}
  /* Below 900px the bar holds the chapter label, the gauge and the link: the
     label gives way (it already ends in an ellipsis), the right end keeps
     its size. */
  @media (max-width:899px){.ser .bar-exit{border-left:0;padding-left:0}.ser .toc{min-width:0}.ser .bar-end{flex:none}}
  @media (max-width:520px){.ser .bar-exit{padding:16.5px 16px 16.5px 14px;margin-right:-16px}.ser .bar-exit-t{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}}
  /* The shared foot, on the coda's dark and the width of the sources, in the
     page's typed face. */
  .ser .ser-foot{max-width:1240px}
  .ser .ser-foot .scroll-foot__k,.ser .ser-foot .scroll-foot__btn,.ser .ser-foot .scroll-foot__next-label,.ser .ser-foot .scroll-foot__status{font-family:var(--typed)}
</style>
