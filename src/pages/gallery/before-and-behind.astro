  var sl=$('hinge'),leaf=$('leaf'),o=$('hl-open'),s=$('hl-shut'),last=+sl.value;
  function set(v,dir){leaf.style.setProperty('--a',n3(v*.8));o.classList.toggle('on',dir>0);s.classList.toggle('on',dir<0);}
  sl.addEventListener('input',function(){var v=+sl.value;if(v!==last)set(v,v>last?1:-1);last=v;});
  set(last,1);
})();

/* fig VII: what turns on the hinge */
(function(){
  var S={
    compass:{n:['north'],e:['east'],s:['south'],w:['west'],cap:'The cardinal points. Latin first calls the two poles cardines, the pivots the sky turns on, and then lends the word to east and west.'},
    year:{n:['Cancer','summer solstice'],e:['Libra','autumn equinox'],s:['Capricorn','winter solstice'],w:['Aries','spring equinox'],cap:'The cardinal signs, where each season turns, laid out like a day: spring rises at the left, summer stands at noon, winter sits at midnight. January opens a few days after that lowest hinge.'},
    chart:{n:['Midheaven'],e:['Descendant'],s:['Imum Coeli'],w:['Ascendant'],cap:'The four angles of a nativity. Manilius and Firmicus call them the cardines, and everything in the chart is read from them.'},
    town:{n:['north gate'],e:['decumanus','east'],s:['south gate'],w:['decumanus','west'],cap:'Roman surveyors named the north–south street of a camp or a town the cardo, after the axis the sky turns on. The decumanus crosses it east to west.'},
    virtue:{n:['prudence'],e:['justice'],s:['temperance'],w:['fortitude'],cap:'The cardinal virtues, so named by Ambrose in the fourth century: the four the rest of a life swings on.'}};
  var btns=document.querySelectorAll('[data-w]');
  function show(k){var d=S[k];
    $('w-n').textContent=d.n[1]||d.n[0];$('w-n2').textContent=d.n[1]?d.n[0]:'';
    $('w-s').textContent=d.s[0];$('w-s2').textContent=d.s[1]||'';
    $('w-e').textContent=d.e[0];$('w-e2').textContent=d.e[1]||'';
    $('w-w').textContent=d.w[0];$('w-w2').textContent=d.w[1]||'';
    $('wheel-cap').textContent=d.cap;}
  [].forEach.call(btns,function(b){b.addEventListener('click',function(){press(btns,b);show(b.getAttribute('data-w'));});});
  show('year');
})();

/* fig VIII: the gates */
var gatesOpen=true;
(function(){
  var g=$('gates'),b=$('gate-btn'),o=$('gate-out'),sec=$('sec-gates');
  b.addEventListener('click',function(){
    gatesOpen=!gatesOpen;g.classList.toggle('open',gatesOpen);
    b.textContent=gatesOpen?'Shut the gates':'Open the gates';
    o.textContent=gatesOpen?'Open. Rome is in arms.':'Shut. Peace on land and sea, for now.';
    sec.setAttribute('data-p',JSON.stringify({open:gatesOpen?1:0,east:.7,west:.7,veil:.35}));onScroll();
  });
})();

/* the wall of modern references */
(function(){
  var btns=document.querySelectorAll('[data-f]');
  [].forEach.call(btns,function(b){b.addEventListener('click',function(){press(btns,b);var f=b.getAttribute('data-f');each('#cards .card',function(c){c.hidden=!(f==='all'||c.getAttribute('data-c')===f);});});});
})();

/* ---------- the sill: a doorway behind the page, lit from both sides ---------- */
var cv=$('sill'),cx=cv.getContext('2d'),W=0,H=0,DPR=1,t0=performance.now();
var P={open:.35,east:.85,west:.85,veil:.1,swing:0},T={open:.35,east:.85,west:.85,veil:.1,swing:0};
function size(){DPR=Math.min(2,window.devicePixelRatio||1);W=innerWidth;H=innerHeight;cv.width=W*DPR;cv.height=H*DPR;cx.setTransform(DPR,0,0,DPR,0,0);}
addEventListener('resize',function(){size();if(reduce)draw(performance.now());});size();
var motes=[];for(var i=0;i<64;i++)motes.push({x:Math.random(),y:Math.random(),s:.012+Math.random()*.03,d:i%2?1:-1,r:.6+Math.random()*1.1,ph:Math.random()*6.28});
var lastT=0;
function draw(now){
  var t=(now-t0)/1000,dt=Math.min(.05,t-lastT);lastT=t;
  var k=reduce?1:.05;['open','east','west','veil','swing'].forEach(function(q){P[q]+=((T[q]||0)-P[q])*k;});
  cx.fillStyle='#0e0d11';cx.fillRect(0,0,W,H);
  var big=Math.max(W,H),g;
  g=cx.createRadialGradient(-W*.12,H*.58,0,-W*.12,H*.58,big*.85);g.addColorStop(0,'rgba(147,166,220,'+(.2*P.west)+')');g.addColorStop(1,'rgba(147,166,220,0)');cx.fillStyle=g;cx.fillRect(0,0,W,H);
  g=cx.createRadialGradient(W*1.12,H*.42,0,W*1.12,H*.42,big*.85);g.addColorStop(0,'rgba(233,180,92,'+(.2*P.east)+')');g.addColorStop(1,'rgba(233,180,92,0)');cx.fillStyle=g;cx.fillRect(0,0,W,H);

  var wide=W>1100,ax=wide?W*.8:W*.5,aw=Math.min(W*(wide?.2:.6),H*.4),r=aw/2,base=H*(wide?.9:.965),top=base-aw*2.05;
  function arch(){cx.beginPath();cx.moveTo(ax-r,base);cx.lineTo(ax-r,top+r);cx.arc(ax,top+r,r,Math.PI,0);cx.lineTo(ax+r,base);cx.closePath();}
  var th=Math.max(0,Math.min(1.42,P.open*1.4+(reduce?0:Math.sin(t*.55)*.16*P.swing)));
  cx.save();arch();cx.clip();
  g=cx.createLinearGradient(ax-r,0,ax+r,0);g.addColorStop(0,'rgba(147,166,220,'+(.03+.2*P.open*P.west)+')');g.addColorStop(1,'rgba(233,180,92,'+(.03+.22*P.open*P.east)+')');cx.fillStyle=g;cx.fillRect(ax-r,top,aw,base-top);
  var lw=r*Math.cos(th),sk=r*Math.sin(th)*.14;
  [[-1],[1]].forEach(function(a){var s=a[0],jx=ax+s*r,fx=jx-s*lw;
    cx.beginPath();cx.moveTo(jx,top-4);cx.lineTo(fx,top-4+sk);cx.lineTo(fx,base-sk*.5);cx.lineTo(jx,base);cx.closePath();
    cx.fillStyle='rgba(58,39,22,.62)';cx.fill();cx.strokeStyle='rgba(176,122,67,.55)';cx.lineWidth=1;cx.stroke();
    for(var j=1;j<4;j++){var yy=top+(base-top)*j/4;cx.beginPath();cx.moveTo(jx,yy);cx.lineTo(fx,yy+sk*(1-j/4));cx.strokeStyle='rgba(176,122,67,.22)';cx.stroke();}
  });
  cx.restore();
  arch();cx.strokeStyle='rgba(236,229,214,.2)';cx.lineWidth=1.2;cx.stroke();
  cx.beginPath();cx.arc(ax,top+r,r+9,Math.PI,0);cx.moveTo(ax-r-9,top+r);cx.lineTo(ax-r-9,base);cx.moveTo(ax+r+9,top+r);cx.lineTo(ax+r+9,base);cx.strokeStyle='rgba(236,229,214,.09)';cx.stroke();
  cx.beginPath();cx.moveTo(ax-r*1.7,base);cx.lineTo(ax+r*1.7,base);cx.moveTo(ax-r*2.1,base+10);cx.lineTo(ax+r*2.1,base+10);cx.strokeStyle='rgba(236,229,214,'+(wide?.16:.1)+')';cx.stroke();

  for(var i=0;i<motes.length;i++){var m=motes[i];if(!reduce){m.x+=m.d*m.s*dt;if(m.x>1.05)m.x=-.05;if(m.x<-.05)m.x=1.05;}
    var mx=m.x*W,my=base-(.08+m.y*.9)*(base-top)+Math.sin(t*.4+m.ph)*8,near=1-Math.min(1,Math.abs(mx-ax)/(W*.6));
    cx.beginPath();cx.arc(mx,my,m.r,0,6.283);cx.fillStyle=(m.d>0?'rgba(233,180,92,':'rgba(147,166,220,')+(.1+.3*near*P.open)+')';cx.fill();}
  cx.fillStyle='rgba(14,13,17,'+Math.min(.7,P.veil+(wide?0:.22))+')';cx.fillRect(0,0,W,H);
  if(!reduce)requestAnimationFrame(draw);
}
requestAnimationFrame(draw);

/* scroll: nearest block sets the doorway; the rail keeps both directions */
var blocks=[].slice.call(document.querySelectorAll('[data-p]')),fill=$('fill'),bar=$('bar-i'),state=$('state'),rt=$('r-top'),rb=$('r-bot'),flip=$('sec-prosso');
function onScroll(){
  var mid=innerHeight*.5,best=null,bd=1e9;
  blocks.forEach(function(b){var r=b.getBoundingClientRect(),d=r.top<=mid&&r.bottom>=mid?0:Math.min(Math.abs(r.top-mid),Math.abs(r.bottom-mid));if(d<bd){bd=d;best=b;}});
  if(best){try{var p=JSON.parse(best.getAttribute('data-p'));T={open:p.open,east:p.east,west:p.west,veil:p.veil,swing:p.swing||0};}catch(e){}}
  var total=document.documentElement.scrollHeight-innerHeight,pr=total>0?Math.min(1,Math.max(0,scrollY/total)):0;
  fill.style.height=(4+pr*96)+'%';bar.style.width=(pr*100)+'%';
  state.textContent=pr<.12?'outside':pr<.45?'on the sill':pr<.8?'under the lintel':'through';
  var greek=flip.getBoundingClientRect().top<innerHeight*.5;
  rt.textContent=greek?'πρόσσω':'read';rb.textContent=greek?'ὀπίσσω':'to come';rt.classList.toggle('gk',greek);rb.classList.toggle('gk',greek);
  if(reduce)draw(performance.now());
}
addEventListener('scroll',onScroll,{passive:true});onScroll();
})();
</script>
