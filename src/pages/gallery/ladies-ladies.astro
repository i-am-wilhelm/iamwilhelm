<script>
(() => {
  const svg = document.getElementById('plot') as unknown as SVGSVGElement | null;
  const dataEl = document.getElementById('ll-exhibits');
  if (!svg || !dataEl) return;
  const world = document.getElementById('world') as unknown as SVGGElement;
  const flaresG = document.getElementById('flares') as unknown as SVGGElement;
  const defs = document.getElementById('plotdefs') as unknown as SVGDefsElement;
  const wrap = document.getElementById('plotwrap') as HTMLElement;
  const glow = document.getElementById('glow') as HTMLElement;
  const eqs = document.getElementById('eqs') as HTMLOListElement;
  const panel = document.getElementById('panel') as HTMLElement;
  const help = document.getElementById('help') as HTMLElement;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const NS = 'http://www.w3.org/2000/svg';
  const { case: CASE, exhibits } = JSON.parse(dataEl.textContent || '{}');

  const el = (tag: string, attrs: Record<string, any>, parent?: Element): any => {
    const e = document.createElementNS(NS, tag);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (parent) parent.appendChild(e);
    return e;
  };
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
  /* Sample f over [x0, x1] into a path, lifting the pen outside the frame or below `lo` (a restricted domain such as {y > 0}). */
  const pathD = (f: (x: number) => number, x0: number, x1: number, n = 120, lo = -3.2) => {
    let d = '', pen = false;
    for (let i = 0; i <= n; i++) {
      const x = x0 + ((x1 - x0) * i) / n, y = f(x);
      if (!isFinite(y) || y < lo || y > 7.4) { pen = false; continue; }
      d += (pen ? 'L' : 'M') + x.toFixed(3) + ' ' + y.toFixed(3) + ' ';
      pen = true;
    }
    return d.trim();
  };
  const curve = (f: (x: number) => number, x0: number, x1: number, cls: string, g: Element, n?: number, lo?: number) => el('path', { d: pathD(f, x0, x1, n, lo), class: 'fx ' + cls }, g);
  const seg = (x1: number, y1: number, x2: number, y2: number, cls: string, g: Element) => el('line', { x1, y1, x2, y2, class: 'fx ' + cls }, g);
  const circ = (cx: number, cy: number, r: number, cls: string, g: Element) => el('circle', { cx, cy, r, class: cls }, g);
  /* Text inside the flipped world: a counter-flipped group, so it reads upright and leaves with its exhibit. */
  const upright = (g: Element) => el('g', { transform: 'scale(1,-1)' }, g);
  const txt = (g: Element, x: number, y: number, s: string, cls: string) => { const t = el('text', { x, y: -y, class: cls }, g); t.textContent = s; return t; };

  /* ---------- the underglow: placed in pixels from the world's own matrix, so it lands under the exhibit however the sheet letterboxes ---------- */
  let glowAt: [number, number, string] = [0, 0, 'off'];
  const placeGlow = () => {
    const [x, y, mode] = glowAt;
    const m = world.getScreenCTM();
    if (!m) return;
    const r = wrap.getBoundingClientRect();
    glow.style.left = m.a * x + m.c * y + m.e - r.left + 'px';
    glow.style.top = m.b * x + m.d * y + m.f - r.top + 'px';
    const scale = mode === 'full' ? 2.6 : mode === 'small' ? 0.45 : 0.75;
    glow.style.transform = `translate(-50%,-50%) scale(${scale})`;
    glow.classList.toggle('on', mode !== 'off');
    glow.classList.toggle('full', mode === 'full');
  };
  if ('ResizeObserver' in window) new ResizeObserver(placeGlow).observe(wrap);

  /* ---------- draggable points ---------- */
  const toGraph = (ev: PointerEvent) => {
    const pt = svg.createSVGPoint();
    pt.x = ev.clientX; pt.y = ev.clientY;
    const m = world.getScreenCTM();
    return m ? pt.matrixTransform(m.inverse()) : { x: 0, y: 0 };
  };
  interface HandleOpts { label: string; axis: 'x' | 'y' | 'xy'; min: number; max: number; hit: number; cls?: string }
  function handle(g: Element, x: number, y: number, r: number, o: HandleOpts) {
    const hit = circ(x, y, Math.max(r, o.hit), 'hit', g);
    const dot = circ(x, y, r, 'pt ' + (o.cls || ''), g);
    let cur = { x, y };
    let move: (x: number, y: number) => void = () => {};
    hit.setAttribute('tabindex', '0');
    hit.setAttribute('role', 'slider');
    hit.setAttribute('aria-label', o.label);
    hit.setAttribute('aria-valuemin', String(o.min));
    hit.setAttribute('aria-valuemax', String(o.max));
    if (o.axis !== 'xy') hit.setAttribute('aria-orientation', o.axis === 'y' ? 'vertical' : 'horizontal');
    const aria = () => {
      const v = o.axis === 'y' ? cur.y : cur.x;
      hit.setAttribute('aria-valuenow', v.toFixed(1));
      hit.setAttribute('aria-valuetext', o.axis === 'xy' ? `x ${cur.x.toFixed(1)}, y ${cur.y.toFixed(1)}` : `${o.axis} ${v.toFixed(1)}`);
    };
    aria();
    let active = false;
    hit.addEventListener('pointerdown', (e: PointerEvent) => { active = true; hit.setPointerCapture(e.pointerId); e.preventDefault(); });
    hit.addEventListener('pointermove', (e: PointerEvent) => { if (!active) return; const p = toGraph(e); move(p.x, p.y); });
    const up = () => { active = false; };
    hit.addEventListener('pointerup', up);
    hit.addEventListener('pointercancel', up);
    hit.addEventListener('keydown', (e: KeyboardEvent) => {
      const s = e.shiftKey ? 0.5 : 0.1;
      let dx = 0, dy = 0;
      if (e.key === 'ArrowLeft') dx = -s; else if (e.key === 'ArrowRight') dx = s; else if (e.key === 'ArrowUp') dy = s; else if (e.key === 'ArrowDown') dy = -s; else return;
      e.preventDefault();
      /* A slider with one axis answers all four arrows. */
      if (o.axis === 'x' && dy) { dx = dy; dy = 0; }
      if (o.axis === 'y' && dx) { dy = dx; dx = 0; }
      move(cur.x + dx, cur.y + dy);
    });
    return {
      onMove(fn: (x: number, y: number) => void) { move = fn; },
      set(nx: number, ny: number) {
        cur = { x: nx, y: ny };
        for (const c of [hit, dot]) { c.setAttribute('cx', nx); c.setAttribute('cy', ny); }
        aria();
      },
    };
  }

  /* ---------- flares: every coincidence ---------- */
  const flares: Record<string, SVGGElement> = {};
  const flare = (id: string, x: number, y: number) => {
    let f = flares[id];
    if (!f) {
      f = el('g', { class: 'flare live' }, flaresG);
      el('circle', { cx: x, cy: y, r: 0.12, class: 'core' }, f);
      el('circle', { cx: x, cy: y, r: 0.12, class: 'halo' }, f);
      flares[id] = f;
    }
    f.querySelectorAll('circle').forEach((c) => { c.setAttribute('cx', String(x)); c.setAttribute('cy', String(y)); });
    return f;
  };
  const setFlare = (id: string, s: string) => { flares[id]?.setAttribute('class', 'flare ' + s); };
  const killFlare = (id: string) => { const f = flares[id]; if (f) { f.remove(); delete flares[id]; } };

  /* ---------- the exhibits ---------- */
  const SEED_HOME = Array.from({ length: 6 }, (_, i) => {
    const a = Math.PI / 2 + (i * Math.PI * 2) / 6;
    return { x: 0.5 + 0.9 * Math.cos(a), y: 3.2 + 0.9 * Math.sin(a) };
  });
  const state = { windowY: 3, flameH: 6, seeds: SEED_HOME.map((p) => ({ ...p })), seedsMoved: false, origin: { x: 0, y: 0 } };
  const near = (a: number, b: number) => Math.abs(a - b) < 0.09;

  const DRAW: Record<string, (g: Element) => void> = {
    bench(g) { seg(-9, 0, 9, 0, 'gilt', g); },
    form(g) {
      seg(-8.5, 0.5, -8.5, 6.5, 'ink', g); seg(-2.5, 0.5, -2.5, 6.5, 'ink d1', g);
      seg(-8.5, 0.5, -2.5, 0.5, 'ink d2', g); seg(-8.5, 6.5, -2.5, 6.5, 'ink d3', g);
      [5.7, 4.9, 4.1, 3.3].forEach((y, i) => seg(-8, y, -3, y, 'ink hatch d' + (i + 3), g));
      txt(upright(g), -8.2, 6.0, 'BUREAU OF COINCIDENCE · FORM 302', 'ftxt');
    },
    window(g) {
      seg(3, 1, 3, 5, 'gilt', g); seg(-1, 7, 3, 3, 'gilt thin d1', g);
      flare('win', 3, 3);
      const h = handle(g, 3, state.windowY, 0.14, { label: 'Point on the window pane. Arrow keys move it.', axis: 'y', min: 1, max: 5, hit: 0.95 });
      const sync = () => setFlare('win', near(state.windowY, 3) ? 'live' : 'off');
      h.onMove((_x, y) => { state.windowY = clamp(y, 1, 5); h.set(3, state.windowY); sync(); });
      sync();
    },
    flame(g) {
      const outer = el('path', { class: 'fx ember' }, g), inner = el('path', { class: 'fx ember thin d2' }, g);
      const redraw = () => {
        const h0 = state.flameH;
        outer.setAttribute('d', pathD((x) => -2 * (x - h0) ** 2 + 4, 2, 9, 160, 0));
        inner.setAttribute('d', pathD((x) => -4 * (x - h0) ** 2 + 1, 2, 9, 160, 0));
        inner.style.strokeOpacity = String(Math.min(1, Math.abs(h0 - 6) * 1.6));
      };
      redraw();
      flare('flame', 6, 4);
      const h = handle(g, state.flameH, 4, 0.14, { label: 'Vertex of the flame. Arrow keys move it.', axis: 'x', min: 4.4, max: 8.4, hit: 0.95 });
      const sync = () => setFlare('flame', near(state.flameH, 6) ? 'live' : 'off');
      h.onMove((x) => { state.flameH = clamp(x, 4.4, 8.4); h.set(state.flameH, 4); redraw(); sync(); });
      sync();
    },
    pome(g) {
      const cx = 0.5, cy = 3.2;
      const fill = circ(cx, cy, 1.6, 'fill pome', g);
      circ(cx, cy, 1.6, 'fx pome', g);
      const sync = () => {
        state.seedsMoved = state.seeds.some((s, i) => Math.hypot(s.x - SEED_HOME[i].x, s.y - SEED_HOME[i].y) > 0.15);
        fill.style.opacity = state.seedsMoved ? '0' : '';
        setFlare('seed', state.seedsMoved ? 'off' : 'live');
      };
      state.seeds.forEach((s, i) => {
        const h = handle(g, s.x, s.y, 0.3, { label: `Seed ${i + 1} of six. Arrow keys move it.`, axis: 'xy', min: -0.78, max: 1.78, hit: 0.45, cls: 'seed fx thin d' + Math.min(6, i + 1) });
        h.onMove((x, y) => {
          const dx = x - cx, dy = y - cy, d = Math.hypot(dx, dy), r = 1.28;
          if (d > r) { x = cx + (dx / d) * r; y = cy + (dy / d) * r; }
          s.x = x; s.y = y; h.set(x, y); sync();
        });
      });
      flare('seed', SEED_HOME[5].x, SEED_HOME[5].y);
      sync();
    },
    intake(g) {
      const u = upright(g);
      const rows: [string, string, number][] = [['RULING PLANET', 'Venus', 5.3], ['HOUSE', 'Twelfth', 4.5], ['SIGN', 'Aries', 3.7], ['CONDITION', 'Pre-existing', 2.9]];
      for (const [k, v, y] of rows) { txt(u, -8.1, y, k, 'ftxt'); txt(u, -5.2, y, v, 'ftxt v'); }
    },
    venus(g) {
      curve((x) => 0.4 * Math.sin(2 * x) - 2.4, 4, 9, 'gilt thin', g, 160);
      circ(7, -0.4, 0.8, 'fx gilt d2', g);
      seg(7, -2.6, 7, -1.2, 'gilt d4', g);
      seg(6.5, -1.9, 7.5, -1.9, 'gilt d5', g);
    },
    word(g) {
      curve((x) => 0.3 * x * x - 2, -9, 9, 'ink thin', g);
      curve((x) => -0.5 * x + 3, -9, 9, 'ink thin d2', g);
      flare('w1', -5, 5.5);
      flare('w2', 10 / 3, 4 / 3);
    },
    seal(g) {
      g.classList.add('seal');
      if (!reduced) g.classList.add('stamp');
      const cx = -5.5, cy = 3.5, rt = 1.27;
      circ(cx, cy, 1.5, 'fx gilt', g);
      circ(cx, cy, 1.2, 'fx gilt thin', g);
      if (!document.getElementById('ll-ring')) el('path', { id: 'll-ring', d: `M ${cx - rt} ${-cy} a ${rt} ${rt} 0 1 1 ${2 * rt} 0 a ${rt} ${rt} 0 1 1 ${-2 * rt} 0` }, defs);
      const u = upright(g);
      const t = el('text', { class: 'sealtxt' }, u);
      const tp = el('textPath', { href: '#ll-ring', startOffset: '1%' }, t);
      tp.textContent = `BUREAU OF COINCIDENCE · CERTIFIED · CASE ${CASE} · `;
      const c = txt(u, cx, cy - 0.08, 'COINCIDENTAL', 'sealtxt c');
      c.setAttribute('text-anchor', 'middle');
    },
    origin(g) {
      const o = state.origin;
      const hl = seg(-9, o.y, 9, o.y, 'gilt hatch', g), vl = seg(o.x, -3, o.x, 7, 'gilt hatch d1', g);
      flare('origin', o.x, o.y);
      const h = handle(g, o.x, o.y, 0.16, { label: 'A free point. Arrow keys move it.', axis: 'xy', min: -8.8, max: 8.8, hit: 0.95 });
      h.onMove((x, y) => {
        state.origin = { x: clamp(x, -8.8, 8.8), y: clamp(y, -2.9, 6.9) };
        const p = state.origin;
        h.set(p.x, p.y);
        hl.setAttribute('y1', p.y); hl.setAttribute('y2', p.y);
        vl.setAttribute('x1', p.x); vl.setAttribute('x2', p.x);
        flare('origin', p.x, p.y);
        if (current === 10) { glowAt = [p.x, p.y, 'small']; placeGlow(); }
      });
    },
  };

  const present = (ex: any, step: number) => ex.from <= step && (ex.until === undefined || step < ex.until);
  const mounted: Record<string, SVGGElement> = {};
  const GLOW: Record<number, [number, number, string]> = { 1: [0, 0, 'small'], 2: [-5.5, 3.5, 'on'], 3: [3, 3, 'on'], 4: [6, 4, 'on'], 5: [0.5, 3.2, 'on'], 6: [7, -1.2, 'on'], 7: [0, 2, 'full'], 8: [0, 2, 'full'], 9: [-5.5, 3.5, 'full'], 10: [0, 0, 'small'] };
  /* Each flare's own section: live there, and at §7; an afterimage between; bright once at §9; gone at §10. */
  const FLARE_STEP: Record<string, number> = { win: 3, flame: 4, seed: 5, w1: 8, w2: 8 };

  function render(step: number) {
    for (const ex of exhibits) {
      const on = present(ex, step);
      if (on && !mounted[ex.id]) {
        const g = el('g', { class: 'ex in', 'data-ex': ex.id }, world);
        DRAW[ex.id]?.(g);
        mounted[ex.id] = g;
      } else if (!on && mounted[ex.id]) {
        mounted[ex.id].remove();
        delete mounted[ex.id];
      }
    }
    for (const id of Object.keys(FLARE_STEP)) {
      const s = FLARE_STEP[id];
      if (!flares[id]) continue;
      if (step === 10 || step < s) { killFlare(id); continue; }
      let st = 'after';
      if (step === s) {
        const out = (id === 'win' && !near(state.windowY, 3)) || (id === 'flame' && !near(state.flameH, 6)) || (id === 'seed' && state.seedsMoved);
        st = out ? 'off' : 'live';
      } else if (step === 7) st = 'live';
      else if (step === 9) st = 'bright';
      setFlare(id, st);
    }
    if (step < 10) killFlare('origin');
    glowAt = step === 10 ? [state.origin.x, state.origin.y, 'small'] : GLOW[step] || [0, 0, 'off'];
    placeGlow();
    help.classList.toggle('on', [3, 4, 5, 10].includes(step));
    renderPanel(step);
  }

  /* ---------- the equation panel: earlier lines muted, this section's in ink, typed in once ---------- */
  const typed: Record<string, boolean> = {};
  function renderPanel(step: number) {
    eqs.innerHTML = '';
    let n = 0;
    let last: HTMLElement | null = null;
    for (const ex of exhibits) {
      if (!present(ex, step)) continue;
      ex.eq.forEach((q: any, i: number) => {
        const li = document.createElement('li');
        const isCur = ex.from === step;
        if (q.word) {
          li.className = 'word' + (isCur ? ' cur' : '');
          li.innerHTML = '<b>σύμπτωμα</b> · σύν + πίπτω · <span class="m">that which falls together</span> · <b class="sym">SYMPTOM</b>';
          eqs.appendChild(li);
          if (isCur) last = li;
          return;
        }
        n++;
        li.className = (isCur ? 'cur ' : '') + (q.c || '');
        li.innerHTML = '<span class="n">' + String(n).padStart(2, '0') + '</span><span class="eq"></span>';
        const span = li.querySelector('.eq') as HTMLElement;
        const key = ex.id + ':' + i;
        if (isCur && !typed[key] && !reduced) {
          typed[key] = true;
          let k = 0;
          const s = q.t as string;
          const tick = () => { k++; span.textContent = s.slice(0, k); if (k < s.length) setTimeout(tick, 18 + Math.random() * 22); };
          setTimeout(tick, 220 + i * 260);
        } else {
          span.textContent = q.t;
          typed[key] = true;
        }
        eqs.appendChild(li);
        if (isCur) last = li;
      });
    }
    /* Keep the newest current line in view inside the panel, without scrolling the page. */
    const l = last as HTMLElement | null;
    if (l && panel.scrollHeight > panel.clientHeight) panel.scrollTop = Math.max(0, l.offsetTop + l.offsetHeight - panel.clientHeight + 4);
  }

  /* ---------- scroll: a section is in session while it crosses the middle band of the screen (on phones, the band just under the pinned figure) ---------- */
  const steps = Array.from(document.querySelectorAll<HTMLElement>('.ladies .step'));
  let current = 0;
  const activate = (n: number) => {
    if (n === current) return;
    current = n;
    steps.forEach((s) => s.classList.toggle('active', +(s.dataset.step || 0) === n));
    render(n);
  };
  if ('IntersectionObserver' in window) {
    const phone = window.matchMedia('(max-width: 860px)').matches;
    const io = new IntersectionObserver(
      (entries) => { for (const e of entries) if (e.isIntersecting) activate(+((e.target as HTMLElement).dataset.step || 1)); },
      { rootMargin: phone ? '-48% 0px -40% 0px' : '-42% 0px -48% 0px', threshold: 0 },
    );
    steps.forEach((s) => io.observe(s));
  }
  activate(1);
  /* If the page loads scrolled (a reload, a #s7 link), start at the nearest section. */
  requestAnimationFrame(() => {
    const mid = window.innerHeight * 0.5;
    let best = 1, bd = Infinity;
    for (const s of steps) {
      const r = s.getBoundingClientRect();
      const d = Math.abs((r.top + r.bottom) / 2 - mid);
      if (d < bd) { bd = d; best = +(s.dataset.step || 1); }
    }
    if (window.scrollY > 0) activate(best);
  });
})();
</script>
