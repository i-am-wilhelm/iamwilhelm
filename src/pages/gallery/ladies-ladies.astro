---
/**
 * Ladies, Ladies: the interlude between the poems. Minutes of a hearing
 * before the Bureau of Coincidence, in ten sections, beside one sheet of
 * graph paper on which every exhibit is an Algebra-I function with a
 * restricted domain. Ported from the owner's prototype
 * (docs/prototypes/ladies-ladies-prototype.html); its copy, palette and
 * pacing ship as written, the shell is the site's.
 *
 * The page: a pinned SVG exhibit (viewBox x −9..9, y −3..7; the world group
 * is flipped so graph y runs up) and an equation panel under it, beside the
 * minutes. Each section, as it crosses the middle of the screen, mounts its
 * exhibit (cumulative; the form and the intake fields unmount at §9, and
 * at §10 everything but the bench clears for one free point), types its equations into the panel, moves the underglow
 * (the rose light under the grid) and sets the flares (every intersection
 * is a coincidence: live in its own section and again at §7, an afterimage
 * between, brighter once when the seal stamps at §9, cleared at §10). The
 * window point, the flame's vertex, the six seeds and the last free point
 * drag with pointer, touch or arrow keys (role=slider; shift for 0.5).
 *
 * The functions live once, in EXHIBITS below: they feed the panel as served
 * (the whole record, for scripts off), the per-section lists the twin and
 * screen readers read, and the client script, which reads them from a JSON
 * block. The panel itself is aria-hidden, since it types character by
 * character. Each section's exhibit is described in one sentence by its
 * data-twin line. §9 carries data-og-frame, so `npm run og:scrollies` shoots
 * the seal stamped in the form's place with the afterimages brightened.
 *
 * Stylesheet scoped under body.ladies so Poem.astro's line, section and
 * fixed-stage rules cannot reach it.
 */
import Poem from '../../layouts/Poem.astro';
import SeriesMark from '../../components/scroll/SeriesMark.astro';
import Byline from '../../components/scroll/Byline.astro';
import ScrollFoot from '../../components/scroll/ScrollFoot.astro';
import MethodLink from '../../components/scroll/MethodLink.astro';
import { CONTACT_EMAIL, SCHEDULER_URL } from '../../config/site';
import { getPiece } from '../../lib/pieces';

const piece = await getPiece('ladies-ladies');
const { title, description, date } = piece;
const month = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });

/** The case number: Saturn's ecliptic longitude, 2°30' Aquarius, on the MC. */
const CASE = '302.30';

type Ink = 'gilt' | 'ink' | 'ember' | 'pome';
interface Eq {
  t: string;
  c?: Ink;
  word?: boolean;
}
interface Exhibit {
  id: string;
  /** The section that mounts it. */
  from: number;
  /** The section that unmounts it, if any. */
  until?: number;
  eq: Eq[];
}
const EXHIBITS: Exhibit[] = [
  { id: 'bench', from: 1, eq: [{ t: 'y = 0 {−9 < x < 9}', c: 'gilt' }] },
  {
    id: 'form',
    from: 2,
    until: 9,
    eq: [
      { t: 'x = −8.5 {0.5 < y < 6.5}', c: 'ink' },
      { t: 'x = −2.5 {0.5 < y < 6.5}', c: 'ink' },
      { t: 'y = 0.5 {−8.5 < x < −2.5}', c: 'ink' },
      { t: 'y = 6.5 {−8.5 < x < −2.5}', c: 'ink' },
    ],
  },
  {
    id: 'window',
    from: 3,
    until: 10,
    eq: [
      { t: 'x = 3 {1 < y < 5}', c: 'gilt' },
      { t: 'y = −x + 6 {−1 < x < 3}', c: 'gilt' },
    ],
  },
  {
    id: 'flame',
    from: 4,
    until: 10,
    eq: [
      { t: 'y = −2(x − 6)² + 4 {y > 0}', c: 'ember' },
      { t: 'y = −4(x − 6)² + 1 {y > 0}', c: 'ember' },
    ],
  },
  {
    id: 'pome',
    from: 5,
    until: 10,
    eq: [
      { t: '(x − 0.5)² + (y − 3.2)² = 2.56', c: 'pome' },
      { t: '(x − a)² + (y − b)² = 0.09  × 6', c: 'pome' },
    ],
  },
  {
    id: 'intake',
    from: 6,
    until: 9,
    eq: [
      { t: 'RULING PLANET = Venus', c: 'ink' },
      { t: 'HOUSE = 12 · SIGN = Aries', c: 'ink' },
      { t: 'CONDITION = pre-existing', c: 'ink' },
    ],
  },
  {
    id: 'venus',
    from: 7,
    until: 10,
    eq: [
      { t: 'y = 0.4·sin(2x) − 2.4 {4 < x < 9}', c: 'gilt' },
      { t: '(x − 7)² + (y + 0.4)² = 0.64', c: 'gilt' },
      { t: 'x = 7 {−2.6 < y < −1.2}', c: 'gilt' },
      { t: 'y = −1.9 {6.5 < x < 7.5}', c: 'gilt' },
    ],
  },
  {
    id: 'word',
    from: 8,
    until: 10,
    eq: [
      { t: 'y = 0.3x² − 2', c: 'ink' },
      { t: 'y = −0.5x + 3', c: 'ink' },
      { t: 'σύμπτωμα · σύν + πίπτω · that which falls together · SYMPTOM', word: true },
    ],
  },
  {
    id: 'seal',
    from: 9,
    until: 10,
    eq: [
      { t: '(x + 5.5)² + (y − 3.5)² = 1.5²', c: 'gilt' },
      { t: '(x + 5.5)² + (y − 3.5)² = 1.2²', c: 'gilt' },
    ],
  },
  { id: 'origin', from: 10, eq: [{ t: 'x = a · y = b', c: 'gilt' }] },
];
/* Graph paper past the viewBox on every side, so the sheet is ruled to its edges however the frame letterboxes it (SVG y, so graph y = −value). */
const range = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => a + i).filter((v) => v !== 0);
const GRID_Y = range(-15, 11);
const GRID_X = range(-23, 23);
const entered = (step: number) => EXHIBITS.filter((x) => x.from === step).flatMap((x) => x.eq);
let n = 0;
const record = EXHIBITS.flatMap((x) => x.eq.map((q) => ({ ...q, n: q.word ? 0 : ++n })));
---

<Poem
  title={title}
  description={description}
  year={String(date.getUTCFullYear())}
  published={date}
  night="#f4efe3"
  accent="#7d5f18"
  genre="Poetry"
  bodyClass="ladies"
  scheme="light"
  preload={[
    '/fonts/cormorant-garamond-latin-500-normal.woff2',
    '/fonts/eb-garamond-latin-wght-normal.woff2',
    '/fonts/jetbrains-mono-var.woff2',
  ]}
>
<main class="ll">

<header class="masthead">
  <p class="label">Room II · Interlude · Case No. {CASE}</p>
  <h1>Ladies, Ladies</h1>
  <p class="sub">Minutes of a hearing before the Bureau of Coincidence</p>
  <p class="label lower">Drawn in eleven functions on graph paper. The points are yours to move.</p>
  <p class="label kicker"><SeriesMark id="ladies-ladies" /> &middot; <Byline /> &middot; {month}</p>
</header>

<div class="hearing">
  <aside
    class="figure"
    aria-label="Exhibit: the hearing room, drawn in functions"
    data-twin="A sheet of graph paper stays pinned beside the minutes, x from −9 to 9 and y from −3 to 7, on which each section draws its exhibit as Algebra-I functions with restricted domains, every meeting of two of them flaring gilt as a coincidence, over a rose light that drifts to whichever exhibit is testifying; a panel under the sheet types each function's equation as it is entered on the record."
  >
    <div class="plotwrap" id="plotwrap">
      <div class="underglow" id="glow" aria-hidden="true"></div>
      <svg id="plot" viewBox="-9 -7 18 10" role="group" aria-label="Graph paper. Functions appear as the minutes proceed; the points that can be moved are sliders.">
        <defs id="plotdefs"></defs>
        <g id="grid" aria-hidden="true">
          {GRID_Y.map((y) => <line class="gridline" x1="-24" y1={y} x2="24" y2={y} />)}
          {GRID_X.map((x) => <line class="gridline" x1={x} y1="-16" x2={x} y2="12" />)}
          <line class="axis" x1="-24" y1="0" x2="24" y2="0" /><line class="axis" x1="0" y1="-16" x2="0" y2="12" />
          <text class="tick" x="-5.1" y=".38">−5</text><text class="tick" x="4.85" y=".38">5</text>
          <text class="tick" x=".1" y="-4.85">5</text><text class="tick" x=".1" y="-1.85">2</text><text class="tick" x=".1" y="2.2">−2</text>
        </g>
        <g id="world" transform="scale(1,-1)"></g>
        <g id="flares" transform="scale(1,-1)" aria-hidden="true"></g>
      </svg>
      <div class="help" id="help" aria-hidden="true">drag the point</div>
    </div>
    <div class="panel" id="panel" aria-hidden="true">
      <div class="ph">Functions on the record</div>
      <ol id="eqs">
        {
          record.map((q) =>
            q.word ? (
              <li class="word"><b>σύμπτωμα</b> · σύν + πίπτω · <span class="m">that which falls together</span> · <b class="sym">SYMPTOM</b></li>
            ) : (
              <li class={q.c}><span class="n">{String(q.n).padStart(2, '0')}</span><span class="eq">{q.t}</span></li>
            ),
          )
        }
      </ol>
    </div>
  </aside>

  <div class="minutes">

    <section class="step" data-step="1" id="s1">
      <p class="cue">§1 · y = 0</p>
      <h2>Call to order</h2>
      <p class="ll-sr" data-twin="The bench: the line y = 0, drawn in gilt across the whole sheet, with a small rose light under the origin.">The bench: the line y = 0, drawn in gilt across the whole sheet, with a small rose light under the origin.</p>
      <ul class="ll-sr">{entered(1).map((q) => <li>{q.t}</li>)}</ul>
      <p><span class="num">1.1</span>The Bureau of Coincidence convened at the hour of 2° Aquarius, the Presiding Officer taking the bench. The bench is a line. The Bureau notes for the record that it has always been a line.</p>
      <p><span class="num">1.2</span>Present: the Clerk, recording. The Author, respondent, appearing on his own behalf, having declined counsel on the grounds that "counsel would only make it worse." Seven complainants, represented by their exhibits. One intervenor, who had not yet arrived and whose arrival the Bureau did not anticipate.</p>
      <p><span class="num">1.3</span>The matter: whether the poems published by the Author under the headings <em>The Keeper and the Flame</em>, <em>Pharmakon</em>, and <em>The Unseen One Pleads His Case</em> bear resemblance to persons living, dead, or formerly dating the Author, and if so, whether said resemblance is, as his standard notice claims, purely coincidental.</p>
      <p><span class="num">1.4</span>The Clerk read the standard notice into the record. The Author mouthed along.</p>
    </section>

    <section class="step" data-step="2" id="s2">
      <p class="cue">§2 · a form, four hatched fields</p>
      <h2>The standard notice</h2>
      <p class="ll-sr" data-twin="The standard notice: a form drawn in ink from four restricted lines, x = −8.5 and x = −2.5 between y = 0.5 and 6.5, closed by y = 0.5 and y = 6.5, with four hatched field lines and the heading BUREAU OF COINCIDENCE · FORM 302.">The standard notice: a form drawn in ink from four restricted lines, x = −8.5 and x = −2.5 between y = 0.5 and 6.5, closed by y = 0.5 and y = 6.5, with four hatched field lines and the heading BUREAU OF COINCIDENCE · FORM 302.</p>
      <ul class="ll-sr">{entered(2).map((q) => <li>{q.t}</li>)}</ul>
      <p><span class="num">2.1</span>"The works in question are works of imagination. Any resemblance to actual persons, names, settings, hours of the night, windows, flames, fruit, or turns of phrase is purely coincidental."</p>
      <p><span class="num">2.2</span>The Presiding Officer asked the Author whether he stood by the notice. The Author stated that he did.</p>
      <p><span class="num">2.3</span>Asked whether he had written the notice himself, the Author stated that he had, "at about three in the morning, which I would like entered as a mitigating circumstance."</p>
      <p><span class="num">2.4</span>Entered.</p>
    </section>

    <section class="step" data-step="3" id="s3">
      <p class="cue">§3 · x = 3 · a beam strikes it at one point</p>
      <h2>Testimony of the Window</h2>
      <p class="ll-sr" data-twin="The Window: a vertical gilt line x = 3 between y = 1 and 5, struck by a thin beam y = −x + 6 at the single point (3, 3), which flares; the reader can drag the point up and down the pane, and the flare goes out once it leaves y = 3.">The Window: a vertical gilt line x = 3 between y = 1 and 5, struck by a thin beam y = −x + 6 at the single point (3, 3), which flares; the reader can drag the point up and down the pane, and the flare goes out once it leaves y = 3.</p>
      <ul class="ll-sr">{entered(3).map((q) => <li>{q.t}</li>)}</ul>
      <p><span class="num">3.1</span>The Window was sworn. The Window testified that it is a vertical line of restricted domain and has never been a window.</p>
      <p><span class="num">3.2</span>Asked why a complainant recognized it as the window of a specific apartment in a specific city in a specific winter, the Window stated: "A line of light hit me at one point. One point. That is what a coincidence is. Two things that happen to share a coordinate."</p>
      <p><span class="num">3.3</span>The Bureau asked the Author to respond.</p>
      <blockquote><p>I love from the other side of a window. I've said it in verse and I'll say it under oath. The window in the poem is the one I've been standing at since before I knew her name, or anyone's. If a real window happened to be where I was standing, that is the window's business.</p></blockquote>
      <p><span class="num">3.4</span>The Clerk notes that the Author's voice changed on the word <em>her</em> and resumed its normal register on the word <em>business</em>.</p>
      <p><span class="num">3.5</span>The Presiding Officer invited the reader to drag the point. The flare went out. The Bureau entered the result: <em>resemblance terminated at the reader's hand.</em></p>
    </section>

    <section class="step" data-step="4" id="s4">
      <p class="cue">§4 · a parabola, leading coefficient negative</p>
      <h2>Testimony of the Flame</h2>
      <p class="ll-sr" data-twin="The Flame: an ember parabola y = −2(x − 6)² + 4 above the axis, its vertex flaring at (6, 4), and an inner flame y = −4(x − 6)² + 1 that stays invisible while the vertex sits at x = 6; dragging the vertex sideways brings the inner flame back and puts the flare out.">The Flame: an ember parabola y = −2(x − 6)² + 4 above the axis, its vertex flaring at (6, 4), and an inner flame y = −4(x − 6)² + 1 that stays invisible while the vertex sits at x = 6; dragging the vertex sideways brings the inner flame back and puts the flare out.</p>
      <ul class="ll-sr">{entered(4).map((q) => <li>{q.t}</li>)}</ul>
      <p><span class="num">4.1</span>The Flame was sworn. The Flame stated that it is a parabola with a negative leading coefficient and declined to say more without a lamp present.</p>
      <p><span class="num">4.2</span>A complainant alleges that the Flame went out at the exact hour a certain conversation ended. The Flame testified that it goes out at the vertex, that every parabola does, and that it cannot be held responsible for conversations that also have vertices.</p>
      <p><span class="num">4.3</span>The Author, asked to respond:</p>
      <blockquote><p>I kept that flame for a long time. Keepers don't choose the weather. The poem is about the keeping. If someone recognized the hour, it's because hours like that are more common than any of us were told.</p></blockquote>
      <p><span class="num">4.4</span>The Presiding Officer asked whether the Keeper was himself. The Author said, "Your Honor, the Keeper is a man alone with a light he didn't make, waiting for a ship he can't signal. I'd prefer the Bureau not look into it."</p>
      <p><span class="num">4.5</span>The Bureau did not look into it. The reader may move the vertex and watch the inner flame return.</p>
    </section>

    <section class="step" data-step="5" id="s5">
      <p class="cue">§5 · a circle containing six points</p>
      <h2>Testimony of the Pomegranate</h2>
      <p class="ll-sr" data-twin="The Pomegranate: a deep red circle (x − 0.5)² + (y − 3.2)² = 2.56, faintly filled, holding six small seed circles at even spacing; the sixth seed flares, and moving any seed drains the fruit back to graph paper and puts the flare out.">The Pomegranate: a deep red circle (x − 0.5)² + (y − 3.2)² = 2.56, faintly filled, holding six small seed circles at even spacing; the sixth seed flares, and moving any seed drains the fruit back to graph paper and puts the flare out.</p>
      <ul class="ll-sr">{entered(5).map((q) => <li>{q.t}</li>)}</ul>
      <p><span class="num">5.1</span>The Pomegranate was sworn. It gave its name as an equation and asked that the record reflect it contains exactly six points, "which is a number, Your Honor, and numbers belong to everyone."</p>
      <p><span class="num">5.2</span>A complainant alleges the six seeds correspond to six specific things said over six specific months. The Pomegranate testified that six is six; that it has no months; and that if a reader counted to six in their own life and arrived somewhere painful, "the counting was theirs."</p>
      <p><span class="num">5.3</span>The Author asked permission to address the Pomegranate directly. Granted.</p>
      <blockquote><p>You were the hardest one. I wrote the Unseen One pleading because I know the plea. Six seeds is the number you can eat and still be allowed to leave for half the year. I'm not sorry it landed. I'm sorry where.</p></blockquote>
      <p><span class="num">5.4</span>The Pomegranate did not respond. The Clerk notes that the sixth seed remained lit for the remainder of the hearing. Move any seed and the fruit drains to graph paper.</p>
    </section>

    <section class="step" data-step="6" id="s6">
      <p class="cue">§6 · the form returns, fields filled</p>
      <h2>The Author's intake form</h2>
      <p class="ll-sr" data-twin="The intake form: the fields of the form fill in, RULING PLANET Venus, HOUSE Twelfth, SIGN Aries, CONDITION Pre-existing, and the rose light under the page leaves the exhibits for the empty margin at lower right.">The intake form: the fields of the form fill in, RULING PLANET Venus, HOUSE Twelfth, SIGN Aries, CONDITION Pre-existing, and the rose light under the page leaves the exhibits for the empty margin at lower right.</p>
      <ul class="ll-sr">{entered(6).map((q) => <li>{q.t}</li>)}</ul>
      <p><span class="num">6.1</span>The Presiding Officer reviewed the Author's intake form and noted the entry under <em>Ruling Planet</em>.</p>
      <p><span class="num">6.2</span>The Author confirmed the entry. "Venus. Twelfth house. In exile, if you want the technical word. She runs the chart from behind a wall and I write what comes through."</p>
      <p><span class="num">6.3</span>Asked whether this was offered as a defense, the Author said it was offered as a description. "Fantasy is going to keep happening, Your Honor. I'd rather the Bureau know in advance."</p>
      <p><span class="num">6.4</span>The Bureau entered the condition as pre-existing and noted that it did not, by itself, explain the window.</p>
      <p><span class="num">6.5</span>At this point the light under the page left the exhibits and moved to the empty margin, and the Clerk records that the room became warmer by a degree no instrument present could measure.</p>
    </section>

    <section class="step" data-step="7" id="s7">
      <p class="cue">§7 · a sine wave; a circle; a cross beneath it</p>
      <h2>Intervenor</h2>
      <p class="ll-sr" data-twin="The intervenor: a thin gilt sine wave y = 0.4·sin(2x) − 2.4 runs along the lower right like a sea, and above it the glyph of Venus assembles in order, a circle (x − 7)² + (y + 0.4)² = 0.64 and then a cross beneath it; the rose light fills the whole sheet, and every flare on the page lights at once.">The intervenor: a thin gilt sine wave y = 0.4·sin(2x) − 2.4 runs along the lower right like a sea, and above it the glyph of Venus assembles in order, a circle (x − 7)² + (y + 0.4)² = 0.64 and then a cross beneath it; the rose light fills the whole sheet, and every flare on the page lights at once.</p>
      <ul class="ll-sr">{entered(7).map((q) => <li>{q.t}</li>)}</ul>
      <p><span class="num">7.1</span>The intervenor entered without being announced. The Clerk records her as Aphrodite, appearing in her capacity as the Author's ruling planet, "and because she was in the area."</p>
      <p><span class="num">7.2</span>Asked on what basis she intervened, she stated: "Every resemblance in this room is mine. I put the light on the pane. I set the hour of the flame. I counted the seeds. He wrote down what I did. You are trying a stenographer."</p>
      <p><span class="num">7.3</span>Asked whether the resemblances were, then, intentional:</p>
      <blockquote><p><em>Nothing I do is intentional. I am the goddess of things falling together. A face and a poem. A hand and a hand. He stood at a window because I stood him there. If a woman stood on the other side, that is what windows are for.</em></p></blockquote>
      <p><span class="num">7.4</span>The Author asked to be heard.</p>
      <blockquote><p>She's not wrong. But I'd like the record to show that I stood there willingly. Every time.</p></blockquote>
      <p><span class="num">7.5</span>The Clerk notes that the intervenor looked at the Author for a period the minutes cannot record, and that the beam on the pane, the vertex of the flame, and the sixth seed were all lit at once, the only time in the Bureau's history that every exhibit has flared together.</p>
      <p><span class="num">7.6</span>The Presiding Officer asked the intervenor to state, for the record, the Greek for coincidence.</p>
    </section>

    <section class="step" data-step="8" id="s8">
      <p class="cue">§8 · two curves cross the page and meet twice</p>
      <h2>The word</h2>
      <p class="ll-sr" data-twin="The word: two thin ink curves, the parabola y = 0.3x² − 2 and the line y = −0.5x + 3, cross the whole sheet and meet twice, at (−5, 5.5) and (3.33, 1.33), and both meetings flare; the panel adds the word σύμπτωμα, from σύν and πίπτω, that which falls together: symptom.">The word: two thin ink curves, the parabola y = 0.3x² − 2 and the line y = −0.5x + 3, cross the whole sheet and meet twice, at (−5, 5.5) and (3.33, 1.33), and both meetings flare; the panel adds the word σύμπτωμα, from σύν and πίπτω, that which falls together: symptom.</p>
      <ul class="ll-sr">{entered(8).map((q) => <li>{q.t}</li>)}</ul>
      <p><span class="num">8.1</span>The intervenor stated: "<span lang="grc">σύμπτωμα</span>. That which falls together. Aristotle uses it for a chance meeting. The physicians use it for what the body shows when something is wrong underneath."</p>
      <p><span class="num">8.2</span>The Presiding Officer asked whether the Bureau understood her correctly: that the Greek word for <em>coincidence</em> is the Greek word for <em>symptom</em>.</p>
      <p><span class="num">8.3</span>"You have understood me. When he writes that a resemblance is purely coincidental, he is writing, in the older language, that it is purely symptomatic. Of what, I leave to the Bureau."</p>
      <p><span class="num">8.4</span>The Author, asked whether he wished to amend his standard notice in light of this testimony, stated that he did not. "It's accurate either way, Your Honor. That's the trouble with it."</p>
    </section>

    <section class="step" data-step="9" id="s9" data-og-frame>
      <p class="cue">§9 · two concentric circles, stamped</p>
      <h2>Findings and order</h2>
      <p class="ll-sr" data-twin={`Findings and order: the form and its fields lift away and a gilt seal stamps down in their place, two concentric circles centred at (−5.5, 3.5), BUREAU OF COINCIDENCE · CERTIFIED · CASE ${CASE} around the ring and COINCIDENTAL across the centre, while every earlier flare brightens once.`}>Findings and order: the form and its fields lift away and a gilt seal stamps down in their place, two concentric circles centred at (−5.5, 3.5), BUREAU OF COINCIDENCE · CERTIFIED · CASE {CASE} around the ring and COINCIDENTAL across the centre, while every earlier flare brightens once.</p>
      <ul class="ll-sr">{entered(9).map((q) => <li>{q.t}</li>)}</ul>
      <p><span class="num">9.1</span>The Bureau finds that the works bear resemblance to persons living, dead, and formerly dating the Author.</p>
      <p><span class="num">9.2</span>The Bureau finds that every such resemblance consists of two things sharing a coordinate, that the reader was able to terminate each resemblance by moving a single point, and that the resemblances were therefore coincidental within the meaning of the standard notice.</p>
      <p><span class="num">9.3</span>The Bureau further finds, on the intervenor's testimony, that the resemblances were also symptomatic, and that the two findings do not conflict.</p>
      <p><span class="num">9.4</span>The Author is <strong>certified coincidental</strong> and released into the custody of his ruling planet, who indicated she had him already.</p>
      <p><span class="num">9.5</span>The Bureau notes that the Author's condition is pre-existing and recurring, that further works are anticipated, and that each will be stamped on arrival.</p>
    </section>

    <section class="step" data-step="10" id="s10">
      <p class="cue">§10 · one point remains</p>
      <h2>The Bureau takes commissions</h2>
      <p class="ll-sr" data-twin="One point remains: everything clears but the bench, and a single free point at the origin carries two thin gilt lines, x = a and y = b, whose crossing flares wherever the reader drags it.">One point remains: everything clears but the bench, and a single free point at the origin carries two thin gilt lines, x = a and y = b, whose crossing flares wherever the reader drags it.</p>
      <ul class="ll-sr">{entered(10).map((q) => <li>{q.t}</li>)}</ul>
      <p><span class="num">10.1</span>The Bureau wishes it known that coincidences may also be arranged on purpose.</p>
      <p><span class="num">10.2</span>If you would like a poem that is about you, with your window, your hour, and your name on the intake form, the Author takes commissions. The resemblance will be intentional, certified as such, and yours to keep. Half to start, half at launch.</p>
      <p><span class="num">10.3</span>The intervenor asked to be listed as a reference. Granted.</p>
      <div class="cta">
