---
/**
 * The Unseen One Pleads His Case, in the Gallery: the descent treatment.
 * The poem lives in src/content/writings/the-unseen-one.md (treatment
 * descent) and renders here through Base.astro, with the WebGL stage, the
 * scroll choreography and the orchestra pit live, its movements read from
 * the markdown as `.section[data-section]`; the island in src/scripts/unseen
 * is mounted by boot.ts. It moved here from /writings/the-unseen-one/
 * (public/_redirects carries the 301) so every scroll page has one route.
 */
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Descent from '../../components/writings/Descent.astro';
import ScrollFoot from '../../components/scroll/ScrollFoot.astro';
import { SITE_NAME, SITE_URL } from '../../config/site';
import { ogImage } from '../../config/og';
import { getPiece } from '../../lib/pieces';

const post = await getEntry('writings', 'the-unseen-one');
if (!post || post.data.treatment !== 'descent') throw new Error('the-unseen-one: the writings entry must use the descent treatment.');
const piece = await getPiece('the-unseen-one');
const { Content } = await render(post);
const date = post.data.date;
const dateLabel = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const url = piece.url;
const fullTitle = `${post.data.title} · The Gallery · ${SITE_NAME}`;
/* The piece's own opening frame (public/og/the-unseen-one.jpg, from `npm run og:scrollies`), versioned by content hash. */
const image = ogImage(piece.ogPath);
const modified = piece.gallery?.data.updated ?? date;
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${url}#article`,
  mainEntityOfPage: url,
  url,
  headline: post.data.title,
  name: post.data.title,
  genre: 'Poetry',
  description: post.data.description,
  image,
  datePublished: date.toISOString(),
  dateModified: modified.toISOString(),
  author: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: 'Michael Wilhelm', url: `${SITE_URL}/` },
  isPartOf: { '@type': 'CollectionPage', name: 'The Gallery', url: `${SITE_URL}/gallery/` },
};
---

<Base title={fullTitle} description={post.data.description} fade={post.data.fade}>
  <Fragment slot="head">
    <link rel="canonical" href={url} />
    <link rel="alternate" type="text/html" title={`${post.data.title} · plain text`} href={piece.twinPath} />
    <meta name="theme-color" content="#17141a" />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content="Michael Wilhelm" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/cormorant-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="article:published_time" content={date.toISOString()} />
    <meta property="article:modified_time" content={modified.toISOString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={post.data.description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(article)} />
  </Fragment>
  <Descent id="the-unseen-one" title={post.data.title} dateLabel={dateLabel} dedication="Hades, to the Kore">
    <Content />
    <ScrollFoot slot="after" id="the-unseen-one" class="descent__foot" />
  </Descent>
</Base>
