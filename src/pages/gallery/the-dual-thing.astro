</style>

<script>
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- scroll-driven parameters ---------- */
  type P = Record<string, number>;
  const DEF: P = { egg: 0, scale: 1, crack: 0, mirror: 0, flash: 0, ash: 0, breath: 0, springs: 0, wheel: 0, exit: 0, gold: 0.5, veil: 0.3, still: 0 };
  const KEYS = Object.keys(DEF);
  function fill(p: P): P {
    const o: P = {};
    KEYS.forEach((k) => { o[k] = typeof p[k] === 'number' ? p[k] : DEF[k]; });
    return o;
  }
  const marks = Array.from(document.querySelectorAll<HTMLElement>('[data-p]')).map((el) => {
    let p: P = {};
    try { p = JSON.parse(el.getAttribute('data-p') || '{}'); } catch { p = {}; }
    return { el, p: fill(p), s: el.getAttribute('data-s') || '' };
  });

  let centers: number[] = [];
  function measure() {
    const sy = window.pageYOffset;
    centers = marks.map((m) => {
      const r = m.el.getBoundingClientRect();
      return sy + r.top + r.height / 2;
    });
  }
  function smooth(t: number) { return t * t * (3 - 2 * t); }
  let stateIdx = 0;
  function params(): P {
    if (!centers.length) return marks[0].p;
    const y = window.pageYOffset + window.innerHeight / 2;
    if (y <= centers[0]) { stateIdx = 0; return marks[0].p; }
    if (y >= centers[centers.length - 1]) { stateIdx = marks.length - 1; return marks[marks.length - 1].p; }
    let i = 0;
    while (i < centers.length - 1 && y > centers[i + 1]) i++;
    const a = marks[i].p, b = marks[i + 1].p;
    const t = smooth((y - centers[i]) / (centers[i + 1] - centers[i]));
    stateIdx = t < 0.5 ? i : i + 1;
    const o: P = {};
    KEYS.forEach((k) => { o[k] = a[k] + (b[k] - a[k]) * t; });
    return o;
  }

  /* ---------- canvas ---------- */
  const cv = document.getElementById('sky') as HTMLCanvasElement;
  const cx2 = cv.getContext('2d')!;
  let W = 0, H = 0, DPR = 1;
  const isSmall = window.innerWidth < 760;
  const N = isSmall ? 520 : 1000;
  type Part = { th: number; ph: number; sx: number; sy: number; sz: number; ax: number; ay: number; ad: number; bx: number; by: number; bs: number; wa: number; ws: number; r: number; a: number; tw: number; twv: number; x: number; y: number };
  let parts: Part[] = [];
  function rnd() { return Math.random(); }
  function gauss() { return (rnd() + rnd() + rnd() - 1.5) / 1.5; }

  function seed() {
    parts = [];
    for (let i = 0; i < N; i++) {
      const u = rnd(), v = rnd();
      parts.push({
        th: Math.acos(1 - 2 * u), ph: Math.PI * 2 * v,
        sx: rnd(), sy: rnd(), sz: rnd(),
        ax: rnd(), ay: Math.pow(rnd(), 2.2), ad: rnd(),
        bx: gauss(), by: rnd(), bs: 0.4 + rnd() * 0.8,
        wa: Math.PI * 2 * rnd(), ws: 0.7 + rnd() * 0.6,
        r: 0.6 + rnd() * 1.4, a: 0.35 + rnd() * 0.65, tw: rnd() * Math.PI * 2, twv: 0.6 + rnd() * 1.6,
        x: 0, y: 0,
      });
    }
  }
  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth; H = window.innerHeight;
    cv.width = Math.floor(W * DPR); cv.height = Math.floor(H * DPR);
    cv.style.width = W + 'px'; cv.style.height = H + 'px';
    cx2.setTransform(DPR, 0, 0, DPR, 0, 0);
    measure();
  }
  seed(); resize();
  window.addEventListener('resize', () => { resize(); }, { passive: true });
  window.addEventListener('load', measure);
  setTimeout(measure, 600);
  document.fonts?.ready.then(measure);

  /* pointer: the mirror remembers where you looked */
  let px = -1e4, py = -1e4, pact = 0;
  function onMove(e: MouseEvent | TouchEvent) {
    const t = 'touches' in e ? e.touches[0] : e;
    if (!t) return;
    px = t.clientX; py = t.clientY; pact = 1;
  }
  window.addEventListener('mousemove', onMove, { passive: true });
  window.addEventListener('touchmove', onMove, { passive: true });
  window.addEventListener('touchstart', onMove, { passive: true });
  window.addEventListener('mouseleave', () => { pact = 0; });
  window.addEventListener('touchend', () => { pact = 0; });

  /* lightning */
  let flashAt = -1e9, flashArmed = false, nextStrike = 0;
  let bolt: number[][] = [];
  function makeBolt() {
    bolt = [];
    const x = W * (0.5 + (rnd() - 0.5) * 0.5), y = -10;
    const ty = H * 0.55;
    const n = 14;
    for (let i = 0; i <= n; i++) {
      bolt.push([x + gauss() * 38 * (i > 0 ? 1 : 0), y + (ty - y) * (i / n)]);
    }
  }

  let goldPulse = 0; /* set by drinking from the right */
  let letheBias = 0; /* set by drinking from the left */

  let last = performance.now(), T = 0;
  function mix(a: number, b: number, t: number) { return a + (b - a) * t; }

  function frame(now: number) {
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    if (!reduce) T += dt;
    const P = params();

    /* lightning scheduling */
    if (!reduce) {
      if (P.flash > 0.5 && !flashArmed) { flashArmed = true; flashAt = now; makeBolt(); nextStrike = now + 5000 + rnd() * 4000; }
      if (P.flash <= 0.5) flashArmed = false;
      if (flashArmed && now > nextStrike) { flashAt = now; makeBolt(); nextStrike = now + 6000 + rnd() * 5000; }
    }
    const fl = Math.exp(-(now - flashAt) / 420) * P.flash;
    goldPulse *= Math.pow(0.35, dt);
    letheBias *= Math.pow(0.5, dt);

    /* sky ground */
    const g = cx2.createLinearGradient(0, 0, 0, H);
    const gold = P.gold;
    g.addColorStop(0, 'rgb(' + Math.round(mix(7, 14, gold * 0.4)) + ',' + Math.round(mix(7, 10, gold * 0.3)) + ',' + Math.round(mix(13, 12, gold)) + ')');
    g.addColorStop(1, 'rgb(' + Math.round(mix(9, 22, gold * 0.6 + goldPulse)) + ',' + Math.round(mix(9, 17, gold * 0.5 + goldPulse)) + ',' + Math.round(mix(16, 10, gold)) + ')');
    cx2.fillStyle = g; cx2.fillRect(0, 0, W, H);

    /* the egg's glow and the crack */
    const ecx = W * 0.5, ecy = H * 0.5, R = Math.min(W, H) * 0.26 * P.scale;
    if (P.egg > 0.02) {
      const rg = cx2.createRadialGradient(ecx, ecy, R * 0.2, ecx, ecy, R * 2.2);
      rg.addColorStop(0, 'rgba(227,184,90,' + 0.16 * P.egg + ')');
      rg.addColorStop(0.5, 'rgba(227,184,90,' + 0.04 * P.egg + ')');
      rg.addColorStop(1, 'rgba(227,184,90,0)');
      cx2.fillStyle = rg; cx2.fillRect(0, 0, W, H);
    }
    if (P.crack > 0.02 && P.egg > 0.02) {
      const ch = R * 1.25 * P.crack, cw = 1 + 26 * P.crack * P.crack;
      const cg = cx2.createLinearGradient(ecx - cw * 2, 0, ecx + cw * 2, 0);
      cg.addColorStop(0, 'rgba(255,240,200,0)');
      cg.addColorStop(0.5, 'rgba(255,240,200,' + 0.55 * P.crack * P.egg + ')');
      cg.addColorStop(1, 'rgba(255,240,200,0)');
      cx2.save();
      cx2.filter = 'blur(' + (2 + 8 * P.crack) + 'px)';
      cx2.fillStyle = cg;
      cx2.fillRect(ecx - cw * 2, ecy - ch, cw * 4, ch * 2);
      cx2.restore();
      cx2.fillStyle = 'rgba(255,246,214,' + 0.9 * P.crack * P.egg + ')';
      cx2.fillRect(ecx - 0.5, ecy - ch, 1, ch * 2);
    }

    /* the two springs */
    if (P.springs > 0.02) {
      const ly = H * 0.86, lx = W * 0.16, rx = W * 0.84;
      const lg = cx2.createRadialGradient(lx, ly, 0, lx, ly, Math.min(W, H) * 0.32);
      const la = (0.10 + 0.22 * letheBias) * P.springs;
      lg.addColorStop(0, 'rgba(185,199,216,' + la + ')'); lg.addColorStop(1, 'rgba(185,199,216,0)');
      cx2.fillStyle = lg; cx2.fillRect(0, 0, W, H);
      const rgg = cx2.createRadialGradient(rx, ly, 0, rx, ly, Math.min(W, H) * 0.32);
      const ra = (0.10 + 0.26 * goldPulse) * P.springs;
      rgg.addColorStop(0, 'rgba(227,184,90,' + ra + ')'); rgg.addColorStop(1, 'rgba(227,184,90,0)');
      cx2.fillStyle = rgg; cx2.fillRect(0, 0, W, H);
    }

    /* the wheel */
    const wcx = W * 0.5, wcy = H * 0.52, WR = Math.min(W, H) * 0.3;
    if (P.wheel > 0.02) {
      cx2.save();
      cx2.strokeStyle = 'rgba(227,184,90,' + 0.18 * P.wheel + ')';
      cx2.lineWidth = 1;
      cx2.beginPath();
      cx2.ellipse(wcx, wcy, WR, WR * 0.36, 0, 0, Math.PI * 2);
      cx2.stroke();
      cx2.restore();
    }

    /* weights */
    let wE = P.egg, wA = P.ash, wB = P.breath, wW = P.wheel;
    const sum = wE + wA + wB + wW;
    const wS = Math.max(0, 1 - sum);
    if (sum > 1) { wE /= sum; wA /= sum; wB /= sum; wW /= sum; }
    const rot = T * 0.11;
    const horizon = H * 0.62;
    const prad = 110, pstr = pact ? 14 : 0;

    for (let i = 0; i < N; i++) {
      const p = parts[i];
      /* egg */
      const st = Math.sin(p.th), ct = Math.cos(p.th);
      const ex = ecx + R * 0.78 * st * Math.cos(p.ph + rot);
      const ey = ecy + R * ct * 1.02;
      const ez = st * Math.sin(p.ph + rot); /* -1..1 depth */
      /* stars (slow drift) */
      const sx = ((p.sx * W + T * 2 * p.sz) % (W + 40)) - 20;
      const sy = p.sy * H;
      /* ash: settled low */
      const ay2 = H - p.ay * H * 0.42;
      const ax = p.ax * W + Math.sin(T * 0.3 + p.ad * 9) * 8;
      /* breath: a column rising */
      const brise = reduce ? p.by : (p.by + T * 0.06 * p.bs) % 1;
      const bx = W * 0.5 + p.bx * W * 0.075 * (0.4 + brise);
      const by = H * (0.95 - brise * 0.85);
      /* wheel: orbiting a tilted ring */
      const wa = p.wa + T * 0.28 * p.ws;
      const wx = wcx + WR * Math.cos(wa);
      const wy = wcy + WR * 0.36 * Math.sin(wa);
      const wz = Math.sin(wa);

      let x = wE * ex + wS * sx + wA * ax + wB * bx + wW * wx;
      let y = wE * ey + wS * sy + wA * ay2 + wB * by + wW * wy;

      /* the exit: particle 0 leaves the ring */
      const isExit = i === 0 && P.exit > 0.02 && P.wheel > 0.02;
      if (isExit) {
        const e = P.exit;
        x = wcx + WR * Math.cos(0.2) + e * W * 0.12;
        y = wcy + WR * 0.36 * Math.sin(0.2) - e * H * 0.62;
      }

      /* pointer: a breath across the mirror */
      if (pstr) {
        const dx = x - px, dy = y - py, d2 = dx * dx + dy * dy;
        if (d2 < prad * prad && d2 > 1) {
          const d = Math.sqrt(d2), k = (1 - d / prad) * pstr;
          x += (dx / d) * k; y += (dy / d) * k;
        }
      }

      /* colour and alpha */
      const tw = reduce ? 1 : 0.72 + 0.28 * Math.sin(T * p.twv + p.tw);
      const depth = wE * (0.55 + 0.45 * ez) + wW * (0.55 + 0.45 * wz) + (1 - wE - wW);
      let a = p.a * tw * depth * (1 - P.veil * 0.35);
      if (wA > 0.01) a *= 1 - wA * 0.45;
      let cr = Math.round(wE * 236 + wS * 205 + wA * 120 + wB * 233 + wW * 236);
      let cg = Math.round(wE * 196 + wS * 212 + wA * 124 + wB * 227 + wW * 196);
      let cb = Math.round(wE * 112 + wS * 232 + wA * 134 + wB * 213 + wW * 112);
      if (gold > 0 && wS > 0) { cr = Math.round(mix(cr, 236, gold * wS * 0.5)); cg = Math.round(mix(cg, 196, gold * wS * 0.5)); cb = Math.round(mix(cb, 112, gold * wS * 0.5)); }
      const rad = p.r * (1 + wE * ez * 0.5 + wW * wz * 0.4) * (isExit ? 2.4 : 1);
      if (fl > 0.01) { cr = Math.round(mix(cr, 255, fl)); cg = Math.round(mix(cg, 255, fl)); cb = Math.round(mix(cb, 255, fl)); a = Math.min(1, a + fl * 0.6); }
      cx2.fillStyle = 'rgba(' + cr + ',' + cg + ',' + cb + ',' + Math.max(0, Math.min(1, a)).toFixed(3) + ')';
      cx2.beginPath(); cx2.arc(x, y, rad, 0, Math.PI * 2); cx2.fill();
      if (isExit) {
        cx2.strokeStyle = 'rgba(236,196,112,' + 0.35 * P.exit + ')'; cx2.lineWidth = 1;
        cx2.beginPath(); cx2.moveTo(x, y); cx2.lineTo(x - P.exit * W * 0.05, y + P.exit * H * 0.22); cx2.stroke();
      }
      /* the mirror of Dionysus */
      if (P.mirror > 0.02 && y < horizon) {
        const my = horizon + (horizon - y) * 0.55;
        if (my < H) {
          cx2.fillStyle = 'rgba(' + cr + ',' + cg + ',' + cb + ',' + (a * 0.42 * P.mirror).toFixed(3) + ')';
          cx2.beginPath(); cx2.arc(x + Math.sin(T * 1.3 + p.tw) * 1.5, my, rad * 0.9, 0, Math.PI * 2); cx2.fill();
        }
      }
      p.x = x; p.y = y;
    }

    /* mirror horizon */
    if (P.mirror > 0.02) {
      const hg = cx2.createLinearGradient(0, horizon - 1, 0, H);
      hg.addColorStop(0, 'rgba(185,199,216,' + 0.14 * P.mirror + ')');
      hg.addColorStop(0.08, 'rgba(185,199,216,' + 0.02 * P.mirror + ')');
      hg.addColorStop(1, 'rgba(7,7,13,0)');
      cx2.fillStyle = hg; cx2.fillRect(0, horizon - 1, W, H - horizon + 1);
    }

    /* the bolt and the sheet */
    if (fl > 0.02 && bolt.length) {
      cx2.save();
      cx2.strokeStyle = 'rgba(255,250,235,' + 0.9 * fl + ')';
      cx2.lineWidth = 1.4; cx2.shadowColor = 'rgba(255,240,200,' + fl + ')'; cx2.shadowBlur = 18;
      cx2.beginPath(); cx2.moveTo(bolt[0][0], bolt[0][1]);
      for (let b = 1; b < bolt.length; b++) cx2.lineTo(bolt[b][0], bolt[b][1]);
      cx2.stroke();
      cx2.restore();
      cx2.fillStyle = 'rgba(255,246,222,' + 0.22 * fl + ')'; cx2.fillRect(0, 0, W, H);
    }

    /* veil toward the column */
    if (P.veil > 0.02) {
      cx2.fillStyle = 'rgba(7,7,13,' + P.veil * 0.5 + ')'; cx2.fillRect(0, 0, W, H);
    }

    updateRail(P);
    requestAnimationFrame(frame);
  }

  /* ---------- rail ---------- */
  const arc = document.getElementById('arc'), dot = document.getElementById('dot'), stateEl = document.getElementById('state');
  let lastState = '';
  function updateRail(P: P) {
    if (!arc || !dot || !stateEl) return;
    const prog = stateIdx / Math.max(1, marks.length - 1);
    const ang = -Math.PI / 2 + prog * Math.PI * 2;
    const cx = 27, cy = 27, r = 22;
    const x = cx + r * Math.cos(ang), y = cy + r * Math.sin(ang);
    const large = prog > 0.5 ? 1 : 0;
    arc.setAttribute('d', 'M ' + cx + ' ' + (cy - r) + ' A ' + r + ' ' + r + ' 0 ' + large + ' 1 ' + x.toFixed(2) + ' ' + y.toFixed(2));
    const out = P.exit;
    dot.setAttribute('cx', (x + out * 10 * Math.cos(ang)).toFixed(2));
    dot.setAttribute('cy', (y + out * 10 * Math.sin(ang)).toFixed(2));
    let s = marks[stateIdx].s;
    if (document.body.classList.contains('lethe')) s = 'forgetting';
    if (s !== lastState) { stateEl.textContent = s; lastState = s; }
  }

  /* ---------- reveal ---------- */
  const risers = Array.from(document.querySelectorAll<HTMLElement>('.rise'));
  if (!reduce && 'IntersectionObserver' in window) {
    document.body.classList.add('anim');
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) e.target.classList.remove('pre'); });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.1 });
    risers.forEach((el) => io.observe(el));
  } else {
    risers.forEach((el) => el.classList.remove('pre'));
  }

  /* ---------- the drink ---------- */
  const lethe = document.getElementById('lethe')!, mnemo = document.getElementById('mnemo')!, drank = document.getElementById('drank')!;
  lethe.addEventListener('click', () => {
    document.body.classList.add('lethe');
    lethe.setAttribute('aria-pressed', 'true'); mnemo.setAttribute('aria-pressed', 'false');
    letheBias = 1;
    drank.textContent = 'You drank on the left. Only the Greek still reads. Find the lake.';
    drank.classList.remove('on');
  });
  mnemo.addEventListener('click', () => {
    const was = document.body.classList.contains('lethe');
    document.body.classList.remove('lethe');
    mnemo.setAttribute('aria-pressed', 'true'); lethe.setAttribute('aria-pressed', 'false');
    goldPulse = 1;
    drank.textContent = was ? 'Γῆς παῖς εἰμι καὶ Οὐρανοῦ ἀστερόεντος. The page remembers.' : 'You went straight to the lake. The guards let you through.';
    drank.classList.add('on');
  });

  /* ---------- the leaf ---------- */
  const tb = document.getElementById('tablet-btn')!, ten = document.getElementById('tablet-en')!;
  tb.addEventListener('click', () => {
    const open = ten.hidden;
    ten.hidden = !open;
    tb.setAttribute('aria-expanded', open ? 'true' : 'false');
    tb.textContent = open ? 'fold it back' : 'read the leaf';
    measure();
  });

  requestAnimationFrame(frame);
</script>
