/* Mounted in Poem.astro: neutralise its main and section rules for this page.
   Poem's main sets z-index:1, which would lift the whole column, section
   backgrounds included, above the fixed sea canvas. */
.mimics main{max-width:none;margin:0;padding:0;z-index:auto}
.mimics section{display:block;min-height:0;gap:0;padding-block:0}

body.mimics{
  /* Layout: one reading column sinking through a painted water column; a depth gauge on the right edge reads the scroll as meters. */
  --glare:#eef4f5;
  --ink-day:#0d1a20;
  --ink-night:#e8eff1;
  --abyss:#02080d;
  --biolum:#7fd0ff;
  --dawn:#e2b062;
  --font-display:"Bodoni Moda","Bodoni 72",Didot,Georgia,serif;
  --font-body:"Literata","Iowan Old Style",Georgia,serif;
  --font-mono:"Martian Mono",ui-monospace,"SF Mono",Menlo,Consolas,monospace;
  --font-greek:"GFS Didot","Noto Serif","Times New Roman",serif;
  --measure:34rem;
  --gap:clamp(3.25rem,13vh,7.5rem);
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;overflow-x:clip}
body.mimics{margin:0;background:var(--abyss);color:var(--ink-night);font-family:var(--font-body);font-size:1.125rem;line-height:1.62;font-optical-sizing:auto;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;overflow-x:clip}
.mimics #sea{position:fixed;inset:0;width:100%;height:100%;z-index:1;pointer-events:none}
.mimics main{position:relative}
.mimics .water{background:linear-gradient(180deg,var(--from),var(--to))}
.mimics .day{color:var(--ink-day)}
.mimics .night{color:var(--ink-night)}
.mimics .col{position:relative;z-index:2;width:min(100% - 2.75rem,var(--measure));margin-inline:auto}
.mimics .flow>*{margin:0}
.mimics .flow>*+*{margin-top:var(--gap)}
.mimics .flow>.hint{margin-top:1.25rem}
.mimics p{text-wrap:pretty}
.mimics i,.mimics em{font-style:italic}

/* type */
.mimics .eyebrow{margin:0;font:600 .7rem/1.5 var(--font-mono);letter-spacing:.13em;text-transform:uppercase;opacity:.82}
.mimics .lead{font-size:1.3rem;line-height:1.5}
/* Bodoni Moda at screen sizes: a low optical size and a heavier weight keep the
   hairlines sturdy enough to read; the display cuts thin them almost to nothing. */
.mimics .pull{font-family:var(--font-display);font-style:italic;font-weight:540;font-variation-settings:"opsz" 14;font-size:clamp(1.75rem,6.6vw,2.6rem);line-height:1.18;text-wrap:balance}
.mimics .big{font-family:var(--font-display);font-weight:560;font-variation-settings:"opsz" 18;font-size:clamp(2.4rem,11vw,4.4rem);line-height:1.06;letter-spacing:-.005em;text-wrap:balance}
.mimics .gk{font-family:var(--font-greek);font-size:1.08em;-webkit-text-stroke:.012em currentColor}

/* zone headers */
.mimics .zone{padding:15vh 0 17vh}
.mimics .zone-head{display:grid;gap:.25rem}
.mimics .glyph{margin:.5rem 0 0;font-family:var(--font-greek);font-size:clamp(3.2rem,17vw,7rem);line-height:1.05;letter-spacing:.01em;-webkit-text-stroke:.02em currentColor}
.mimics .night .glyph{text-shadow:0 0 30px rgba(127,208,255,.34)}
.mimics .up .glyph{text-shadow:0 0 30px rgba(226,176,98,.32)}
.mimics .gloss{margin:0;font:400 .78rem/1.5 var(--font-mono);opacity:.8}
.mimics .zone-head h2{margin:1.1rem 0 0;font-family:var(--font-display);font-weight:560;font-variation-settings:"opsz" 18;font-size:clamp(2.3rem,10vw,4rem);line-height:1.04;letter-spacing:-.005em;text-wrap:balance}
.mimics .note{margin:.9rem 0 0;font-size:.95rem;line-height:1.55;opacity:.85;max-width:28rem}

/* cover: the surface, with the feed floating on it */
.mimics .cover{position:relative;overflow:hidden;padding:15vh 0 20vh}
.mimics .feed{position:absolute;inset:0}
.mimics .tile{position:absolute;left:var(--x);top:var(--y);width:7.2rem;padding:.42rem .42rem .5rem;border-radius:.85rem;background:rgba(255,255,255,.6);box-shadow:0 10px 28px rgba(13,26,32,.08);opacity:.62;transform:rotate(var(--r));animation:mm-bob 7s ease-in-out var(--d) infinite alternate}
.mimics .tile b{display:block;height:4.2rem;border-radius:.55rem;background:linear-gradient(135deg,var(--g1),var(--g2))}
.mimics .tile i{display:block;height:.3rem;width:72%;margin-top:.4rem;border-radius:.2rem;background:rgba(13,26,32,.12)}
.mimics .tile span{display:block;margin-top:.38rem;font:600 .6rem/1 var(--font-mono);color:rgba(13,26,32,.55)}
@keyframes mm-bob{from{transform:translateY(-6px) rotate(var(--r))}to{transform:translateY(6px) rotate(calc(var(--r) * -1))}}
.mimics .cover .eyebrow{margin-bottom:1.1rem}
.mimics .title,.mimics .reflection{margin:0;font-family:var(--font-display);font-weight:560;font-variation-settings:"opsz" 20;font-size:clamp(2.5rem,11.6vw,6rem);line-height:.98;letter-spacing:-.008em}
.mimics .title span,.mimics .title em,.mimics .reflection span,.mimics .reflection em{display:block}
.mimics .title em,.mimics .reflection em{font-style:italic;font-weight:480}
.mimics .reflection{position:relative;margin-top:.05em;margin-bottom:-.9em;opacity:.24;transform:scaleY(-1);filter:blur(.5px);-webkit-mask-image:linear-gradient(to top,#000 0%,rgba(0,0,0,.35) 35%,transparent 72%);mask-image:linear-gradient(to top,#000 0%,rgba(0,0,0,.35) 35%,transparent 72%);animation:mm-ripple 6s ease-in-out infinite alternate;user-select:none}
.mimics .reflection::after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(180deg,transparent 0 5px,rgba(234,242,243,.9) 5px 7px);animation:mm-drift 2.8s linear infinite}
@keyframes mm-ripple{0%{transform:scaleY(-1) skewX(0deg)}50%{transform:scaleY(-1.03) skewX(1.4deg) translateX(-2px)}100%{transform:scaleY(-.98) skewX(-1.1deg) translateX(2px)}}
@keyframes mm-drift{to{background-position:0 14px}}
.mimics .deck{margin:1.7rem 0 0;font-size:1.28rem;line-height:1.45;font-style:italic;max-width:22rem}
.mimics .byline{margin:1.4rem 0 0;font:600 .72rem/1.4 var(--font-mono);letter-spacing:.14em;text-transform:uppercase}
.mimics .cue{margin:2.2rem 0 0;display:flex;align-items:center;gap:.6rem;font:400 .72rem/1.4 var(--font-mono);letter-spacing:.1em;opacity:.72}
.mimics .cue::after{content:"↓";display:inline-block;animation:mm-nudge 1.8s ease-in-out infinite}
@keyframes mm-nudge{50%{transform:translateY(4px)}}

/* echo trail */
.mimics .echo span{font-style:italic}
.mimics .echo span:nth-child(1){opacity:.55}
.mimics .echo span:nth-child(2){opacity:.34}
.mimics .echo span:nth-child(3){opacity:.18}

/* the waterline */
.mimics .waterline{position:relative;height:72vh;min-height:26rem;overflow:hidden;background:linear-gradient(180deg,#bcd6dc 0 50%,#1d6d84 50% 100%)}
.mimics .wave{position:absolute;left:0;top:calc(50% - 20px);width:200%;height:40px;animation:mm-wave 9s linear infinite}
@keyframes mm-wave{to{transform:translateX(-50%)}}
.mimics .wl-text{position:absolute;left:0;right:0;top:50%;margin:0;transform:translateY(-50%);z-index:2;text-align:center;font-family:var(--font-display);font-style:italic;font-weight:540;font-variation-settings:"opsz" 18;font-size:clamp(2.8rem,14vw,6rem);line-height:1}
.mimics .wl-text span{display:block;padding:.06em 0}
.mimics .wl-a{color:var(--ink-day);clip-path:inset(0 0 50% 0)}
.mimics .wl-b{position:absolute;inset:0;color:var(--ink-night);clip-path:inset(50% 0 0 0)}

/* figures */
.mimics figure{margin:0}
.mimics .fig{display:grid;gap:.9rem}
.mimics .fig-num{margin:0;font:600 clamp(2.2rem,10vw,3.1rem)/1 var(--font-mono);letter-spacing:-.03em}
.mimics .fig-num small{margin-left:.5em;font-size:.34em;font-weight:400;letter-spacing:.02em;opacity:.78}
.mimics figcaption{font:400 .72rem/1.6 var(--font-mono);opacity:.78;max-width:30rem}
.mimics .key{display:flex;flex-wrap:wrap;gap:.4rem 1.2rem;font:400 .72rem/1.4 var(--font-mono)}
.mimics .key span::before{content:"";display:inline-block;width:.6rem;height:.6rem;margin-right:.45rem;border-radius:50%;vertical-align:-.04rem;background:var(--mark)}
.mimics .key span.off::before{background:var(--track)}
.mimics .units{display:grid;grid-template-columns:repeat(10,1fr);gap:clamp(4px,1.5vw,7px);width:min(100%,16rem)}
.mimics .units i{display:block;aspect-ratio:1;border-radius:50%;background:var(--track)}
.mimics .units i.on{background:var(--mark)}
.mimics .glow .units i.on{box-shadow:0 0 9px 1px rgba(127,208,255,.55);animation:mm-pulse 3.4s ease-in-out var(--d,0s) infinite}
@keyframes mm-pulse{0%,100%{opacity:1}50%{opacity:.5}}
.mimics .pair{display:grid;grid-template-columns:1fr 1fr;gap:1.6rem;max-width:22rem}
.mimics .pair>div{display:grid;gap:.55rem}
.mimics .pair p{margin:0;font:400 .74rem/1.3 var(--font-mono)}
.mimics .pair .val{font-weight:600;font-size:1.05rem}
.mimics .units.sm{width:100%;gap:4px}
.mimics .meter{display:grid;grid-template-columns:repeat(16,1fr);gap:2px;max-width:26rem}
.mimics .meter i{display:block;height:18px;border-radius:3px;background:var(--track)}
.mimics .meter i.on{background:var(--mark)}
.mimics .bars{display:grid;gap:.75rem;max-width:26rem}
.mimics .bar-row{display:grid;grid-template-columns:3.2rem 1fr;align-items:center;gap:.6rem}
.mimics .bar-yr{font:400 .78rem/1 var(--font-mono)}
.mimics .bar{display:flex;align-items:center;gap:.55rem}
.mimics .bar b{display:block;flex:none;height:18px;border-radius:0 4px 4px 0;background:var(--mark);width:calc((100% - 3.4rem) * var(--w))}
.mimics .bar b.past{background:var(--track)}
.mimics .bar-val{font:600 .9rem/1 var(--font-mono)}
.mimics .hint{display:inline-flex;align-items:center;gap:.65rem;font:600 .7rem/1.4 var(--font-mono);letter-spacing:.14em;text-transform:uppercase;opacity:.9}
.mimics .hint::before{content:"";width:.55rem;height:.55rem;border-radius:50%;background:var(--biolum);box-shadow:0 0 12px var(--biolum);animation:mm-pulse 2.4s ease-in-out infinite}

/* dive profile */
.mimics .dive svg{display:block;width:100%;max-width:26rem;height:auto;overflow:visible}
.mimics .dive .surf{stroke:currentColor;stroke-opacity:.4;stroke-width:1}
.mimics .dive .path{fill:none;stroke:var(--biolum);stroke-width:2;stroke-linejoin:round;stroke-linecap:round;filter:drop-shadow(0 0 4px rgba(127,208,255,.6))}
.mimics .dive .pt{fill:var(--biolum);stroke:#061b26;stroke-width:2}
.mimics .dive .diver{fill:#fff;filter:drop-shadow(0 0 6px rgba(127,208,255,.9))}
.mimics .dive .lbl{fill:currentColor;fill-opacity:.85;font:400 10px var(--font-mono)}

/* the bottom, the surfacing, the dawn */
.mimics .bottom{padding:24vh 0;text-align:center}
.mimics .bottom .col{display:grid;gap:1.3rem;justify-items:center}
.mimics .surfacing{height:62vh;min-height:22rem;background:radial-gradient(120% 60% at 50% 100%,rgba(242,198,122,.55),transparent 70%),linear-gradient(180deg,var(--from),var(--to))}
.mimics .final{padding:14vh 0 12vh}
.mimics .final .big{margin-top:1.3rem}
.mimics .actlike{margin:3rem 0 0;font-family:var(--font-display);font-style:italic;font-weight:620;font-variation-settings:"opsz" 20;font-size:clamp(3.4rem,16vw,6.4rem);line-height:.98;letter-spacing:-.012em}
.mimics .again{margin-top:3.2rem;display:inline-flex;align-items:center;gap:.6rem;padding:.8rem 1.25rem;border:1px solid currentColor;border-radius:999px;background:transparent;color:inherit;font:600 .74rem/1 var(--font-mono);letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
.mimics .again:hover{background:rgba(13,26,32,.07)}

/* soundings */
.mimics .soundings{padding:9vh 0 14vh}
.mimics .snd-h{margin:.6rem 0 0;font-family:var(--font-display);font-weight:560;font-variation-settings:"opsz" 14;font-size:clamp(1.7rem,6vw,2.3rem);line-height:1.12}
.mimics .snd{margin:2rem 0 0;padding-left:1.4rem;display:grid;gap:1rem;font-size:.9rem;line-height:1.55}
.mimics .snd li::marker{font-family:var(--font-mono);font-size:.75rem}
.mimics .snd a{color:inherit;text-decoration-thickness:1px;text-underline-offset:2px}
.mimics .colophon{margin:2.6rem 0 0;font:400 .72rem/1.5 var(--font-mono);letter-spacing:.08em;opacity:.78}
.mimics a:focus-visible,.mimics button:focus-visible{outline:2px solid currentColor;outline-offset:3px;border-radius:4px}

/* instrument: depth readout and gauge */
.mimics .readout{position:fixed;top:.75rem;right:.75rem;z-index:5;display:grid;justify-items:end;gap:.12rem;padding:.42rem .68rem .48rem;border-radius:.6rem;font-family:var(--font-mono);background:rgba(2,8,13,.45);color:var(--ink-night);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);transition:background-color .6s,color .6s}
html[data-ink="day"] body.mimics .readout{background:rgba(238,244,245,.66);color:var(--ink-day)}
.mimics .ro-depth{font-size:.8rem;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}
.mimics .ro-zone{font-size:.56rem;letter-spacing:.12em;text-transform:uppercase;opacity:.82;white-space:nowrap}
.mimics .gauge{position:fixed;right:6px;top:5.4rem;bottom:1.6rem;width:1px;z-index:5;color:var(--ink-night);transition:color .6s}
html[data-ink="day"] body.mimics .gauge{color:var(--ink-day)}
.mimics .gauge::before{content:"";position:absolute;inset:0;background:currentColor;opacity:.28}
.mimics .gauge i{position:absolute;left:-3px;width:7px;height:1px;background:currentColor;opacity:.55}
.mimics .gauge b{position:absolute;left:-4px;top:-4px;width:9px;height:9px;border-radius:50%;background:var(--biolum);box-shadow:0 0 10px var(--biolum);will-change:transform}
html[data-phase="up"] body.mimics .gauge b{background:var(--dawn);box-shadow:0 0 10px var(--dawn)}
html[data-ink="day"] body.mimics .gauge b{background:var(--ink-day);box-shadow:none}

@media (min-width:760px){
  body.mimics{font-size:1.2rem}
  .mimics .readout{top:1.1rem;right:1.4rem}
  .mimics .gauge{right:14px}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
  .mimics .dive .diver{display:none}
}

/* The gallery exit, matched to the depth readout: dark glass in the deep,
   pale glass at the surface. */
.mimics .poem-exit{font-family:var(--font-mono);font-size:.62rem;letter-spacing:.14em;border-radius:.6rem;background:rgba(2,8,13,.45);color:var(--ink-night);border:1px solid rgba(127,208,255,.32);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);transition:background-color .6s,color .6s,border-color .6s}
html[data-ink="day"] body.mimics .poem-exit{background:rgba(238,244,245,.66);color:var(--ink-day);border-color:rgba(13,26,32,.22)}
html[data-phase="up"] body.mimics .poem-exit{border-color:rgba(226,176,98,.4)}
.mimics .mm-foot{display:flex;justify-content:space-between;gap:.6rem 1rem;flex-wrap:wrap;margin-top:2.6rem;padding-top:1.1rem;border-top:1px solid rgba(13,26,32,.22);font:400 .68rem/1.6 var(--font-mono);letter-spacing:.16em;text-transform:uppercase}
.mimics .mm-foot a{color:inherit;text-underline-offset:.3em}

</style>

<script>
(() => {
  const root = document.documentElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const MAXD = 10935;
  const fmt = new Intl.NumberFormat('en-US');

  // unit charts and meters
  document.querySelectorAll('.units').forEach(el => {
    const n = +el.dataset.n || 0;
    const frag = document.createDocumentFragment();
    for (let i = 0; i < 100; i++) {
      const d = document.createElement('i');
      if (i < n) { d.className = 'on'; d.style.setProperty('--d', (Math.random() * -3.4).toFixed(2) + 's'); }
      frag.appendChild(d);
    }
    el.appendChild(frag);
  });
  document.querySelectorAll('.meter').forEach(el => {
    const n = +el.dataset.n || 0, total = +el.dataset.total || 16;
    for (let i = 0; i < total; i++) { const s = document.createElement('i'); if (i < n) s.className = 'on'; el.appendChild(s); }
  });

  // depth model: every [data-depth] element maps its own height to a depth range
  const segs = [...document.querySelectorAll('[data-depth]')].map(el => {
    const [a, b] = el.dataset.depth.split(',').map(Number);
    return { el, a, b, ink: el.dataset.ink || 'night', phase: el.dataset.phase || 'down', zone: el.dataset.zone || '' };
  });
  let geo = [], gH = 0;
  const gauge = document.querySelector('.gauge');
  const mark = gauge.querySelector('b');
  const roDepth = document.querySelector('.ro-depth');
  const roZone = document.querySelector('.ro-zone');

  function measure() {
    const y = window.scrollY;
    geo = segs.map(s => { const r = s.el.getBoundingClientRect(); return { top: r.top + y, h: Math.max(1, r.height) }; });
    gH = gauge.clientHeight;
  }
  function at(y) {
    let i = 0;
    for (let k = 0; k < geo.length; k++) if (y >= geo[k].top) i = k;
    const g = geo[i];
    return { i, t: Math.min(1, Math.max(0, (y - g.top) / g.h)) };
  }
  function inkAt(y) {
    const r = at(y), s = segs[r.i];
    if (s.ink !== 'split') return s.ink;
    const first = r.t < 0.5;
    return s.phase === 'up' ? (first ? 'night' : 'day') : (first ? 'day' : 'night');
  }
  function zoneName(d) {
    if (d < 1) return 'The surface';
    if (d < 200) return 'Sunlight zone';
    if (d < 1000) return 'Twilight zone';
    if (d < 4000) return 'Midnight zone';
    if (d < 6000) return 'The abyss';
    return 'Hadal zone';
  }

  const S = { depth: 0, phase: 'down' };
  let lastTxt = '', lastZone = '', lastInk = '', lastPhase = '';
  function update() {
    const sy = window.scrollY;
    const r = at(sy + window.innerHeight * 0.45), s = segs[r.i];
    S.depth = s.a + (s.b - s.a) * r.t;
    S.phase = s.phase;
    const zone = s.zone || zoneName(S.depth);
    const ink = inkAt(sy + 28);
    const arrow = S.depth >= 1 ? (S.phase === 'up' ? '▲ ' : '▼ ') : '';
    const txt = arrow + fmt.format(Math.round(S.depth)) + ' m';
    if (txt !== lastTxt) { roDepth.textContent = txt; lastTxt = txt; }
    if (zone !== lastZone) { roZone.textContent = zone; lastZone = zone; }
    if (ink !== lastInk) { root.dataset.ink = ink; lastInk = ink; }
    if (S.phase !== lastPhase) { root.dataset.phase = S.phase; lastPhase = S.phase; }
    const f = Math.sqrt(Math.max(0, S.depth) / MAXD);
    mark.style.transform = 'translate3d(0,' + (f * gH).toFixed(1) + 'px,0)';
  }

  // the sea: rays, bubbles, marine snow, bioluminescence
  const cvs = document.getElementById('sea');
  const ctx = cvs.getContext('2d');
  let W = 0, H = 0;
  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 1.75);
    W = window.innerWidth; H = window.innerHeight;
    cvs.width = Math.round(W * dpr); cvs.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  function sprite(rgb) {
    const s = document.createElement('canvas'); s.width = s.height = 64;
    const c = s.getContext('2d'); const g = c.createRadialGradient(32, 32, 0, 32, 32, 32);
    g.addColorStop(0, 'rgba(' + rgb + ',1)'); g.addColorStop(0.22, 'rgba(' + rgb + ',.6)');
    g.addColorStop(0.55, 'rgba(' + rgb + ',.14)'); g.addColorStop(1, 'rgba(' + rgb + ',0)');
    c.fillStyle = g; c.fillRect(0, 0, 64, 64); return s;
  }
  const BLUE = sprite('127,208,255'), GOLD = sprite('242,198,122');
  const R = (a, b) => a + Math.random() * (b - a);
  const snow = Array.from({ length: 64 }, () => ({ x: R(0, 1), y: R(0, 1), r: R(.5, 1.7), v: R(.006, .02), p: R(.25, .7), w: R(0, 6.28) }));
  const sparks = Array.from({ length: 42 }, () => ({ x: R(0, 1), y: R(0, 1), s: R(5, 16), ph: R(0, 6.28), sp: R(.6, 1.8), p: R(.15, .45), v: R(-.004, .004) }));
  const bubbles = Array.from({ length: 22 }, () => ({ x: R(0, 1), y: R(0, 1), r: R(1.2, 4), v: R(.03, .08), w: R(0, 6.28), p: R(.3, .8) }));
  const rays = Array.from({ length: 5 }, (_, i) => ({ x: (i + .5) / 5 + R(-.08, .08), w: R(40, 120), ph: R(0, 6.28) }));
  const bursts = [];
  const c01 = v => v < 0 ? 0 : v > 1 ? 1 : v;
  function weights() {
    const d = S.depth, up = S.phase === 'up';
    return {
      rays: up ? c01(1 - d / 320) : (d > 0 ? c01(1 - d / 230) : 0),
      bubbles: up ? 0 : (d > 0 ? c01(1 - d / 450) : 0),
      snow: c01((d - 120) / 900),
      sparks: c01((d - 800) / 1800)
    };
  }
  function wrap(p) {
    if (p.y < -0.05) p.y += 1.1; else if (p.y > 1.05) p.y -= 1.1;
    if (p.x < -0.05) p.x += 1.1; else if (p.x > 1.05) p.x -= 1.1;
  }
  let scrollDelta = 0, lastY = window.scrollY, T = 0;
  function step(dt) {
    const sd = scrollDelta / Math.max(1, H); scrollDelta = 0;
    const dir = S.phase === 'up' ? -1 : 1;
    for (const p of snow) { p.y += p.v * dt - sd * p.p * dir; p.x += Math.sin(T * .3 + p.w) * .0006; wrap(p); }
    for (const p of sparks) { p.y += p.v * dt - sd * p.p * dir; wrap(p); }
    for (const p of bubbles) { p.y -= p.v * dt + sd * p.p * dir; p.x += Math.sin(T * 1.4 + p.w) * .0008; wrap(p); }
    for (let i = bursts.length - 1; i >= 0; i--) {
      const b = bursts[i]; b.life -= dt;
      if (b.life <= 0) { bursts.splice(i, 1); continue; }
      b.x += b.vx * dt; b.y += b.vy * dt; b.vx *= .965; b.vy *= .965; b.vy -= 6 * dt;
    }
  }
  function draw() {
    ctx.clearRect(0, 0, W, H);
    const w = weights();
    if (w.rays > 0.01) {
      const gold = S.phase === 'up', c = gold ? '242,198,122' : '220,238,245';
      ctx.globalCompositeOperation = 'lighter';
      for (const r of rays) {
        const x = (r.x + Math.sin(T * .15 + r.ph) * .03) * W;
        const a = w.rays * (gold ? .16 : .1) * (.6 + .4 * Math.sin(T * .4 + r.ph));
        const g = ctx.createLinearGradient(0, 0, 0, H);
        g.addColorStop(0, 'rgba(' + c + ',' + a.toFixed(3) + ')'); g.addColorStop(1, 'rgba(' + c + ',0)');
        ctx.fillStyle = g; ctx.beginPath();
        ctx.moveTo(x - r.w * .5, 0); ctx.lineTo(x + r.w * .5, 0);
        ctx.lineTo(x + r.w * 1.6 + H * .18, H); ctx.lineTo(x - r.w * 1.1 + H * .18, H);
        ctx.closePath(); ctx.fill();
      }
    }
    ctx.globalCompositeOperation = 'source-over';
    if (w.bubbles > 0.01) {
      ctx.lineWidth = 1;
      for (const b of bubbles) {
        ctx.strokeStyle = 'rgba(235,246,250,' + ((.18 + .3 * b.p) * w.bubbles).toFixed(3) + ')';
        ctx.beginPath(); ctx.arc(b.x * W, b.y * H, b.r, 0, 6.283); ctx.stroke();
      }
    }
    if (w.snow > 0.01) {
      for (const p of snow) {
        ctx.fillStyle = 'rgba(214,228,234,' + (p.p * .55 * w.snow).toFixed(3) + ')';
        ctx.beginPath(); ctx.arc(p.x * W, p.y * H, p.r, 0, 6.283); ctx.fill();
      }
    }
    ctx.globalCompositeOperation = 'lighter';
    if (w.sparks > 0.01) {
      const spr = S.phase === 'up' && S.depth < 2600 ? GOLD : BLUE;
      for (const p of sparks) {
        const k = .5 + .5 * Math.sin(T * p.sp + p.ph);
        const a = w.sparks * (p.p + (1 - p.p) * k * k) * .85;
        if (a < .02) continue;
        ctx.globalAlpha = a; const s = p.s * (.7 + .3 * k);
        ctx.drawImage(spr, p.x * W - s, p.y * H - s, s * 2, s * 2);
      }
    }
    for (const b of bursts) {
      const a = Math.pow(b.life / b.max, 1.3); ctx.globalAlpha = a;
      const s = b.s * (.6 + .4 * a);
      ctx.drawImage(b.spr, b.x - s, b.y - s, s * 2, s * 2);
    }
    ctx.globalAlpha = 1; ctx.globalCompositeOperation = 'source-over';
  }
  let running = false, tPrev = 0;
  function frame(now) {
    if (!running) return;
    const dt = Math.min(0.05, (now - tPrev) / 1000); tPrev = now; T += dt;
    step(dt); draw();
    requestAnimationFrame(frame);
  }
  function start() { if (running || reduce) return; running = true; tPrev = performance.now(); requestAnimationFrame(frame); }
  function stop() { running = false; }
  document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else start(); });

  // tap the dark: light you make
  function burst(x, y, spr) {
    for (let i = 0; i < 20; i++) {
      const a = R(0, 6.283), v = R(20, 150), l = R(1, 2.2);
      bursts.push({ x, y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, life: l, max: l, s: R(4, 13), spr });
    }
    if (bursts.length > 160) bursts.splice(0, bursts.length - 160);
  }
  window.addEventListener('click', e => {
    if (reduce) return;
    if (e.target.closest && e.target.closest('a, button')) return;
    const w = weights();
    if (!(w.sparks > .12 || (S.phase === 'up' && S.depth > 300))) return;
    burst(e.clientX, e.clientY, S.phase === 'up' && S.depth < 2600 ? GOLD : BLUE);
  });

  // scroll, resize, start
  let ticking = false;
  window.addEventListener('scroll', () => {
    const y = window.scrollY; scrollDelta += y - lastY; lastY = y;
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(() => { ticking = false; update(); if (reduce) draw(); });
    }
  }, { passive: true });
  let rT = 0;
  window.addEventListener('resize', () => {
    clearTimeout(rT);
    rT = setTimeout(() => { measure(); resize(); update(); if (reduce) draw(); }, 120);
  });
  document.getElementById('again').addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });

  measure(); resize(); update();
  if (reduce) draw(); else start();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { measure(); update(); });
  window.addEventListener('load', () => { measure(); update(); });
})();
</script>
