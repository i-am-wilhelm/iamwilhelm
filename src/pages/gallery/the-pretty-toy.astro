  /* reveal */
  .essay .rise {
    transition:
      opacity 0.9s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .essay.anim .rise.pre {
    opacity: 0.16;
    transform: translateY(14px);
  }
  @media (prefers-reduced-motion: reduce) {
    .essay.anim .rise.pre {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  type P = { depth: number; ripple: number; bloom: number };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- scroll-driven parameters ----------
  const DEF: P = { depth: 0.04, ripple: 0.15, bloom: 1 };
  const KEYS = Object.keys(DEF) as (keyof P)[];
  function fill(p: Partial<P>): P {
    const o = { ...DEF };
    for (const k of KEYS) if (typeof p[k] === 'number') o[k] = p[k]!;
    return o;
  }
  const marks = Array.from(document.querySelectorAll<HTMLElement>('[data-p]')).map((el) => {
    let p: Partial<P> = {};
    try { p = JSON.parse(el.dataset.p!); } catch { p = {}; }
    return { el, p: fill(p) };
  });

  let centers: number[] = [];
  function measure() {
    const sy = scrollY;
    centers = marks.map((m) => {
      const r = m.el.getBoundingClientRect();
      return sy + r.top + r.height / 2;
    });
  }

  function params(): P {
    if (!centers.length) return fill({});
    const y = scrollY + innerHeight / 2;
    if (y <= centers[0]) return marks[0].p;
    if (y >= centers[centers.length - 1]) return marks[marks.length - 1].p;
    let i = 0;
    while (i < centers.length - 1 && centers[i + 1] < y) i++;
    const span = centers[i + 1] - centers[i];
    let t = span > 0 ? (y - centers[i]) / span : 0;
    t = t * t * (3 - 2 * t);
    const a = marks[i].p, b = marks[i + 1].p;
    const o = { ...DEF };
    for (const k of KEYS) o[k] = a[k] + (b[k] - a[k]) * t;
    return o;
  }

  // ---------- canvas ----------
  const cv = document.getElementById('water') as HTMLCanvasElement;
  const ctx = cv.getContext('2d')!;
  let W = 0, H = 0, DPR = 1;
  function resize() {
    DPR = Math.min(devicePixelRatio || 1, 1.5);
    W = cv.clientWidth; H = cv.clientHeight;
    cv.width = Math.round(W * DPR); cv.height = Math.round(H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    measure();
  }

  // the flower head: six tepals and a cup
  function flower(x: number, y: number, r: number, alpha: number, rot: number) {
    ctx.save();
    ctx.translate(x, y); ctx.rotate(rot); ctx.globalAlpha = alpha;
    for (let i = 0; i < 6; i++) {
      ctx.save(); ctx.rotate((i * Math.PI) / 3);
      ctx.beginPath(); ctx.moveTo(0, 0);
      ctx.bezierCurveTo(r * 0.42, -r * 0.18, r * 0.95, -r * 0.22, r, 0);
      ctx.bezierCurveTo(r * 0.95, r * 0.22, r * 0.42, r * 0.18, 0, 0);
      ctx.fillStyle = '#efe5bf'; ctx.fill(); ctx.restore();
    }
    ctx.beginPath(); ctx.arc(0, 0, r * 0.26, 0, 6.2832); ctx.fillStyle = '#e39a3c'; ctx.fill();
    ctx.beginPath(); ctx.arc(0, 0, r * 0.14, 0, 6.2832); ctx.fillStyle = '#8c4e14'; ctx.fill();
    ctx.restore();
  }

  function draw(P: P, time: number) {
    if (!W || !H) return;
    const t = time / 1000;
    const d = Math.max(0, Math.min(1, P.depth));

    // the pool
    const g = ctx.createLinearGradient(0, 0, 0, H);
    const topL = 22 - d * 12;
    g.addColorStop(0, `rgb(${(12 + topL * 0.6) | 0},${(18 + topL) | 0},${(26 + topL * 1.3) | 0})`);
    g.addColorStop(1, '#07090d');
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

    // a faint rim of light where the pool meets the meadow
    const horizon = H * (0.3 + d * 0.25);
    const hg = ctx.createLinearGradient(0, horizon - 40, 0, horizon + 40);
    hg.addColorStop(0, 'rgba(241,232,194,0)');
    hg.addColorStop(0.5, `rgba(241,232,194,${(0.09 * (1 - d)).toFixed(3)})`);
    hg.addColorStop(1, 'rgba(241,232,194,0)');
    ctx.fillStyle = hg; ctx.fillRect(0, horizon - 40, W, 80);

    // ripples from the point the flower touches the surface
    const fx = W * 0.62, fy = horizon + H * 0.16;
    const n = 7;
    for (let i = 0; i < n; i++) {
      const ph = ((reduce ? 0.5 : t * 0.11) + i / n) % 1;
      const r = ph * Math.min(W, H) * 0.42 * (0.6 + P.ripple);
      ctx.beginPath(); ctx.ellipse(fx, fy, r, r * 0.34, 0, 0, 6.2832);
      ctx.strokeStyle = `rgba(233,227,212,${((1 - ph) * 0.11 * (0.3 + P.ripple)).toFixed(3)})`;
      ctx.lineWidth = 1; ctx.stroke();
    }

    // the flower, and its reflection below it
    const R = Math.min(W, H) * 0.045;
    const bob = reduce ? 0 : Math.sin(t * 0.6) * 2;
    flower(fx, fy - R * 1.5 + bob, R, 0.9 * P.bloom, 0);
    ctx.save();
    ctx.translate(fx, fy + R * 1.5 - bob); ctx.scale(1, -0.85);
    flower(0, 0, R * (1 + P.ripple * 0.15), 0.32 * P.bloom * (1 - d * 0.5), reduce ? 0 : Math.sin(t * 0.4) * 0.08);
    ctx.restore();
    // the stem, into the water
    ctx.beginPath(); ctx.moveTo(fx, fy - R * 1.5 + bob + R * 0.3); ctx.lineTo(fx + R * 0.2, fy + H * 0.05);
    ctx.strokeStyle = `rgba(120,150,110,${(0.4 * P.bloom).toFixed(3)})`; ctx.lineWidth = 1.5; ctx.stroke();

    // the veil deepens with depth
    ctx.fillStyle = `rgba(7,9,13,${(d * 0.55).toFixed(3)})`; ctx.fillRect(0, 0, W, H);
  }

  // ---------- rail ----------
  const fillEl = document.getElementById('fill')!, stateEl = document.getElementById('state')!;
  let lastState = '';
  function rail(P: P) {
    const d = Math.max(0, Math.min(1, P.depth));
    fillEl.style.height = `${(4 + d * 96).toFixed(1)}%`;
    const s = d < 0.3 ? 'surface' : d < 0.62 ? 'reaching' : d < 0.86 ? 'stunned' : 'below';
    if (s !== lastState) { stateEl.textContent = s; lastState = s; }
  }

  // ---------- loop ----------
  // The scene paints once at load and comes alive on the first sign of a
  // reader (scroll, pointer, key), so a phone's first seconds go to the text.
  let engaged = false;
  const ENGAGE = ['scroll', 'wheel', 'pointerdown', 'pointermove', 'touchstart', 'keydown'] as const;
  function engage() {
    if (engaged) return;
    engaged = true;
    ENGAGE.forEach((ev) => removeEventListener(ev, engage));
    requestAnimationFrame(frame);
  }
  ENGAGE.forEach((ev) => addEventListener(ev, engage, { passive: true }));
  let current: P | null = null;
  let running = true;
  function frame(ts: number) {
    if (!running) return;
    const p = params();
    if (current === null) current = p;
    else for (const k of KEYS) current[k] += (p[k] - current[k]) * 0.06;
    draw(current, ts || 0);
    rail(current);
    if (!reduce && engaged) requestAnimationFrame(frame);
  }
  const still = () => { current = params(); draw(current, 0); rail(current); };

  resize();
  addEventListener('resize', () => { resize(); if (reduce) still(); });
  if (reduce) {
    still();
    addEventListener('scroll', still, { passive: true });
  } else {
    document.addEventListener('visibilitychange', () => {
      running = !document.hidden;
      if (running && engaged) requestAnimationFrame(frame);
    });
    requestAnimationFrame(frame);
  }

  // ---------- reveal, only below the first frame ----------
  if ('IntersectionObserver' in window) {
    const risers = Array.from(document.querySelectorAll<HTMLElement>('section .body, .still, .close-foot .colophon, .close-foot .links'));
    risers.forEach((el) => el.classList.add('rise'));
    document.body.classList.add('anim');
    const vh = innerHeight;
    const hidden = risers.filter((el) => el.getBoundingClientRect().top > vh * 0.86);
    hidden.forEach((el) => el.classList.add('pre'));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting) { en.target.classList.remove('pre'); io.unobserve(en.target); }
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });
    hidden.forEach((el) => io.observe(el));
  }

  addEventListener('load', measure);
  document.fonts?.ready.then(measure);
</script>
