    --petal: #f1e8c2; /* narcissus tepal */
    --cup: #e39a3c; /* the corona */
    --dim: #9aa3ad; /* gloss grey */
    --rule: #1b2430;
    font-size: clamp(1.19rem, 1.9vw, 1.44rem);
    line-height: 1.5;
  }
  .essay main.page {
    max-width: none;
    padding: 0;
  }
  .essay .wrap {
    max-width: 74ch;
    margin: 0 auto;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
