---
/**
 * Horoskopos ("hour-marker"), second of the Machines: a chart engine. It casts a
 * birth chart in the browser (Astronomy Engine for the planets; Chiron and
 * the four asteroids integrated from saved states; Placidus, whole-sign or
 * equal houses; the Vertex and the Hellenistic lots), and reads one chart as
 * a wheel or several together as a biwheel, a web of wired wheels, a grid
 * or a Davison chart. It opens empty until a chart is chosen; the library holds
 * historical figures by genre, each tagged with how its birth time is
 * known; a visitor's own data stays in the tab and is never sent or saved
 * (the city list is a file of the site's own, public/machines/natal/).
 *
 * Generated from the engine's source (the owner's Claude artifact,
 * claude.ai/artifact/WzrGQaWF2KJFTZdgaiaKhq): markup and stylesheet here,
 * scoped under body.natal so Poem.astro's globals cannot reach them; the
 * scripts are plain files in public/machines/natal/ and load as written.
 */
import Poem from '../../layouts/Poem.astro';
import SeriesMark from '../../components/scroll/SeriesMark.astro';
import Byline from '../../components/scroll/Byline.astro';
import ScrollFoot from '../../components/scroll/ScrollFoot.astro';
import MethodLink from '../../components/scroll/MethodLink.astro';
---

<Poem
  title="Horoskopos"
  description="Horoskopos, the hour-marker: a chart engine by Michael Wilhelm. Cast a birth chart, lay two together as a biwheel, a web, a grid or a Davison chart, and read which gods are talking."
  year="2026"
  night="#0b0a10"
  accent="#f2c56b"
  genre="Interactive"
  bodyClass="natal"
  exit={false}
  preload={['/fonts/literata-latin-opsz-normal.woff2', '/fonts/ibm-plex-mono-latin-500-normal.woff2']}
>
<main class="ne-main">
<header class="top" data-og-frame>
  <p class="eyebrow"><span>A machine · <Byline /></span><span><SeriesMark id="horoskopos" /></span></p>
  <h1>Horoskopos <span class="h1-gk" lang="grc">ὡροσκόπος</span></h1>
  <p class="deck">The hour-marker: a sky clock you can read. Cast a chart, lay two together, and watch which gods are talking.</p>
</header>

<section id="start" class="start" aria-label="Start">
  <h2>Whose sky?</h2>
  <p>Nothing is loaded yet. Cast your own chart, or pick one from the library.</p>
  <div class="start-go">
    <button class="big" data-start="self">Enter your birth details<small>Kept in this tab, never sent, never saved</small></button>
    <button class="big" data-start="lib">Choose a chart<small>Historical figures by field, or the sky right now</small></button>
  </div>
  <p class="fine"><button class="chip" data-start="house">Open the house chart</button></p>
</section>

<div class="rig">
  <div class="bench" role="region" aria-label="The chart">
    <div id="slots" class="slots"></div>
    <div id="views" class="views" role="tablist" aria-label="Views"></div>
    <p id="hint" class="hint"></p>
    <div id="focus" class="focus"></div>
    <div class="ne-stage" data-twin="A chart wheel drawn on a night field: the zodiac as a ring of twelve signs, the house lines, the planets as orbs of colored light, and lines between them for the aspects, each carrying a moving signal. Other views lay two charts together as rings, as wired wheels, as a grid, or as one Davison chart."><canvas id="sky" role="img" aria-label="Chart"></canvas><div id="tip" class="tip" role="status" hidden></div></div>
    <details id="tuning" class="tuning">
      <summary>Tuning</summary>
      <div class="tune">
        <div class="tune-row"><label for="tight">Orbs <span id="tightv"></span></label><input id="tight" type="range" min="0.4" max="1.5" step="0.05" value="1" aria-describedby="tightn"></div>
        <p id="tightn" class="fine" style="margin:-6px 0 0">Lower is stricter: only the closest lines stay.</p>
        <div class="tune-row"><span class="lab">Lines</span><button class="chip" data-tone="flow">Flowing</button><button class="chip" data-tone="grind">Grinding</button><button class="chip" data-tone="fuse">Fused</button></div>
        <div class="tune-row"><label for="hsys">Houses</label><select id="hsys"><option value="P">Placidus</option><option value="W">Whole sign</option><option value="E">Equal</option></select></div>
        <div class="tune-row"><button class="chip" data-tog="minor">Chiron and asteroids in the lines</button><button class="chip" data-tog="greek">Greek names</button><button class="chip" data-tog="still">Hold still</button></div>
      </div>
    </details>
  </div>

  <div class="panel" role="region" aria-label="The reading">
    <div id="facts"></div>
    <div id="card" aria-live="polite"></div>
    <div id="tabs" role="tablist" aria-label="Reading"><button role="tab" data-tab="placements">Placements</button><button role="tab" data-tab="aspects">Lines</button><button role="tab" data-tab="reading">Reading</button><button role="tab" data-tab="houses">Houses</button><button role="tab" data-tab="today">Today</button><button role="tab" data-tab="music">Music</button><button role="tab" data-tab="energies">Energies</button></div>
    <div id="body"></div>
  </div>
</div>

<footer class="after">
  <div>
    <h2>How to read it</h2>
    <p class="tones"><span class="tone-flow">Flowing: trine, sextile</span><span class="tone-grind">Grinding: square, opposition</span><span class="tone-fuse">Fused: conjunction</span></p>
    <p>A line is an aspect: two points standing at a telling angle. Thicker and brighter means closer to exact. Each planet sends its signal down the line in its own manner, so you can tell who is talking without a label.</p>
    <ul id="legend" class="legend"></ul>
  </div>
  <div>
    <h2>How it is made</h2>
    <p>Positions are worked out in your browser by Astronomy Engine (Don Cross, MIT licence). Checked against Swiss Ephemeris values for the house chart, the ten planets agree to within a tenth of an arcminute, and the angles and Placidus cusps agree to three decimal places. Checked against the published positions of every chart in the library, back to 1452, the Sun and Moon land within about an arcminute of the printed values.</p>
    <p>Chiron, Ceres, Pallas, Juno and Vesta are integrated from JPL orbital elements with the same library’s gravity model. Against published positions they land within an arcminute in 1879, within four arcminutes in 1756, and within a quarter of a degree in 1452, where Chiron itself stays within an arcminute. They sit on the wheel as quiet marks until you switch them into the lines under Tuning.</p>
    <p><b>The name.</b> <span lang="grc">Ὡροσκόπος</span>, hōroskopos, “hour-marker”, was the Greek astrologers’ word for the degree of the zodiac rising in the east at the moment of birth: the point the whole chart is counted from, and the word “horoscope” comes from.</p>
    <p>The North Node and the Black Moon are mean values. The lots follow the Hellenistic rule and flip by day and night: Fortune from Sun to Moon, Spirit from Moon to Sun, Eros from Spirit to Venus, each cast from the Ascendant.</p>
    <p>Library birth data comes from Astrotheme, whose reliability notes follow the Rodden scale. Every chart carries a tag saying how its birth time is known. Two charts (Fitzgerald and Freud) use a different clock standard for the birthplace than the source does, so their angles sit three to four degrees from the published ones.</p>
    <p>What you enter stays in this tab. The city list travels with the page, so even the place lookup happens here. Nothing is sent and nothing is saved.</p>
  </div>
  <div>
    <MethodLink />
    <p class="eyebrow"><span><a class="ne-back" href="/gallery/">The Gallery</a></span><span><SeriesMark id="horoskopos" /></span></p>
    <ScrollFoot id="horoskopos" class="ne-sf" />
  </div>
</footer>
</main>

<dialog id="library" aria-labelledby="lib-title">
  <div class="lib">
    <header><h2 id="lib-title">Choose a chart</h2><button data-close aria-label="Close">&times;</button></header>
    <div id="lib-body"></div>
    <form id="self" hidden novalidate>
      <button type="button" class="back" data-back>&larr; Library</button>
      <p class="priv">What you enter stays in this tab. It is never sent anywhere or saved, and it is gone when you close the page.</p>
      <label>Name <input id="f-name" autocomplete="off" placeholder="Optional"></label>
      <div class="two"><label>Birth date <input id="f-date" type="date" min="0100-01-01" max="2100-12-31"></label><label>Birth time <input id="f-time" type="time"></label></div>
      <label class="check"><input id="f-unknown" type="checkbox"> I do not know the time</label>
      <label>Birthplace <input id="f-place" autocomplete="off" placeholder="Start typing a city"></label>
      <div id="f-hits" class="hits"></div>
      <details class="hand"><summary>Set it by hand</summary>
        <div class="three"><label>Latitude <input id="f-lat" inputmode="text" placeholder="32.83"></label><label>Longitude <input id="f-lon" inputmode="text" placeholder="-109.71"></label><label>UTC offset <input id="f-off" inputmode="text" placeholder="-7"></label></div>
        <p class="fine">North and east are positive. The offset is hours ahead of UTC on the clock at the birth.</p>
      </details>
      <p id="f-offnote" class="fine"></p>
      <p id="f-err" class="err" role="alert"></p>
      <button class="go" type="submit">Cast the chart</button>
    </form>
  </div>
</dialog>

  <div id="cities" data-src="/machines/natal/cities.json" hidden></div>
  <script is:inline src="/machines/natal/astronomy.min.js"></script>
  <script is:inline src="/machines/natal/engine.js"></script>
</Poem>

<style is:global>
