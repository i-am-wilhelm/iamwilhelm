body.natal{--night:#0b0a10;--slab:#15131c;--slab2:#1c1925;--ink:#efe8d8;--mute:#aaa49b;--rule:#2d2935;--ichor:#f2c56b;--flow:#7fd8c4;--grind:#f0786a;--fuse:#f2c56b;
  --display:'Literata',Georgia,'Times New Roman',serif;--mono:'IBM Plex Mono',ui-monospace,'SFMono-Regular',Menlo,Consolas,monospace;color-scheme:dark}
body.natal *{box-sizing:border-box}

body.natal{margin:0;background:var(--night);color:var(--ink);font-family:var(--display);font-size:17px;line-height:1.5;-webkit-font-smoothing:antialiased}
:where(body.natal) button,:where(body.natal) input,:where(body.natal) select{font:inherit;color:inherit}
:where(body.natal) button{cursor:pointer;background:none;border:0;padding:0;-webkit-tap-highlight-color:transparent}
body.natal :focus-visible{outline:2px solid var(--ichor);outline-offset:2px}
body.natal [lang=grc]{font-family:var(--display);font-style:normal}
body.natal .lab,body.natal .eyebrow,body.natal .hint,body.natal .fine,body.natal .bd,body.natal .views button,body.natal .chip,body.natal .slot b,body.natal .slot i,body.natal #tabs button,body.natal .orb,body.natal .as small,body.natal .hs,body.natal .tune-row label,body.natal .lib-h,body.natal .fig small,body.natal .big small,body.natal .priv,body.natal .check,body.natal .err,body.natal .lib label{font-family:var(--mono);font-weight:500}

body.natal .top{padding:16px 16px 4px;max-width:1240px;margin:0 auto}
body.natal .eyebrow{display:flex;flex-wrap:wrap;gap:2px 14px;align-items:center;margin:0 0 8px;font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--mute)}
body.natal .eyebrow span{white-space:nowrap}
body.natal .eyebrow .rev{border:1px solid var(--ichor);color:var(--ichor);padding:1px 7px;border-radius:99px;letter-spacing:.08em}
body.natal h1{font-size:clamp(1.75rem,6.4vw,3.2rem);line-height:1.05;margin:0;font-weight:700;letter-spacing:-.01em}
body.natal .deck{margin:6px 0 0;font-style:italic;font-size:1rem;line-height:1.4;color:var(--ink);max-width:34em}

body.natal .rig{max-width:1240px;margin:0 auto;padding:10px 12px 0;display:grid;gap:18px}
body.natal .slots{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0 10px}
body.natal .slot{display:flex;align-items:stretch;border:1px solid var(--rule);border-radius:10px;background:var(--slab);min-height:44px;overflow:hidden}
body.natal .slot-main,body.natal .slot.add{display:flex;align-items:center;gap:9px;padding:6px 12px 6px 7px;text-align:left}
body.natal .slot b{display:grid;place-items:center;width:28px;height:28px;border-radius:7px;background:var(--c,var(--rule));color:#0b0a10;font-size:.8rem;font-weight:600;flex:none}
body.natal .slot span{font-size:.95rem;font-weight:600;line-height:1.15;max-width:36vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
body.natal .slot i{display:none;font-style:normal;font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--mute)}
body.natal .slot-x{padding:0 12px;border-left:1px solid var(--rule);color:var(--mute);font-size:1.2rem}
body.natal .slot.add{border-style:dashed;color:var(--mute)}body.natal .slot.add span{max-width:none}body.natal .slot.add b{background:transparent;border:1px dashed var(--mute);color:var(--mute)}
body.natal .views{display:flex;gap:4px;overflow-x:auto;scrollbar-width:none;border-bottom:1px solid var(--rule)}
body.natal .views::-webkit-scrollbar{display:none}
body.natal .views button{padding:10px 13px 9px;font-size:.76rem;letter-spacing:.1em;text-transform:uppercase;color:var(--mute);border-bottom:2px solid transparent;white-space:nowrap;min-height:44px}
body.natal .views button[aria-selected=true]{color:var(--ichor);border-bottom-color:var(--ichor)}
body.natal .views button:disabled{opacity:.38;cursor:not-allowed}
body.natal .hint{margin:9px 2px 4px;font-size:.72rem;line-height:1.5;color:var(--mute)}
body.natal .focus{display:flex;flex-wrap:wrap;gap:6px;align-items:center;min-height:0;margin:2px 0}
body.natal .focus:empty{display:none}
body.natal .lab{font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mute);margin-right:2px}
body.natal .chip{border:1px solid var(--rule);border-radius:99px;padding:7px 12px;font-size:.72rem;letter-spacing:.05em;color:var(--ink);background:var(--slab);min-height:36px}
body.natal .chip[aria-pressed=true]{border-color:var(--c,var(--ichor));color:var(--c,var(--ichor));background:rgba(242,197,107,.08)}
body.natal .ne-stage{position:relative;width:100%;aspect-ratio:1/1.06;max-height:74vh;margin:6px 0 0;border:1px solid var(--rule);border-radius:14px;background:radial-gradient(120% 90% at 50% 40%,#16131f 0%,#0b0a10 70%);overflow:hidden;touch-action:pan-y}
body.natal .ne-stage[data-mode=web]{aspect-ratio:1/1.3;max-height:84vh}body.natal .ne-stage[data-mode=grid]{aspect-ratio:1/1.02}
body.natal #sky{position:absolute;inset:0;width:100%;height:100%;display:block}
body.natal .tuning{scroll-margin-bottom:12px;margin:10px 0 0;border:1px solid var(--rule);border-radius:10px;background:var(--slab)}
body.natal .tuning summary{padding:11px 14px;font-family:var(--mono);font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mute);cursor:pointer;min-height:44px}
body.natal .tune{padding:2px 14px 14px;display:grid;gap:12px}
body.natal .tune-row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
body.natal .tune-row label{font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);min-width:5.5em}
body.natal .tune-row input[type=range]{flex:1;min-width:140px;accent-color:var(--ichor)}
body.natal .tune-row select{background:var(--night);border:1px solid var(--rule);border-radius:8px;padding:8px 10px;font-family:var(--mono);font-size:.8rem;min-height:40px}
body.natal [data-tone=flow][aria-pressed=true]{--c:var(--flow)}body.natal [data-tone=grind][aria-pressed=true]{--c:var(--grind)}body.natal [data-tone=fuse][aria-pressed=true]{--c:var(--fuse)}

body.natal .panel{min-width:0}
body.natal .fact{border-left:3px solid var(--c);padding:2px 0 2px 12px;margin:0 0 12px}
body.natal .fact h3{margin:0;font-size:1.12rem;line-height:1.25;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
body.natal .fact p{margin:3px 0 0;font-family:var(--mono);font-weight:500;font-size:.72rem;line-height:1.55;color:var(--mute)}
body.natal .bd{font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;padding:2px 7px;border-radius:99px;border:1px solid var(--rule);color:var(--mute);white-space:nowrap}
body.natal .bd-record{border-color:#5d8f7f;color:#9fe0cd}body.natal .bd-memory,body.natal .bd-bio{border-color:#8f8356;color:#e2d08c}body.natal .bd-rectified,body.natal .bd-question,body.natal .bd-unknown,body.natal .bd-conflict{border-color:#8f5b55;color:#f0a79c}body.natal .bd-self,body.natal .bd-now,body.natal .bd-own{border-color:var(--ichor);color:var(--ichor)}
body.natal .trail{display:flex;align-items:center;gap:5px;overflow-x:auto;white-space:nowrap;margin:0 0 10px;padding:2px 0 6px;scrollbar-width:thin;font-family:var(--mono);font-weight:500;font-size:.7rem}
body.natal .trail button{display:inline-flex;align-items:center;gap:4px;padding:6px 10px;border:1px solid var(--rule);border-radius:999px;color:var(--mute);flex:none;min-height:34px}
body.natal .trail button[aria-current]{color:var(--ink);border-color:var(--ichor);background:rgba(242,197,107,.1)}body.natal .trail button.ahead{opacity:.55;border-style:dashed}
body.natal .trail span{color:var(--mute);flex:none}body.natal .trail .gl{width:14px;height:14px}
body.natal .stop .eb{margin:0 0 1px;font-family:var(--mono);font-weight:500;font-size:.62rem;letter-spacing:.09em;text-transform:uppercase;color:var(--c)}
body.natal .stop .card-h>.gl{width:40px;height:40px}body.natal .stop .card-h>.gl.tx{font-size:1.2rem;color:var(--c)}
body.natal .stop .lesson{margin:12px 0 10px;line-height:1.55;font-size:1rem}
body.natal .stop .here{margin:0 0 10px;padding:10px 12px;border-radius:10px;background:rgba(255,255,255,.04);font-size:.95rem;line-height:1.55}
body.natal .stop .q{margin:0 0 10px;font-style:italic;color:var(--ichor)}
body.natal .next{display:flex;flex-wrap:wrap;gap:7px;align-items:center;margin-top:10px}
body.natal .next>span{width:100%;font-family:var(--mono);font-weight:500;font-size:.62rem;letter-spacing:.09em;text-transform:uppercase;color:var(--mute)}
body.natal .nx{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--rule);border-radius:999px;padding:7px 12px;font-size:.9rem;font-weight:600;min-height:38px;text-align:left;line-height:1.2;color:var(--ink)}
