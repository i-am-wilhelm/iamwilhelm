---
/**
 * The Keeper and the Flame, hung in the Gallery of Visualized Poetry.
 * One fixed canvas (sea, tower, beam, dawn) behind a single column of loose
 * lines. Each section sets the mood of the sea; the beam sweeps Fl W 7s and
 * turns toward a hand on the water. Sister page: /gallery/pharmakon/.
 */
import Poem from '../../layouts/Poem.astro';
---

<Poem
  title="The Keeper and the Flame"
  description="A visualized poem by Michael Wilhelm: a lighthouse keeper, the flame he tends, and the light that goes out across the world and comes back as the morning."
  year="2026"
  night="#05070d"
  accent="#ffb06a"
>
  <canvas id="sea" class="stage" aria-hidden="true"></canvas>

  <main>
    <header class="poem-head">
      <p class="char"><span>Light list</span><span>Character <b>Fl W 7s</b></span><span>Range <b>40 M</b></span><span>Station <b>the hidden house</b></span></p>
      <h1>The Keeper<br />and the <em>Flame</em></h1>
      <p class="log">scroll · the beam turns · tap the water to steer it</p>
    </header>

    <section data-mode="night">
      <p class="l" style="--ml:0%">There is a tower at the edge of the named world</p>
      <p class="l" style="--ml:14%">where the land gives up its argument with the sea,</p>
      <p class="l gap" style="--ml:4%">and a man lives there</p>
      <p class="l" style="--ml:30%">whose office is the light.</p>
    </section>

    <section data-mode="born">
      <p class="l" style="--ml:0%">He was born with fire</p>
      <p class="l" style="--ml:22%">in a windless room,</p>
      <p class="l gap" style="--ml:6%">a ram's heart</p>
      <p class="l" style="--ml:26%">issued to a hidden house,</p>
      <p class="l gap" style="--ml:0%">and told: <span class="ital">you will love from the high place,</span></p>
      <p class="l ital" style="--ml:40%">apart.</p>
      <p class="l gap dim" style="--ml:10%">The ships will know you only as the shining.</p>
    </section>

    <section data-mode="liturgy" class="stairs">
      <p class="l plain" style="--ml:0%">So he learned the keeper's liturgy.</p>
      <p class="l gap" style="--ml:0%">Climb before dusk.</p>
      <p class="l" style="--ml:14%">Trim the wick.</p>
      <p class="l" style="--ml:28%">Polish the lens</p>
      <p class="l plain" style="--ml:42%">until the one flame multiplies</p>
    </section>

    <section data-mode="wheel">
      <p class="l" style="--ml:8%">into a <span class="wheel-word">wheel</span> of <span class="wheel-word">suns</span>.</p>
      <p class="l count gap" style="--ml:0%">Count the turning beams across the water</p>
      <p class="l" style="--ml:10%">and call each sweep a word in a long sentence</p>
      <p class="l gap" style="--ml:0%">spoken to everyone,</p>
      <p class="l" style="--ml:34%">addressed to no one,</p>
      <p class="l dim" style="--ml:12%">received in full by the dark alone.</p>
    </section>

    <section data-mode="flame" class="flame-sec">
      <p class="l big" style="--ml:0%">And the flame!</p>
      <p class="l big" style="--ml:16%">Oh, the flame is her.</p>
      <p class="l gap" style="--ml:0%">She lives in the glass heart of the tower,</p>
      <p class="l" style="--ml:20%">the inward woman,</p>
      <p class="l" style="--ml:34%">the fire he tends,</p>
      <p class="l match gap" style="--ml:0%">ardent as a struck match,</p>
      <p class="l match" style="--ml:24%">sudden as spring,</p>
      <p class="l" style="--ml:6%">burning in <span class="aries">Aries red</span> behind the salt-fogged panes.</p>
    </section>

    <section data-mode="weather">
      <p class="l" style="--ml:0%">She is every rush of love he ever felt</p>
      <p class="l" style="--ml:16%">arrive like weather,</p>
      <p class="l" style="--ml:32%">vast and unannounced,</p>
      <p class="l grow gap" style="--ml:0%">too large for the doorways of the daylight world.</p>
      <p class="l gap" style="--ml:0%">He brings her oil.</p>
      <p class="l" style="--ml:18%">He brings her breath.</p>
      <p class="l gap" style="--ml:0%">He guards her from the gale</p>
      <p class="l" style="--ml:14%">and from his own impatience,</p>
      <p class="l" style="--ml:28%">which is her impatience,</p>
      <p class="l gap" style="--ml:6%">for they are <span class="onefire">one fire</span></p>
      <p class="l" style="--ml:30%">wearing two names.</p>
    </section>

    <section data-mode="secret">
      <p class="l" style="--ml:0%">This is the exile's secret,</p>
      <p class="l dim" style="--ml:20%">the one the charts keep:</p>
      <p class="l gap" style="--ml:0%">the <span class="cross">sentence</span> was a <span class="station">station</span> all along.</p>
      <p class="l gap" style="--ml:8%">The high place apart is where light serves.</p>
      <p class="l" style="--ml:0%">The hidden house is where the flame stays lit</p>
      <p class="l dim" style="--ml:18%">through storms that drown the lamps of open country.</p>
    </section>

    <section data-mode="water">
      <p class="l" style="--ml:0%">What he could never carry down the stairs</p>
      <p class="l wide" style="--ml:4%">He casts across forty miles of black water</p>
      <p class="l gap" style="--ml:0%">and the love that felt</p>
      <p class="l drift" style="--ml:12%;--dx:-6%">unhoused,</p>
      <p class="l drift" style="--ml:24%;--dx:8%">unlanded,</p>
      <p class="l drift" style="--ml:36%;--dx:-4%">hermit-strange,</p>
      <p class="l right gap">turns out to be the kind that reaches farthest.</p>
    </section>

    <section data-mode="lens">
      <p class="l" style="--ml:0%">Some nights he stands with her inside the lens,</p>
      <p class="l" style="--ml:12%">inside the turning wheel of their one burning,</p>
      <p class="l" style="--ml:24%">and feels the whole dark sea attend</p>
      <p class="l gap" style="--ml:0%">and understands</p>
      <p class="l" style="--ml:10%">the tower is a <span class="hand">body</span>,</p>
      <p class="l" style="--ml:22%">the flame a <span class="beat aries">heart</span>,</p>
      <p class="l" style="--ml:34%">the beam an <span class="hand">open hand</span>,</p>
      <p class="l gap" style="--ml:0%">and exile the name beginners give</p>
      <p class="l" style="--ml:14%">to the long apprenticeship of keeping fire.</p>
    </section>

    <section data-mode="dawn" class="end">
      <div class="keeps">
        <p class="l">He keeps it.</p>
        <p class="l big burns">She burns.</p>
      </div>
      <p class="l gap morning" style="--ml:0%">The light goes out across the world</p>
      <p class="l morning" style="--ml:16%">and comes back as the morning,</p>
      <p class="l stars-line morning gap" style="--ml:30%"><span class="star">star</span> by <span class="star">star</span> by <span class="star">star</span>.</p>
      <footer class="poem-foot"><span>Michael Wilhelm · 2026</span><a href="/gallery/">Return to the gallery</a></footer>
    </section>
  </main>
</Poem>

<style is:global>
  :root {
    --fg: #e6dfd0;
    --dim: #8a91a1;
    --aries: #ff3a1c;
    --ember: #ffb06a;
    --lens: #f6e7b2;
  }
  h1 {
    font-weight: 400;
    font-size: clamp(2.4rem, 7vw, 5.4rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  h1 em {
    font-style: italic;
    color: var(--aries);
    text-shadow: 0 0 24px rgba(255, 58, 28, 0.45);
  }
  .char {
    color: #aab0bf;
  }
  .char b {
    color: var(--ember);
  }
  body.dawn .char {
    color: #5a5248;
  }
  .log.in {
    color: var(--ember);
  }
  .aries {
    color: var(--aries);
  }

  /* stairs: the liturgy climbs */
  .stairs .l {
    font-family: var(--log);
    font-size: 0.62em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 2;
  }
  .stairs .l.plain {
    font-family: var(--display);
    font-size: 1em;
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.3;
  }

  /* wheel of suns */
  .wheel-word {
    display: inline-block;
    transition: letter-spacing 3s ease;
  }
  .in .wheel-word {
    letter-spacing: 0.2em;
    margin-right: -0.2em;
  }
  .count {
    transition: word-spacing 4s ease;
  }
  .count.in {
    word-spacing: 0.9em;
  }

  /* the flame */
  .flame-sec {
    align-items: flex-start;
  }
  .big {
    font-size: 1.9em;
    line-height: 1;
    max-width: none;
    color: var(--aries);
    font-style: italic;
    text-shadow: 0 0 0.35em rgba(255, 58, 28, 0.5), 0 0 1.4em rgba(255, 58, 28, 0.25);
  }
  .big.in {
    animation: flicker 5.5s steps(1, end) infinite;
  }
  @keyframes flicker {
    0%, 100% { opacity: 1; }
    7% { opacity: 0.86; }
    11% { opacity: 1; }
    43% { opacity: 0.78; }
    46% { opacity: 1; }
    71% { opacity: 0.92; }
    74% { opacity: 1; }
  }
  .match.in {
    animation: strike 1.1s ease-out 1;
  }
  @keyframes strike {
    0% { color: #fff; text-shadow: 0 0 1em #fff, 0 0 2.2em var(--ember); }
    100% { color: var(--fg); text-shadow: none; }
  }
  .grow {
    transform-origin: left center;
  }
  .grow.in {
    transform: scale(1.07);
  }
  .onefire {
    background: linear-gradient(90deg, var(--lens), var(--aries));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* the exile's secret */
  .cross {
    position: relative;
    display: inline-block;
  }
  .cross::after {
    content: '';
    position: absolute;
    left: 0;
    top: 58%;
    height: 0.06em;
    width: 0;
    background: var(--aries);
    transition: width 1.6s ease 0.4s;
  }
  .in .cross::after {
    width: 100%;
  }
  .station {
    color: var(--dim);
    transition: color 1.4s ease 1.4s;
  }
  .in .station {
    color: var(--ember);
  }
  .wide {
    transition: word-spacing 5s ease, letter-spacing 5s ease;
  }
  .wide.in {
    word-spacing: 0.55em;
    letter-spacing: 0.06em;
  }
  .drift {
    transition: transform 3s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 1.4s ease;
  }
  .drift.in {
    transform: translateX(var(--dx, 0));
  }

  /* body, heart, hand */
  .beat {
    display: inline-block;
  }
  .in .beat {
    animation: beat 1.15s ease-in-out infinite;
  }
  @keyframes beat {
    0%, 100% { transform: scale(1); }
    14% { transform: scale(1.14); }
    28% { transform: scale(1); }
    42% { transform: scale(1.08); }
  }
  .hand {
    display: inline-block;
    transition: letter-spacing 3s ease;
  }
  .in .hand {
    letter-spacing: 0.2em;
  }

  /* ending */
  .keeps {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1em;
    flex-wrap: wrap;
  }
  .keeps .l {
    max-width: none;
  }
  .keeps .burns {
    font-size: 1.2em;
  }
  .stars-line .star {
    display: inline-block;
    opacity: 0.35;
    transition: opacity 1s ease, text-shadow 1s ease;
  }
  .stars-line.in .star:nth-child(1) { opacity: 1; text-shadow: 0 0 0.6em var(--lens); transition-delay: 0.3s; }
  .stars-line.in .star:nth-child(2) { opacity: 1; text-shadow: 0 0 0.6em var(--lens); transition-delay: 1.3s; }
  .stars-line.in .star:nth-child(3) { opacity: 1; text-shadow: 0 0 0.6em var(--lens); transition-delay: 2.3s; }
  .morning {
    color: var(--fg);
    transition: color 2s ease;
  }

  /* dawn: the page's own ink darkens as the sky lightens */
  body.dawn {
    --fg: #2a241e;
    color: #2a241e;
  }
  body.dawn .dim,
  body.dawn .log,
  body.dawn .poem-foot {
    color: #5e554b;
  }
  body.dawn .log.in {
    color: #a0471f;
  }
  body.dawn .big {
    color: #b52a16;
    text-shadow: none;
  }
  body.dawn h1 em {
    text-shadow: none;
  }
  body.dawn .poem-exit {
    --night: #e9e3d6;
  }

  @media (prefers-reduced-motion: reduce) {
    .stars-line .star {
      opacity: 1;
    }
  }
</style>

<script>
  const cv = document.getElementById('sea') as HTMLCanvasElement;
  const ctx = cv.getContext('2d')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let W = 0, H = 0, dpr = 1;
  type RGB = [number, number, number];
  const stars: { x: number; y: number; r: number; tw: number; k: number }[] = [];
  for (let i = 0; i < 260; i++) stars.push({ x: Math.random(), y: Math.random() * 0.66, r: Math.random() * 1.3 + 0.3, tw: Math.random() * 6.28, k: Math.random() });

  // State the scroll and the sections write into; the canvas lerps toward it.
  type State = { red: number; wheel: number; beam: number; flame: number; starBoost: number; dawn: number; water: number };
  const target: State = { red: 0, wheel: 0, beam: 1, flame: 1, starBoost: 0, dawn: 0, water: 0 };
  const cur: State = { ...target };
  let progress = 0;
  let steer: number | null = null, steerUntil = 0, theta = 0, lastT = 0;

  const modes: Record<string, Partial<State>> = {
    night:   { red: 0,   wheel: 0, beam: 1,   flame: 1,   starBoost: 0,  water: 0 },
    born:    { red: .25, wheel: 0, beam: .8,  flame: 1.1, starBoost: 0,  water: 0 },
    liturgy: { red: .1,  wheel: 0, beam: 1.2, flame: 1.2, starBoost: 0,  water: 0 },
    wheel:   { red: .1,  wheel: 1, beam: 1,   flame: 1.3, starBoost: .2, water: .3 },
    flame:   { red: 1,   wheel: 0, beam: 1.1, flame: 1.8, starBoost: 0,  water: 0 },
    weather: { red: .8,  wheel: 0, beam: 1,   flame: 1.5, starBoost: 0,  water: .4 },
    secret:  { red: .4,  wheel: 0, beam: .9,  flame: 1.2, starBoost: .4, water: 0 },
    water:   { red: .2,  wheel: 0, beam: 1.6, flame: 1.1, starBoost: .2, water: 1 },
    lens:    { red: .6,  wheel: 1, beam: 1.3, flame: 1.6, starBoost: .6, water: .6 },
    dawn:    { red: .3,  wheel: 0, beam: .6,  flame: .8,  starBoost: 1,  water: .3 },
  };

  function resize() {
    dpr = Math.min(devicePixelRatio || 1, 2);
    W = innerWidth; H = innerHeight;
    cv.width = W * dpr; cv.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  addEventListener('resize', resize, { passive: true });
  resize();

  function onScroll() {
    const max = document.documentElement.scrollHeight - innerHeight;
    progress = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    const d = Math.max(0, (progress - 0.86) / 0.14);
    target.dawn = d;
    document.body.classList.toggle('dawn', d > 0.5);
  }
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Lines brighten as they arrive; sections set the mood of the sea.
  const io = new IntersectionObserver((es) => {
    es.forEach((e) => { if (e.isIntersecting) e.target.classList.add('in'); });
  }, { rootMargin: '0px 0px -18% 0px', threshold: 0.2 });
  // A line entering the frame shows dim before it arrives.
  const near = new IntersectionObserver((es) => {
    es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('near'); near.unobserve(e.target); } });
  });
  document.querySelectorAll('.l').forEach((el) => { io.observe(el); near.observe(el); });

  const sio = new IntersectionObserver((es) => {
    es.forEach((e) => {
      if (e.isIntersecting) Object.assign(target, modes[(e.target as HTMLElement).dataset.mode!]);
    });
  }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
  document.querySelectorAll('section[data-mode]').forEach((s) => sio.observe(s));

  // Tap (or move a mouse over) the water to point the beam.
  function lantern() { return { x: W - Math.max(26, W * 0.085), y: H * 0.66 - Math.min(H, W) * 0.22 }; }
  function aim(px: number, py: number, ms: number) {
    const L = lantern();
    steer = Math.atan2(py - L.y, px - L.x);
    steerUntil = performance.now() + ms;
  }
  addEventListener('pointerdown', (e) => {
    if ((e.target as Element).closest('a,button')) return;
    aim(e.clientX, e.clientY, 2600);
    target.flame = Math.min(2.4, target.flame + 0.3);
  }, { passive: true });
  addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') aim(e.clientX, e.clientY, 900); }, { passive: true });

  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const mix = (c1: RGB, c2: RGB, t: number): RGB => c1.map((v, i) => Math.round(lerp(v, c2[i], t))) as RGB;
  const rgb = (c: RGB, a = 1) => `rgba(${c[0]},${c[1]},${c[2]},${a})`;

  let running = true;
  document.addEventListener('visibilitychange', () => {
    running = !document.hidden;
    if (running) { lastT = 0; requestAnimationFrame(frame); }
  });

  function frame(t: number) {
    if (!running) return;
    const dt = Math.min(0.05, (t - lastT) / 1000 || 0); lastT = t;
    for (const k in target) {
      const key = k as keyof State;
      cur[key] = lerp(cur[key], target[key], Math.min(1, dt * 1.6));
    }
    if (reduce) Object.assign(cur, target);
    const d = cur.dawn;

    // The beam: Fl W 7s, steered when a hand touches the water.
    const sweepRate = (Math.PI * 2) / 7;
    if (!reduce) {
      if (steer !== null && t < steerUntil) {
        const diff = Math.atan2(Math.sin(steer - theta), Math.cos(steer - theta));
        theta += diff * Math.min(1, dt * 4);
      } else theta += sweepRate * dt;
    } else if (steer !== null) theta = steer;

    // sky
    const skyTop = mix([5, 7, 13], [191, 184, 170], d);
    const skyLow = mix(mix([10, 14, 26], [36, 16, 20], cur.red * 0.35), [233, 219, 196], d);
    const horizon = H * 0.66;
    let g = ctx.createLinearGradient(0, 0, 0, horizon);
    g.addColorStop(0, rgb(skyTop)); g.addColorStop(1, rgb(skyLow));
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, horizon + 1);

    // Stars: more of them as the poem learns to read them, gone at dawn.
    const visible = 0.35 + 0.65 * Math.min(1, progress * 1.3) + cur.starBoost * 0.4;
    for (const s of stars) {
      if (s.k > visible) continue;
      const tw = reduce ? 1 : 0.7 + 0.3 * Math.sin(t / 900 + s.tw);
      ctx.fillStyle = `rgba(246,231,178,${0.9 * tw * (1 - d)})`;
      ctx.beginPath(); ctx.arc(s.x * W, s.y * H, s.r, 0, 6.28); ctx.fill();
    }

    // sea
    const seaTop = mix(mix([8, 13, 24], [34, 12, 16], cur.red * 0.3), [170, 170, 165], d);
    const seaBot = mix([3, 4, 8], [120, 118, 112], d);
    g = ctx.createLinearGradient(0, horizon, 0, H);
    g.addColorStop(0, rgb(seaTop)); g.addColorStop(1, rgb(seaBot));
    ctx.fillStyle = g; ctx.fillRect(0, horizon, W, H - horizon);

    const L = lantern();
    const flameCol = mix([246, 231, 178], [255, 58, 28], cur.red);
    const bAlpha = 0.16 * cur.beam * (1 - d * 0.9);

    // beam(s)
    const spokes = cur.wheel > 0.02 ? 12 : 1;
    const reach = Math.max(W, H) * 1.6;
    for (let i = 0; i < spokes; i++) {
      const a = theta + (i / spokes) * Math.PI * 2;
      const alpha = i === 0 ? bAlpha : bAlpha * cur.wheel * 0.55;
      const halfW = i === 0 ? 0.055 : 0.02;
      const bg = ctx.createLinearGradient(L.x, L.y, L.x + Math.cos(a) * reach, L.y + Math.sin(a) * reach);
      bg.addColorStop(0, rgb(flameCol, alpha * 1.6)); bg.addColorStop(0.35, rgb(flameCol, alpha)); bg.addColorStop(1, rgb(flameCol, 0));
      ctx.fillStyle = bg;
      ctx.beginPath(); ctx.moveTo(L.x, L.y);
      ctx.lineTo(L.x + Math.cos(a - halfW) * reach, L.y + Math.sin(a - halfW) * reach);
      ctx.lineTo(L.x + Math.cos(a + halfW) * reach, L.y + Math.sin(a + halfW) * reach);
      ctx.closePath(); ctx.fill();
    }

    // Forty miles: the beam's reflection lies on the water where it points.
    if (cur.water > 0.02) {
      const rx = L.x + Math.cos(theta) * (W * 0.6);
      const rg = ctx.createLinearGradient(rx, horizon, rx, H);
      rg.addColorStop(0, rgb(flameCol, 0.22 * cur.water * (1 - d))); rg.addColorStop(1, rgb(flameCol, 0));
      ctx.fillStyle = rg;
      ctx.fillRect(rx - W * 0.03, horizon, W * 0.06, H - horizon);
    }

    // the tower
    const tw = Math.max(10, W * 0.028);
    const towerCol = mix([3, 4, 7], [52, 46, 42], d);
    ctx.fillStyle = rgb(towerCol);
    ctx.beginPath();
    ctx.moveTo(L.x - tw * 0.7, horizon + 6);
    ctx.lineTo(L.x + tw * 0.7, horizon + 6);
    ctx.lineTo(L.x + tw * 0.45, L.y + 10);
    ctx.lineTo(L.x - tw * 0.45, L.y + 10);
    ctx.closePath(); ctx.fill();
    ctx.fillRect(L.x - tw * 0.6, L.y - 8, tw * 1.2, 18); // gallery
    ctx.fillRect(L.x - tw * 0.3, L.y - 20, tw * 0.6, 12); // lantern room cap
    // headland: a slope from the sea floor up to the tower's foot
    ctx.beginPath(); ctx.moveTo(L.x - W * 0.55, H); ctx.quadraticCurveTo(L.x - W * 0.3, H * 0.86, L.x - W * 0.22, horizon + 14); ctx.quadraticCurveTo(L.x - W * 0.1, horizon - 12, L.x + W * 0.08, horizon - 6); ctx.lineTo(W, horizon - 6); ctx.lineTo(W, H); ctx.closePath(); ctx.fill();

    // The flame: her heartbeat, a polyrhythm against the sweep.
    const beat = reduce ? 1 : 1 + 0.12 * Math.max(0, Math.sin((t / 575) * Math.PI)) ** 6;
    const fr = (18 + 30 * cur.flame) * beat;
    const fg = ctx.createRadialGradient(L.x, L.y - 3, 0, L.x, L.y - 3, fr * 3);
    fg.addColorStop(0, rgb(flameCol, 0.95 * (1 - d * 0.5)));
    fg.addColorStop(0.18, rgb(flameCol, 0.5 * (1 - d * 0.5)));
    fg.addColorStop(1, rgb(flameCol, 0));
    ctx.fillStyle = fg; ctx.beginPath(); ctx.arc(L.x, L.y - 3, fr * 3, 0, 6.28); ctx.fill();
    ctx.fillStyle = rgb(mix(flameCol, [255, 255, 255], 0.6)); ctx.beginPath(); ctx.arc(L.x, L.y - 3, 2.2 * beat, 0, 6.28); ctx.fill();

    // Morning: the sun where the beam used to be.
    if (d > 0.01) {
      const sg = ctx.createRadialGradient(W * 0.3, horizon, 0, W * 0.3, horizon, W * 0.5);
      sg.addColorStop(0, `rgba(255,176,106,${0.55 * d})`); sg.addColorStop(1, 'rgba(255,176,106,0)');
      ctx.fillStyle = sg; ctx.fillRect(0, 0, W, H);
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
