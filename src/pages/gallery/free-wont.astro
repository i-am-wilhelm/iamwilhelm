---
/**
 * Free Won't, Mythmaking No. 3: mounted as delivered from its approved
 * source file, _incoming/mythmaking/free-wont.html. The page is the file;
 * src/lib/futurist.ts documents the few changes made on the way
 * (self-hosted fonts, the title, share and schema meta, and the links
 * back). The shared foot (ScrollFoot) is rendered here, between the two
 * halves of the document.
 */
import ScrollFoot from '../../components/scroll/ScrollFoot.astro';
import { futuristDocument } from '../../lib/futurist';
const [before, after] = await futuristDocument('free-wont');
---

<Fragment set:html={before} /><ScrollFoot id="free-wont" class="site-foot" /><Fragment set:html={after} />
