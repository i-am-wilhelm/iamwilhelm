      ctx.beginPath(); for(let i=0;i<=36;i++){const s=i/36,[x,y]=P(s,m*amp*Math.sin(s*3*Math.PI)*ph); i?ctx.lineTo(x,y):ctx.moveTo(x,y);} ctx.strokeStyle=rgba(c,.6*a); ctx.lineWidth=1.5; ctx.stroke();
      ctx.beginPath(); for(let i=0;i<=36;i++){const s=i/36,[x,y]=P(s,m*amp*Math.sin(s*3*Math.PI)); i?ctx.lineTo(x,y):ctx.moveTo(x,y);} ctx.strokeStyle=rgba(c,.13*a); ctx.lineWidth=1; ctx.stroke();}
    for(const s of [1/3,2/3]){const [x,y]=P(s,0); dot(x,y,2.4,mix(c,COL.white,.5),a);}
