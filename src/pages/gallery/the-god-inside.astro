    ctx.beginPath(); ctx.moveTo(A.x,A.y); ctx.lineTo(Bp.x,Bp.y); ctx.strokeStyle=rgba(c,.16*a); ctx.lineWidth=1; ctx.stroke();
    for(let k=0;k<3;k++){const s=(t*.55+k/3)%1,[x0,y0]=P(Math.max(0,s-.1),0),[x1,y1]=P(s,0), g=ctx.createLinearGradient(x0,y0,x1,y1);
      g.addColorStop(0,rgba(c,0)); g.addColorStop(1,rgba(mix(c,COL.white,.5),a)); ctx.strokeStyle=g; ctx.lineWidth=2.4; ctx.beginPath(); ctx.moveTo(x0,y0); ctx.lineTo(x1,y1); ctx.stroke(); dot(x1,y1,2.6,COL.white,a);}
  }
