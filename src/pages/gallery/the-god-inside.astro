/* Layout: one pinned night field holds two figures drawn in Greek letters and the gods as orbs; the text walks past it in cards. Gold is ichor, the gods' blood, and the color of every Greek word. */
body.entheos{
  --night:#0b0a10;
  --slab:#15131c;
  --ink:#efe8d8;
  --mute:#aaa49b;
  --rule:#2d2935;
  --ichor:#f2c56b;
  --display:'Literata',Georgia,'Times New Roman',serif;
  --mono:'Entheos Mono',ui-monospace,'SFMono-Regular',Menlo,Consolas,monospace;
  color-scheme:dark;
}
body.entheos *{box-sizing:border-box}


body.entheos{background:var(--night);color:var(--ink);font-family:var(--display);font-size:clamp(17px,calc(14px + .7vw),20px);line-height:1.55}
body.entheos p{margin:0}
body.entheos a{color:var(--ichor)}
body.entheos :focus-visible{outline:2px solid var(--ichor);outline-offset:3px}

body.entheos .top{max-width:44rem;margin:0 auto;padding:30px 20px 34px;display:grid;gap:.9rem}
body.entheos .eyebrow{display:flex;flex-wrap:wrap;gap:.4rem 1rem;align-items:center;font-family:var(--mono);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--mute)}
body.entheos .chip{border:1px dashed var(--mute);border-radius:2px;padding:.1em .5em;letter-spacing:.08em}
body.entheos h1{font-weight:700;font-size:clamp(2.6rem,11vw,5rem);line-height:.98;letter-spacing:-.01em;margin:0;text-wrap:balance}
body.entheos .h1gk{font-weight:700;color:var(--ichor);font-size:clamp(1.6rem,6vw,2.4rem);line-height:1.1}
body.entheos .deck{font-style:italic;font-size:1.15em;max-width:30em;text-wrap:balance}
body.entheos .legend{display:grid;gap:.5rem;font-family:var(--mono);font-size:.74rem;line-height:1.6;color:var(--mute);border-top:1px solid var(--rule);padding-top:.9rem}
body.entheos .tg{font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;padding:.12em .5em;border-radius:2px;border:1px solid #57515f;color:var(--mute);white-space:nowrap}
body.entheos .tg[data-k="reading"]{background:var(--mute);color:var(--night);border-color:var(--mute)}
body.entheos .tg[data-k="disputed"]{border-style:dashed;border-color:var(--ink);color:var(--ink)}

body.entheos .scrolly{position:relative}
body.entheos .eth-stage{position:sticky;top:0;height:56vh;height:56svh;z-index:2;background:var(--night);border-bottom:1px solid var(--rule);overflow:hidden}
body.entheos #sky{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:pan-y}
body.entheos .screen{position:absolute;left:0;right:0;top:0;padding:14px 18px 0;display:grid;gap:.3rem;justify-items:center;text-align:center;pointer-events:none}
body.entheos .gk{font-weight:700;color:var(--ichor);font-size:clamp(1.25rem,5.2vw,2.2rem);line-height:1.15;text-wrap:balance;text-shadow:0 0 18px rgba(242,197,107,.35)}
body.entheos .gl{font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;color:var(--mute)}
body.entheos .gl .w{font-family:var(--display);font-weight:700;font-size:1.3rem;letter-spacing:0;color:var(--ink)}
body.entheos .hint{position:absolute;left:0;right:0;bottom:8px;text-align:center;font-family:var(--mono);font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mute);pointer-events:none}
body.entheos .bar{position:absolute;left:0;right:0;top:0;height:2px}
body.entheos .bar i{display:block;height:100%;width:0;background:var(--ichor);transition:width .4s}
body.entheos .flash{animation:eth-flash .7s ease-out}
@keyframes eth-flash{from{opacity:.25;transform:translateY(4px)}to{opacity:1;transform:none}}
body.entheos .tau{display:inline-block;color:#fff;animation:eth-tau 1.6s cubic-bezier(.3,1.4,.5,1) .5s both}
@keyframes eth-tau{from{opacity:0;transform:translateY(-1.3em)}to{opacity:1;transform:none}}
body.entheos .pt{display:inline-block;color:#fff;transform-origin:left bottom;animation:eth-pt 1.4s ease-out .4s both}
@keyframes eth-pt{from{opacity:0;transform:rotate(-70deg)}to{opacity:1;transform:none}}

body.entheos .steps{position:relative;z-index:1;max-width:36rem;margin:0 auto;padding:6vh 20px 30vh;display:flex;flex-direction:column;gap:8vh}
body.entheos .step{min-height:40vh;display:flex;flex-direction:column;gap:.85rem;opacity:.5;transition:opacity .4s}
body.entheos .step.on{opacity:1}
body.entheos .step .n{font-family:var(--mono);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--mute)}
body.entheos .step h2{font-weight:700;font-size:1.45em;line-height:1.15;margin:0;text-wrap:balance}
body.entheos .step p{max-width:34em}
body.entheos .aside{border-left:2px solid var(--ichor);padding-left:.9rem;font-size:.93em;color:#d8d1c2}
body.entheos .next{font-family:var(--mono);font-size:.76rem;line-height:1.6;color:var(--mute);border:1px solid var(--rule);border-radius:3px;padding:.7rem .9rem}
body.entheos .next b{color:var(--ichor);font-weight:500}
body.entheos details.src{font-family:var(--mono);font-size:.74rem;line-height:1.65;color:var(--mute)}
body.entheos details.src summary{display:flex;flex-wrap:wrap;gap:.45rem;align-items:center;min-height:44px;cursor:pointer;list-style:none}
body.entheos details.src summary::-webkit-details-marker{display:none}
body.entheos details.src summary::after{content:'source +';letter-spacing:.08em}
body.entheos details.src[open] summary::after{content:'source \2212'}
body.entheos details.src p{padding:.1rem 0 .5rem;max-width:none}
body.entheos .g{font-family:var(--display);font-size:1.22em;color:var(--ichor)}
body.entheos .ctl{display:grid;gap:.25rem;font-family:var(--mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mute)}
body.entheos .ends{display:flex;justify-content:space-between;text-transform:none;letter-spacing:.02em}
body.entheos input[type=range]{width:100%;min-height:44px;margin:0;accent-color:var(--ichor);background:transparent}
body.entheos .row{display:flex;flex-wrap:wrap;gap:.5rem}
body.entheos .btn{font-family:var(--mono);font-weight:500;font-size:.74rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);background:transparent;border:1px solid #57515f;border-radius:2px;min-height:44px;padding:.5rem .9rem;cursor:pointer;-webkit-tap-highlight-color:transparent}
body.entheos .btn:hover{border-color:var(--ink)}
body.entheos .btn[aria-pressed="true"]{border-color:var(--ichor);color:var(--ichor);background:rgba(242,197,107,.1)}

@media (min-width:900px){
  body.entheos .scrolly{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);align-items:start}
  body.entheos .eth-stage{height:100vh;border-bottom:0;border-right:1px solid var(--rule)}
  body.entheos .steps{margin:0;padding:34vh 4vw 60vh 3rem;gap:22vh}
  body.entheos .step{min-height:46vh}
}

body.entheos .after{max-width:44rem;margin:0 auto;padding:8vh 20px 12vh;display:grid;gap:2.4rem}
body.entheos .after h2{font-size:1.5em;line-height:1.15;margin:0 0 .7rem}
body.entheos .after h3{font-size:1.05em;margin:1rem 0 .2rem;color:var(--ichor)}
body.entheos #plain{display:grid;gap:.8rem}
body.entheos .after ul{margin:0;padding-left:1.1rem;display:grid;gap:.5rem}
body.entheos .plain summary{cursor:pointer;min-height:44px;display:flex;align-items:center;font-family:var(--mono);font-size:.76rem;letter-spacing:.1em;text-transform:uppercase;color:var(--mute)}
body.entheos .note{border:1px dashed var(--mute);border-radius:3px;padding:1rem 1.1rem;display:grid;gap:.6rem}
body.entheos .note h2{font-size:1.15em;margin:0}
body.entheos .colophon{font-family:var(--mono);font-size:.74rem;line-height:1.7;color:var(--mute);border-top:1px solid var(--rule);padding-top:1rem}
@media (prefers-reduced-motion:reduce){body.entheos .flash,body.entheos .tau,body.entheos .pt{animation:none}body.entheos .step{transition:none}}

body.entheos main.eth-main{position:relative;z-index:1;padding:0;max-width:none;margin:0}
body.entheos h1{margin:0}
body.entheos .eth-back{font-family:var(--mono);font-size:.74rem;letter-spacing:.06em}
body.entheos .eth-sf{margin-top:1.5rem}
