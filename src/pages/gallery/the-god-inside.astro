    for(let i=1;i<=5;i++){x=Cp.x+Math.cos(th)*L*i/5+(rnd(seed*3+k*11+i)-.5)*s*.14; y=Cp.y+Math.sin(th)*L*i/5+(rnd(seed*5+k*13+i)-.5)*s*.14; ctx.lineTo(x,y);}
    ctx.strokeStyle=rgba(mix(c,COL.white,.4),a*(.3+.6*rnd(seed+k))); ctx.lineWidth=1.3; ctx.stroke(); dot(x,y,1.6,[255,240,220],a*.8);}
  ctx.restore();
