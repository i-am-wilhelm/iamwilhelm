function rays(Cp,s,c,a,t,k){
  ctx.save(); ctx.globalCompositeOperation='lighter';
  for(let i=0;i<18;i++){const th=i/18*TAU+t*.05, L=s*(.9+.5*rnd(i)+.25*k), ex=Cp.x+Math.cos(th)*L, ey=Cp.y+Math.sin(th)*L, g=ctx.createLinearGradient(Cp.x,Cp.y,ex,ey);
    g.addColorStop(0,rgba(c,0)); g.addColorStop(.35,rgba(c,.28*a)); g.addColorStop(1,rgba(c,0));
    ctx.strokeStyle=g; ctx.lineWidth=1+2*rnd(i+40); ctx.beginPath(); ctx.moveTo(Cp.x,Cp.y); ctx.lineTo(ex,ey); ctx.stroke();}
  ctx.restore();
