function plinth(G,a){
  if(a<.01)return; ctx.save(); ctx.strokeStyle=rgba(COL.gold,.8*a); ctx.fillStyle=rgba(COL.gold,.08*a); ctx.lineWidth=1.2;
  for(const [dx,dy,w,h] of [[-.04,0,1.08,.045],[-.1,.045,1.2,.06]]){ctx.beginPath(); ctx.rect(G.bx+dx*G.s,G.base+dy*G.s,w*G.s,h*G.s); ctx.fill(); ctx.stroke();}
  ctx.restore();
}
function wheels(G,a,t){
  if(a<.01)return; const r=G.s*.5, cy=G.y0+.72*G.s, cs=[{x:G.lx+.5*G.s,y:cy},{x:G.bx+.5*G.s,y:cy}], pts=[];
  const PL=[[.35,'gold'],[1.4,'silver'],[2.3,'rose'],[3.5,'ares'],[4.4,'zeus'],[5.5,'hera']];
  ctx.save(); ctx.lineWidth=1;
