  orb(x0,y0,Math.max(4,G.s*.05),COL.silver,a,t); label(nm[0],x0,y0-rr*2.5,a,'500 10px '+MONO,COL.grey);
  let x=x0,y=y0+rr*.9;
  for(let i=1;i<4;i++){const th=reduce?0:Math.sin(t*1.1-i*.55)*.2*i/3; x+=Math.sin(th)*rr*1.7; y+=Math.cos(th)*rr*1.7;
    orbSmall(x,y,rr*.3,COL.gold,a*(.7-.15*i));
    ctx.save(); ctx.lineWidth=2; ctx.strokeStyle=rgba(mix(COL.gold,COL.grey,i/4),a*(1-.18*i)); ctx.beginPath(); ctx.ellipse(x,y,rr*.7,rr,th,0,TAU); ctx.stroke(); ctx.restore();
    label(nm[i],x+rr*1.4+24,y,a*.9,'500 10px '+MONO,COL.grey);}
}
function netFx(G,a,t){
