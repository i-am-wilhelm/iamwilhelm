      const gr=ctx.createLinearGradient(ox,R.y,ex,ey); gr.addColorStop(0,rgba(c,.05*a*al)); gr.addColorStop(.5,rgba(c,.5*a*al)); gr.addColorStop(1,rgba(mix(c,COL.white,.6),.75*a*al));
      ctx.strokeStyle=gr; ctx.lineWidth=1.3; ctx.beginPath(); ctx.moveTo(ox,R.y); ctx.quadraticCurveTo(cx,cy,ex,ey); ctx.stroke();
      const at=u=>{const q=1-u;return [q*q*ox+2*q*u*cx+u*u*ex,q*q*R.y+2*q*u*cy+u*u*ey];};
      for(let k=1;k<=6;k++){const u=k/7,[px,py]=at(u); ctx.strokeStyle=rgba(c,.24*a*al*u); ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(px,py); ctx.lineTo(px+Math.cos(th+1.25)*L*.09*u,py+Math.sin(th+1.25)*L*.09*u); ctx.stroke();}
      const u=(t*.22+i*.13)%1,[px,py]=at(u); dot(px,py,1.3,mix(c,COL.white,.6),a*al*Math.sin(u*Math.PI));
    }}
  ctx.restore();
}
function sparksOut(Cp,s,c,a,t){
  const seed=Math.floor(t*9); ctx.save(); ctx.globalCompositeOperation='lighter';
