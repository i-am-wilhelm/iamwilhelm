  if(S.mirror>.02){orb(G.bc.x,G.bc.y,r*.8,mix(c,COL.pale,.5),.4*S.mirror*ba,t+3); label('ἀντέρως',G.bc.x,G.bc.y-r*4.4,S.mirror*ba,'700 '+Math.max(13,s*.09).toFixed(0)+'px '+FONT,COL.pale);}

  if(S.four>.02){[[.58,.38,'apollo','Apollo','prophecy'],[.85,.38,'wine','Dionysus','the rites'],[.58,.62,'silver','the Muses','poetry'],[.85,.62,'rose','Aphrodite + Eros','love']].forEach((p,i)=>{
    const lit=reduce?1:clamp(tau*1.1-i*.9), x=W*p[0], y=H*p[1], rr=Math.max(4,s*.045)*(i===3?1.25*(1+.3*hb):1);
    orb(x,y,rr,COL[p[2]],S.four*(.18+.82*lit),t+i); label(p[3],x,y+rr*3.4+12,S.four*(.4+.6*lit),'500 11px '+MONO,COL.ink); label(p[4],x,y+rr*3.4+26,S.four*(.3+.5*lit),'500 10px '+MONO,COL.grey);});}

  if(S.choose>.02){const rr=Math.max(4,s*.045);
    GKEYS.forEach((g,i)=>{const x=W*(.17+.22*i), y=H*.36, sel=god===g; homes[g]={x,y};
      orb(x,y,rr,GODS[g].col,S.choose*(sel?.22:1),t+i*1.7); label(GODS[g].name,x,y+rr*3.4+12,S.choose,'500 11px '+MONO,sel?GODS[g].col:COL.ink);});
    if(flight){const u=clamp((t-flight.t0)/.7); if(u<1){const e2=ease(u); orb(lerp(flight.x,G.lc.x,e2),lerp(flight.y,G.lc.y,e2)-Math.sin(u*Math.PI)*s*.3,rr*1.2,flight.col,1,t);}else flight=null;}}

  if(S.daimon>.05){label(between<.3?'ἔνθεος':'δαίμων',ox,oy-r*4.4,S.daimon,'700 '+Math.max(14,s*.1).toFixed(0)+'px '+FONT,COL.gold);
    if(between>=.3)label('μεταξύ · between',ox,oy+r*4.6+6,S.daimon*.85,'500 10px '+MONO,COL.grey);}
  if(S.wheels>.02){const u=(tau/2.6)%1; label(PHR[reduce?0:Math.floor(tau/2.6)%PHR.length],W/2,G.y0+.06*s,S.wheels*(reduce?1:Math.sin(u*Math.PI)),'italic 400 '+Math.max(15,s*.11).toFixed(0)+'px '+FONT,COL.ink);}
  if(S.crowd>.02){for(let i=0;i<16;i++){const x=((rnd(i)*W-t*(8+10*rnd(i+5)))%W+W)%W; ctx.fillStyle=rgba(COL.grey,.5*S.crowd); ctx.beginPath(); ctx.arc(x,H*(.28+.5*rnd(i+20)),2.2,0,TAU); ctx.fill();}}
}
function frame(ts){
  const t=ts/1000, dt=Math.min(.05,Math.max(.001,t-now)); now=t;
  if(figs&&step>=0)draw(reduce?1.3:t,dt);
  if(!reduce&&running)requestAnimationFrame(frame);
}
const redraw=()=>{if(reduce)frame(performance.now());};

/* ---------- scroll: which card is the reader on ---------- */
function setStep(i){
  if(i===step)return; step=i; stepStart=now; const Bt=BEATS[i];
  gkEl.innerHTML=Bt.gk; glEl.innerHTML=Bt.gl;
  for(const n of [gkEl,glEl]){n.classList.remove('flash'); void n.offsetWidth; n.classList.add('flash');}
  hintEl.textContent=Bt.hint||''; cv.setAttribute('aria-label',Bt.aria); cv.style.cursor=(Bt.ctl==='choose'||Bt.ctl==='daimon')?'pointer':'default'; $('#bar').style.width=((i+1)/steps.length*100)+'%';
  steps.forEach((el,j)=>el.classList.toggle('on',j===i)); redraw();
}
function onScroll(){
  const sr=stage.getBoundingClientRect(), vh=window.innerHeight, wide=matchMedia('(min-width:900px)').matches;
  const ref=wide?vh*.5:sr.bottom+(vh-sr.bottom)*.4; let best=0, bd=1e9;
  steps.forEach((el,i)=>{const r=el.getBoundingClientRect(), d=ref<r.top?r.top-ref:ref>r.bottom?ref-r.bottom:0; if(d<bd){bd=d;best=i;}});
  setStep(best);
}

/* ---------- controls ---------- */
function choose(g){
  if(god===g)return; const h=homes[g]; god=g; if(h&&!reduce)flight={x:h.x,y:h.y,col:GODS[g].col,t0:now};
  $$('.god').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.g===g))); redraw();
}
$('#dist').addEventListener('input',e=>{dist=e.target.value/100; redraw();});
$('#crowd').addEventListener('click',e=>{crowd=!crowd; e.currentTarget.setAttribute('aria-pressed',String(crowd)); redraw();});
$$('.god').forEach(b=>b.addEventListener('click',()=>choose(b.dataset.g)));
$('#daim').addEventListener('input',e=>{dTouched=true; dUser=e.target.value/200; redraw();});
function dragTo(e){const r=cv.getBoundingClientRect(), G=layout(); dTouched=true; dUser=clamp((e.clientX-r.left-G.lc.x)/(W/2-G.lc.x))*.5; $('#daim').value=Math.round(dUser*200); redraw();}
cv.addEventListener('pointerdown',e=>{
  const r=cv.getBoundingClientRect(), x=e.clientX-r.left, y=e.clientY-r.top;
  if(BEATS[step].ctl==='choose'){for(const g of GKEYS){const h=homes[g]; if(h&&Math.hypot(x-h.x,y-h.y)<32){choose(g);return;}}}
  if(BEATS[step].ctl==='daimon'){drag=true; try{cv.setPointerCapture(e.pointerId);}catch(_){} dragTo(e);}
});
cv.addEventListener('pointermove',e=>{if(drag)dragTo(e);});
for(const ev of ['pointerup','pointercancel'])cv.addEventListener(ev,()=>{drag=false;});


/* ---------- start ---------- */
function start(){
  build(); onScroll();
  window.addEventListener('scroll',onScroll,{passive:true}); window.addEventListener('resize',onScroll);
  new ResizeObserver(()=>{build(); redraw();}).observe(stage);
  if('IntersectionObserver' in window)new IntersectionObserver(en=>{const v=en[0].isIntersecting; if(v&&!running&&!reduce){running=true; requestAnimationFrame(frame);} running=v;}).observe(stage);
  if(document.fonts&&document.fonts.addEventListener)document.fonts.addEventListener('loadingdone',()=>{build(); redraw();});
  if(reduce)frame(performance.now()); else requestAnimationFrame(frame);
}
const ready=document.fonts&&document.fonts.ready?document.fonts.ready:Promise.resolve();
Promise.race([ready,new Promise(r=>setTimeout(r,1500))]).then(start);
})();
</script>
