    ctx.strokeStyle=rgba(COL.ink,.5*a); ctx.beginPath(); ctx.arc(c.x,c.y,r,0,TAU); ctx.stroke();
    ctx.strokeStyle=rgba(COL.ink,.24*a); ctx.beginPath(); ctx.arc(c.x,c.y,r*.76,0,TAU); ctx.stroke();
    for(let i=0;i<12;i++){const th=rot+i/12*TAU; ctx.beginPath(); ctx.moveTo(c.x+Math.cos(th)*r*.76,c.y+Math.sin(th)*r*.76); ctx.lineTo(c.x+Math.cos(th)*r,c.y+Math.sin(th)*r); ctx.stroke();}
