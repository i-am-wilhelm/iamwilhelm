function wings(R,s,g,c,a,t){
  if(g<.01||a<.01)return; ctx.save(); ctx.globalCompositeOperation='lighter'; ctx.lineCap='round';
  for(let w=0;w<2;w++){const ox=R.x-(w?.07*s:0), al=w?.4:1;
    for(let i=0;i<7;i++){const th=(-66-i*12+(w?7:0))*Math.PI/180+Math.sin(t*.9+i*.5)*.03, L=s*(1.28-.1*i)*ease(clamp(g*1.3-i*.05));
      if(L<1)continue;
