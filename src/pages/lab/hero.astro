---
/**
 * /lab/hero — permanent workbench for the natal hero. The hero alone, plus a
 * single empty section beneath it so the dissolve handoff can be scrolled.
 *   ?tinker=1   opens the layer toggles and dials
 *   ?chart=test renders a throwaway chart (proves the engine is data-driven)
 */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/sections/Hero.astro';
import { sections } from '../../design/tokens';

const hero = sections.find((s) => s.id === 'hero')!;
---

<Base title="Lab — Hero" noindex>
  <Hero spec={hero} />
  <section class="lab-next" aria-hidden="true">
    <p>— next section —</p>
  </section>
</Base>

<style>
  .lab-next {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: grid;
    place-items: center;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--ink-dim);
  }
</style>
