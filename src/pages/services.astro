---
/**
 * /services: Room IV, Commissions. The one page that sells scrollies
 * (visualized essays, poems, stories) and nothing else. Built from the
 * museum's own parts: the placard, the Room I feature-list cells, the
 * Gallery cards (six live pieces, their own share images as thumbnails),
 * the meander and the colophon. No script beyond what Museum.astro loads.
 */
import Museum from '../layouts/Museum.astro';
import Placard from '../components/museum/Placard.astro';
import PoemGallery from '../components/museum/PoemGallery.astro';
import Meander from '../components/museum/Meander.astro';
import Colophon from '../components/museum/Colophon.astro';
import { CONTACT_EMAIL, SCHEDULER_URL, SITE_URL } from '../config/site';

const url = `${SITE_URL}/services/`;
const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('Commission')}`;

const jobs = [
  {
    title: 'An essay or poem of your own',
    body: 'Your writing given the treatment the gallery pieces get: exhibits built for the argument, Greek or any other language set correctly, a source ledger if the piece makes claims.',
  },
  {
    title: 'Impact report',
    body: 'For nonprofits and foundations. The year’s work as a page donors actually finish: the numbers drawn as you reach them, the people in the middle of it, the ask at the end. Replaces the PDF nobody opens.',
  },
  {
    title: 'Launch page',
    body: 'For authors, musicians, and artists. A chapter, a track, or a series given its own interactive page, with a pre-order or ticket door built into the scroll.',
  },
  {
    title: 'Origin story',
    body: 'For founders. How the company came to be, told the way you tell it in the room, with the product arriving where it arrives in the story. Doubles as the pitch page.',
  },
];

const steps = [
  {
    title: 'The story session',
    body: 'An hour on what happened and why it matters. I leave with the spine of the piece and a chapter outline you approve.',
  },
  {
    title: 'The exhibits',
    body: 'Each chapter gets its own exhibit: a drawing, a chart, a wall of files, a flood. You review a working prototype on desktop and phone.',
  },
  {
    title: 'The build and the twin',
    body: 'The page ships with a plain-text twin for sharing and search, a share image rendered from the page itself, and a source ledger where the piece makes claims.',
  },
];

const pieces = [
  'mimics-and-mythmakers',
  'everyone-searchable',
  'true-amazons',
  'the-dual-thing',
  'pharmakon',
  'the-pretty-toy',
];

const schema = [
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    url,
    name: 'Commission a scrolly',
    serviceType: 'Visualized essays, poems, impact reports, launch pages and origin stories as interactive pages',
    description:
      'A story told as an interactive page: visualized essays, poems, impact reports, launch pages and origin stories, written with you and built by Michael Wilhelm.',
    provider: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: 'Michael Wilhelm', url: `${SITE_URL}/` },
    offers: {
      '@type': 'Offer',
      url,
      price: '2500',
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'PriceSpecification',
        price: '2500',
        priceCurrency: 'USD',
        minPrice: '2500',
        description: 'From $2,500. Larger pieces quoted.',
      },
      availability: 'https://schema.org/InStock',
      offeredBy: { '@id': `${SITE_URL}/#person` },
    },
  },
];
---

<Museum
  title="Commission a Scrolly | Michael Wilhelm"
  description="A story told as an interactive page: visualized essays, poems, impact reports, launch pages and origin stories, written with you and built by Michael Wilhelm. From $2,500."
  current="services"
  schema={schema}
>
  <article class="page" aria-labelledby="services-title" style="--room-accent: var(--room-iv)">
    <div class="page__inner wrap">
      <header class="page__head">
        <Placard
          id="services-title"
          level={1}
          label="Room IV · Commissions"
          title="Pieces like these are built to order."
          medium="Visualized essays, poems and stories, written with you and built as their own interactive page"
          catalog="Cat. IV"
        />
        <div class="page__statement" data-reveal>
          <p class="lede">
            A scrolly is a long piece told as a page where the design is part of the plot: the text darkens as the
            argument does, a chart draws itself when you reach it, a held button turns the page. I write it with you,
            design the exhibit, and build it so it works on a phone, with the script off, and for a reader who cannot
            see motion.
          </p>
          <p class="actions">
            <a class="cta cta--gilt" href={SCHEDULER_URL}>Book a call</a>
            <a class="text-link actions__mail" href={mailto}>or write: {CONTACT_EMAIL}</a>
          </p>
        </div>
      </header>

      <section class="sect" aria-labelledby="jobs-title" data-reveal>
        <div class="sect__head">
          <p class="sect__num mono">IV.01</p>
          <h2 class="sect__title display" id="jobs-title">Four jobs it does.</h2>
        </div>
        <ol class="cells" role="list">
          {
            jobs.map((j, i) => (
              <li class="cell">
                <span class="cell__num mono">IV.01.{i + 1}</span>
                <h3 class="cell__title">{j.title}</h3>
                <p class="cell__body">{j.body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="sect sect--wide" aria-labelledby="pieces-title" data-reveal>
        <div class="sect__head">
          <p class="sect__num mono">IV.02</p>
          <h2 class="sect__title display" id="pieces-title">Every one of these is live. Open any of them and scroll.</h2>
        </div>
        <PoemGallery level={3} ids={pieces} thumbs />
        <p class="more">
          <a class="text-link" href="/gallery/">The full gallery</a>
        </p>
      </section>

      <section class="sect" aria-labelledby="made-title" data-reveal>
        <div class="sect__head">
          <p class="sect__num mono">IV.03</p>
          <h2 class="sect__title display" id="made-title">How a piece is made.</h2>
        </div>
        <ol class="steps" role="list">
          {
            steps.map((s, i) => (
              <li class="step">
                <span class="step__num display">0{i + 1}</span>
                <h3 class="step__title">{s.title}</h3>
                <p class="step__body">{s.body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="sect" aria-labelledby="cost-title" data-reveal>
        <div class="sect__head">
          <p class="sect__num mono">IV.04</p>
          <h2 class="sect__title display" id="cost-title">From $2,500. Larger pieces quoted.</h2>
        </div>
        <div class="sect__body prose-museum">
          <p>
            The base price covers a piece of roughly six to nine chapters with custom exhibits. Longer pieces, original
            illustration, data that needs cleaning, and voice or sound are quoted on the call. Half to start, half at
            launch. Hosted on your domain or mine; you own the files either way.
          </p>
        </div>
      </section>

      <section class="sect sect--close" aria-labelledby="close-title" data-reveal>
        <div class="sect__head">
          <p class="sect__num mono">IV.05</p>
          <h2 class="sect__title display" id="close-title">Bring the story. I will show you the page it becomes.</h2>
        </div>
        <div class="sect__body">
          <p class="lede">Thirty minutes. Leave with a chapter outline and a fixed quote.</p>
          <p class="actions">
            <a class="cta cta--gilt" href={SCHEDULER_URL}>Book a call</a>
            <a class="text-link actions__mail" href={mailto}>or write: {CONTACT_EMAIL}</a>
          </p>
        </div>
      </section>
    </div>
  </article>
  <Meander />
  <Colophon />
</Museum>

<style>
  .page {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem);
  }
  .page__inner {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .page__head,
  .sect {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .page__statement {
    display: grid;
    gap: 1.6rem;
    padding-top: 0.5rem;
  }
  .page__statement .lede {
    color: var(--ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.4rem;
  }
  .actions__mail {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  /* Each room of the page: catalogue number and heading on the left, the matter on the right. */
  .sect {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    border-top: 1px solid var(--rule);
  }
  .sect--wide {
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.75rem, 1rem + 2vw, 2.5rem);
  }
  .sect__head {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }
  .sect--wide .sect__head {
    max-width: 40rem;
  }
  .sect__num {
    color: var(--room-accent);
  }
  .sect__title {
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
    color: var(--ink);
  }
  .sect__body {
    display: grid;
    gap: 1.4rem;
    color: var(--ink-soft);
  }
  .sect--close .sect__body .lede {
    color: var(--ink);
  }

  /* IV.01: the Room I feature-list cells. */
  .cells {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .cell {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: 1.4rem 1.25rem 1.6rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--wall) 70%, white);
  }
  .cell__num {
    color: var(--gilt-ink);
  }
  .cell__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.4rem;
    line-height: 1.15;
  }
  .cell__body {
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.5;
  }

  /* IV.02: the gallery cards, then the way to the whole wall. */
  .more {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }

  /* IV.03: three numbered steps. */
  .steps {
    list-style: none;
    display: grid;
    gap: 1.6rem;
  }
  .step {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    grid-template-areas:
      'num title'
      'num body';
    column-gap: 1rem;
    row-gap: 0.4rem;
    padding-left: 1.4rem;
    border-left: 1px solid var(--gilt);
  }
  .step__num {
    grid-area: num;
    font-size: 2.2rem;
    font-weight: 300;
    line-height: 1;
    color: var(--room-accent);
    font-variant-numeric: tabular-nums;
  }
  .step__title {
    grid-area: title;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.4rem;
    line-height: 1.15;
  }
  .step__body {
    grid-area: body;
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  @media (max-width: 820px) {
    .page__head,
    .sect {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    .cells {
      grid-template-columns: minmax(0, 1fr);
    }
    .step {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'num'
        'title'
        'body';
    }
  }
</style>
