---
/**
 * 404 in the museum style: a closed door, and the way back to the foyer.
 */
import Museum from '../layouts/Museum.astro';
---

<Museum title="Not found · Michael Wilhelm" description="This room is closed." noindex>
  <section class="lost wrap" aria-labelledby="lost-title">
    <p class="lost__greek" lang="grc">οὐκ ἔστιν ὧδε</p>
    <h1 class="lost__title display" id="lost-title">This room is closed.</h1>
    <p class="lede">The page you asked for is elsewhere in the building, or was never hung.</p>
    <a class="cta" href="/">Return to the foyer</a>
  </section>
</Museum>

<style>
  .lost {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    min-height: 70vh;
    align-content: center;
    text-align: center;
    padding-block: 4rem;
  }
  .lost__greek {
    font-family: 'GFS Neohellenic', 'Palatino Linotype', 'Noto Serif', Georgia, serif;
    color: var(--gilt-ink);
    font-size: 1.2rem;
    letter-spacing: 0.08em;
  }
  .lost__title {
    font-size: clamp(2.4rem, 1.6rem + 3.6vw, 4.6rem);
  }
</style>
