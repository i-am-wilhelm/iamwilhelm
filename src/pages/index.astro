---
/**
 * The homepage: a walk through a small museum. A foyer, three numbered
 * rooms divided by Greek meander keylines, and a colophon. The previous
 * homepage lives on, unlinked and noindexed, at /atelier.
 *
 * Unmounted, kept in the repo: RoomManifesto (the libertariantoolsuite
 * manifesto exhibit) and RoomAlm (Advancing Liberty Media / Websites by
 * Wilhelm, with the console, cartridges, and src/data/portfolio.ts). They
 * left the public site; re-import them here to hang them again.
 */
import Museum from '../layouts/Museum.astro';
import Meander from '../components/museum/Meander.astro';
import Foyer from '../components/museum/rooms/Foyer.astro';
import RoomBackGold from '../components/museum/rooms/RoomBackGold.astro';
import RoomGallery from '../components/museum/rooms/RoomGallery.astro';
import RoomWritings from '../components/museum/rooms/RoomWritings.astro';
import Colophon from '../components/museum/Colophon.astro';
---

<Museum home>
  <Foyer />
  <Meander mark="I" />
  <RoomBackGold />
  <Meander mark="II" />
  <RoomGallery />
  <Meander mark="III" />
  <RoomWritings />
  <Meander />
  <Colophon />
</Museum>
