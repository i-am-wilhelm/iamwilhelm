---
/**
 * The homepage: a walk through a small museum. A foyer, the featured work
 * now on view (FeatureMimics: Mimics & Mythmakers), three numbered rooms
 * divided by Greek meander keylines (the Treasury, the Gallery kept as the
 * Archive, the Reading Room), and a colophon. The previous homepage lives
 * on, unlinked and noindexed, at /atelier.
 *
 * The Threshold ("What brought you here?", Janus and six doors, #welcome)
 * is a popup, so it takes no room in the walk: it greets a new arrival
 * over the Foyer and opens again from "Begin the tour" and every link to
 * /#welcome. It is mounted after the Foyer because that is where it falls
 * back into the page when there is no script.
 *
 * The Futurist installments are shelved in the Archive's first bay; their
 * own homepage section (rooms/FeatureFuturist.astro) is unmounted and kept.
 *
 * Unmounted, kept in the repo: RoomManifesto (the libertariantoolsuite
 * manifesto exhibit) and RoomAlm (Advancing Liberty Media / Websites by
 * Wilhelm, with the console, cartridges, and src/data/portfolio.ts). They
 * left the public site; re-import them here to hang them again.
 */
import Museum from '../layouts/Museum.astro';
import Meander from '../components/museum/Meander.astro';
import Foyer from '../components/museum/rooms/Foyer.astro';
import Threshold from '../components/museum/rooms/Threshold.astro';
import FeatureMimics from '../components/museum/rooms/FeatureMimics.astro';
import RoomBackGold from '../components/museum/rooms/RoomBackGold.astro';
import RoomGallery from '../components/museum/rooms/RoomGallery.astro';
import RoomWritings from '../components/museum/rooms/RoomWritings.astro';
import Colophon from '../components/museum/Colophon.astro';
---

<Museum home>
  <Foyer />
  <Threshold />
  <FeatureMimics />
  <Meander mark="I" />
  <RoomBackGold />
  <Meander mark="II" />
  <RoomGallery />
  <Meander mark="III" />
  <RoomWritings />
  <Meander />
  <Colophon />
</Museum>
