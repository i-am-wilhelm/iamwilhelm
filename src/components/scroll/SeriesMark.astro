---
/**
 * The series label on a scroll page's header: "In the Original · No. 1",
 * linking to the series index. Inline, and unstyled beyond the link, so it
 * sits inside whatever eyebrow, kicker or log line the page already sets
 * and takes that line's face. The catalogue number is a sort key only and
 * is not shown.
 */
import { series as registry } from '../../config/series';
import { getPiece, type PieceKind } from '../../lib/pieces';

interface Props {
  id: string;
  kind?: PieceKind;
  class?: string;
}
const { id, kind = 'scroll', class: cls } = Astro.props;
const p = await getPiece(id, kind);
const s = p.series ? registry[p.series] : undefined;
---

{
  s && (
    <span class:list={['series-mark', cls]}>
      <a href={s.href}>{p.label}</a>
    </span>
  )
}

<style is:global>
  .series-mark a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    transition: border-color 0.3s ease;
  }
  .series-mark a:hover,
  .series-mark a:focus-visible {
    border-bottom-color: currentColor;
  }
</style>
