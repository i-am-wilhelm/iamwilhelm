---
/**
 * The foot of every scroll page and every reading: share the piece (copy
 * the link, X, Facebook, Bluesky, and the device's own share sheet where
 * navigator.share exists; the card each platform draws comes from the
 * page's own og:image), the next piece in its series by number (wrapping to the
 * series index after the last), the newsletter field (the same form and
 * endpoint as the colophon, via NewsletterForm), and the patronage door to
 * /support, and one line to the commissions page, since every piece ends here.
 * Under it, the way to the front door: most readers arrive on a piece from
 * a shared link and have never seen the homepage, so the foot points them
 * to the Threshold (/#welcome), where the rest of the work is laid out.
 * The Janus mark beside that line opens the essay on Janus (Before and
 * Behind), on every page but that one.
 *
 * Above that line, where the piece is filed: its breadcrumb trail (Foyer /
 * Gallery / Seen / the piece, src/lib/crumbs.ts), its tags, each linking to
 * the tag's page (src/config/tags.ts), up to three pieces from other series
 * that share at least two of its tags, and the way to search.
 *
 * Self-contained: everything inherits the page's colour and text face, and
 * the small type reads the page's mono variable (--font-mono, --log or
 * --typed), so the block takes each page's voice without a per-page style.
 * One inline script of a few lines handles the copy button; nothing loads.
 */
import NewsletterForm from '../museum/NewsletterForm.astro';
import JanusMark from '../museum/JanusMark.astro';
import { series as registry } from '../../config/series';
import { filedNear, getPiece, nextInSeries, type PieceKind } from '../../lib/pieces';
import { tags as tagRegistry, tagHref } from '../../config/tags';
import { pieceTrail } from '../../lib/crumbs';
import { JANUS_ESSAY } from '../../config/site';

interface Props {
  id: string;
  kind?: PieceKind;
  class?: string;
}
const { id, kind = 'scroll', class: cls } = Astro.props;
const p = await getPiece(id, kind);
const next = await nextInSeries(p);
const near = await filedNear(p);
const crumbs = pieceTrail(p);
const s = p.series ? registry[p.series] : undefined;
const shareText = [p.title, p.label].filter(Boolean).join(' · ');
const x = `https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(p.url)}`;
const bsky = `https://bsky.app/intent/compose?text=${encodeURIComponent(`${shareText} ${p.url}`)}`;
const fb = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(p.url)}`;
const uid = `sf-${id}`;
---

<aside class:list={['scroll-foot', cls]} aria-labelledby={`${uid}-title`} data-og-hide>
  <h2 class="scroll-foot__sr" id={`${uid}-title`}>After the piece</h2>
  <div class="scroll-foot__grid">
    <div class="scroll-foot__cell">
      <p class="scroll-foot__k">Share</p>
      <div class="scroll-foot__row">
        <button class="scroll-foot__btn" type="button" data-copy={p.url}>Copy link</button>
        <a class="scroll-foot__btn" href={x} rel="noopener noreferrer" target="_blank">Post on X</a>
        <a class="scroll-foot__btn" href={fb} rel="noopener noreferrer" target="_blank">Share on Facebook</a>
        <a class="scroll-foot__btn" href={bsky} rel="noopener noreferrer" target="_blank">Post on Bluesky</a>
        <button class="scroll-foot__btn" type="button" data-share-title={p.title} data-share-url={p.url} hidden>Share&hellip;</button>
      </div>
      <p class="scroll-foot__status" role="status" aria-live="polite" data-copy-status></p>
    </div>

    {
      next && s && (
        <div class="scroll-foot__cell">
          <p class="scroll-foot__k">{next.isIndex ? 'The series' : 'Next in the series'}</p>
          <a class="scroll-foot__next" href={next.path}>
            <span class="scroll-foot__next-label">{next.isIndex ? `${s.name} · every piece` : next.label}</span>
            <span class="scroll-foot__next-title">{next.title}</span>
          </a>
          {!next.isIndex && (
            <p class="scroll-foot__also">
              <a href={s.href}>All of {s.name}</a>
            </p>
          )}
        </div>
      )
    }

    <div class="scroll-foot__cell">
      <p class="scroll-foot__k" id={`${uid}-nl`}>The newsletter</p>
      <p class="scroll-foot__note">Occasional letters when a new piece is hung.</p>
      <NewsletterForm id={`${uid}-email`} class="scroll-foot__form" labelledby={`${uid}-nl`} buttonClass="scroll-foot__btn" />
    </div>

    <div class="scroll-foot__cell">
      <p class="scroll-foot__k">Patronage</p>
      <p class="scroll-foot__note">These pages are free to read and slow to make.</p>
      <a class="scroll-foot__btn scroll-foot__door" href="/support/">Keep the lights on</a>
    </div>
  </div>
  <div class="scroll-foot__filed">
    <nav class="scroll-foot__trail" aria-label="Breadcrumb">
      <ol>
        {
          crumbs.map((c, i) => (
            <li>{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
          ))
        }
      </ol>
    </nav>
    {
      p.tags.length > 0 && (
        <p class="scroll-foot__filed-line">
          <span class="scroll-foot__k">Filed under</span>
          {p.tags.map((t, i) => (
            <>{i > 0 && <span class="scroll-foot__dot" aria-hidden="true"> &middot; </span>}<a href={tagHref(t)}>{tagRegistry[t].label}</a></>
          ))}
        </p>
      )
    }
    {
      near.length > 0 && (
        <p class="scroll-foot__filed-line">
          <span class="scroll-foot__k">Filed near</span>
          {near.map((q, i) => (
            <>{i > 0 && <span class="scroll-foot__dot" aria-hidden="true"> &middot; </span>}<a href={q.path}><i>{q.title}</i></a></>
          ))}
        </p>
      )
    }
    <p class="scroll-foot__filed-line">
      <a href="/search/">Search the collection</a>
      <span class="scroll-foot__dot" aria-hidden="true"> &middot; </span>
      <a href="/tags/">Every tag</a>
    </p>
  </div>
  <p class="scroll-foot__commission">
    {p.twinPath && (
      <span class="scroll-foot__twin">
        Plain text: <a href={p.twinPath}>read this piece as text</a> &middot;{' '}
      </span>
    )}
    Pieces like these are built to order. <a href="/services/">Commissions &rarr;</a>
    <span class="scroll-foot__front">
      <JanusMark size={16} link={p.path !== JANUS_ESSAY} />
      <span>Came in by a side door? <a href="/#welcome">The front door &rarr;</a></span>
    </span>
  </p>
</aside>

<script>
  /* The device's own share sheet (phones, mostly): shown only where the
     browser offers it, so the row never promises a control it lacks. */
  if (typeof navigator.share === 'function') {
    for (const btn of document.querySelectorAll<HTMLButtonElement>('.scroll-foot [data-share-url]')) {
      btn.hidden = false;
      btn.addEventListener('click', async () => {
        try {
          await navigator.share({ title: btn.dataset.shareTitle, url: btn.dataset.shareUrl });
        } catch {
          /* The reader closed the sheet. */
        }
      });
    }
  }
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.scroll-foot [data-copy]')) {
    const status = btn.closest('.scroll-foot__cell')?.querySelector<HTMLElement>('[data-copy-status]');
    btn.addEventListener('click', async () => {
      const url = btn.dataset.copy!;
      try {
        await navigator.clipboard.writeText(url);
        if (status) status.textContent = 'Link copied.';
      } catch {
        if (status) status.textContent = url;
      }
    });
  }
</script>

<style is:global>
  .scroll-foot,
  .scroll-foot * {
    box-sizing: border-box !important;
  }
  .scroll-foot {
    --sf-mono: var(--font-mono, var(--log, var(--typed, ui-monospace, Menlo, monospace)));
    --sf-rule: color-mix(in srgb, currentColor 22%, transparent);
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 60rem;
    margin: clamp(3rem, 8vh, 6rem) auto 0;
    padding: clamp(1.6rem, 4vh, 2.6rem) max(16px, env(safe-area-inset-left, 0px)) clamp(2.5rem, 6vh, 4rem)
      max(16px, env(safe-area-inset-right, 0px));
    border-top: 1px solid var(--sf-rule);
    color: inherit;
    font-size: 1rem;
    line-height: 1.5;
    text-align: left;
  }
  .scroll-foot__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .scroll-foot__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2rem 2.5rem;
  }
  .scroll-foot__cell {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    min-width: 0;
  }
  .scroll-foot__k {
    margin: 0;
    font-family: var(--sf-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .scroll-foot__note,
  .scroll-foot__also,
  .scroll-foot__status {
    margin: 0;
    font-size: 0.92rem;
    opacity: 0.8;
  }
  .scroll-foot__status {
    min-height: 1.4em;
    font-family: var(--sf-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    overflow-wrap: anywhere;
  }
  .scroll-foot__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .scroll-foot__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.6rem 0.95rem;
    border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-family: var(--sf-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1.2;
    cursor: pointer;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }
  .scroll-foot__btn:hover,
  .scroll-foot__btn:focus-visible {
    border-color: currentColor;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }
  .scroll-foot__next {
    display: grid;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }
  .scroll-foot__next-label {
    font-family: var(--sf-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .scroll-foot__next-title {
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.8rem);
    line-height: 1.15;
    border-bottom: 1px solid var(--sf-rule);
    padding-bottom: 0.3rem;
    transition: border-color 0.3s ease;
  }
  .scroll-foot__next:hover .scroll-foot__next-title,
  .scroll-foot__next:focus-visible .scroll-foot__next-title {
    border-bottom-color: currentColor;
  }
  .scroll-foot__also a {
    color: inherit;
    text-underline-offset: 0.3em;
  }
  .scroll-foot__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }
  .scroll-foot__form input {
    flex: 1 1 11rem;
    min-width: 0;
    min-height: 44px;
    margin: 0;
    padding: 0.6rem 0.8rem;
    font: inherit;
    font-size: 0.95rem;
    color: inherit;
    background: color-mix(in srgb, currentColor 6%, transparent);
    border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    border-radius: 0;
  }
  .scroll-foot__form input::placeholder {
    color: inherit;
    opacity: 0.5;
  }
  .scroll-foot__form input[aria-invalid='true'] {
    border-color: currentColor;
  }
  .scroll-foot__form .nl-form__status {
    flex-basis: 100%;
    min-height: 1.4em;
    margin: 0;
    font-size: 0.85rem;
    font-style: italic;
    opacity: 0.8;
  }
  .scroll-foot__door {
    justify-self: start;
  }
  .scroll-foot__filed {
    display: grid;
    gap: 0.55rem;
    margin: 2rem 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--sf-rule);
  }
  .scroll-foot__trail ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2em 0.6em;
    margin: 0 0 0.35rem;
    padding: 0;
    font-family: var(--sf-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .scroll-foot__trail li {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .scroll-foot__trail li + li::before {
    content: '/';
    margin-right: 0.6em;
    opacity: 0.55;
  }
  @supports (content: 'x' / '') {
    .scroll-foot__trail li + li::before {
      content: '/' / '';
    }
  }
  .scroll-foot__trail a,
  .scroll-foot__filed-line a {
    color: inherit;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }
  .scroll-foot__filed-line {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .scroll-foot__filed-line .scroll-foot__k {
    display: inline-block;
    margin-right: 0.7em;
  }
  .scroll-foot__dot {
    opacity: 0.5;
  }
  .scroll-foot__commission {
    margin: 2rem 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--sf-rule);
    font-family: var(--sf-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .scroll-foot__commission a {
    color: inherit;
    text-underline-offset: 0.3em;
  }
  .scroll-foot__front {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-top: 0.9rem;
  }
  .scroll-foot__front svg {
    flex: none;
  }
  /* The mark's link keeps a full-height target without making the row taller. */
  .scroll-foot__front .janus-link {
    margin-block: -14px;
    margin-inline: -0.35rem -0.25rem;
  }
  @media print {
    .scroll-foot {
      display: none;
    }
  }
</style>
