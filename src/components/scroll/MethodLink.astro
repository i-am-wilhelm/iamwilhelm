---
/**
 * The one line every source ledger ends on: "How this was made", the way
 * through to /method, where the tags, the originals and the machines are
 * explained. Inherits the ledger's face; the page may pass a class for
 * placement.
 */
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<p class:list={['method-link', cls]}>
  <a href="/method/">How this was made</a>: the tags, the originals, and the machines.
</p>

<style is:global>
  .method-link {
    margin: 1.4rem 0 0;
    font-size: 0.92rem;
    opacity: 0.85;
  }
  .method-link a {
    color: inherit;
    text-underline-offset: 0.3em;
  }
</style>
