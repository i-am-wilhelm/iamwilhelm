---
/**
 * Colophon and contact: the sign-off, a booking CTA to the BackGold
 * scheduler, a mail line, and the BackGold newsletter form.
 */
import Glyph from './Glyph.astro';
import Newsletter from './Newsletter.astro';
import { CONTACT_EMAIL, SCHEDULER_URL, SCHEDULER_IS_PLACEHOLDER } from '../../config/site';
---

<section id="contact" class="colophon" aria-labelledby="contact-title">
  <div class="colophon__inner wrap">
    <div class="colophon__mark" aria-hidden="true">
      <span class="colophon__rule"></span>
      <Glyph sign="libra" size={26} />
      <span class="colophon__rule"></span>
    </div>
    <p class="colophon__label smallcaps" data-reveal>Colophon</p>
    <h2 class="colophon__title display" id="contact-title" data-reveal>Thank you for walking through.</h2>
    <p class="lede colophon__lede" data-reveal>
      If a room here speaks to the work in front of you, a campaign, a cause, a site, or a poem, I would be glad to
      hear about it.
    </p>
    <div class="colophon__grid">
      <div class="colophon__contact" data-reveal>
        <h3 class="colophon__sub smallcaps">Book a conversation</h3>
        <p class="colophon__note">Choose a time on my BackGold calendar.</p>
        <a
          class="cta"
          href={SCHEDULER_URL}
          rel="noopener"
          data-placeholder={SCHEDULER_IS_PLACEHOLDER ? 'scheduler-url' : undefined}
        >
          Book a call
        </a>
        <p class="colophon__mail">
          Or write to <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </p>
      </div>
      <div data-reveal>
        <Newsletter />
      </div>
    </div>
  </div>
</section>

<style>
  .colophon {
    --room-accent: var(--gilt-ink);
    padding-block: clamp(4.5rem, 3rem + 7vw, 9rem);
    text-align: center;
  }
  .colophon__inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
  }
  .colophon__mark {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: min(100%, 22rem);
    color: var(--gilt-ink);
    margin-bottom: 1rem;
  }
  .colophon__rule {
    flex: 1;
    height: 1px;
    background: var(--gilt);
  }
  .colophon__label {
    color: var(--gilt-ink);
    font-size: 1rem;
  }
  .colophon__title {
    font-size: clamp(2.3rem, 1.5rem + 3.4vw, 4.4rem);
    max-width: 18ch;
  }
  .colophon__lede {
    margin-inline: auto;
  }
  .colophon__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    width: 100%;
    max-width: 56rem;
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    border-top: 1px solid var(--rule);
    text-align: left;
  }
  .colophon__contact {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    align-content: start;
  }
  .colophon__sub {
    color: var(--gilt-ink);
    font-weight: 400;
    font-size: 1.05rem;
  }
  .colophon__note {
    color: var(--ink-soft);
    margin-bottom: 0.4rem;
  }
  .colophon__mail {
    margin-top: 0.6rem;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }
  @media (max-width: 760px) {
    .colophon__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
