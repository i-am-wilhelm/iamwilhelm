---
/**
 * The Threshold (#welcome): the doorkeeper, and the one place the museum
 * asks the visitor a question. "What brought you here?" has six answers,
 * three on each side of Janus, and each answer is a door to the room that
 * fits it.
 *
 * It is a popup (a modal <dialog>), kept out of the page's flow. It opens
 *   - by itself, once per browser session, a moment after the Foyer has
 *     settled (GREET_MS below), unless the visitor arrived at a room's
 *     anchor or has already started down the page;
 *   - from any link to #welcome on the homepage: the Foyer's "Begin the
 *     tour" and the footer's "The front door";
 *   - on arrival at /#welcome (the foot of every scroll page, the footer
 *     on every other page, and the /welcome short address).
 * It closes on its Close button, Escape, a click on the veil, or a door.
 * On a phone it is a bottom sheet, like the Archive's reading table.
 *
 * The plan follows the couplet at its foot (Ovid, Fasti 1.135-136): every
 * door has two fronts, one looking out at the people and one looking in at
 * the household god. The elder's side is the work done for others
 * (BackGold, Scrollbrief, Commissions); the youth's side is the work made
 * for its own sake (the Gallery, Futurist, the Reading Room). Pointing at
 * a door wakes the face that looks toward it.
 *
 * Two answers fall between the faces (only looking; looking for Michael)
 * and sit under the coin. The coin itself turns over (Janus.astro).
 *
 * The page remembers the last door taken, in localStorage and nowhere
 * else, and on the next visit offers it back in one line: the face that
 * looks behind. Without script the popup is laid back into the page as a
 * plain section between the Foyer and Now on view (the <noscript> rules at
 * the foot of the markup), so every door is still a link.
 *
 * To change where an answer leads, edit the arrays below. `id` is what the
 * page remembers, so keep it stable once it has shipped.
 */
import Janus from '../Janus.astro';
import JanusMark from '../JanusMark.astro';

interface Door {
  id: string;
  /** The visitor's answer, in their voice. */
  answer: string;
  /** The same answer mid-sentence: "Last time, you came for …". */
  again: string;
  dest: string;
  room: string;
  gloss: string;
  href: string;
  accent: string;
}

/* TODO(owner): the six answers and their glosses are a first draft in the
   site's voice. The destinations and the facts in the glosses come from
   each room's own page. */

/** The elder's side: haec populum spectat. Work done for others. */
const outward: Door[] = [
  {
    id: 'cause',
    answer: 'A cause to organize.',
    again: 'a cause to organize',
    dest: 'BackGold',
    room: 'Room I',
    gloss: 'One platform for campaigns, causes, and organizations.',
    href: '#backgold',
    accent: 'var(--room-i)',
  },
  {
    id: 'case',
    answer: 'A case to argue.',
    again: 'a case to argue',
    dest: 'Scrollbrief',
    room: 'Room V',
    gloss: 'Interactive case stories for trial lawyers.',
    href: '/scrollbrief/',
    accent: '#23456b',
  },
  {
    id: 'story',
    answer: 'A story that needs a page.',
    again: 'a story that needs a page',
    dest: 'Commissions',
    room: 'Room IV',
    gloss: 'Essays, impact reports, and launch pages, built to order.',
    href: '/services/',
    accent: 'var(--room-iv)',
  },
];

/** The youth's side: at illa Larem. Work made for its own sake. */
const inward: Door[] = [
  {
    id: 'slow',
    answer: 'Something to read slowly.',
    again: 'something to read slowly',
    dest: 'The Gallery',
    room: 'Room II',
    gloss: 'Poems and essays, each set on its own page.',
    href: '#gallery',
    accent: 'var(--room-iv)',
  },
  {
    id: 'next',
    answer: 'A look at what comes next.',
    again: 'a look at what comes next',
    dest: 'Futurist',
    room: 'The series',
    gloss: 'The Futurist installments: essays on what is coming.',
    href: '/writings/futurist/',
    accent: '#c0281c',
  },
  {
    id: 'words',
    answer: 'The old words.',
    again: 'the old words',
    dest: 'Writings',
    room: 'Room III',
    gloss: 'Close readings of Greek words that hold more than one world.',
    href: '#writings',
    accent: 'var(--room-v)',
  },
];

const wings = [
  {
    key: 'out',
    title: 'Work to be done',
    tag: 'haec populum spectat',
    gloss: 'This one looks out at the people.',
    doors: outward,
  },
  {
    key: 'in',
    title: 'Something to read',
    tag: 'at illa Larem',
    gloss: 'That one, in at the household god.',
    doors: inward,
  },
];
---

<dialog id="welcome" class="thr" aria-labelledby="welcome-title" data-threshold>
  <div class="thr__bar">
    <JanusMark size={26} class="thr__mark" />
    <span class="thr__label" aria-hidden="true">The Threshold</span>
    <span class="thr__rule" aria-hidden="true"></span>
    <button class="thr__close" type="button" data-thr-close>
      <span class="smallcaps">Close</span>
      <span class="thr__x" aria-hidden="true"></span>
    </button>
  </div>

  <div class="thr__scroll" data-thr-scroll>
    <header class="thr__head">
      <h2 class="thr__title display" id="welcome-title" tabindex="-1" data-thr-title>What brought you here?</h2>
      <p class="thr__lede lede">
        The doorkeeper has two faces. One looks out at the work to be done, the other in at the hearth. Give him
        your answer and he will point.
      </p>
      <p class="thr__again" data-thr-again hidden>
        Last time, you came for <span data-thr-what></span>.
        <a class="text-link" href="#welcome" data-thr-same>The same door</a>
      </p>
    </header>

    <nav class="thr__plan" aria-labelledby="welcome-title">
      {
        wings.map((wing) => (
          <div class:list={['thr__wing', `thr__wing--${wing.key}`]}>
            <p class="thr__wing-head" id={`thr-${wing.key}`}>
              <span class="thr__wing-title smallcaps">{wing.title}</span>
              <span class="thr__wing-tag mono" lang="la" title={wing.gloss}>
                {wing.tag}
              </span>
              <span class="thr__wing-rule" aria-hidden="true" />
            </p>
            <ul class="thr__doors" aria-labelledby={`thr-${wing.key}`}>
              {wing.doors.map((door) => (
                <li>
                  <a
                    class="door"
                    href={door.href}
                    data-door={door.id}
                    data-again={door.again}
                    style={`--door-accent: ${door.accent}`}
                  >
                    <span class="door__answer">{door.answer}</span>
                    <span class="door__dest">
                      <span class="door__name smallcaps">{door.dest}</span>
                      <span class="door__room mono">{door.room}</span>
                    </span>
                    <span class="door__gloss">{door.gloss}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="thr__coin">
        <Janus />
      </div>

      <p class="thr__between">
        <span class="thr__between-k smallcaps">Neither face?</span>
        <a class="thr__between-a" href="#now-on-view" data-door="looking" data-again="a look around">Only looking</a>
        <a class="thr__between-a" href="#contact" data-door="michael" data-again="Michael">Looking for Michael</a>
      </p>
    </nav>

    <figure class="thr__epigraph">
      <blockquote lang="la">
        <p>omnis habet geminas, hinc atque hinc, ianua frontes,</p>
        <p>e quibus haec populum spectat, at illa Larem.</p>
      </blockquote>
      {/* TODO(owner): the translation is a plain draft; set your own reading of the couplet here. */}
      <p class="thr__gloss">
        Every door has two fronts, this side and that. One looks out at the people, the other in at the household
        god.
      </p>
      <figcaption class="mono">Janus, to Ovid &middot; Fasti 1.135&ndash;136</figcaption>
    </figure>
  </div>
</dialog>

{/* Without script the popup can never open, so it is laid back into the
    page as a plain section and #welcome is an ordinary anchor again. */}
<noscript>
  <style is:inline>
    #welcome.thr {
      display: block;
      position: relative;
      inset: auto;
      width: auto;
      max-width: none;
      height: auto;
      max-height: none;
      margin: 0;
      padding-block: 3rem 4rem;
      border: 0;
      box-shadow: none;
      overflow: visible;
      background: linear-gradient(180deg, transparent, rgba(227, 217, 198, 0.55) 12%, rgba(227, 217, 198, 0.55) 88%, transparent);
    }
    #welcome.thr::before,
    #welcome.thr .thr__close {
      display: none;
    }
    #welcome.thr .thr__bar,
    #welcome.thr .thr__scroll {
      max-width: var(--page);
      margin-inline: auto;
      overflow: visible;
    }
  </style>
</noscript>

<script>
  /*
   * The Threshold is a popup. This opens and closes it, and keeps the
   * face that looks behind: the last door taken is remembered (in this
   * browser only) and offered back on the next visit.
   */
  const KEY = 'iw:threshold';
  /** Set once the popup has opened in this browser session. */
  const GREETED = 'iw:threshold-greeted';
  /** How long after load the doorkeeper waits before greeting a new arrival. */
  const GREET_MS = 1400;
  /** Matches the is-leaving animation below. */
  const LEAVE_MS = 240;

  const root = document.documentElement;
  const dlg = document.querySelector<HTMLDialogElement>('[data-threshold]');

  if (dlg) {
    const doors = Array.from(dlg.querySelectorAll<HTMLAnchorElement>('[data-door]'));
    const again = dlg.querySelector<HTMLElement>('[data-thr-again]');
    const what = again?.querySelector<HTMLElement>('[data-thr-what]');
    const same = again?.querySelector<HTMLAnchorElement>('[data-thr-same]');

    /* The face that looks behind. */
    try {
      const id = localStorage.getItem(KEY);
      const last = id ? doors.find((d) => d.dataset.door === id) : undefined;
      if (last && again && what && same) {
        what.textContent = last.dataset.again ?? '';
        same.href = last.getAttribute('href') ?? '#welcome';
        same.dataset.door = last.dataset.door;
        again.hidden = false;
        last.classList.add('is-last');
      }
    } catch {
      /* Storage is closed to this page. The doors still open. */
    }
  }

  if (dlg && typeof dlg.showModal === 'function') {
    const scroller = dlg.querySelector<HTMLElement>('[data-thr-scroll]');
    const title = dlg.querySelector<HTMLElement>('[data-thr-title]');
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let leaving = 0;

    const show = () => {
      if (dlg.open) return;
      dlg.classList.remove('is-leaving');
      root.style.setProperty('--thr-sbw', `${Math.max(0, window.innerWidth - root.clientWidth)}px`);
      root.classList.add('thr-locked');
      dlg.showModal();
      /* The question is read first; Tab then moves on to Close and the doors. */
      title?.focus({ preventScroll: true });
      if (scroller) scroller.scrollTop = 0;
      try {
        sessionStorage.setItem(GREETED, '1');
      } catch {
        /* Nothing to remember with. */
      }
    };

    const closeNow = () => {
      window.clearTimeout(leaving);
      leaving = 0;
      dlg.classList.remove('is-leaving');
      if (dlg.open) dlg.close();
      root.classList.remove('thr-locked');
    };

    const hide = () => {
      if (!dlg.open || leaving) return;
      if (still.matches) return closeNow();
      dlg.classList.add('is-leaving');
      leaving = window.setTimeout(closeNow, LEAVE_MS);
    };

    /** A plain left click, with nothing held that would open a new tab. */
    const plain = (e: MouseEvent) => e.button === 0 && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey;

    /** A link whose target is on this page (#room), as opposed to another page. */
    const here = (a: HTMLAnchorElement) => {
      const url = new URL(a.href, location.href);
      return url.origin === location.origin && url.pathname === location.pathname && url.hash.length > 1
        ? url.hash
        : '';
    };

    dlg.querySelector('[data-thr-close]')?.addEventListener('click', hide);
    /* Escape: leave the same way the Close button does. */
    dlg.addEventListener('cancel', (e) => {
      e.preventDefault();
      hide();
    });
    dlg.addEventListener('close', () => root.classList.remove('thr-locked'));

    dlg.addEventListener('click', (e) => {
      const target = e.target as Element;
      const link = target.closest<HTMLAnchorElement>('a[href]');
      if (link) {
        if (link.dataset.door) {
          try {
            localStorage.setItem(KEY, link.dataset.door);
          } catch {
            /* Nothing to remember with. */
          }
        }
        /* A door to a room on this page: step aside at once, so the
           browser's own jump to the room is what moves the page and the
           keyboard's place in it. Doors to other pages just leave. */
        if (plain(e) && here(link)) closeNow();
        return;
      }
      /* A click on the veil (outside the panel) closes it. */
      if (target === dlg) {
        const r = dlg.getBoundingClientRect();
        const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
        if (!inside) hide();
      }
    });

    /* Every link to #welcome on this page opens the popup. */
    document.addEventListener('click', (e) => {
      if (!plain(e) || e.defaultPrevented) return;
      const link = (e.target as Element).closest?.<HTMLAnchorElement>('a[href]');
      if (!link || dlg.contains(link) || here(link) !== '#welcome') return;
      e.preventDefault();
      show();
    });

    /* Arriving at /#welcome (or /welcome) opens it; the address is then
       tidied so a reload or a copied link is the plain homepage. */
    const fromHash = () => {
      if (location.hash !== '#welcome') return false;
      show();
      history.replaceState(history.state, '', location.pathname + location.search);
      return true;
    };
    addEventListener('hashchange', fromHash);

    if (!fromHash() && !location.hash) {
      let greeted = false;
      try {
        greeted = sessionStorage.getItem(GREETED) === '1';
      } catch {
        /* No session memory: greet on every arrival. */
      }
      if (!greeted) {
        window.setTimeout(() => {
          /* Already down the page, or busy with another popup: let them be. */
          if (window.scrollY > window.innerHeight * 0.5) return;
          if (document.querySelector('dialog[open]')) return;
          show();
        }, GREET_MS);
      }
    }
  }
</script>

<style>
  /* ---- The panel ---------------------------------------------------- */
  .thr {
    --room-accent: var(--gilt-ink);
    --thr-pad: clamp(1.25rem, 0.6rem + 2.4vw, 2.75rem);
    /* One thirty-second note at the site tempo: the popup's parts arrive
       on the same 7/8 count as the page's reveals, twice as fast. */
    --thr-step: calc(var(--beat) / 8);
    position: fixed;
    inset: 0;
    width: min(71rem, calc(100vw - 2rem));
    max-width: none;
    height: fit-content;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border: 1px solid var(--gilt);
    background:
      radial-gradient(120% 70% at 50% 0%, rgba(255, 252, 244, 0.9), transparent 70%),
      var(--wall);
    color: var(--ink);
    overflow: hidden;
    box-shadow:
      0 50px 90px -40px rgba(20, 14, 6, 0.7),
      0 18px 40px -22px rgba(20, 14, 6, 0.45);
  }
  /* Closed means gone, stated here as well so a browser that does not
     know <dialog> cannot leave the panel stuck on screen. */
  .thr:not([open]) {
    display: none;
  }
  .thr[open] {
    display: flex;
    flex-direction: column;
    animation: thr-rise calc(var(--beat) * 0.9) var(--ease-settle) both;
  }
  /* A second gilt hairline inside the first, like the mount of a label. */
  .thr::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid color-mix(in srgb, var(--gilt) 38%, transparent);
    pointer-events: none;
  }
  .thr::backdrop {
    background: #18120a99;
  }
  .thr[open]::backdrop {
    animation: thr-dim calc(var(--beat) * 0.9) ease both;
  }
  .thr.is-leaving {
    animation: thr-leave 0.24s ease-in both;
  }
  .thr.is-leaving::backdrop {
    animation: thr-dim 0.24s ease reverse both;
  }
  /* The page behind holds still while the popup is up. The scrollbar's
     width (measured in the script) is padded back in, so nothing shifts
     sideways when it goes. */
  :global(html.thr-locked) {
    overflow: hidden;
    padding-right: var(--thr-sbw, 0px);
  }

  @keyframes thr-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 22px, 0) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes thr-leave {
    to {
      opacity: 0;
      transform: translate3d(0, 10px, 0);
    }
  }
  @keyframes thr-up {
    from {
      transform: translate3d(0, 100%, 0);
    }
    to {
      transform: none;
    }
  }
  @keyframes thr-down {
    to {
      transform: translate3d(0, 100%, 0);
    }
  }
  @keyframes thr-dim {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes thr-settle {
    from {
      opacity: 0;
      transform: translate3d(0, 14px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Each part settles in turn: 2, 2, 3 steps apart, then again. */
  .thr[open] :is(.thr__head, .thr__coin, .thr__wing, .thr__between, .thr__epigraph) {
    animation: thr-settle calc(var(--beat) * 1.1) var(--ease-settle) both;
    animation-delay: calc(var(--thr-step) * var(--thr-at, 0));
  }
  .thr__head {
    --thr-at: 1;
  }
  .thr__coin {
    --thr-at: 3;
  }
  .thr__wing--out {
    --thr-at: 5;
  }
  .thr__wing--in {
    --thr-at: 8;
  }
  .thr__between {
    --thr-at: 10;
  }
  .thr__epigraph {
    --thr-at: 12;
  }

  /* ---- The bar: where you are, and the way out ----------------------- */
  .thr__bar {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem calc(var(--thr-pad) - 0.5rem) 0 var(--thr-pad);
    color: var(--room-accent);
  }
  .thr :global(.thr__mark) {
    flex: none;
    color: var(--gilt-ink);
  }
  .thr__label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.22em;
    font-variant-caps: all-small-caps;
    white-space: nowrap;
  }
  .thr__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--gilt), transparent);
    opacity: 0.7;
  }
  .thr__close {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 0.5rem;
    border: 0;
    background: none;
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    transition: color 300ms ease;
  }
  .thr__close:hover,
  .thr__close:focus-visible {
    color: var(--ink);
  }
  .thr__x {
    position: relative;
    width: 0.85rem;
    height: 0.85rem;
  }
  .thr__x::before,
  .thr__x::after {
    content: '';
    position: absolute;
    inset: 50% -12% auto;
    height: 1px;
    background: currentColor;
    transform: rotate(45deg);
    transition: transform 500ms var(--ease-settle);
  }
  .thr__x::after {
    transform: rotate(-45deg);
  }
  .thr__close:hover .thr__x::before {
    transform: rotate(135deg);
  }
  .thr__close:hover .thr__x::after {
    transform: rotate(45deg);
  }

  /* ---- The body: scrolls inside the panel when the window is short --- */
  .thr__scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(0.5rem, 0.2rem + 1vw, 1.25rem) var(--thr-pad) clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
  }

  .thr__head {
    display: grid;
    justify-items: center;
    gap: clamp(0.6rem, 0.45rem + 0.5vw, 1rem);
    margin-bottom: clamp(1.4rem, 1rem + 1.4vw, 2.25rem);
    text-align: center;
  }
  .thr__title {
    font-size: clamp(2.1rem, 1.35rem + 3vw, 3.75rem);
    color: var(--ink);
  }
  /* The title takes focus when the popup opens so it is read first; it is
     not a control, so it wears no ring. */
  .thr__title:focus {
    outline: none;
  }
  .thr__lede {
    max-width: 38rem;
    font-size: clamp(1.0625rem, 0.98rem + 0.4vw, 1.25rem);
    text-wrap: balance;
  }
  .thr__again {
    color: var(--ink-soft);
    font-style: italic;
  }
  .thr__again a {
    font-style: normal;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  /* The plan: a wing either side of the coin, each face toward its own. */
  .thr__plan {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(10.5rem, 6.5rem + 9vw, 14.5rem) minmax(0, 1fr);
    grid-template-areas:
      'out coin in'
      'out between in';
    column-gap: clamp(1.25rem, 0.25rem + 3vw, 3.25rem);
    row-gap: 0.75rem;
    align-items: start;
  }
  .thr__wing--out {
    grid-area: out;
    text-align: right;
  }
  .thr__wing--in {
    grid-area: in;
  }
  .thr__coin {
    grid-area: coin;
    align-self: end;
  }
  .thr__between {
    grid-area: between;
    align-self: start;
  }

  .thr__wing-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.8rem;
    margin-bottom: 0.7rem;
  }
  .thr__wing--out .thr__wing-head {
    flex-direction: row-reverse;
  }
  .thr__wing-title {
    color: var(--gilt-ink);
    font-size: 1.05rem;
    white-space: nowrap;
  }
  .thr__wing-tag {
    color: var(--ink-faint);
    font-style: italic;
    white-space: nowrap;
    cursor: help;
  }
  /* The line of sight: strongest by the coin, gone by the far wall. */
  .thr__wing-rule {
    flex: 1 1 0;
    align-self: center;
    min-width: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--gilt), transparent);
    opacity: 0.7;
  }
  .thr__wing--out .thr__wing-rule {
    background: linear-gradient(270deg, var(--gilt), transparent);
  }

  .thr__doors {
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }
