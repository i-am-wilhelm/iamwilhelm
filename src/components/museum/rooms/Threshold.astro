---
/**
 * The Threshold (#welcome): the doorway between the Foyer and the rooms,
 * and the one place the museum asks the visitor a question. "What brought
 * you here?" has six answers, three on each side of Janus, and each answer
 * is a door to the room that fits it.
 *
 * The plan follows the couplet at its foot (Ovid, Fasti 1.135-136): every
 * door has two fronts, one looking out at the people and one looking in at
 * the household god. The elder's side is the work done for others
 * (BackGold, Scrollbrief, Commissions); the youth's side is the work made
 * for its own sake (the Gallery, Futurist, the Reading Room). Pointing at
 * a door wakes the face that looks toward it.
 *
 * Two answers fall between the faces (only looking; looking for Michael)
 * and sit under the coin. The coin itself turns over (Janus.astro).
 *
 * The page remembers the last door taken, in localStorage and nowhere
 * else, and on the next visit offers it back in one line: the face that
 * looks behind. Nothing here needs script to work; every door is a link.
 *
 * To change where an answer leads, edit the arrays below. `id` is what the
 * page remembers, so keep it stable once it has shipped.
 */
import Janus from '../Janus.astro';
import JanusMark from '../JanusMark.astro';

interface Door {
  id: string;
  /** The visitor's answer, in their voice. */
  answer: string;
  /** The same answer mid-sentence: "Last time, you came for …". */
  again: string;
  dest: string;
  room: string;
  gloss: string;
  href: string;
  accent: string;
}

/* TODO(owner): the six answers and their glosses are a first draft in the
   site's voice. The destinations and the facts in the glosses come from
   each room's own page. */

/** The elder's side: haec populum spectat. Work done for others. */
const outward: Door[] = [
  {
    id: 'cause',
    answer: 'A cause to organize.',
    again: 'a cause to organize',
    dest: 'BackGold',
    room: 'Room I',
    gloss: 'One platform for campaigns, causes, and organizations.',
    href: '#backgold',
    accent: 'var(--room-i)',
  },
  {
    id: 'case',
    answer: 'A case to argue.',
    again: 'a case to argue',
    dest: 'Scrollbrief',
    room: 'Room V',
    gloss: 'Interactive case stories for trial lawyers.',
    href: '/scrollbrief/',
    accent: '#23456b',
  },
  {
    id: 'story',
    answer: 'A story that needs a page.',
    again: 'a story that needs a page',
    dest: 'Commissions',
    room: 'Room IV',
    gloss: 'Essays, impact reports, and launch pages, built to order.',
    href: '/services/',
    accent: 'var(--room-iv)',
  },
];

/** The youth's side: at illa Larem. Work made for its own sake. */
const inward: Door[] = [
  {
    id: 'slow',
    answer: 'Something to read slowly.',
    again: 'something to read slowly',
    dest: 'The Gallery',
    room: 'Room II',
    gloss: 'Poems and essays, each set on its own page.',
    href: '#gallery',
    accent: 'var(--room-iv)',
  },
  {
    id: 'next',
    answer: 'A look at what comes next.',
    again: 'a look at what comes next',
    dest: 'Futurist',
    room: 'The series',
    gloss: 'The Futurist installments: essays on what is coming.',
    href: '/writings/futurist/',
    accent: '#c0281c',
  },
  {
    id: 'words',
    answer: 'The old words.',
    again: 'the old words',
    dest: 'Writings',
    room: 'Room III',
    gloss: 'Close readings of Greek words that hold more than one world.',
    href: '#writings',
    accent: 'var(--room-v)',
  },
];

const wings = [
  {
    key: 'out',
    title: 'Work to be done',
    tag: 'haec populum spectat',
    gloss: 'This one looks out at the people.',
    doors: outward,
  },
  {
    key: 'in',
    title: 'Something to read',
    tag: 'at illa Larem',
    gloss: 'That one, in at the household god.',
    doors: inward,
  },
];
---

<section id="welcome" class="thr" aria-labelledby="welcome-title" data-threshold>
  <div class="thr__wayfinding wrap" aria-hidden="true">
    <span class="thr__label">The Threshold</span>
    <span class="thr__rule"></span>
    <JanusMark size={30} class="thr__mark" />
  </div>

  <div class="thr__inner wrap">
    <header class="thr__head" data-reveal>
      <h2 class="thr__title display" id="welcome-title">What brought you here?</h2>
      <p class="thr__lede lede">
        The doorkeeper has two faces. One looks out at the work to be done, the other in at the hearth. Give him
        your answer and he will point.
      </p>
      <p class="thr__again" data-thr-again hidden>
        Last time, you came for <span data-thr-what></span>.
        <a class="text-link" href="#welcome" data-thr-same>The same door</a>
      </p>
    </header>

    <nav class="thr__plan" aria-labelledby="welcome-title">
      {
        wings.map((wing) => (
          <div class:list={['thr__wing', `thr__wing--${wing.key}`]} data-reveal>
            <p class="thr__wing-head" id={`thr-${wing.key}`}>
              <span class="thr__wing-title smallcaps">{wing.title}</span>
              <span class="thr__wing-tag mono" lang="la" title={wing.gloss}>
                {wing.tag}
              </span>
              <span class="thr__wing-rule" aria-hidden="true" />
            </p>
            <ul class="thr__doors" aria-labelledby={`thr-${wing.key}`}>
              {wing.doors.map((door) => (
                <li>
                  <a
                    class="door"
                    href={door.href}
                    data-door={door.id}
                    data-again={door.again}
                    style={`--door-accent: ${door.accent}`}
                  >
                    <span class="door__answer">{door.answer}</span>
                    <span class="door__dest">
                      <span class="door__name smallcaps">{door.dest}</span>
                      <span class="door__room mono">{door.room}</span>
                    </span>
                    <span class="door__gloss">{door.gloss}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="thr__coin" data-reveal>
        <Janus />
      </div>

      <p class="thr__between" data-reveal>
        <span class="thr__between-k smallcaps">Neither face?</span>
        <a class="thr__between-a" href="#now-on-view" data-door="looking" data-again="a look around">Only looking</a>
        <a class="thr__between-a" href="#contact" data-door="michael" data-again="Michael">Looking for Michael</a>
      </p>
    </nav>

    <figure class="thr__epigraph" data-reveal>
      <blockquote lang="la">
        <p>omnis habet geminas, hinc atque hinc, ianua frontes,</p>
        <p>e quibus haec populum spectat, at illa Larem.</p>
      </blockquote>
      {/* TODO(owner): the translation is a plain draft; set your own reading of the couplet here. */}
      <p class="thr__gloss">
        Every door has two fronts, this side and that. One looks out at the people, the other in at the household
        god.
      </p>
      <figcaption class="mono">Janus, to Ovid &middot; Fasti 1.135&ndash;136</figcaption>
    </figure>
  </div>
</section>

<script>
  /* The face that looks behind: remember the last door taken (in this
     browser only) and offer it back on the next visit. */
  const KEY = 'iw:threshold';
  const root = document.querySelector<HTMLElement>('[data-threshold]');
  if (root) {
    const doors = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-door]'));
    const again = root.querySelector<HTMLElement>('[data-thr-again]');
    const what = again?.querySelector<HTMLElement>('[data-thr-what]');
    const same = again?.querySelector<HTMLAnchorElement>('[data-thr-same]');
    try {
      const id = localStorage.getItem(KEY);
      const last = id ? doors.find((d) => d.dataset.door === id) : undefined;
      if (last && again && what && same) {
        what.textContent = last.dataset.again ?? '';
        same.href = last.getAttribute('href') ?? '#welcome';
        again.hidden = false;
        last.classList.add('is-last');
      }
    } catch {
      /* Storage is closed to this page. The doors still open. */
    }
    for (const door of doors) {
      door.addEventListener('click', () => {
        try {
          localStorage.setItem(KEY, door.dataset.door ?? '');
        } catch {
          /* Nothing to remember with. */
        }
      });
    }
  }
</script>

<style>
  .thr {
    --room-accent: var(--gilt-ink);
    position: relative;
    padding-block: clamp(3rem, 2.25rem + 3.5vw, 5.5rem) clamp(3.5rem, 2.5rem + 5vw, 7.5rem);
    /* The deeper wall tone, so the doorway reads as its own space between
       the Foyer and what is on view. */
    background: linear-gradient(
      180deg,
      transparent,
      rgba(227, 217, 198, 0.55) 12%,
      rgba(227, 217, 198, 0.55) 88%,
      transparent
    );
  }
  .thr__wayfinding {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(1.75rem, 1.4rem + 1.4vw, 2.75rem);
    color: var(--room-accent);
  }
  .thr__label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.22em;
    font-variant-caps: all-small-caps;
    white-space: nowrap;
  }
  .thr__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--gilt), transparent);
    opacity: 0.7;
  }
  .thr :global(.thr__mark) {
    flex: none;
    color: var(--gilt-ink);
  }

  .thr__head {
    display: grid;
    justify-items: center;
    gap: clamp(0.9rem, 0.7rem + 0.6vw, 1.4rem);
    margin-bottom: clamp(2rem, 1.5rem + 2.2vw, 3.5rem);
    text-align: center;
  }
  .thr__title {
    font-size: clamp(2.4rem, 1.5rem + 4.2vw, 4.8rem);
    color: var(--ink);
  }
  .thr__lede {
    max-width: 40rem;
    text-wrap: balance;
  }
  .thr__again {
    color: var(--ink-soft);
    font-style: italic;
  }
  .thr__again a {
    font-style: normal;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  /* The plan: a wing either side of the coin, each face toward its own. */
  .thr__plan {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(12rem, 8rem + 10vw, 17rem) minmax(0, 1fr);
    grid-template-areas:
      'out coin in'
      'out between in';
    column-gap: clamp(1.5rem, 0.25rem + 3.5vw, 4rem);
    row-gap: 1.1rem;
    align-items: start;
  }
  .thr__wing--out {
    grid-area: out;
    text-align: right;
  }
  .thr__wing--in {
    grid-area: in;
  }
  .thr__coin {
    grid-area: coin;
    align-self: end;
  }
  .thr__between {
    grid-area: between;
    align-self: start;
  }

  .thr__wing-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.8rem;
    margin-bottom: 0.9rem;
  }
  .thr__wing--out .thr__wing-head {
    flex-direction: row-reverse;
  }
  .thr__wing-title {
    color: var(--gilt-ink);
    font-size: 1.05rem;
    white-space: nowrap;
  }
  .thr__wing-tag {
    color: var(--ink-faint);
    font-style: italic;
    white-space: nowrap;
    cursor: help;
  }
  /* The line of sight: strongest by the coin, gone by the far wall. */
  .thr__wing-rule {
    flex: 1 1 0;
    align-self: center;
    min-width: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--gilt), transparent);
    opacity: 0.7;
  }
  .thr__wing--out .thr__wing-rule {
    background: linear-gradient(270deg, var(--gilt), transparent);
  }

  .thr__doors {
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }
  .door {
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding: clamp(0.85rem, 0.7rem + 0.5vw, 1.2rem) 0 clamp(0.95rem, 0.8rem + 0.5vw, 1.3rem);
    border-top: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
  }
  /* The door's own colour runs along its lintel, starting from the coin. */
  .door::before {
    content: '';
    position: absolute;
    inset: -1px 0 auto;
    height: 1px;
    background: var(--door-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform calc(var(--beat) * 0.9) var(--ease-settle);
  }
  .thr__wing--out .door::before {
    transform-origin: right;
  }
  .door:hover::before,
  .door:focus-visible::before {
    transform: scaleX(1);
  }
  .door__answer {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.45rem, 1.15rem + 1.1vw, 2rem);
    line-height: 1.15;
    color: var(--ink);
    text-wrap: balance;
    transition: color 400ms var(--ease-settle);
  }
  .door:hover .door__answer,
  .door:focus-visible .door__answer {
    color: var(--door-accent);
  }
  .door__dest {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.7rem;
    color: var(--door-accent);
  }
  .thr__wing--out .door__dest {
    justify-content: flex-end;
  }
  .door__name {
    font-size: 1.05rem;
  }
  .door__room {
    color: var(--ink-faint);
  }
  .door__gloss {
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.4;
    text-wrap: pretty;
  }
  /* The door taken last time: one gilt point beside its answer. */
  .door.is-last .door__answer::after {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-left: 0.55em;
    border-radius: 50%;
    background: var(--gilt);
    vertical-align: 0.28em;
  }

  /* Pointing at a door wakes the face that looks toward it. */
  .thr:has(.thr__wing--out .door:is(:hover, :focus-visible)) :global(.janus__face--out),
  .thr:has(.thr__wing--in .door:is(:hover, :focus-visible)) :global(.janus__face--in) {
    color: var(--ink);
  }
  .thr:has(.thr__wing--out .door:is(:hover, :focus-visible)) :global(.janus__face--in),
  .thr:has(.thr__wing--in .door:is(:hover, :focus-visible)) :global(.janus__face--out) {
    opacity: 0.35;
  }

  .thr__between {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    text-align: center;
  }
  .thr__between-k {
    color: var(--gilt-ink);
    font-size: 0.95rem;
  }
  .thr__between-a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.5rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.4rem);
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--gilt) 70%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    transition:
      color 300ms ease,
      text-decoration-color 300ms ease;
  }
  .thr__between-a + .thr__between-a {
    margin-top: -0.5rem;
  }
  .thr__between-a:hover,
  .thr__between-a:focus-visible {
    color: var(--ink);
    text-decoration-color: var(--gilt-ink);
  }

  .thr__epigraph {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    margin-top: clamp(2.5rem, 2rem + 3vw, 5rem);
    text-align: center;
  }
  .thr__epigraph blockquote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 1.05rem + 0.5vw, 1.45rem);
    line-height: 1.35;
    color: var(--ink);
  }
  .thr__gloss {
    max-width: 30rem;
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.45;
    text-wrap: balance;
  }
  .thr__epigraph figcaption {
    color: var(--ink-faint);
  }

  /* Between phone and desktop the wings are narrow: each heading stacks
     its Latin under its title, so both lists start on the same line. */
  @media (min-width: 861px) and (max-width: 1080px) {
    .thr__wing-head,
    .thr__wing--out .thr__wing-head {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
    }
    .thr__wing--out .thr__wing-head {
      align-items: flex-end;
    }
    .thr__wing-rule {
      display: none;
    }
  }

  /* Narrow screens: the coin first, then each wing in turn, read down the page. */
  @media (max-width: 860px) {
    .thr__plan {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'coin'
        'out'
        'in'
        'between';
      row-gap: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
    }
    .thr__coin {
      justify-self: center;
      width: min(13.5rem, 62vw);
    }
    .thr__wing--out {
      text-align: left;
    }
    .thr__wing--out .thr__wing-head {
      flex-direction: row;
    }
    .thr__wing--out .thr__wing-rule {
      background: linear-gradient(90deg, var(--gilt), transparent);
    }
    .thr__wing--out .door::before {
      transform-origin: left;
    }
    .thr__wing--out .door__dest {
      justify-content: flex-start;
    }
    .thr__between {
      grid-auto-flow: row;
    }
  }
</style>
