---
/**
 * Room III: Advancing Liberty Media / Websites by Wilhelm, hung as a studio
 * wall. One framed picture under a brass picture light, a caption beneath
 * it, and a column of wall labels that choose which of the four works
 * hangs there. The works: src/data/portfolio.ts. Behaviour: wall.ts.
 */
import Room from '../Room.astro';
import Placard from '../Placard.astro';
import { portfolio } from '../../../data/portfolio';
import { ALM_URL } from '../../../config/site';

const first = portfolio.find((w) => w.flagship) ?? portfolio[0];
const external = (href: string) => href.startsWith('http');
const last = portfolio[portfolio.length - 1].code;
---

<Room id="work" number={3} sign="gemini" accent="var(--room-iii)" labelledby="work-title">
  <div class="studio wrap">
    <div class="studio__head">
      <Placard
        id="work-title"
        label="Room III · The Studio"
        title="Advancing Liberty Media"
        subtitle="Websites by Wilhelm"
        medium="Campaign websites, product sites, and interactive pages, built on BackGold"
        year="2026"
        catalog={`Cat. ${portfolio[0].code}–${last}`}
      />
      <div class="studio__statement prose-museum" data-reveal>
        <p class="lede">
          Advancing Liberty Media gives candidates, parties, and freedom organizations professional campaign
          infrastructure: strategy, training, and digital media in one place.
        </p>
        <p>
          Websites by Wilhelm is its design studio. Four works hang in this room, chosen for what they show. Each was
          designed and built by Michael and ships on BackGold, with donations, supporters, email, and events configured
          from day one.
        </p>
        <p class="studio__howto">Choose a label to hang a work. The caption beneath the frame leads to the live page.</p>
      </div>
    </div>

    <div class="wall" data-wall data-boot={first.slug}>
      <div class="easel" data-reveal>
        <div class="picture-light" aria-hidden="true">
          <span class="picture-light__arm"></span>
          <span class="picture-light__bar"></span>
        </div>
        <div class="frame" data-frame>
          <div class="frame__mat">
            <div class="frame__glass">
              <img
                class="frame__pic is-front"
                data-pic-a
                src={`/work/${first.slug}.webp`}
                alt={first.alt}
                width="960"
                height="600"
                loading="lazy"
                decoding="async"
              />
              <img class="frame__pic" data-pic-b src="" alt="" width="960" height="600" aria-hidden="true" />
              <canvas class="frame__live" data-live-canvas hidden></canvas>
              <span class="frame__wash"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="caption" data-caption data-reveal>
        <p class="caption__code mono" data-cap-code>Cat. {first.code}</p>
        <h3 class="caption__title display" data-cap-title>{first.title}</h3>
        <p class="caption__medium" data-cap-medium>{first.medium}</p>
        <p class="caption__text" data-cap-text>{first.caption}</p>
        <p class="caption__foot">
          <a
            class="cta cta--gilt"
            data-cap-link
            href={first.href}
            target={external(first.href) ? '_blank' : undefined}
            rel={external(first.href) ? 'noopener' : undefined}>Visit the work</a
          >
          <span class="mono caption__domain" data-cap-domain>{first.domain}</span>
        </p>
        <p class="sr-only" role="status" aria-live="polite" data-wall-status></p>
      </div>

      <div class="labels" data-reveal>
        <p class="labels__head">
          <span class="smallcaps">Works in this room</span>
          <span class="mono">{portfolio.length} on the wall</span>
        </p>
        <ol class="labels__list" role="list">
          {
            portfolio.map((w) => (
              <li>
                <button
                  type="button"
                  class="wall-label"
                  data-work={w.slug}
                  data-src={`/work/${w.slug}.webp`}
                  data-alt={w.alt}
                  data-title={w.title}
                  data-medium={w.medium}
                  data-caption={w.caption}
                  data-href={w.href}
                  data-domain={w.domain}
                  data-code={w.code}
                  data-live={w.live}
                  aria-pressed={w.slug === first.slug ? 'true' : 'false'}
                >
                  <span class="wall-label__pin" aria-hidden="true" />
                  <span class="wall-label__code mono">Cat. {w.code}</span>
                  <span class="wall-label__title">{w.title}</span>
                  <span class="wall-label__medium">{w.medium}</span>
                  <span class="wall-label__foot">
                    <span class="wall-label__year">{w.year}</span>
                    <span class="wall-label__state smallcaps">
                      <span class="wall-label__state-on">On the wall</span>
                      <span class="wall-label__state-off">Hang this</span>
                    </span>
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="studio__cta" data-reveal>
      <a class="cta" href={ALM_URL} rel="noopener">Visit Advancing Liberty Media</a>
    </div>
  </div>
</Room>

<script>
  import '../../../scripts/case/wall.ts';
</script>

<style>
  .studio {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .studio__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .studio__statement {
    padding-top: 0.5rem;
    color: var(--ink-soft);
  }
  .studio__statement .lede {
    color: var(--ink);
  }
  .studio__howto {
    font-style: italic;
  }

  /* ---- The wall: frame and caption on the left, labels on the right ---- */
  .wall {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-areas:
      'easel labels'
      'caption labels';
    column-gap: clamp(2rem, 1rem + 4vw, 5rem);
    row-gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    align-items: start;
  }
  .easel {
    grid-area: easel;
    position: relative;
    padding-top: 2.6rem; /* room for the picture light */
  }
  .caption {
    grid-area: caption;
  }
  .labels {
    grid-area: labels;
    align-self: stretch;
  }

  /*
   * The picture light: a slender brass bar on a short arm, centred over
   * the frame. Its wash falls down the glass (.frame__wash) and dims while
   * a work is being changed.
   */
  .picture-light {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    width: 46%;
    pointer-events: none;
    z-index: 3;
  }
  .picture-light__arm {
    width: 2px;
    height: 1.5rem;
    background: linear-gradient(180deg, var(--gilt-ink), var(--gilt-bright));
  }
  .picture-light__bar {
    width: 100%;
    height: 9px;
    border-radius: 2px;
    background: linear-gradient(180deg, #e2c47c, var(--gilt) 55%, var(--gilt-ink));
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.55) inset,
      0 6px 14px -6px rgba(60, 40, 10, 0.6);
  }

  /* The frame: charcoal moulding, ivory mat, gilt fillet, then the glass. */
  .frame {
    padding: clamp(8px, 0.4rem + 0.5vw, 14px);
    background: linear-gradient(135deg, #2e2a25, #1a1815 55%, #2b2723);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.45),
      0 2px 0 rgba(0, 0, 0, 0.25) inset,
      0 36px 60px -34px rgba(40, 28, 12, 0.7),
      0 14px 24px -16px rgba(40, 28, 12, 0.45);
  }
  .frame__mat {
    padding: clamp(0.9rem, 0.6rem + 1.4vw, 1.9rem);
    background: #fbf8f1;
    outline: 1px solid var(--gilt);
    outline-offset: -6px;
  }
  .frame__glass {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #14120f;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.5) inset;
  }
  .frame__pic,
  .frame__live {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    transition:
      opacity calc(var(--beat) * 2) var(--ease-settle),
      filter calc(var(--beat) * 1.2) var(--ease-settle);
  }
  .frame__pic.is-front {
    opacity: 1;
  }
  .frame__live.is-on {
    opacity: 1;
    transition-duration: calc(var(--beat) * 2.4);
  }
  .frame__live[hidden] {
    display: none;
  }
  /* The light's wash down the glass, and the glazing's faint reflection. */
  .frame__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(70% 55% at 50% -8%, rgba(255, 234, 184, 0.34), transparent 70%),
      linear-gradient(112deg, rgba(255, 255, 255, 0.07) 0%, transparent 28%, transparent 72%, rgba(255, 255, 255, 0.035) 100%);
    transition: opacity calc(var(--beat) * 1.2) var(--ease-settle);
  }
  .frame.is-changing .frame__wash {
    opacity: 0.25;
  }
  .frame.is-changing .frame__pic,
  .frame.is-changing .frame__live {
    filter: brightness(0.55);
  }

  /* ---- The caption beneath the frame ---- */
  .caption {
    max-width: 38rem;
    transition: opacity calc(var(--beat) * 0.9) var(--ease-settle);
  }
  .caption.is-changing {
    opacity: 0;
  }
  .caption__code {
    color: var(--room-accent);
  }
  .caption__title {
    margin-top: 0.3rem;
    font-size: clamp(1.75rem, 1.35rem + 1.6vw, 2.5rem);
    color: var(--ink);
  }
  .caption__medium {
    margin-top: 0.35rem;
    font-style: italic;
    color: var(--ink-soft);
  }
  .caption__text {
    margin-top: 0.9rem;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .caption__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.25rem;
  }
  .caption__domain {
    color: var(--ink-faint);
  }

  /* ---- The wall labels ---- */
  .labels__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.7rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--room-accent);
  }
  .labels__head .mono {
    color: var(--ink-faint);
  }
  .labels__list {
    list-style: none;
    display: grid;
    gap: 0.8rem;
  }
  .wall-label {
    position: relative;
    display: grid;
    gap: 0.3rem;
    width: 100%;
    padding: 1.05rem 1.2rem 0.95rem 1.4rem;
    text-align: left;
    font: inherit;
    line-height: inherit;
    color: var(--ink);
    background: color-mix(in srgb, var(--wall) 70%, white);
    border: 1px solid var(--rule);
    cursor: pointer;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.7) inset,
      0 10px 24px -20px rgba(40, 30, 15, 0.5);
    transition:
      background-color calc(var(--beat) * 0.7) var(--ease-settle),
      border-color calc(var(--beat) * 0.7) var(--ease-settle),
      transform calc(var(--beat) * 0.9) var(--ease-settle),
      box-shadow calc(var(--beat) * 0.9) var(--ease-settle);
  }
  .wall-label:hover {
    transform: translateY(-2px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.7) inset,
      0 18px 30px -22px rgba(40, 30, 15, 0.6);
  }
  /* The pin: a gilt hairline down the left edge that lights with the work. */
  .wall-label__pin {
    position: absolute;
    left: -1px;
    top: -1px;
    bottom: -1px;
    width: 3px;
    background: linear-gradient(180deg, var(--gilt-bright), var(--gilt), var(--gilt-ink));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform calc(var(--beat) * 1.2) var(--ease-settle);
  }
  .wall-label[aria-pressed='true'] {
    background: color-mix(in srgb, var(--wall) 40%, white);
    border-color: color-mix(in srgb, var(--gilt) 55%, var(--rule));
    cursor: default;
  }
  .wall-label[aria-pressed='true']:hover {
    transform: none;
  }
  .wall-label[aria-pressed='true'] .wall-label__pin {
    transform: scaleY(1);
  }
  .wall-label__code {
    color: var(--room-accent);
  }
  .wall-label__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    line-height: 1.15;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }
  .wall-label__medium {
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .wall-label__foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-top: 0.35rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-faint);
    font-size: 0.95rem;
  }
  .wall-label__year {
    font-variant-numeric: oldstyle-nums;
  }
  .wall-label__state {
    color: var(--gilt-ink);
    letter-spacing: 0.12em;
  }
  .wall-label__state-on {
    display: none;
  }
  .wall-label[aria-pressed='true'] .wall-label__state-on {
    display: inline;
  }
  .wall-label[aria-pressed='true'] .wall-label__state-off {
    display: none;
  }

  .studio__cta {
    display: flex;
    justify-content: flex-start;
  }

  @media (max-width: 960px) {
    .wall {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'easel'
        'caption'
        'labels';
    }
    .labels__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .caption {
      max-width: var(--measure);
    }
  }
  @media (max-width: 820px) {
    .studio__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .labels__list {
      grid-template-columns: minmax(0, 1fr);
    }
    .picture-light {
      width: 58%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .frame__pic,
    .frame__live,
    .frame__wash,
    .caption,
    .wall-label,
    .wall-label__pin {
      transition: none;
    }
  }
</style>
