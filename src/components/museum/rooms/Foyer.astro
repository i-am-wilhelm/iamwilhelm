---
/**
 * The foyer: the gilt zodiac chart with Michael's portrait set at its
 * centre, then the headline, the name, and one line of roles. The ring
 * turns slowly with scroll; the portrait holds still inside it. The
 * headline settles in with CSS alone (no script), so it paints at first
 * render. Wide screens hang the chart beside the text; narrow screens stack.
 */
import ZodiacRing from '../ZodiacRing.astro';
---

<section class="foyer" aria-labelledby="foyer-title">
  <div class="foyer__inner wrap">
    <div class="foyer__chart">
      <ZodiacRing contained />
      <figure class="foyer__portrait">
        <img
          src="/assets/foyer-portrait-440.webp"
          srcset="/assets/foyer-portrait-440.webp 440w, /assets/foyer-portrait-720.webp 720w"
          sizes="(min-width: 1000px) 16rem, 44vw"
          width="440"
          height="440"
          alt="Michael Wilhelm, smiling, long dark hair, in close portrait."
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>

    <div class="foyer__text">
      <p class="foyer__kicker smallcaps">The Foyer</p>
      <h1 class="foyer__title display" id="foyer-title">Devoted to something, but no one knows what.</h1>
      <div class="foyer__byline">
        <p class="foyer__name">Michael Wilhelm</p>
        <p class="foyer__roles">
          <span>CEO &amp; Cofounder, BackGold</span>
          <span class="foyer__sep" aria-hidden="true">·</span>
          <span>Founder, Advancing Liberty Media</span>
          <span class="foyer__sep" aria-hidden="true">·</span>
          <span>Writer</span>
        </p>
      </div>
      <a class="foyer__enter" href="#backgold">
        <span class="smallcaps">Begin the tour</span>
        <span class="foyer__arrow" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .foyer {
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(100svh - var(--nav-h));
    padding-block: clamp(2.5rem, 2rem + 4vw, 6rem);
    overflow: clip;
    text-align: center;
  }
  .foyer__inner {
    display: grid;
    justify-items: center;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  /* The chart: the ring fills the box; the portrait sits inside its
     innermost circle (r 206 of 400), so the engraving frames the face. */
  .foyer__chart {
    position: relative;
    width: min(88vw, 30rem, 58svh);
    aspect-ratio: 1;
    animation: settle calc(var(--beat) * 3) var(--ease-settle) both;
  }
  .foyer__portrait {
    position: absolute;
    inset: 25.5%;
    margin: 0;
    border-radius: 50%;
    overflow: hidden;
    background: var(--wall-deep);
    box-shadow:
      0 0 0 1px var(--gilt),
      0 0 0 6px color-mix(in srgb, var(--wall) 85%, transparent),
      0 0 0 7px color-mix(in srgb, var(--gilt) 55%, transparent),
      0 24px 40px -24px rgba(40, 28, 12, 0.55);
  }
  .foyer__portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .foyer__text {
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 0.8rem + 0.8vw, 1.6rem);
  }
  .foyer__kicker {
    color: var(--gilt-ink);
    font-size: 1rem;
    animation: settle calc(var(--beat) * 2.4) var(--ease-settle) both;
  }
  .foyer__title {
    max-width: 16ch;
    font-size: clamp(2.4rem, 1.4rem + 4.6vw, 5.2rem);
    color: var(--ink);
    animation: settle calc(var(--beat) * 3) var(--ease-settle) calc(var(--beat) * 0.5) both;
  }
  .foyer__byline {
    display: grid;
    gap: 0.5rem;
    animation: settle calc(var(--beat) * 2.4) var(--ease-settle) calc(var(--beat) * 1.25) both;
  }
  .foyer__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.8rem);
    letter-spacing: 0.18em;
    font-variant-caps: all-small-caps;
  }
  .foyer__roles {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.7rem;
    row-gap: 0.15rem;
    color: var(--ink-soft);
    font-style: italic;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
  }
  .foyer__sep {
    color: var(--gilt);
    font-style: normal;
  }
  .foyer__enter {
    display: inline-grid;
    justify-items: center;
    gap: 0.5rem;
    margin-top: clamp(0.5rem, 0.25rem + 1vw, 1.5rem);
    padding: 0.5rem 1rem;
    color: var(--ink-soft);
    text-decoration: none;
    animation: settle calc(var(--beat) * 2.4) var(--ease-settle) calc(var(--beat) * 2) both;
  }
  .foyer__enter:hover {
    color: var(--ink);
  }
  .foyer__arrow {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(var(--gilt), transparent);
  }

  /* Wide rooms: the chart hangs to the left, the wall text beside it. */
  @media (min-width: 1000px) {
    .foyer__inner {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      column-gap: clamp(3rem, 1rem + 4vw, 6rem);
    }
    .foyer__chart {
      width: min(40vw, 34rem, 76svh);
    }
    .foyer__text {
      justify-items: start;
      text-align: left;
    }
    .foyer__roles {
      flex-direction: column;
      align-items: flex-start;
    }
    .foyer__sep {
      display: none;
    }
    .foyer__enter {
      justify-items: start;
      padding-inline: 0;
    }
  }

  /* Opacity starts above zero so the headline is a paint candidate at once. */
  @keyframes settle {
    from {
      opacity: 0.12;
      transform: translate3d(0, 18px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 520px) {
    .foyer__sep {
      display: none;
    }
    .foyer__roles {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
