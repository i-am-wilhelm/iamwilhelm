---
/**
 * Room IV: the Gallery of Visualized Poetry. The same framed tiles as
 * /gallery, fed by the `gallery` content collection.
 */
import Room from '../Room.astro';
import Placard from '../Placard.astro';
import PoemGallery from '../PoemGallery.astro';
---

<Room id="gallery" number={4} sign="pisces" accent="var(--room-iv)" labelledby="gallery-title" deep>
  <div class="gal wrap">
    <div class="gal__head">
      <Placard
        id="gallery-title"
        label="Room IV · Poetry"
        title="Gallery of Visualized Poetry"
        medium="Poems written to be read slowly, each set on its own interactive page"
        catalog="Cat. IV"
      />
      <div class="gal__statement prose-museum" data-reveal>
        <p class="lede">
          Each poem here is staged as a page you walk through. Movements arrive one at a time and the text settles
          into place as you read.
        </p>
        <p>Choose a frame to enter the poem.</p>
      </div>
    </div>
    <PoemGallery level={3} />
    <p class="gal__more" data-reveal>
      <a class="text-link" href="/gallery/">Visit the gallery on its own</a>
    </p>
  </div>
</Room>

<style>
  .gal {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .gal__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .gal__statement {
    padding-top: 0.5rem;
    color: var(--ink-soft);
  }
  .gal__statement .lede {
    color: var(--ink);
  }
  .gal__more {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }
  @media (max-width: 820px) {
    .gal__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
