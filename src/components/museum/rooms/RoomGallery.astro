---
/**
 * Room II: The Gallery. On the homepage the collection is kept as the
 * Archive (Archive.astro): every scroll page on view, the Futurist
 * installments included, is a box shelved by series, and the chosen box
 * opens on the reading table. The framed wall is /gallery.
 */
import Room from '../Room.astro';
import Placard from '../Placard.astro';
import Archive from '../Archive.astro';
---

<Room id="gallery" number={2} sign="pisces" accent="var(--room-iv)" labelledby="gallery-title" deep>
  <div class="gal wrap">
    <div class="gal__head">
      <Placard
        id="gallery-title"
        label="Room II"
        title="The Gallery"
        medium="Poems and essays written to be read slowly, each set on its own interactive page"
        catalog="Cat. II"
      />
      <div class="gal__statement prose-museum" data-reveal>
        <p class="lede">
          Each piece here is staged as a page you walk through. Movements arrive one at a time and the text settles
          into place as you read.
        </p>
        <p>The collection is kept in boxes, shelved by series. Take one down and it opens on the table.</p>
      </div>
    </div>
    <Archive />
    <p class="gal__more" data-reveal>
      <a class="text-link" href="/gallery/">See every piece framed on the wall</a>
    </p>
    <p class="gal__more" data-reveal>
      Pieces like these are built to order. <a class="text-link" href="/services/">Commissions &rarr;</a>
    </p>
  </div>
</Room>

<style>
  .gal {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .gal__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .gal__statement {
    padding-top: 0.5rem;
    color: var(--ink-soft);
  }
  .gal__statement .lede {
    color: var(--ink);
  }
  .gal__more + .gal__more {
    margin-top: calc(-1 * clamp(2.5rem, 2rem + 3vw, 4.5rem) + 0.6rem);
  }
  .gal__more {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }
  @media (max-width: 820px) {
    .gal__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
