---
/**
 * The Futurist series on the homepage: its own section after Room II, with
 * the series name as the heading (linking to the series index), the series
 * statement, and every installment framed in number order. The primary
 * navigation's "Futurist" item lands here on the homepage (id="futurist")
 * and on /writings/futurist/ everywhere else. The frames come from the
 * gallery entries that name the series, so a new installment hangs itself.
 */
import Placard from '../Placard.astro';
import Glyph from '../Glyph.astro';
import PoemGallery from '../PoemGallery.astro';
import { series, seriesAccent } from '../../../config/series';
import { getSeriesPieces } from '../../../lib/pieces';

const s = series.futurist;
const ids = (await getSeriesPieces('futurist'))
  .filter((p) => p.kind === 'scroll')
  .sort((a, b) => (a.seriesNo ?? 0) - (b.seriesNo ?? 0))
  .map((p) => p.id);
---

<section id="futurist" class="fut" aria-labelledby="futurist-title" style={`--room-accent: ${seriesAccent('futurist')}`}>
  <div class="fut__wayfinding wrap" aria-hidden="true">
    <span class="fut__label">A series</span>
    <span class="fut__rule"></span>
    <Glyph sign="aquarius" size={26} class="fut__glyph" />
  </div>
  <div class="fut__inner wrap">
    <div class="fut__head">
      <Placard id="futurist-title" label="A series" title={s.name} medium={s.statement} />
      <div class="fut__statement prose-museum" data-reveal>
        <p class="lede">{ids.length} installments so far, in the order they were written. Choose a frame to enter.</p>
      </div>
    </div>
    <div class="fut__wall">
      <PoemGallery level={3} ids={ids} />
    </div>
    <p class="fut__more" data-reveal>
      <a class="text-link" href={s.href}>All of {s.name}</a>
    </p>
  </div>
</section>

<style>
  .fut {
    position: relative;
    padding-block: clamp(4.5rem, 3rem + 7vw, 9.5rem);
  }
  .fut__wayfinding {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    color: var(--room-accent);
  }
  .fut__label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.22em;
    font-variant-caps: all-small-caps;
    white-space: nowrap;
  }
  .fut__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--gilt), transparent);
    opacity: 0.7;
  }
  .fut :global(.fut__glyph) {
    flex: none;
    color: var(--gilt-ink);
  }
  .fut__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .fut__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .fut__statement {
    padding-top: 0.5rem;
    color: var(--ink);
  }
  /* Two frames across, as on the Gallery's Futurist wall; stacked on phones. */
  .fut__wall :global(.poems) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .fut__more {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }
  @media (max-width: 820px) {
    .fut__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .fut__wall :global(.poems) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
