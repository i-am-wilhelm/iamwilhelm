<style is:global>
  .sbmark {
    display: block;
    width: 100%;
  }
  .sbmark__mat {
    display: block;
  }
  .sbmark__svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }
  .sbmark--framed {
    padding: 10px;
    background: linear-gradient(135deg, #2a2622, #1a1815 60%, #2a2622);
    box-shadow:
      0 1px #fff6,
      0 28px 40px -26px #281c0cb3;
  }
  .sbmark--framed .sbmark__mat {
    padding: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    background: #fbf8f1;
    outline: 1px solid var(--gilt);
    outline-offset: -5px;
  }
  .js-reveal [data-reveal] .sbmark__beam {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .js-reveal [data-reveal].is-revealed .sbmark__beam {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset calc(var(--beat) * 2.4) var(--ease-settle)
      calc(var(--beat) * 0.8);
  }
  @media (prefers-reduced-motion: reduce) {
    .js-reveal [data-reveal] .sbmark__beam {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
  }
</style>
