---
/**
 * A series' index (/writings/<id>/), in the reading room's style: the
 * series' one-line statement, its pieces newest first (scroll pages and
 * readings alike, from src/lib/pieces.ts), and its own feed. Everything
 * comes from the series registry (src/config/series.ts) and the entries
 * that name the series, so the page never needs touching when a piece
 * joins.
 */
import Museum from '../../layouts/Museum.astro';
import Placard from './Placard.astro';
import WritingsList from './WritingsList.astro';
import Meander from './Meander.astro';
import Colophon from './Colophon.astro';
import { series as registry, seriesAccent, seriesFeed, type SeriesId } from '../../config/series';
import { SITE_NAME, SITE_URL } from '../../config/site';

interface Props {
  id: SeriesId;
}
const { id } = Astro.props;
const s = registry[id];
const url = `${SITE_URL}${s.href}`;
const feed = seriesFeed(id);
---

<Museum
  title={`${s.title} · Writings · ${SITE_NAME}`}
  description={`${s.title} by ${SITE_NAME}. ${s.statement}`}
  current="writings"
  schema={[
    {
      '@type': ['CollectionPage', 'CreativeWorkSeries'],
      '@id': `${url}#series`,
      url,
      name: s.title,
      description: s.statement,
      author: { '@id': `${SITE_URL}/#person` },
      isPartOf: { '@type': 'CollectionPage', name: 'Writings', url: `${SITE_URL}/writings/` },
    },
  ]}
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title={`${s.title} · ${SITE_NAME}`} href={feed} />
  </Fragment>
  <section class="page" aria-labelledby="series-title" style={`--room-accent: ${seriesAccent(id)}`}>
    <div class="page__inner wrap">
      <div class="page__head">
        <Placard
          id="series-title"
          level={1}
          label="A series"
          title={s.name}
          medium={s.statement}
        />
        <div class="page__statement" data-reveal>
          {/* TODO(owner): the series description. The one-liner above is the `statement` in src/config/series.ts; a longer paragraph belongs here. */}
          <p class="lede">The series so far, newest first.</p>
          <p class="page__feed">
            <a class="text-link" href={feed}>Follow this series by RSS</a>
          </p>
        </div>
      </div>
      <WritingsList level={2} series={id} />
      <div data-reveal>
        <a class="cta" href="/writings/">The reading room</a>
      </div>
    </div>
  </section>
  <Meander />
  <Colophon />
</Museum>

<style>
  .page {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem);
  }
  .page__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .page__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .page__statement {
    display: grid;
    gap: 1rem;
    padding-top: 0.5rem;
    color: var(--ink);
  }
  .page__feed {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }
  @media (max-width: 820px) {
    .page__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
