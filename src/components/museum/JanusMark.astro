---
/**
 * Janus as a small hairline mark, the size of a zodiac wayfinding glyph:
 * two profiles back to back and the seam between them. Decorative; the
 * link or label beside it carries the name. Paths in ./janus.ts.
 */
import { MARK_HALF, MARK_SEAM } from './janus';

interface Props {
  size?: number | string;
  class?: string;
}

const { size = 22, class: cls } = Astro.props;
const dim = typeof size === 'number' ? `${size}px` : size;
---

<svg
  class:list={['janus-mark', cls]}
  viewBox="0 0 24 24"
  width={dim}
  height={dim}
  fill="none"
  stroke="currentColor"
  stroke-width="1.1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={MARK_HALF}></path>
  <path d={MARK_HALF} transform="translate(24 0) scale(-1 1)"></path>
  <path d={MARK_SEAM} opacity="0.55"></path>
</svg>
