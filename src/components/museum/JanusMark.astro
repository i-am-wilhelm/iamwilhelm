---
/**
 * Janus as a small hairline mark, the size of a zodiac wayfinding glyph:
 * two profiles back to back and the seam between them. Paths in ./janus.ts.
 *
 * With `link` the mark is a door of its own: it opens Before and Behind,
 * the essay on Janus (JANUS_ESSAY, src/config/site.ts), and carries that
 * name for screen readers and on hover. Without it the mark is decorative
 * and the link or label beside it carries the name. `class` always lands
 * on the drawing.
 */
import { MARK_HALF, MARK_SEAM } from './janus';
import { JANUS_ESSAY, JANUS_ESSAY_TITLE } from '../../config/site';

interface Props {
  size?: number | string;
  class?: string;
  /** Wrap the mark in a link to the Janus essay. */
  link?: boolean;
}

const { size = 22, class: cls, link = false } = Astro.props;
const dim = typeof size === 'number' ? `${size}px` : size;
const name = `${JANUS_ESSAY_TITLE}: the essay on Janus`;
const Wrap = link ? 'a' : Fragment;
const wrapProps = link ? { class: 'janus-link', href: JANUS_ESSAY, 'aria-label': name, title: name } : {};
---

<Wrap {...wrapProps}>
  <svg
    class:list={['janus-mark', cls]}
    viewBox="0 0 24 24"
    width={dim}
    height={dim}
    fill="none"
    stroke="currentColor"
    stroke-width="1.1"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d={MARK_HALF}></path>
    <path d={MARK_HALF} transform="translate(24 0) scale(-1 1)"></path>
    <path d={MARK_SEAM} opacity="0.55"></path>
  </svg>
</Wrap>

<style>
  /* A full-height target around a small drawing; the drawing keeps its size. */
  .janus-link {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .janus-link .janus-mark {
    transition: transform 0.35s ease;
  }
  .janus-link:hover .janus-mark,
  .janus-link:focus-visible .janus-mark {
    transform: scale(1.18);
  }
  @media (prefers-reduced-motion: reduce) {
    .janus-link .janus-mark {
      transition: none;
    }
    .janus-link:hover .janus-mark,
    .janus-link:focus-visible .janus-mark {
      transform: none;
    }
  }
</style>
