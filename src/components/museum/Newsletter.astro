---
/**
 * The BackGold newsletter form. When NEWSLETTER_EMBED_HTML (config/site.ts)
 * holds BackGold's embed snippet it renders verbatim. Until then a stand-in
 * form in the museum style renders, marked data-placeholder: it validates
 * the address and tells the visitor sign-up opens soon, and sends nothing.
 */
import { NEWSLETTER_EMBED_HTML } from '../../config/site';
const hasEmbed = NEWSLETTER_EMBED_HTML.trim().length > 0;
---

<div class="newsletter">
  <h3 class="newsletter__title smallcaps" id="newsletter-title">The newsletter</h3>
  <p class="newsletter__note">Occasional letters when a new room opens or a new poem is hung.</p>
  {
    hasEmbed ? (
      <div class="newsletter__embed" set:html={NEWSLETTER_EMBED_HTML} />
    ) : (
      <form class="newsletter__form" data-placeholder aria-labelledby="newsletter-title" novalidate>
        {/* PLACEHOLDER(owner): replace with the BackGold embeddable form via NEWSLETTER_EMBED_HTML. */}
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          placeholder="you@example.com"
          required
        />
        <button class="cta cta--gilt" type="submit">Subscribe</button>
        <p class="newsletter__status" role="status" aria-live="polite" data-status></p>
      </form>
    )
  }
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('.newsletter__form[data-placeholder]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!input.checkValidity()) {
        status.textContent = 'Please enter a full email address.';
        input.setAttribute('aria-invalid', 'true');
        input.focus();
        return;
      }
      input.removeAttribute('aria-invalid');
      status.textContent = 'Thank you. Sign-up opens soon; please check back.';
    });
  }
</script>

<style>
  .newsletter {
    display: grid;
    gap: 0.6rem;
  }
  .newsletter__title {
    color: var(--gilt-ink);
    font-weight: 400;
    font-size: 1.05rem;
  }
  .newsletter__note {
    color: var(--ink-soft);
  }
  .newsletter__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }
  .newsletter__form input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 44px;
    padding: 0.6rem 0.9rem;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: color-mix(in srgb, var(--wall) 60%, white);
    border: 1px solid var(--ink-faint);
    border-radius: 0;
  }
  .newsletter__form input::placeholder {
    color: var(--ink-faint);
    opacity: 1;
  }
  .newsletter__form input[aria-invalid='true'] {
    border-color: var(--room-ii);
  }
  .newsletter__status {
    flex-basis: 100%;
    min-height: 1.6em;
    color: var(--ink-soft);
    font-style: italic;
  }
</style>
