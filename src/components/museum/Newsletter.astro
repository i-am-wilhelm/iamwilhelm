---
/**
 * The BackGold newsletter block in the colophon: title, note, and the
 * shared field (NewsletterForm), which renders BackGold's embed once
 * NEWSLETTER_EMBED_HTML is set and the stand-in form until then.
 */
import NewsletterForm from './NewsletterForm.astro';
---

<div class="newsletter">
  <h3 class="newsletter__title smallcaps" id="newsletter-title">The newsletter</h3>
  <p class="newsletter__note">Occasional letters when a new room opens or a new poem is hung.</p>
  <NewsletterForm class="newsletter__form" labelledby="newsletter-title" buttonClass="cta cta--gilt" />
</div>

<style>
  .newsletter {
    display: grid;
    gap: 0.6rem;
  }
  .newsletter__title {
    color: var(--gilt-ink);
    font-weight: 400;
    font-size: 1.05rem;
  }
  .newsletter__note {
    color: var(--ink-soft);
  }
  .newsletter :global(.newsletter__form) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }
  .newsletter :global(.newsletter__form input) {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 44px;
    padding: 0.6rem 0.9rem;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: color-mix(in srgb, var(--wall) 60%, white);
    border: 1px solid var(--ink-faint);
    border-radius: 0;
  }
  .newsletter :global(.newsletter__form input::placeholder) {
    color: var(--ink-faint);
    opacity: 1;
  }
  .newsletter :global(.newsletter__form input[aria-invalid='true']) {
    border-color: var(--room-ii);
  }
  .newsletter :global(.nl-form__status) {
    flex-basis: 100%;
    min-height: 1.6em;
    color: var(--ink-soft);
    font-style: italic;
  }
</style>
