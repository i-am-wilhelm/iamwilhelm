---
/**
 * The framed tiles of the Gallery (PoemCard), shared by Room II, /gallery
 * and /services. Each piece on view is one link to its page, so the wall is
 * a plain list of links in tab order; forthcoming entries hang as empty
 * frames with no link. The catalogue `order` sorts the wall and is not
 * printed.
 *
 * With `hero`, the homepage wall hangs its first piece as the hero frame:
 * the full width of the wall, frame and placard side by side. With `ids`,
 * only those frames hang, in that order (the commissions page); with
 * `thumbs`, each frame shows the piece's own share image (public/og/<id>.jpg)
 * in place of the painted plate. With `grouped` (/gallery), the wall is
 * hung by series, in the order of src/config/series.ts: each series gets a
 * heading that links to its index, its one-line statement, and its pieces
 * by number; a piece in no series hangs last, under "Elsewhere".
 */
import PoemCard from './PoemCard.astro';
import { series as registry, seriesAccent, seriesIds, type SeriesId } from '../../config/series';
import { getCollection } from 'astro:content';
import { getScrollPieces, type Piece } from '../../lib/pieces';

interface Props {
  /** Heading level for tile titles (h3 inside a room, h2 on a flat page); grouped, the series headings take it and the tiles one lower. */
  level?: 2 | 3;
  /** Hang the first piece as the hero frame (the homepage wall). */
  hero?: boolean;
  /** Only these pieces, in this order. */
  ids?: string[];
  /** Leave these pieces off this wall (the homepage, for pieces hung in the Gallery only). */
  exclude?: string[];
  /** Show each piece's share image in the frame instead of the plate. */
  thumbs?: boolean;
  /** Hang the wall by series. */
  grouped?: boolean;
}
const { level = 3, hero = false, ids, exclude, thumbs = false, grouped = false } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
const tileLevel = (grouped ? level + 1 : level) as 2 | 3 | 4;

/* Every frame, on view or forthcoming, in wall order; the pieces view
   carries the series and verb for the ones on view. */
const all = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
const hung = exclude ? all.filter((f) => !exclude.includes(f.id)) : all;
const frames = ids ? ids.map((id) => hung.find((f) => f.id === id)).filter((f) => !!f) : hung;
const pieces = new Map((await getScrollPieces()).map((p) => [p.id, p]));

type Group = { id?: SeriesId; name: string; href?: string; statement?: string; accent?: string; frames: typeof frames };
const groups: Group[] = [];
if (grouped) {
  for (const id of seriesIds) {
    const s = registry[id];
    const inSeries = frames
      .filter((f) => pieces.get(f.id)?.series === id)
      .sort((a, b) => (pieces.get(a.id)?.seriesNo ?? 0) - (pieces.get(b.id)?.seriesNo ?? 0));
    if (inSeries.length) groups.push({ id, name: s.name, href: s.href, statement: s.statement, accent: seriesAccent(id), frames: inSeries });
  }
  const loose = frames.filter((f) => !pieces.get(f.id)?.series);
  if (loose.length) groups.push({ name: 'Elsewhere', frames: loose });
}
const pieceFor = (id: string): Piece | undefined => pieces.get(id);
---

{
  grouped ? (
    <div class="walls">
      {groups.map((g) => (
        <section
          class="wall"
          aria-labelledby={`wall-${g.id ?? 'elsewhere'}`}
          style={g.accent ? `--series-accent: ${g.accent}` : undefined}
        >
          <header class="wall__head" data-reveal>
            <H class="wall__title display" id={`wall-${g.id ?? 'elsewhere'}`}>
              {g.href ? <a href={g.href}>{g.name}</a> : g.name}
            </H>
            {g.statement && <p class="wall__statement">{g.statement}</p>}
            {g.href && (
              <p class="wall__all mono">
                <a href={g.href}>All of {g.name}</a>
              </p>
            )}
          </header>
          <ul class="poems" role="list">
            {g.frames.map((f, i) => (
              <PoemCard frame={f} piece={pieceFor(f.id)} index={i} level={tileLevel} thumb={thumbs} />
            ))}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <ul class="poems" role="list">
      {frames.map((f, i) => (
        <PoemCard frame={f} piece={pieceFor(f.id)} index={i} level={tileLevel} hero={hero && i === 0} thumb={thumbs} />
      ))}
    </ul>
  )
}

<style>
  .poems {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: clamp(2.5rem, 2rem + 2vw, 4rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  /* The wall by series: a heading in the series' accent, the statement,
     then the frames. */
  .walls {
    display: grid;
    gap: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }
  .wall {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    border-top: 1px solid var(--rule);
  }
  .wall__head {
    display: grid;
    gap: 0.5rem;
    max-width: 40rem;
  }
  .wall__title {
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
    color: var(--series-accent, var(--ink));
  }
  .wall__title a {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size calc(var(--beat) * 1.2) var(--ease-settle);
  }
  .wall__title a:hover,
  .wall__title a:focus-visible {
    background-size: 100% 1px;
  }
  .wall__statement {
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .wall__all a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--series-accent, var(--gilt-ink));
    text-decoration: none;
    text-underline-offset: 0.3em;
  }
  .wall__all a:hover,
  .wall__all a:focus-visible {
    text-decoration: underline;
  }
</style>
