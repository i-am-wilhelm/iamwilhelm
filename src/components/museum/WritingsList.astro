---
/**
 * Rows of pieces in the reading room's style: the series label as the
 * primary line (in the series accent, linking to the series index), the
 * title, the date, and the one-line description. Shared by Room III (the
 * latest few readings), /writings (every reading: the readings shelf) and
 * the series indexes (`series`: that series' pieces, scroll pages and
 * readings alike, numbered in it). The catalogue number is a sort key and
 * is not printed.
 */
import { series as seriesSpec, seriesAccent, type SeriesId } from '../../config/series';
import { getReadings, getSeriesPieces, type Piece } from '../../lib/pieces';

interface Props {
  limit?: number;
  level?: 2 | 3;
  /** Only this series, scroll pages and readings, newest first. */
  series?: SeriesId;
}
const { limit, level = 3, series } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';

const all: (Piece & { companion?: Piece })[] = series ? await getSeriesPieces(series) : await getReadings();
const posts = limit ? all.slice(0, limit) : all;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<ol class="writings" role="list">
  {
    posts.map((p) => (
      <li class="entry" data-reveal>
        <span class="entry__num mono">{p.seriesNo ? `No. ${p.seriesNo}` : '·'}</span>
        <div class="entry__body">
          {p.series && p.label && (
            <p class="entry__series mono" style={`--series-accent: ${seriesAccent(p.series)}`}>
              {series ? <span>{p.label}</span> : <a href={seriesSpec[p.series].href}>{p.label}</a>}
              {p.kind === 'scroll' && <span class="entry__kind">Scroll page</span>}
            </p>
          )}
          <H class="entry__title">
            <a href={p.path}>{p.title}</a>
          </H>
          <p class="entry__date">
            <time datetime={p.date.toISOString()}>{fmt(p.date)}</time>
          </p>
          {p.line && <p class="entry__desc">{p.line}</p>}
          {p.verb && <p class="entry__verb">{p.verb}</p>}
          {p.companion && (
            <p class="entry__companion">
              <a class="text-link" href={p.companion.path}>
                Read the headnote and essay
              </a>
            </p>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .writings {
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .entry {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: clamp(1.4rem, 1rem + 1.5vw, 2.2rem);
    border-bottom: 1px solid var(--rule);
  }
  .entry__num {
    padding-top: 0.6rem;
    color: var(--gilt-ink);
  }
  .entry__body {
    display: grid;
    gap: 0.35rem;
  }
  .entry__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
    line-height: 1.1;
  }
  .entry__title a {
    text-decoration: none;
    background-image: linear-gradient(var(--gilt), var(--gilt));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size calc(var(--beat) * 1.2) var(--ease-settle);
  }
  .entry__title a:hover,
  .entry__title a:focus-visible {
    background-size: 100% 1px;
  }
  .entry__series {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    letter-spacing: 0.06em;
    color: var(--series-accent);
  }
  .entry__series a {
    color: var(--series-accent);
    text-decoration: none;
    text-underline-offset: 0.3em;
  }
  .entry__series a:hover,
  .entry__series a:focus-visible {
    text-decoration: underline;
  }
  .entry__kind {
    color: var(--ink-faint);
  }
  .entry__date {
    color: var(--ink-faint);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
  }
  .entry__desc {
    max-width: var(--measure);
    color: var(--ink-soft);
  }
  .entry__verb,
  .entry__companion {
    color: var(--ink-faint);
    font-style: italic;
    font-size: 0.95rem;
  }
  .entry__companion {
    font-style: normal;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
  }
  @media (max-width: 480px) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }
    .entry__num {
      padding-top: 0;
    }
  }
</style>
