---
/**
 * Sticky minimal nav. On the homepage every item is an in-page anchor to its
 * room (museum.ts marks the room in view with aria-current); elsewhere,
 * Gallery and Writings go to their own routes and the rest return to the
 * homepage rooms.
 */
import { NAV } from '../../config/site';

interface Props {
  home?: boolean;
  /** Route key for aria-current="page" on standalone pages. */
  current?: 'gallery' | 'writings';
}
const { home = false, current } = Astro.props;

const items = NAV.map((item) => {
  const href = home ? `#${item.id}` : 'page' in item && item.page ? item.page : `/#${item.id}`;
  return { ...item, href, isCurrent: current === item.id };
});
---

<header class="site-nav" data-nav>
  <nav class="site-nav__inner wrap" aria-label="Primary">
    <a class="site-nav__brand" href={home ? '#top' : '/'}>
      <span class="site-nav__mono" aria-hidden="true">MW</span>
      <span class="site-nav__name">Michael Wilhelm</span>
    </a>
    <ul class="site-nav__list">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav-link={home ? item.id : undefined}
              aria-current={item.isCurrent ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--wall) 96%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color 500ms var(--ease-settle);
  }
  :global(.is-scrolled) .site-nav {
    border-bottom-color: var(--rule);
  }
  .site-nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
    flex: none;
    min-height: 44px;
  }
  .site-nav__mono {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--gilt);
    border-radius: 50%;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: var(--gilt-ink);
  }
  .site-nav__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
  }
  .site-nav__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 0.4rem + 1.2vw, 1.75rem);
  }
  .site-nav__list a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 1rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.14em;
    white-space: nowrap;
    transition: color 300ms ease;
  }
  .site-nav__list a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.7rem;
    height: 1px;
    background: var(--gilt);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms var(--ease-settle);
  }
  .site-nav__list a:hover,
  .site-nav__list a[aria-current] {
    color: var(--ink);
  }
  .site-nav__list a:hover::after,
  .site-nav__list a[aria-current]::after {
    transform: scaleX(1);
  }

  /* Narrow screens: the brand keeps its monogram; the six links ride one
     row that scrolls inside the nav, never the page. */
  @media (max-width: 860px) {
    /* Visually hidden, still the link's accessible name. */
    .site-nav__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .site-nav__inner {
      gap: 0.75rem;
    }
    .site-nav__list {
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(90deg, #000 92%, transparent);
      mask-image: linear-gradient(90deg, #000 92%, transparent);
      padding-right: 2rem;
      gap: 1rem;
      min-width: 0;
    }
    .site-nav__list::-webkit-scrollbar {
      display: none;
    }
  }
</style>
