---
/**
 * The footer: a quiet credit line, the typefaces, and the outbound links.
 */
import { ALM_URL, BACKGOLD_URL } from '../../config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner wrap">
    <p class="site-footer__credit">
      <span class="smallcaps">Michael Wilhelm</span>
      <span class="site-footer__year">© {year}</span>
    </p>
    <nav class="site-footer__links" aria-label="Footer">
      <a href="/gallery/">Gallery</a>
      <a href="/writings/">Writings</a>
      <a href={BACKGOLD_URL} rel="noopener">BackGold</a>
      <a href={ALM_URL} rel="noopener">Advancing Liberty Media</a>
    </nav>
    <p class="site-footer__type">Set in Cormorant Garamond, EB Garamond, and JetBrains Mono.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    padding-block: 2rem 2.5rem;
    color: var(--ink-faint);
    font-size: 0.95rem;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }
  .site-footer__credit {
    display: flex;
    gap: 0.75rem;
    color: var(--ink-soft);
  }
  .site-footer__year {
    font-variant-numeric: oldstyle-nums;
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-soft);
    text-decoration: none;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }
  .site-footer__links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .site-footer__type {
    flex-basis: 100%;
    font-style: italic;
  }
</style>
