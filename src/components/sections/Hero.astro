---
/**
 * HERO — portrait facecard + tagline (spec §4.1, design merged from the
 * `production` prototype line: centered portrait feathered into the void,
 * "Builder. Writer. Musician." tagline).
 * The Black Swan stays the hero *symbol*: the WebGL pipeline renders the
 * swan splash + constellation base from the data-* attributes Section.astro
 * emits; this component is the DOM/copy layer only. The swan symbol card
 * remains at /assets/facecard.webp for the visual layer's use.
 */
import Section from '../Section.astro';
import type { SectionSpec } from '../../design/tokens';

interface Props {
  spec: SectionSpec;
}

const { spec } = Astro.props;
---

<Section spec={spec}>
  <figure class="facecard" data-egg-anchor="hero-swan">
    <img
      src="/assets/portrait.webp"
      alt="Michael Wilhelm — portrait"
      loading="eager"
      onerror="this.closest('.facecard').classList.add('facecard--absent')"
    />
    <span class="facecard-fallback greek" aria-hidden="true">Ψ</span>
  </figure>

  <p class="term">&gt; Michael Wilhelm</p>
  <h1>Builder. Writer. Musician.</h1>
  <p class="lede">Devoted to something, but nobody knows what.</p>
  <blockquote class="epigraph">
    <a href="/writings/pharmakon/">
      I was born legible — and lonely for a reader.<br />
      I have never wanted to be merely loved.<br />
      I want to be studied.
    </a>
  </blockquote>
  <!-- Venus as Phosphoros: answers only in the dawn band (phosphoros-dawn egg). -->
  <span class="phosphoros" data-egg-anchor="phosphoros-star" aria-hidden="true">⁘</span>
</Section>

<style>
  /* The portrait outgrows the standard 42rem copy column. */
  :global(#hero .copy) {
    max-width: min(92vmin, 760px);
    margin: 0 auto;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.6rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--ink);
    margin-bottom: 1rem;
    text-align: center;
  }

  .facecard {
    position: relative;
    width: min(92vmin, 760px);
    margin: 0 auto 2.4rem;
    /* feather the square edges into the void — no visible corners.
       opaque through the face, dissolving to nothing before the edge
       so the portrait bleeds into the black instead of ending on a line */
    -webkit-mask-image: radial-gradient(circle at 50% 45%, #000 40%, rgba(0, 0, 0, 0) 74%);
    mask-image: radial-gradient(circle at 50% 45%, #000 40%, rgba(0, 0, 0, 0) 74%);
  }

  .facecard img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  /* Graceful absence: hide the broken img, reveal the glyph placeholder. */
  .facecard-fallback {
    display: none;
  }

  .facecard--absent img {
    display: none;
  }

  .facecard--absent .facecard-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 1px dashed var(--ink-dim);
    font-size: 4rem;
    color: var(--section-accent, var(--ink-dim));
  }

  .term {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    color: var(--ink-dim);
    text-align: center;
    margin-bottom: 0.8rem;
  }

  .lede {
    max-width: 34rem;
    margin: 0 auto;
    color: var(--ink-dim);
    text-align: center;
    font-style: italic;
  }

  /* Pull-quote from the Pharmakon poem — small, unattributed, a door. */
  .epigraph {
    max-width: 30rem;
    margin: 1.6rem auto 0;
    text-align: center;
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .epigraph a {
    color: var(--ink-dim);
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.4s ease, color 0.4s ease;
  }

  .epigraph a:hover {
    opacity: 1;
    color: var(--accent-writings);
  }

  .phosphoros {
    position: absolute;
    top: 8vh;
    right: 6vw;
    font-size: 1rem;
    color: var(--ink-dim);
    opacity: 0.4;
  }
</style>
